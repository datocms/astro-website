---
import { PixelCover, PixelCoverFragment, pixelCover } from '~/components/PixelCover';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { graphql } from '~/lib/datocms/graphql';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

// Show the covers of the blog as the site draws them, with PixelCover. The
// CMS has the covers: the fields `pixel_cover` and `theme` of a blog post.
//
// - at the size of a feed card (366 × 214 CSS px): for each feed (all the
//   posts, then each category), its three newest posts with a cover. No
//   cover may look smaller or busier than the other covers of its row, and
//   the three covers of a row have three different themes.
// - at the size of the post header (712 CSS px wide): all the covers, the
//   newest first.
//
// This page is not in src/pages/. The integration "dev-tools" in
// astro.config.ts adds its route.

const query = graphql(
  /* GraphQL */ `
    query CoverGallery {
      posts: allBlogPosts(
        first: 500
        orderBy: _firstPublishedAt_DESC
        filter: { pixelCover: { exists: true } }
      ) {
        id
        slug
        category {
          id
        }
        ...PixelCoverFragment
      }
      categories: allBlogPostCategories(first: 100, orderBy: position_ASC) {
        id
        name
      }
    }
  `,
  [PixelCoverFragment],
);

const { posts, categories } = await executeQuery(Astro, query);
const covers = posts.filter((post) => pixelCover(post) !== undefined);
const rows = [
  { name: 'All posts', covers: covers.slice(0, 3) },
  ...categories.map((category) => ({
    name: category.name,
    covers: covers.filter((post) => post.category?.id === category.id).slice(0, 3),
  })),
].filter((row) => row.covers.length > 0);
const seo = overrideSeo([], seoTitle('cover gallery'));
---

<Layout seo={seo} theme="green" headerVariant={false} footer={false}>
  {
    rows.map((row) => (
      <section class="section">
        <h2 class="label">Feed card, 366 × 214: {row.name}</h2>
        <ul class="feed">
          {row.covers.map((post) => (
            <li>
              <PixelCover post={post} class="feedCover" />
              <p class="caption label">
                {post.slug} · {pixelCover(post)?.theme}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="section">
    <h2 class="label">Post header, 712 wide</h2>
    <ul class="headers">
      {
        covers.map((post) => (
          <li>
            <PixelCover post={post} class="headerCover" />
            <p class="caption label">{post.slug}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-md);
  }

  .feed {
    display: grid;
    grid-template-columns: repeat(3, 366px);
    gap: var(--space-xl) var(--space-lg);
    list-style: none;
  }

  .headers {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    list-style: none;
  }

  .feedCover {
    width: 366px;
    aspect-ratio: 12 / 7;
  }

  .headerCover {
    width: 712px;
    max-width: 100%;
    aspect-ratio: 12 / 7;
  }

  .caption {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
  }

  @media (max-width: 1200px) {
    .feed {
      grid-template-columns: repeat(auto-fill, 366px);
    }
  }
</style>
