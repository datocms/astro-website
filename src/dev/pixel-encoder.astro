    .dropHint {
      position: fixed;
      inset: var(--space-sm);
      display: grid;
      place-items: center;
      border: 2px dashed var(--border-strong);
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--surface-default) 85%, transparent);
      pointer-events: none;
      z-index: 10;
    }
    .dropHint[hidden] {
      display: none;
    }
  }
</style>
