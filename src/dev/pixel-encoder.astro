      padding: var(--space-lg) var(--section-padding-x);
      display: flex;
      flex-direction: column-reverse;
      gap: var(--space-md);
    }
    .controlsColumn {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      min-width: 0;
    }
    /* On wide screens the previews stay in view next to the controls. */
    @media (min-width: 1152px) {
      .wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }
      .previews {
        position: sticky;
        top: var(--space-md);
      }
    }

    /* A numbered step: a box with a title. */
    .step {
      margin: 0;
      padding: var(--space-sm);
      border: 1px solid var(--border-default);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      min-width: 0;
    }
    .step h2,
    .step legend,
    .step summary {
      margin: 0;
      display: flex;
      align-items: baseline;
      gap: var(--space-2xs);
    }
    /* A fieldset legend sits on the border. Float puts it inside the box. */
    .step legend {
      float: left;
      width: 100%;
      padding: 0;
    }
    .step summary {
      cursor: pointer;
    }
    details.step:not([open]) {
      gap: 0;
    }
    .num {
      display: inline-grid;
      place-items: center;
      width: 1.5em;
      height: 1.5em;
      border-radius: var(--radius-full);
      background: var(--surface-inverse);
      color: var(--text-on-inverse);
      font-size: 0.75em;
    }
    .step:disabled {
      opacity: 0.45;
    }
    .step p {
      margin: 0;
    }
    .hint,
    .muted {
      color: var(--text-soft);
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: var(--space-sm);
    }
    label {
      display: flex;
      flex-direction: column;
      gap: var(--space-4xs);
    }
    .check,
    .inline {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3xs);
    }
    input[type='number'] {
      width: 6em;
    }
    #emoji {
      width: 14em;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-xs);
    }

    /* The same size as the items of the segmented control. */
    .btn {
      padding: var(--space-2xs) var(--space-xs);
      font-size: var(--type-caption);
      font-weight: 500;
      line-height: 12px;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      background: var(--surface-default);
    }
    .btn.primary {
      background: var(--surface-inverse);
      border-color: var(--surface-inverse);
      color: var(--text-on-inverse);
    }
    .btn:disabled {
      cursor: default;
    }
    .btn[aria-pressed='true'] {
      background: var(--surface-inverse-faint);
    }
    @media (hover: hover) {
      .btn:not(:disabled):hover {
        background: var(--surface-inverse-faint);
      }
      .btn.primary:not(:disabled):hover {
        background: var(--surface-inverse);
        opacity: 0.85;
      }
    }

    .status {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }
    progress {
      width: 100%;
      height: 4px;
    }
    .status p {
      min-height: 1lh;
    }

    /* The three layers, on the histogram and in the legend. */
    #tune {
      --band-bg: color-mix(in srgb, var(--surface-inverse) 4%, var(--surface-default));
      --band-mid: color-mix(in srgb, var(--surface-inverse) 12%, var(--surface-default));
      --band-high: color-mix(in srgb, var(--surface-inverse) 22%, var(--surface-default));
    }
    #histogram {
      width: 100%;
      height: 120px;
      display: block;
      cursor: ew-resize;
      touch-action: none;
      border-radius: var(--radius-sm);
    }
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }
    .legend span {
      display: inline-flex;
      align-items: center;
      gap: var(--space-4xs);
    }
    .swatch {
      width: 12px;
      height: 12px;
      border: 1px solid var(--border-default);
    }
    .swatch.bg {
      background: var(--band-bg);
    }
    .swatch.mid {
      background: var(--band-mid);
    }
    .swatch.high {
      background: var(--band-high);
    }
    .matte {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
