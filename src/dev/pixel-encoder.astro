---
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';
import { DEFAULT_THRESHOLDS } from '~/lib/pixel-video/format';
import { DEFAULTS } from '~/lib/pixel-video/settings';
import { pixelStyles as styles } from '~/lib/pixel-video/styles';
import { THEMES } from '~/lib/theme';

// Make a .pxv file (see src/lib/pixel-video/format.ts) from a video, in the
// browser:
// 1. Choose a video or a Lottie animation (JSON). The page reads it one
//    time, as brightness values.
// 2. Move the thresholds. The preview changes at once, with no encode.
// 3. Download the .pxv file.
// The preview uses the <pixel-video> element of the site. A
// browser that cannot read video frames (Firefox on Android) cannot do step
// 1, but it can play the .pxv files in "Test the player".
//
// This page is not in src/pages/. The integration "dev-tools" in
// astro.config.ts adds its route only in `astro dev`, thus the build does
// not have it (see "Pixel videos" in AGENTS.md).

const seo = overrideSeo([], seoTitle('Pixel encoder'));

// The videos that `npm run pixel-videos` and wave-footage.mjs write (see
// scripts/pixel-videos/README.md). They are not in the repository: make them
// first.
const presets = [
  { label: 'globe', src: '/videos/globe.mp4' },
  { label: 'wave', src: '/videos/wave.mp4' },
];
// The stroke switches. They are not part of a style: they go with each style.
const strokeSettings = [
  { key: 'bgStrokeDisabled', label: 'No background strokes' },
  { key: 'midStrokeDisabled', label: 'No midtone strokes' },
  { key: 'highStrokeDisabled', label: 'No highlight strokes' },
] as const;
// The settings with a slider. The other settings are only in the JSON. The
// dimensions are a % of the width of the drawn video (see settings.ts).
const sliderSettings = [
  { key: 'bgSize', min: 0.25, max: 6, step: 0.05, unit: '%' },
  { key: 'midSize', min: 0.25, max: 6, step: 0.05, unit: '%' },
  { key: 'highSize', min: 0.25, max: 6, step: 0.05, unit: '%' },
  { key: 'hoverPixelSize', min: 0.25, max: 12, step: 0.05, unit: '%' },
  { key: 'hoverRadius', min: 0, max: 60, step: 0.5, unit: '%' },
  { key: 'hoverFalloff', min: 0, max: 30, step: 0.5, unit: '%' },
  { key: 'hoverDistortion', min: 0, max: 20, step: 0.25, unit: '%' },
  { key: 'hoverSpeed', min: 0, max: 5, step: 0.1, unit: '×' },
] as const;
---

<Layout seo={seo} headerVariant={false} footer={false}>
  <div class="wrap" id="wrap">
    <div class="controlsColumn">
      <section class="step">
        <h2 class="subtitleMedium"><span class="num">1</span> Source video</h2>
        <form id="form" class="controls body">
          <label>
            <span class="caption">Example videos</span>
            <select name="preset">
              {presets.map((p, i) => <option value={i}>{p.label}</option>)}
            </select>
          </label>
          <label>
            <span class="caption">
              Or a <a href="https://googlefonts.github.io/noto-emoji-animation/">Noto emoji</a> (CC BY
              4.0)
            </span>
            <input
              type="search"
              id="emoji"
              list="emojiList"
              placeholder="Loading the list…"
              disabled
            />
            <datalist id="emojiList"></datalist>
          </label>
          <label>
            <span class="caption">Or a local video or Lottie JSON (or drop it on the page)</span>
            <input type="file" name="file" accept="video/*,.json,application/json" />
          </label>
          <label>
            <span class="caption">Frames per second</span>
            <input type="number" name="fps" value="30" min="1" max="60" />
          </label>
          <label>
            <span class="caption">Longest side, in cells</span>
            <input type="number" name="maxSide" value="160" min="8" max="1024" />
          </label>
        </form>
        <div class="status">
          <progress id="progress" value="0" max="1"></progress>
          <p id="status" class="caption" aria-live="polite"></p>
        </div>
      </section>

      <fieldset id="tune" class="step" disabled>
        <legend class="subtitleMedium"><span class="num">2</span> Layers</legend>
        <p class="caption hint">Drag the lines on the histogram, or use the sliders.</p>
        <canvas id="histogram" width="1024" height="120" aria-hidden="true"></canvas>
        <p class="legend caption">
          <span><i class="swatch bg"></i> Background <output id="shareBg">–</output></span>
          <span><i class="swatch mid"></i> Midtone <output id="shareMid">–</output></span>
          <span><i class="swatch high"></i> Highlight <output id="shareHigh">–</output></span>
        </p>
        <label class="slider">
          <span class="caption"
            >Midtone threshold: <output id="tMidValue">{DEFAULT_THRESHOLDS.tMid}</output></span
          >
          <input type="range" id="tMid" min="0" max="256" value={DEFAULT_THRESHOLDS.tMid} />
        </label>
        <label class="slider">
          <span class="caption"
            >Highlight threshold: <output id="tHighValue">{DEFAULT_THRESHOLDS.tHigh}</output></span
          >
          <input type="range" id="tHigh" min="0" max="256" value={DEFAULT_THRESHOLDS.tHigh} />
        </label>
        <div class="actions">
          <button type="button" class="btn" id="find">Find the thresholds</button>
          <button type="button" class="btn" id="reset">Default thresholds</button>
        </div>
        <div class="matte" id="matte" hidden>
          <span class="caption">Transparent pixels</span>
          <label class="check">
            <input type="radio" name="matte" value="empty" checked />
            <span class="caption">No square</span>
          </label>
          <label class="check">
            <input type="radio" name="matte" value="color" />
            <span class="caption">On a background colour</span>
          </label>
          <input type="color" id="matteColor" value="#ffffff" aria-label="Background colour" />
          <output id="matteInfo" class="caption"></output>
        </div>
      </fieldset>

      <fieldset id="export" class="step" disabled>
        <legend class="subtitleMedium"><span class="num">3</span> Export</legend>
        <div class="actions">
          <button type="button" class="btn primary" id="generate">Download the .pxv file</button>
        </div>
        <pre id="stats" class="codeSmall"></pre>
      </fieldset>

      <section class="step">
        <h2 class="subtitleMedium">
          Look <span class="caption muted">(in the .pxv file, as the suggested settings)</span>
        </h2>
        <div class="controls body">
          <label>
            <span class="caption">Style</span>
            <select id="style">
              {styles.map((st, i) => <option value={i}>{st.label}</option>)}
            </select>
          </label>
          {
            strokeSettings.map(({ key, label }) => (
              <label class="check">
                <input type="checkbox" data-setting={key} checked={DEFAULTS[key]} />
                <span class="caption">{label}</span>
              </label>
            ))
          }
          <label class="check">
            <input type="checkbox" data-setting="hover" checked={DEFAULTS.hover} />
            <span class="caption">Lens under the pointer</span>
          </label>
        </div>
        <div class="sizes">
          <label class="check">
            <input type="checkbox" id="sameSize" />
            <span class="caption">One size for the three tones (the bgSize slider)</span>
          </label>
          {
            sliderSettings.map(({ key, min, max, step, unit }) => (
              <label class="slider" data-slider={key}>
                <span class="caption">
                  {key}: <output data-output={key}>{DEFAULTS[key]}</output> {unit}
                </span>
                <input
                  type="range"
                  data-setting={key}
                  min={min}
                  max={max}
                  step={step}
                  value={DEFAULTS[key]}
                />
              </label>
            ))
          }
        </div>
        <label class="settings">
          <span class="caption">Settings (JSON)</span>
          <textarea id="settings" class="codeSmall" rows="10" spellcheck="false"></textarea>
        </label>
        <div class="actions">
          <button type="button" class="btn" id="copy">Copy the JSON</button>
          <output id="copied" class="caption"></output>
        </div>
      </section>

      <details class="step" id="player">
        <summary class="subtitleMedium">Test the player</summary>
        <p class="caption hint">
          Play a .pxv file without the encoder (for example on Firefox for Android).
        </p>
        <div class="controls body">
          <label>
            <span class="caption">A local .pxv file (or drop it on the page)</span>
            <input type="file" id="pxvFile" accept=".pxv" />
          </label>
        </div>
      </details>
    </div>

    <div class="previews">
      <div class="toolbar body">
        <div class="segmented" role="radiogroup" aria-label="Preview">
          <label
            ><input type="radio" name="view" value="pixel" checked /><span class="caption"
              >Pixel video</span
            ></label
          >
          <label
            ><input type="radio" name="view" value="source" /><span class="caption">Source</span
            ></label
          >
          <label
            ><input type="radio" name="view" value="both" /><span class="caption">Both</span></label
          >
        </div>
        <label class="inline">
          <span class="caption">Theme</span>
          <select id="theme">
            {THEMES.map((t) => <option value={t}>{t}</option>)}
          </select>
        </label>
        <button type="button" class="btn" id="pause" aria-pressed="false">Pause</button>
      </div>
      <div class="figures" id="figures" data-view="pixel">
        <figure id="stage" data-theme="default">
          <pixel-video id="preview"></pixel-video>
          <figcaption class="caption" id="previewCaption">pixel-video</figcaption>
        </figure>
        <figure id="sourceFigure">
          <video id="source" muted playsinline loop autoplay></video>
          <div id="sourceLottie" hidden></div>
          <figcaption class="caption">Source video</figcaption>
        </figure>
      </div>
    </div>
  </div>
  <div class="dropHint subtitleMedium" id="dropHint" hidden>
    Drop a video, a Lottie JSON or a .pxv file
  </div>
</Layout>

<script is:inline define:vars={{ presets, styles }}>
  window.__pixelPresets = presets;
  window.__pixelStyles = styles;
</script>

<script>
  import { definePixelVideo, type PixelVideoElement } from '~/lib/pixel-video/element';
  import { extractFrames, extractLottieFrames, type LumaFrames } from '~/lib/pixel-video/extract';
  import {
    autoThresholds,
    classify,
    decode,
    DEFAULT_THRESHOLDS,
    encode,
    flatten,
    histogram,
    lumaOf,
    readHeader,
    type PixelFrames,
    type Thresholds,
  } from '~/lib/pixel-video/format';
  import { DEFAULTS, type PixelVideoSettings } from '~/lib/pixel-video/settings';

  definePixelVideo();

  type Preset = { label: string; src: string };
  const { __pixelPresets: presets, __pixelStyles: styles } = window as unknown as {
    __pixelPresets: Preset[];
    __pixelStyles: { label: string; settings: Partial<PixelVideoSettings> }[];
  };

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
  const form = $<HTMLFormElement>('#form');
  const fileInput = form.file as HTMLInputElement;
  const progress = $<HTMLProgressElement>('#progress');
  const status = $<HTMLParagraphElement>('#status');
  const tune = $<HTMLFieldSetElement>('#tune');
  const exportStep = $<HTMLFieldSetElement>('#export');
  const generate = $<HTMLButtonElement>('#generate');
  const sliders = { tMid: $<HTMLInputElement>('#tMid'), tHigh: $<HTMLInputElement>('#tHigh') };
  const canvas = $<HTMLCanvasElement>('#histogram');
  const stats = $<HTMLPreElement>('#stats');
  const source = $<HTMLVideoElement>('#source');
  const sourceLottie = $<HTMLElement>('#sourceLottie');
  const preview = $('#preview') as PixelVideoElement;
  const previewCaption = $<HTMLElement>('#previewCaption');
  const settings = $<HTMLTextAreaElement>('#settings');
  const stage = $<HTMLElement>('#stage');
  const figures = $<HTMLElement>('#figures');
  // The sliders and the check box of the settings. `data-setting` is the key.
  const settingInputs = [...document.querySelectorAll<HTMLInputElement>('[data-setting]')];
  const keyOf = (input: HTMLInputElement) => input.dataset.setting as keyof PixelVideoSettings;
  const styleSelect = $<HTMLSelectElement>('#style');

  // ---- Preview ----------------------------------------------------------

  // Show the pixel video, the source video, or the two next to each other.
  const viewInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="view"]')];
  viewInputs.forEach((input) =>
    input.addEventListener('change', () => (figures.dataset.view = input.value)),
  );
  // When there is no source video (a .pxv file plays), show the pixel video only.
  const setHasSource = (hasSource: boolean) => {
    for (const input of viewInputs) input.disabled = !hasSource && input.value !== 'pixel';
    if (!hasSource) {
      viewInputs[0]!.checked = true;
      figures.dataset.view = 'pixel';
    }
  };

  const themeSelect = $<HTMLSelectElement>('#theme');
  const setTheme = (theme: string) => {
    themeSelect.value = theme;
    stage.dataset.theme = theme;
    preview.refreshColors();
  };
  themeSelect.addEventListener('change', () => setTheme(themeSelect.value));
  const pause = $<HTMLButtonElement>('#pause');
  pause.addEventListener('click', () => {
    preview.paused = !preview.paused;
    pause.setAttribute('aria-pressed', String(preview.paused));
    pause.textContent = preview.paused ? 'Play' : 'Pause';
    if (source.src) source[preview.paused ? 'pause' : 'play']();
    lottiePlayer?.[preview.paused ? 'pause' : 'play']();
  });

  // A Lottie source plays in an SVG player in place of the source video.
  let lottiePlayer: import('lottie-web').AnimationItem | null = null;
  const showLottie = async (animationData: unknown | null) => {
    lottiePlayer?.destroy();
    lottiePlayer = null;
    source.hidden = animationData !== null;
    sourceLottie.hidden = animationData === null;
    if (animationData === null) return;
    const { default: lottie } = await import('lottie-web');
    lottiePlayer = lottie.loadAnimation({
      container: sourceLottie,
      renderer: 'svg',
      loop: true,
      autoplay: !preview.paused,
      animationData,
    });
  };

  // The object URLs of the source video and of the last .pxv file.
  let sourceUrl = '';
  let pxvUrl = '';
  const replaceUrl = (old: string, blob: Blob) => {
    if (old) URL.revokeObjectURL(old);
    return URL.createObjectURL(blob);
  };

  const kb = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;
  const describe = (f: Omit<PixelFrames, 'cells'>) =>
    `${f.width}×${f.height} cells, ${f.count} frames at ${f.fps} fps (${(f.count / f.fps).toFixed(2)} s)`;

  // ---- Look -------------------------------------------------------------

  // The settings in the text area, or null if the JSON is not valid.
  const readSettings = (): Partial<PixelVideoSettings> | null => {
    try {
      return settings.value.trim() ? JSON.parse(settings.value) : {};
    } catch {
      return null;
    }
  };

  // The text area is the source of the settings. The setting inputs show
  // its values, or the defaults.
  const applySettings = () => {
    const value = readSettings();
    if (!value) {
      settings.setCustomValidity('not valid JSON');
      settings.reportValidity();
      return;
    }
    settings.setCustomValidity('');
    preview.settings = value;
    for (const input of settingInputs) {
      const key = keyOf(input);
      const current = value[key] ?? DEFAULTS[key];
      if (input.type === 'checkbox') input.checked = Boolean(current);
      else {
        input.value = String(current);
        $(`[data-output="${key}"]`).textContent = String(current);
      }
    }
  };
  settings.addEventListener('input', applySettings);

  const setSettings = (value: Partial<PixelVideoSettings>) => {
    settings.value = JSON.stringify(value, null, 2);
    applySettings();
  };

  // When "One size" is on, the bgSize slider sets the three tone sizes, and
  // the midSize and highSize sliders do not show.
  const sizeKeys = ['bgSize', 'midSize', 'highSize'] as const;
  const sameSize = $<HTMLInputElement>('#sameSize');
  const sameSizeSettings = (size: number) => Object.fromEntries(sizeKeys.map((key) => [key, size]));
  sameSize.addEventListener('change', () => {
    for (const key of sizeKeys.slice(1))
      $<HTMLElement>(`[data-slider="${key}"]`).hidden = sameSize.checked;
    const value = readSettings();
    if (value && sameSize.checked)
      setSettings({ ...value, ...sameSizeSettings(value.bgSize ?? DEFAULTS.bgSize) });
  });

  // A setting input writes its value into the text area.
  for (const input of settingInputs) {
    input.addEventListener('input', () => {
      const value = readSettings();
      const key = keyOf(input);
      const next = input.type === 'checkbox' ? input.checked : Number(input.value);
      if (!value) return;
      if (sameSize.checked && key === 'bgSize')
        setSettings({ ...value, ...sameSizeSettings(Number(next)) });
      else setSettings({ ...value, [key]: next });
    });
  }

  const styleSettings = () => styles[Number(styleSelect.value)]!.settings;
  // A style changes only the colours. The other settings stay.
  styleSelect.addEventListener('change', () =>
    setSettings({ ...readSettings(), ...styleSettings() }),
  );

  const copied = $<HTMLOutputElement>('#copied');
  $('#copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(settings.value);
      copied.textContent = 'Copied.';
    } catch {
      settings.select();
      copied.textContent = 'The browser did not let the page copy. The text is selected.';
    }
    setTimeout(() => (copied.textContent = ''), 2000);
  });

  // ---- Test the player --------------------------------------------------

  // Give the file to the element as `src`, so that this also tests the
  // fetch and the decoder of the element.
  const play = (bytes: Uint8Array, label: string) => {
    const header = readHeader(bytes);
    running?.abort();
    last = null;
    tune.disabled = true;
    // The cells of the file stay. Step 3 saves them again with the
    // settings of the Look step.
    const name = label.replace(/\.pxv$/, '');
    played = { name, bytes };
    exportStep.disabled = false;
    generate.textContent = `Download ${name}.pxv`;
    stats.textContent = '';
    canvas.getContext('2d')!.clearRect(0, 0, canvas.width, canvas.height);
    // Clear the preset, so that a choice of the same preset reads it again.
    form.preset.selectedIndex = -1;
    fileInput.value = '';
    emojiInput.value = '';
    source.removeAttribute('src');
    source.load();
    showLottie(null);
    setHasSource(false);
    // Show the suggested settings of the file. A file with no settings keeps
    // the current look.
    if (header.settings) setSettings(header.settings);
    pxvUrl = replaceUrl(pxvUrl, new Blob([bytes as BlobPart]));
    preview.setAttribute('src', pxvUrl);
    previewCaption.textContent = `pixel-video: ${label}`;
    progress.value = 0;
    status.textContent = `Plays ${label}: ${describe(header)}, ${kb(bytes.length)}. Change the look and download it again, or choose a video to encode again.`;
  };
  const playError = (label: string, error: unknown) => {
    status.textContent = `${label}: ${(error as Error).message}`;
  };
  const playFile = async (file: File) => {
    try {
      play(new Uint8Array(await file.arrayBuffer()), file.name);
    } catch (error) {
      playError(file.name, error);
    }
  };
  $<HTMLInputElement>('#pxvFile').addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) playFile(file);
  });

  // ---- Noto emoji --------------------------------------------------------

  // Google gives the list of the Noto Animated Emoji, and a Lottie file for
  // each emoji. The two allow requests from other origins.
  // The key is the text of the option, for example "🔥 fire".
  const emojiInput = $<HTMLInputElement>('#emoji');
  const emojis = new Map<string, { name: string; codepoint: string; url: string }>();
  const emojiList = fetch('https://googlefonts.github.io/noto-emoji-animation/data/api.json')
    .then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json() as Promise<{ icons: { codepoint: string; tags: string[] }[] }>;
    })
    .then(({ icons }) => {
      const list = $<HTMLDataListElement>('#emojiList');
      for (const { codepoint, tags } of icons) {
        const char = codepoint
          .split('_')
          .map((hex) => String.fromCodePoint(parseInt(hex, 16)))
          .join('');
        const name = (tags[0] ?? codepoint).replace(/^:|:$/g, '');
        const key = `${char} ${name}`;
        emojis.set(key, {
          name,
          codepoint,
          url: `https://fonts.gstatic.com/s/e/notoemoji/latest/${codepoint}/lottie.json`,
        });
        list.append(new Option('', key));
      }
      emojiInput.disabled = false;
      emojiInput.placeholder = `Search ${emojis.size} emoji`;
    })
    .catch((error) => {
      emojiInput.placeholder = `The list cannot load (${(error as Error).message})`;
    });

  // ---- 1. Read the video ------------------------------------------------

  // The video that was read. The sliders sort its brightness values again
  // with no new read. `values` and `counts` change with the background
  // colour of the transparent pixels.
  let last: {
    name: string;
    sourceBytes: number;
    frames: LumaFrames;
    values: Uint16Array;
    counts: Float64Array;
    readMs: number;
  } | null = null;
  // The .pxv file that plays in "Test the player", when no video was read.
  let played: { name: string; bytes: Uint8Array } | null = null;

  // The brightness of the background colour, or null for no square.
  const matteInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="matte"]')];
  const matteColor = $<HTMLInputElement>('#matteColor');
  const matteInfo = $<HTMLOutputElement>('#matteInfo');
  const matte = (): number | null => {
    if (!matteInputs.find((i) => i.checked && i.value === 'color')) return null;
    const hex = matteColor.value;
    const byte = (i: number) => parseInt(hex.slice(i, i + 2), 16);
    return Math.round(lumaOf(byte(1), byte(3), byte(5)));
  };

  // Put the transparent pixels on the background again, then sort.
  const reflatten = () => {
    const m = matte();
    matteColor.disabled = m === null;
    if (!last) return;
    $<HTMLElement>('#matte').hidden = !last.frames.transparent;
    matteInfo.textContent = m === null ? 'The cells stay empty.' : `Brightness ${m}`;
    last.values = flatten(last.frames.luma, last.frames.alpha, m);
    last.counts = histogram(last.values);
    schedule();
  };
  matteInputs.forEach((i) => i.addEventListener('change', reflatten));
  matteColor.addEventListener('input', reflatten);

  let running: AbortController | null = null;
  const read = async () => {
    running?.abort();
    const controller = (running = new AbortController());
    last = null;
    played = null;
    tune.disabled = exportStep.disabled = true;
    stats.textContent = '';
    progress.value = 0;
    status.textContent = 'Loading the video…';
    // The source is the local file, else the emoji, else the preset.
    const file = fileInput.files?.[0];
    const emoji = emojis.get(emojiInput.value);
    const preset = presets[form.preset.selectedIndex];
    if (!file && !emoji && !preset) return;
    const isLottie = file
      ? file.type === 'application/json' || file.name.endsWith('.json')
      : Boolean(emoji);
    const url = file ? (sourceUrl = replaceUrl(sourceUrl, file)) : (emoji?.url ?? preset!.src);
    const name = file
      ? file.name.replace(/\.[^.]+$/, '')
      : (emoji?.name ??
        preset!.src
          .split('/')
          .pop()!
          .replace(/\.[^.]+$/, ''));
    if (isLottie) {
      source.removeAttribute('src');
      source.load();
    } else {
      source.src = url;
      showLottie(null);
    }
    setHasSource(true);
    const num = (key: string) => Number((form.elements.namedItem(key) as HTMLInputElement).value);
    try {
      const blob: Blob =
        file ??
        (await fetch(url).then((r) => {
          if (!r.ok) throw new Error(`${url}: HTTP ${r.status}`);
          return r.blob();
        }));
      const sourceBytes = blob.size;
      const start = performance.now();
      const options = {
        fps: num('fps'),
        maxSide: num('maxSide'),
        signal: controller.signal,
        onProgress: (done: number, total: number) => {
          progress.value = done / total;
          status.textContent = `Reading frame ${done} of ${total}…`;
        },
      };
      let frames: LumaFrames;
      if (isLottie) {
        const animationData = JSON.parse(await blob.text());
        showLottie(animationData);
        frames = await extractLottieFrames(animationData, options);
      } else {
        frames = await extractFrames(url, options);
      }
      const values = flatten(frames.luma, frames.alpha, matte());
      last = {
        name,
        sourceBytes,
        frames,
        values,
        counts: histogram(values),
        readMs: performance.now() - start,
      };
      preview.removeAttribute('src');
      previewCaption.textContent = `pixel-video: ${name}`;
      tune.disabled = exportStep.disabled = false;
      generate.textContent = `Download ${name}.pxv`;
      progress.value = 1;
      status.textContent = `${name}: ${describe(frames)}. Source ${kb(sourceBytes)}, read in ${Math.round(last.readMs)} ms.`;
      reflatten();
    } catch (error) {
      if (!controller.signal.aborted) status.textContent = `Error: ${(error as Error).message}`;
    }
  };

  // Each change of the source reads the video again.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    read();
  });
  form.preset.addEventListener('change', () => {
    fileInput.value = '';
    emojiInput.value = '';
    read();
  });
  fileInput.addEventListener('change', () => {
    if (!fileInput.files?.[0]) return;
    emojiInput.value = '';
    read();
  });
  emojiInput.addEventListener('change', () => {
    if (!emojis.has(emojiInput.value)) return;
    fileInput.value = '';
    form.preset.selectedIndex = -1;
    read();
  });
  form.fps.addEventListener('change', read);
  form.maxSide.addEventListener('change', read);

  // Drop a video or a .pxv file on the page.
  const dropHint = $<HTMLElement>('#dropHint');
  let dragDepth = 0;
  const hasFiles = (e: DragEvent) => e.dataTransfer?.types.includes('Files');
  document.addEventListener('dragenter', (e) => {
    if (!hasFiles(e)) return;
    dragDepth++;
    dropHint.hidden = false;
  });
  document.addEventListener('dragleave', () => {
    if (--dragDepth <= 0) dropHint.hidden = true;
  });
  document.addEventListener('dragover', (e) => hasFiles(e) && e.preventDefault());
  document.addEventListener('drop', (e) => {
    e.preventDefault();
    dragDepth = 0;
    dropHint.hidden = true;
    const file = e.dataTransfer?.files[0];
    if (!file) return;
    if (file.name.endsWith('.pxv')) {
      playFile(file);
      return;
    }
    const files = new DataTransfer();
    files.items.add(file);
    fileInput.files = files.files;
    emojiInput.value = '';
    read();
  });

  // ---- 2. Tune the thresholds -------------------------------------------

  const thresholds = (): Thresholds => ({
    tMid: Number(sliders.tMid.value),
    tHigh: Number(sliders.tHigh.value),
  });

  const setThresholds = ({ tMid, tHigh }: Thresholds) => {
    sliders.tMid.value = String(tMid);
    sliders.tHigh.value = String(tHigh);
    schedule();
  };

  // Draw the three layers as bands, the histogram, and the two thresholds.
  // The colours come from the page tokens. The x axis of the histogram is
  // the same as the sliders.
  const drawHistogram = (counts: Float64Array, { tMid, tHigh }: Thresholds) => {
    const ctx = canvas.getContext('2d')!;
    const style = getComputedStyle(canvas);
    const { width: w, height: h } = canvas;
    const bar = w / 257;
    const max = Math.log1p(Math.max(...counts));
    ctx.clearRect(0, 0, w, h);
    const bands: [number, number, string][] = [
      [0, tMid, '--band-bg'],
      [tMid, tHigh, '--band-mid'],
      [tHigh, 257, '--band-high'],
    ];
    for (const [from, to, token] of bands) {
      ctx.fillStyle = style.getPropertyValue(token);
      ctx.fillRect(from * bar, 0, (to - from) * bar, h);
    }
    ctx.fillStyle = style.getPropertyValue('--text-soft');
    counts.forEach((c, i) => {
      const bh = max > 0 ? (Math.log1p(c) / max) * h : 0;
      ctx.fillRect(i * bar, h - bh, Math.ceil(bar), bh);
    });
    ctx.fillStyle = style.getPropertyValue('--text-primary');
    for (const t of [tMid, tHigh]) ctx.fillRect(t * bar - 2, 0, 4, h);
  };

  // Sort the cells with the current thresholds and show them. No encode.
  const update = () => {
    if (!last) return;
    const t = thresholds();
    $('#tMidValue').textContent = String(t.tMid);
    $('#tHighValue').textContent = String(t.tHigh);
    drawHistogram(last.counts, t);
    // The share of each layer, from the histogram.
    let total = 0;
    const layers: [number, number, number] = [0, 0, 0];
    last.counts.forEach((c, b) => {
      total += c;
      layers[b < t.tMid ? 0 : b < t.tHigh ? 1 : 2] += c;
    });
    const pct = (n: number) => `${total ? Math.round((n / total) * 100) : 0}%`;
    $('#shareBg').textContent = pct(layers[0]);
    $('#shareMid').textContent = pct(layers[1]);
    $('#shareHigh').textContent = pct(layers[2]);
    const { luma, alpha, transparent, ...header } = last.frames;
    preview.frames = { ...header, cells: classify(last.values, t) };
    stats.textContent = '';
    saveUrl();
  };

  // Sort at most one time for each animation frame.
  let queued = 0;
  const schedule = () => {
    queued ||= requestAnimationFrame(() => {
      queued = 0;
      update();
    });
  };

  // The midtone threshold cannot go above the highlight threshold. A
  // threshold pushes the other threshold.
  const setThreshold = (key: keyof Thresholds, value: number) => {
    sliders[key].value = String(value);
    if (key === 'tMid' && value > Number(sliders.tHigh.value)) sliders.tHigh.value = String(value);
    if (key === 'tHigh' && value < Number(sliders.tMid.value)) sliders.tMid.value = String(value);
    schedule();
  };
  sliders.tMid.addEventListener('input', () => setThreshold('tMid', Number(sliders.tMid.value)));
  sliders.tHigh.addEventListener('input', () => setThreshold('tHigh', Number(sliders.tHigh.value)));
  $('#find').addEventListener('click', () => last && setThresholds(autoThresholds(last.counts)));
  $('#reset').addEventListener('click', () => setThresholds(DEFAULT_THRESHOLDS));

  // Drag on the histogram: the threshold nearest to the pointer follows it.
  let dragging: keyof Thresholds | null = null;
  const valueAt = (e: PointerEvent) => {
    const rect = canvas.getBoundingClientRect();
    return Math.max(0, Math.min(256, Math.round(((e.clientX - rect.left) / rect.width) * 257)));
  };
  canvas.addEventListener('pointerdown', (e) => {
    if (!last) return;
    const v = valueAt(e);
    const t = thresholds();
    // When the two thresholds are at the same value, the drag direction chooses.
    dragging =
      Math.abs(v - t.tMid) < Math.abs(v - t.tHigh) || (t.tMid === t.tHigh && v < t.tMid)
        ? 'tMid'
        : 'tHigh';
    canvas.setPointerCapture(e.pointerId);
    setThreshold(dragging, v);
  });
  canvas.addEventListener('pointermove', (e) => dragging && setThreshold(dragging, valueAt(e)));
  canvas.addEventListener('pointerup', () => (dragging = null));
  canvas.addEventListener('pointercancel', () => (dragging = null));

  // ---- 3. Generate the .pxv file ----------------------------------------

  generate.addEventListener('click', async () => {
    if (!last && !played) return;
    // The settings of the Look step go into the file.
    const look = readSettings();
    if (!look) {
      stats.textContent = 'The settings (JSON) are not valid. Correct them first.';
      return;
    }
    // The cells come from the video that was read, or from the .pxv file
    // that plays.
    let name: string;
    let cells: Uint8Array;
    let header: Omit<PixelFrames, 'cells' | 'settings'>;
    let info: string[];
    if (last) {
      const t = thresholds();
      const { luma, alpha, transparent, ...rest } = last.frames;
      name = last.name;
      header = rest;
      cells = classify(last.values, t);
      info = [
        `source ${kb(last.sourceBytes)}`,
        `thresholds ${t.tMid} / ${t.tHigh}`,
        ...(transparent
          ? [`transparent pixels: ${matte() === null ? 'no square' : `on ${matteColor.value}`}`]
          : []),
      ];
    } else {
      const { settings: _, cells: old, ...rest } = await decode(played!.bytes);
      name = played!.name;
      header = rest;
      cells = old;
      info = [`cells of the .pxv file (${kb(played!.bytes.length)})`];
    }
    const start = performance.now();
    const bytes = await encode({ ...header, cells, settings: look });
    const encoded = performance.now();
    // Check that the decoder gives back the same cells.
    const back = await decode(bytes);
    const decoded = performance.now();
    const same =
      back.cells.length === cells.length &&
      back.cells.every((v, i) => v === cells[i]) &&
      JSON.stringify(back.settings ?? {}) === JSON.stringify(look);
    stats.textContent = [
      `${name}.pxv: ${kb(bytes.length)}`,
      describe(header),
      ...info,
      `suggested settings: ${Object.keys(look).length} keys`,
      `encode ${Math.round(encoded - start)} ms, decode ${Math.round(decoded - encoded)} ms, round trip ${same ? 'OK' : 'FAILED'}`,
    ].join('\n');
    // Do not download a file that does not decode to the same cells.
    if (!same) return;
    // A new URL: the preview can still use the URL of the file that plays.
    const url = URL.createObjectURL(
      new Blob([bytes as BlobPart], { type: 'application/octet-stream' }),
    );
    const link = document.createElement('a');
    link.href = url;
    link.download = `${name}.pxv`;
    link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  // ---- The URL ----------------------------------------------------------

  // The query string keeps the parameters, so that a reload or a link gives
  // the same page. A parameter with its default value is not in the query
  // string. A local file cannot go in it. Other parameters stay.
  const KEYS = [
    'video',
    'emoji',
    'fps',
    'side',
    'tMid',
    'tHigh',
    'bg',
    'style',
    'settings',
    'theme',
    'view',
  ];
  const writeUrl = () => {
    const q = new URLSearchParams(location.search);
    for (const key of KEYS) q.delete(key);
    const set = (key: string, value: string, fallback: string) =>
      value !== fallback && q.set(key, value);
    const setInput = (key: string, input: HTMLInputElement) =>
      set(key, input.value, input.defaultValue);
    if (!fileInput.files?.[0]) {
      const emoji = emojis.get(emojiInput.value);
      if (emoji) q.set('emoji', emoji.codepoint);
      else if (form.preset.selectedIndex >= 0)
        set('video', presets[form.preset.selectedIndex]!.label, presets[0]!.label);
    }
    setInput('fps', form.fps);
    setInput('side', form.maxSide);
    setInput('tMid', sliders.tMid);
    setInput('tHigh', sliders.tHigh);
    if (matte() !== null) q.set('bg', matteColor.value.slice(1));
    set('style', styles[Number(styleSelect.value)]!.label, styles[0]!.label);
    // Only the settings that are not the same as in the style.
    const value = readSettings();
    if (value) {
      const base = styleSettings() as Record<string, unknown>;
      const changed = Object.entries(value).filter(
        ([key, v]) => JSON.stringify(v) !== JSON.stringify(base[key]),
      );
      if (changed.length) q.set('settings', JSON.stringify(Object.fromEntries(changed)));
    }
    set('theme', themeSelect.value, 'default');
    set('view', figures.dataset.view ?? 'pixel', 'pixel');
    const search = q.toString();
    history.replaceState(null, '', `${location.pathname}${search ? `?${search}` : ''}`);
  };
  // A slider gives many events. Safari limits the number of history changes,
  // thus write the URL only after a short pause.
  let urlTimer = 0;
  function saveUrl() {
    clearTimeout(urlTimer);
    urlTimer = window.setTimeout(writeUrl, 250);
  }
  document.addEventListener('input', saveUrl);
  document.addEventListener('change', saveUrl);

  const readUrl = async () => {
    const q = new URLSearchParams(location.search);
    const get = (key: string) => q.get(key) ?? undefined;
    const video = presets.findIndex((p) => p.label === get('video'));
    if (video >= 0) form.preset.selectedIndex = video;
    for (const [key, input] of [
      ['fps', form.fps],
      ['side', form.maxSide],
      ['tMid', sliders.tMid],
      ['tHigh', sliders.tHigh],
    ] as [string, HTMLInputElement][]) {
      const value = get(key);
      if (value !== undefined && Number.isFinite(Number(value))) input.value = value;
    }
    const bg = get('bg');
    if (bg && /^[0-9a-f]{6}$/i.test(bg)) {
      matteColor.value = `#${bg.toLowerCase()}`;
      matteInputs.forEach((i) => (i.checked = i.value === 'color'));
    }
    const style = styles.findIndex((st) => st.label === get('style'));
    if (style >= 0) styleSelect.value = String(style);
    let changed = {};
    try {
      if (get('settings')) changed = JSON.parse(get('settings')!);
    } catch {
      // Not valid JSON: keep the settings of the style.
    }
    setSettings({ ...styleSettings(), ...changed });
    const theme = get('theme');
    if (theme && [...themeSelect.options].some((o) => o.value === theme)) setTheme(theme);
    const view = viewInputs.find((i) => i.value === get('view'));
    if (view) {
      view.checked = true;
      figures.dataset.view = view.value;
    }
    const codepoint = get('emoji');
    if (codepoint) {
      form.preset.selectedIndex = -1;
      await emojiList;
      const key = [...emojis].find(([, e]) => e.codepoint === codepoint)?.[0];
      if (key) emojiInput.value = key;
    }
    read();
  };

  readUrl();
</script>

<style>
  /* Without a layer, these rules win over all the layers of the site. */
