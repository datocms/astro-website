    .figures[data-view='pixel'] #sourceFigure,
    .figures[data-view='source'] #stage {
      display: none;
    }

    figure {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-4xs);
      min-width: 0;
    }
    video,
    #sourceLottie {
      width: 100%;
      display: block;
      outline: 1px solid var(--border-default);
    }
    video[hidden],
    #sourceLottie[hidden] {
      display: none;
