---
import { ContentLink, Seo, stripStega, type TitleMetaLinkTag } from '@datocms/astro';
import { ClientRouter } from 'astro:transitions';
import type { HTMLAttributes } from 'astro/types';
import KeepCssLayersFirst from './_KeepCssLayersFirst.astro';
import ProgressBar from './_ProgressBar.astro';
import { fetchFavicon } from './fetchFavicon';
import { baseUrl, isDraftModeEnabled } from '~/lib/draftMode';
import { pipeSeo, replaceSeoPageTitleSuffix, seoCanonicalIfMissing } from '~/lib/datocms/seo';

/*
 * The head of every page: SEO, favicon, canonical URL, RSS links, cookie
 * consent, analytics and the content link of the draft mode.
 * This layout loads no global stylesheet. Each layout family imports its
 * own (see "Two layout families" in AGENTS.md):
 * - the old layouts import ./global.css;
 * - src/layouts/Layout.astro imports src/styles/global.css.
 */
type Props = {
  seo: TitleMetaLinkTag[];
  /**
   * The names of the cascade layers, lowest first. The layout puts the
   * statement as the first child of <head>, before all other CSS.
   * The default is the order of the old pages.
   */
  cssLayers?: string[];
  /**
   * Set to false for a page that does a full load. Then the layout does not
   * render the view transitions router and its progress bar.
   */
  clientRouter?: boolean;
  /** Attributes for <body> (for example data-theme). */
  bodyAttributes?: HTMLAttributes<'body'>;
};

const { seo, cssLayers = ['reset', 'prose'], clientRouter = true, bodyAttributes } = Astro.props;
const cssLayersStatement = `@layer ${cssLayers.join(', ')};`;

const result = await fetchFavicon(Astro);
const draftModeEnabled = isDraftModeEnabled(Astro);

// Maps route prefixes to section-specific title suffixes. Top-level pages
// (e.g. `/blog` itself) are excluded so that titles like "DatoCMS Blog — DatoCMS Blog"
// are avoided.
const titleSuffixByPathPrefix: [string, string][] = [
  ['/docs', 'DatoCMS Docs'],
  ['/academy', 'DatoCMS Academy'],
  ['/user-guides', 'DatoCMS User Guides'],
  ['/product-updates', 'DatoCMS Product Updates'],
  ['/blog', 'DatoCMS Blog'],
];

function titleSuffixForPath(pathname: string): string | undefined {
  const normalized = pathname.replace(/\/+$/, '');

  return titleSuffixByPathPrefix.find(
    ([prefix]) => normalized.startsWith(prefix) && normalized !== prefix,
  )?.[1];
}

const suffix = titleSuffixForPath(Astro.url.pathname);
const canonicalHref = new URL(Astro.url.pathname, baseUrl(Astro)).href;

const finalSeo = pipeSeo(
  seo,
  suffix ? replaceSeoPageTitleSuffix(suffix) : undefined,
  seoCanonicalIfMissing(canonicalHref),
);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <style id="css-layers" is:inline set:html={cssLayersStatement}></style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- Strip stega (content-link annotation) characters from head meta tags so
         that invisible markers don't inflate the <title> length in draft mode -->
    <Seo data={stripStega([...result._site.faviconMetaTags, ...finalSeo])} />
    <link rel="alternate" type="text/markdown" href={`${Astro.url.pathname}.md`} />
    <link rel="alternate" type="application/rss+xml" title="DatoCMS Blog" href="/blog.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DatoCMS Product Changelog"
      href="/product-changelog.xml"
    />
    <script is:inline src="/landing-pages/cookieConsent.js" async></script>
    <slot name="head" />
    {
      clientRouter && (
        <>
          <ClientRouter />
          <ProgressBar />
          <KeepCssLayersFirst />
        </>
      )
    }
  </head>
  <body {...bodyAttributes}>
    <slot />
    {draftModeEnabled && <ContentLink />}
  </body>
</html>

<script>
  import { getCookie, setCookie } from '~/lib/cookies';
  import { GOOGLE_ADS_CONVERSIONS } from '~/lib/googleAds';

  const urlParams = new URLSearchParams(window.location.search);
  const source = urlParams.get('utm_source');

  if (source) {
    const medium = urlParams.get('utm_medium');
    const campaign = urlParams.get('utm_campaign');
    const cookieContent = JSON.stringify({ source, medium, campaign });

    setCookie('latestDatoUtm', cookieContent, 365);

    if (!getCookie('datoUtm')) {
      setCookie('datoUtm', cookieContent, 365);
    }
  }

  document.addEventListener('astro:page-load', () => {
    if ('posthog' in window) {
      (window as any).posthog.capture('$pageview');
    }
  });

  document.addEventListener('astro:before-swap', () => {
    if ('posthog' in window) {
      (window as any).posthog.capture('$pageleave');
    }
  });

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('a');
    if (!link?.href?.includes('dashboard.datocms.com') || !('gtag' in window)) return;

    const label = (link.textContent ?? '').toLowerCase();
    if (/log.?in|sign.?in|enter dashboard/i.test(label)) return;

    (window as any).gtag('event', 'conversion', {
      send_to: GOOGLE_ADS_CONVERSIONS.dashboardClick,
      transport_type: 'beacon',
    });
  });
</script>
