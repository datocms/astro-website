---
import type { FragmentOf } from 'gql.tada';
import { readFragment } from 'gql.tada';
import { CopyPromptButton } from '~/components/legacy/blocks/CopyPromptButton';
import { GithubNpmBadge } from '~/components/legacy/blocks/GithubNpmBadge';
import { Image } from '~/components/legacy/blocks/Image';
import { InternalVideo } from '~/components/legacy/blocks/InternalVideo';
import { CloneButtonForm } from '~/components/legacy/docs/blocks/CloneButtonForm';
import { Demo } from '~/components/legacy/blocks/Demo';
import { overrideSeo, seoGeneratedCard, prependToSeoPageTitleIfMissing } from '~/lib/datocms/seo';
import { JsonLd } from '~/components/legacy/JsonLd';
import { baseUrl } from '~/lib/draftMode';
import { DeployButtonForm } from '~/components/legacy/docs/blocks/DeployButtonForm';
import { DocCallout } from '~/components/legacy/docs/blocks/DocCallout';
import { MultipleDemosBlock } from '~/components/legacy/blocks/MultipleDemosBlock';
import { PluginSdkHookGroup } from '~/components/legacy/docs/blocks/PluginSdkHookGroup';
import { buildGroupsFromPluginSdkHooks } from '~/components/legacy/docs/blocks/PluginSdkHookGroup/utils';
import { ReactUiLiveExample } from '~/components/legacy/docs/blocks/ReactUiLiveExample';
import { buildGroupsFromReactUiLiveExamples } from '~/components/legacy/docs/blocks/ReactUiLiveExample/utils';
import { Table } from '~/components/legacy/blocks/Table';
import { TabsBlock } from '~/components/legacy/blocks/TabsBlock';
import { TutorialVideo } from '~/components/legacy/blocks/TutorialVideo';
import { ContentPlusToc } from '~/components/legacy/docs/ContentPlusToc';
import type { TocGroup } from '~/components/legacy/docs/ContentPlusToc/types';
import { buildGroupsFromHeadings } from '~/components/legacy/docs/ContentPlusToc/utils';
import {
  buildItemsFromHeadings,
  type SidebarEntry,
  type SidebarGroup,
} from '~/components/legacy/docs/Sidebar';
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { Text } from '~/components/legacy/LegacyStructuredText/Text';
import { GroupLayout } from '~/layouts/docs/GroupLayout';
import { GroupLayoutFragment } from '../GroupLayout/_graphql';
import { PageLayoutFragment } from './_graphql';
import { Prose } from '~/components/legacy/LegacyProse';
import { defaultLinkToRecordComponents } from '~/components/legacy/linkToRecords';
import { defaultInlineRecordComponents } from '~/components/legacy/inlineRecords';

type Props = {
  group: FragmentOf<typeof GroupLayoutFragment>;
  page: FragmentOf<typeof PageLayoutFragment>;
  additionalSidebarItems?: (SidebarEntry | SidebarGroup)[];
  additionalTocGroups?: TocGroup[];
};

const {
  page: maskedPage,
  group: maskedGroup,
  additionalSidebarItems,
  additionalTocGroups = [],
} = Astro.props;

const page = readFragment(PageLayoutFragment, maskedPage);
const group = readFragment(GroupLayoutFragment, maskedGroup);

const tocGroupsFromPageContent = (
  await Promise.all([
    buildGroupsFromPluginSdkHooks(Astro, page.content),
    buildGroupsFromReactUiLiveExamples(page.content),
  ])
).flat();

const tocGroups = [
  ...(group.pagesOrSections.length > 1 ? buildGroupsFromHeadings(page.content.value) : []),
  ...tocGroupsFromPageContent,
  ...additionalTocGroups,
];
---

<GroupLayout
  group={maskedGroup}
  seo={overrideSeo(
    page._seoMetaTags,
    prependToSeoPageTitleIfMissing(group.pagesOrSections.length > 1 ? `${group.name}: ` : ''),
    seoGeneratedCard(Astro, {
      kicker: group ? `Documentation: ${group.name}` : 'DatoCMS Docs',
      title: page.title,
      pills: tocGroups.flatMap((group) => group.entries).map((entry) => entry.label),
      excerpt: page.seo?.description,
    }),
  )}
  sidebarItemsIfNoPagesOrSectionsInGroup={buildItemsFromHeadings(page.content.value)}
  additionalSidebarItems={additionalSidebarItems}
  lastUpdatedAt={page._publishedAt}
>
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: page.title,
        url: new URL(Astro.url.pathname, baseUrl(Astro)).href,
        datePublished: page._publishedAt,
        description: page.seo?.description ?? undefined,
      }}
    />
  </Fragment>
  <ContentPlusToc tocGroups={tocGroups}>
    {group.pagesOrSections.length > 1 && <Fragment slot="kicker">{page.parents[0]!.name}</Fragment>}
    <Fragment slot="title">{page.title}</Fragment>

    <Prose>
      <slot>
        <Text
          {...ensureValidStructuredTextProps({
            data: page.content,
            blockComponents: {
              ImageRecord: Image,
              TableRecord: Table,
              TabsBlockRecord: TabsBlock,
              DemoRecord: Demo,
              MultipleDemosBlockRecord: MultipleDemosBlock,
              InternalVideoRecord: InternalVideo,
              CloneButtonFormRecord: CloneButtonForm,
              DeployButtonFormRecord: DeployButtonForm,
              PluginSdkHookGroupRecord: PluginSdkHookGroup,
              DocCalloutRecord: DocCallout,
              GithubNpmBadgeRecord: GithubNpmBadge,
              ReactUiLiveExampleRecord: ReactUiLiveExample,
              TutorialVideoRecord: TutorialVideo,
              CopyPromptButtonBlockRecord: CopyPromptButton,
            },
            linkToRecordComponents: defaultLinkToRecordComponents,
            inlineRecordComponents: defaultInlineRecordComponents,
          })}
        />
      </slot>

      <slot name="afterPageContent" />
    </Prose>
  </ContentPlusToc>
</GroupLayout>
