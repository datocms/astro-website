---
import { ThumbsDown, ThumbsUp } from 'lucide';
import { Icon } from '~/components/Icon';
import s from './style.module.css';
import { Button } from '~/components/Button';
---

<share-feedback data-datocms-noindex>
  <form class={s.form}>
    <input type="hidden" name="url" value={Astro.url.pathname} />
    <input type="hidden" name="namespace" value="docs" />

    <div class={s.thumbsButton}>
      <input type="radio" name="reaction" value="positive" />
      <Icon icon={ThumbsUp} />
      <span class="capTrim">Yes</span>
    </div>

    <div class={s.thumbsButton}>
      <input type="radio" name="reaction" value="negative" />
      <Icon icon={ThumbsDown} />
      <span class="capTrim">No</span>
    </div>

    <div class={s.deets}>
      <div class={s.field}>
        <div class={s.label}>
          <div class={s.labelName}>Would you like to add more information?</div>
          <div class={s.labelInfo}>Optional</div>
        </div>
        <textarea placeholder="Your feedback…" name="notes"></textarea>
      </div>

      <div class={s.field}>
        <div class={s.label}>
          <div class={s.labelName}>
            To receive further updates or address your feedback, share your email address with us.
          </div>
          <div class={s.labelInfo}>Optional</div>
        </div>
        <input placeholder="Enter your email" name="email" />
      </div>

      <p class={s.labelInfo}>
        If you need a reply, <a href="/support">please contact support</a> instead.
      </p>

      <div class={s.turnstile} data-turnstile></div>

      <Button type="submit" arrow={false}>Submit feedback</Button>
    </div>
  </form>

  <script>
    import { actions } from 'astro:actions';
    import { isInputError } from 'astro:actions';
    import { WebComponent } from '~/lib/WebComponent';
    import { solveTurnstile } from '~/lib/loadTurnstile';
    import { isActionError } from 'astro:actions';

    window.customElements.define(
      'share-feedback',
      class ShareFeedback extends WebComponent {
        form!: HTMLFormElement;
        button!: HTMLButtonElement;

        parsedCallback() {
          this.form = this.$('form');
          this.button = this.$('button[type=submit]');

          this.on(this.form, 'submit', this.handleSubmit);
          this.on(this.form, 'change', 'input[name=reaction]', this.showForm);
        }

        /* The fields open below the reaction. Move the page only if they are out of view. */
        showForm() {
          this.form.scrollIntoView({ block: 'nearest' });
        }

        async handleSubmit(event: SubmitEvent) {
          event.preventDefault();

          this.button.innerText = 'Submitting…';
          this.button.disabled = true;

          let token: string;

          try {
            token = await solveTurnstile(this.$('[data-turnstile]'), 'docs-feedback');
          } catch (e) {
            this.form.innerHTML =
              e instanceof Error ? e.message : 'Something went wrong. Try again.';
            return;
          }

          const formData = new FormData(this.form);
          formData.set('token', token);

          const { error } = await actions.sendFeedbackAboutDocPage(formData);

          if (isInputError(error)) {
            for (const [name, errors] of Object.entries(error.fields)) {
              const fieldEl = this.form.querySelector(`[name=${name}]`);
              const message = errors.join(', ');

              if (!fieldEl) {
                continue;
              }

              const errorEl = fieldEl.parentElement!.querySelector<HTMLElement>('[data-error]');

              if (errorEl) {
                errorEl.innerText = message;
              } else {
                const newErrorEl = document.createElement('div');
                newErrorEl.dataset.error = '';
                newErrorEl.innerText = message;
                fieldEl.after(newErrorEl);
              }
            }

            this.button.innerText = 'Submit feedback';
            this.button.disabled = false;
          } else if (isActionError(error)) {
            this.form.innerHTML = 'Something went wrong. Try again.';
          } else {
            this.form.innerHTML = 'Thank you. We received your feedback.';
          }
        }
      },
    );
  </script>
</share-feedback>
