---
import { ChevronLeft } from 'lucide';
import type { TitleMetaLinkTag } from '@datocms/astro';
import type { OgCardData } from '~/lib/ogCardUrl';
import { readFragment, type FragmentOf } from 'gql.tada';
import {
  Sidebar,
  buildItemsForDocGroup,
  type SidebarEntry,
  type SidebarGroup,
} from '~/components/docs/Sidebar';
import { Card } from '~/components/docs/Card';
import { HomeSidebar } from '~/components/docs/HomeSidebar';
import { Space } from '~/components/docs/Space';
import { Icon } from '~/components/Icon';
import { BaseLayout } from '~/layouts/docs/BaseLayout';
import { GroupLayoutFragment } from './_graphql';
import s from './_style.module.css';
import { buildUrlForTemplateDemo } from '~/lib/datocms/gqlUrlBuilder/templateDemo';

type Props = {
  group: FragmentOf<typeof GroupLayoutFragment>;
  seo: TitleMetaLinkTag[];
  /** The OG card of the page (BaseLayout of the site). */
  ogCard: OgCardData;
  additionalSidebarItems?: (SidebarEntry | SidebarGroup)[];
  lastUpdatedAt?: string;
};

const { group: maskedGroup, seo, ogCard, additionalSidebarItems = [], lastUpdatedAt } = Astro.props;

const group = readFragment(GroupLayoutFragment, maskedGroup);

// A group with one page and no other entries has no navigation of its own:
// the sidebar then shows the groups of the docs home.
const showDocsNav = group.pagesOrSections.length <= 1 && additionalSidebarItems.length === 0;
---

<BaseLayout seo={seo} ogCard={ogCard} lastUpdatedAt={lastUpdatedAt}>
  <slot name="head" slot="head" />
  <slot name="pagebar" slot="pagebar" />

  <Fragment slot="sidebar">
    <a href="/docs" class={s.backHome} data-datocms-nomd>
      <Icon icon={ChevronLeft} />
      <span class="capTrim">Back to Docs</span>
    </a>

    {
      showDocsNav ? (
        // The links of the docs home are not related content of this page: the
        // Markdown version leaves them out.
        <div data-datocms-nomd>
          <HomeSidebar />
        </div>
      ) : (
        <Sidebar
          title={group.name}
          items={[...buildItemsForDocGroup(group), ...additionalSidebarItems]}
        />
      )
    }

    {
      group.techStarterKit && (
        <Space top={1}>
          <Card
            size="micro"
            href={buildUrlForTemplateDemo(group.techStarterKit)}
            svgLogo={
              group.techStarterKit.technology.squareLogo || group.techStarterKit.technology.logo
            }
            title={group.techStarterKit.name}
            badge={group.techStarterKit.badge ?? undefined}
            label={group.techStarterKit.label ?? undefined}
            background="pink"
          >
            Words are nice... but code speaks louder. Dive into a fully commented project template,
            showcasing these techniques (and more) in action.
          </Card>
        </Space>
      )
    }
  </Fragment>

  <slot />
</BaseLayout>
