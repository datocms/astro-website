---
// The research program page. The CMS gives the SEO, the link of the
// buttons, the steps and the questions. The FAQPage JSON-LD is in the head.
import { stripStega } from '@datocms/astro';
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import type { FAQPage, WithContext } from 'schema-dts';
import { CtaBanner } from '~/components/CtaBanner';
import { Hero } from '~/components/Hero';
import { Step, Steps } from '~/components/Steps';
import { StructuredText } from '~/components/StructuredText';
import { DraftModeQueryListener } from '~/components/legacy/DraftModeQueryListener';
import { JsonLd } from '~/components/legacy/JsonLd';
import { closing, faqTitle, hero, steps } from '~/data/research-program';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import Faq from './_Faq.astro';
import { query } from './_graphql';

const { page } = await executeQuery(Astro, query);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const ctaUrl = stripStega(page.ctaUrl);

const faqs = page.faqs.flatMap((faq) => ('question' in faq ? [faq] : []));

// The JSON-LD needs strings: the question and the answer as plain text,
// without the stega of Content Link.
const questions = faqs.flatMap((faq) => {
  const question = toPlainText(faq.question as Parameters<typeof toPlainText>[0]);
  const answer = toPlainText(faq.answer as Parameters<typeof toPlainText>[0]);
  return question && answer ? [{ question: stripStega(question), answer: stripStega(answer) }] : [];
});

const jsonLd: WithContext<FAQPage> | null =
  questions.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: questions.map(({ question, answer }) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
      }
    : null;
---

<Layout seo={page.seo} theme="blue" headerVariant="light" footerTheme="blue">
  {jsonLd && <JsonLd slot="head" data={jsonLd} />}

  <Hero
    variant="light"
    {...hero}
    buttons={[{ label: page.heroCtaLabel, href: ctaUrl, appearance: 'deep-on-light' }]}
  />

  <Steps title={steps.title} muted={steps.muted}>
    {
      page.steps.flatMap((step) =>
        'title' in step ? (
          <Step title={step.title}>
            <StructuredText data={step.body} />
          </Step>
        ) : (
          []
        ),
      )
    }
  </Steps>

  <Faq title={faqTitle} questions={faqs} />

  <CtaBanner
    {...closing}
    buttons={[{ label: page.bottomCtaButtonLabel, href: ctaUrl, appearance: 'deep-on-light' }]}
  />

  <DraftModeQueryListener query={query} />
</Layout>
