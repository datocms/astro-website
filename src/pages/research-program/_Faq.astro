---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { Section } from '~/components/Section';
import { PlainText, StructuredText } from '~/components/StructuredText';
import { Prose } from '~/components/Prose';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import type { ResultOf } from '~/lib/datocms/graphql';
import type { query } from './_graphql';
import s from './_faq.module.css';

interface Props {
  title: string;
  questions: Extract<
    NonNullable<ResultOf<typeof query>['page']>['faqs'][number],
    { question: unknown }
  >[];
}

const { title, questions } = Astro.props;
---

{/* Only one answer is open at a time. The first is open. */}
<Section class={s.faq} contentClass={s.content} flushTop>
  <h2 class="h1">{title}</h2>
  <div class={s.items}>
    {
      questions.map((item, i) => (
        <details class={s.item} name="faq" open={i === 0}>
          <summary class={s.question}>
            <span class="h2">
              <PlainText data={item.question} />
            </span>
            <span class:list={[s.sign, 'h2']} aria-hidden="true" />
          </summary>
          {item.answer && (
            <Prose class={s.answer}>
              <StructuredText
                {...ensureValidStructuredTextProps({
                  data: item.answer,
                  linkToRecordComponents: defaultLinkToRecordComponents,
                  inlineRecordComponents: defaultInlineRecordComponents,
                })}
              />
            </Prose>
          )}
        </details>
      ))
    }
  </div>
</Section>
