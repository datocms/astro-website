---
// A compare page, from a ProductComparison record of the
// CMS. The static copy comes from src/data/compare.ts.
import { stripStega } from '@datocms/astro';
import { ComparisonTable } from '~/components/ComparisonTable';
import { CtaBanner } from '~/components/CtaBanner';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Headline } from '~/components/Headline';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/JsonLd';
import { PageCloser } from '~/components/PageCloser';
import { ReasonColumns } from '~/components/ReasonColumns';
import { QuoteGrid } from '~/components/Quote';
import { VersusSplit } from '~/components/VersusSplit';
import * as compare from '~/data/compare';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { baseUrl } from '~/lib/draftMode';
import { canonicalUrl, mainEntityRefs, publisherRef } from '~/lib/jsonLd';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';

const variables = { slug: Astro.params.slug! };
const { page, alternatives } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

// The typewriter of the hero types plain strings: the name has no stega.
const product = stripStega(page.product);
---

<Layout theme="blue" seo={page._seoMetaTags}>
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Article',
        ...mainEntityRefs(canonicalUrl(Astro)),
        headline: `DatoCMS vs. ${product}`,
        url: new URL(Astro.url.pathname, baseUrl(Astro)).href,
        datePublished: page._firstPublishedAt ?? undefined,
        dateModified: page._publishedAt ?? undefined,
        description: extractFromSeoTags(page._seoMetaTags).description,
        image: extractFromSeoTags(page._seoMetaTags).image,
        publisher: publisherRef(baseUrl(Astro)),
      }}
    />
  </Fragment>

  <Hero
    {...compare.hero}
    label={`Compare to ${product}`}
    subheadline={`Here’s what you should know when comparing it to ${product}`}
    alignment="center"
    typewriter
  />
  <VersusSplit
    halves={[
      {
        surface: 'inverse',
        layout: 'stacked',
        headline: 'DatoCMS',
        text: page.datocmsCharacterization,
        button: compare.introButtons.datocms,
      },
      {
        surface: 'accent',
        layout: 'stacked',
        headline: page.product,
        text: page.competitorCharacterization,
        button: compare.introButtons.competitor,
      },
    ]}
  />
  <ReasonColumns title={compare.reasonsTitle} reasons={page.reasons} theme="blue" />
  <CtaBanner variant="plain" theme="blue" headline={`Compare to ${page.product}`} />
  <ComparisonTable comparison={page} alternatives={alternatives} theme="blue" />
  {
    page.importer && (
      <CtaBanner
        variant="subtle"
        theme="blue"
        headline={page.importer.header}
        subline={page.importer.description}
        buttons={[
          {
            label: 'Learn More',
            href: `/docs/import-and-export/${page.importer.learnMoreSlug}`,
            variant: 'soft',
          },
        ]}
      />
    )
  }
  {
    page.testimonials.length > 0 && (
      <QuoteGrid items={page.testimonials} theme="blue">
        <Headline slot="header" as="h2" size="headline" muted={compare.testimonials.muted}>
          {compare.testimonials.headline}
        </Headline>
      </QuoteGrid>
    )
  }
  <VersusSplit
    halves={[
      {
        surface: 'inverse',
        layout: 'stacked',
        headline: 'When to choose DatoCMS?',
        text: page.whenToChooseDatocms,
      },
      {
        surface: 'accent',
        layout: 'stacked',
        headline: `When to choose ${page.product}?`,
        text: page.whenToChooseCompetitor,
      },
    ]}
  />
  <PageCloser face="wink" cta={compare.ctaSwitch} video="/videos/hand-cross.pxv" />

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
