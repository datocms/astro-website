---
// The home page. The copy of the sections comes from
// src/data/home.ts. The SEO, the changelog entries, the case studies and
// the region counts of the partners come from the CMS.
import { CaseStudies } from '~/components/CaseStudies';
import { CodeSnippetPreview } from '~/components/CodeSnippetPreview';
import { Community } from '~/components/Community';
import { ContentSource } from '~/components/ContentSource';
import { CtaBanner } from '~/components/CtaBanner';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Features } from '~/components/Features';
import { HomeHero } from '~/components/HomeHero';
import { PageCloser } from '~/components/PageCloser';
import { Partners } from '~/components/Partners';
import { ProductUpdates } from '~/components/ProductUpdates';
import { QuestionAnswer } from '~/components/QuestionAnswer';
import { TextWithImage } from '~/components/TextWithImage';
import { UserExperience } from '~/components/UserExperience';
import * as home from '~/data/home';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
// One 16:9 window for the four pillars, with a different screen for each
// row. The edges of the section cut the window at the right and at the
// bottom. The pointer on a row changes the theme and the screen.
import FeaturesWindow from '~/scenes/HomeFeatures/Window.astro';
import { query } from './_graphql';

const { page, productUpdates, successStories, partners } = await executeQuery(Astro, query);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}
---

<Layout theme="orange" seo={page.seo} seoAnalysis={page.yoastAnalysis}>
  <HomeHero {...home.homeHero} />
  <UserExperience {...home.userExperience} />
  <ContentSource {...home.contentSource} theme="default" />
  <Features {...home.features} titleSize="title" inverted bleed>
    <FeaturesWindow slot="visual" />
  </Features>
  <TextWithImage
    title={home.frameworkIntegration.title}
    tagline={home.frameworkIntegration.tagline}
    button={home.frameworkIntegration.button}
    theme="purple"
    panelOrder="image-left"
    media="visual"
  >
    <CodeSnippetPreview {...home.frameworkIntegration.code} />
  </TextWithImage>
  <QuestionAnswer {...home.questionAnswer} />
  <Community {...home.community} />
  <CtaBanner {...home.ctaSlack} />
  <ProductUpdates {...home.productUpdates} entries={productUpdates} />
  {
    successStories.length > 0 && (
      <CaseStudies {...home.caseStudies} stories={successStories} rows={2} />
    )
  }
  <Partners {...home.partners} partners={partners} theme="pink" />
  <PageCloser face="approved" cta={home.ctaPricing} video="/videos/crazy-dance-1.pxv" />

  <DraftModeQueryListener query={query} />
</Layout>
