---
// A card with an image, a title and a short text: a project of the
// showcase or a chat. The optional logo is the partner of the project (a
// logo of the agency): it keeps its colours, with no background.
import { stripStega } from '@datocms/astro';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { ResponsiveImageFragment } from '~/components/ResponsiveImage/graphql';
import s from './_Card.module.css';

interface Props {
  href: string;
  title: string;
  image?: FragmentOf<typeof ResponsiveImageFragment> | null;
  logo?: { url: string; alt: string | null } | null;
  /**
   * The image keeps its own ratio. Without this, the box of the image is
   * 3:2 and the image fills it (a cover crop).
   */
  natural?: boolean;
  /**
   * The width of the image on the screen, for a browser with no
   * `sizes="auto"` (Safari). The grid of the caller knows it.
   */
  sizes?: string;
}

const { href, title, image, logo, natural = false, sizes } = Astro.props;

const imageData = image ? readFragment(ResponsiveImageFragment, image) : null;
const ratio =
  natural && imageData?.width && imageData.height
    ? `${imageData.width} / ${imageData.height}`
    : undefined;
---

<a href={href} class={s.card}>
  <span class={s.image} style={ratio ? { aspectRatio: ratio } : undefined}>
    {image && <ResponsiveImage data={image} sizes={sizes} />}
  </span>
  <span class={s.text}>
    <span class:list={[s.title, 'bodyMedium']}>{title}</span>
    <span class:list={[s.description, 'label']}><slot /></span>
  </span>
  {
    logo && (
      <span class={s.logo}>
        <img src={logo.url} alt={stripStega(logo.alt ?? '')} loading="lazy" />
      </span>
    )
  }
</a>
