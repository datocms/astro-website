---
// The list of the partners: a band with the globe of the countries of the
// partners and the link to the partner program, then the filters and a
// cell for each partner. The highlighted
// partners come first, then the partners with most showcase projects.
import { stripStega } from '@datocms/astro';
import sortBy from 'lodash-es/sortBy';
import { Button } from '~/components/Button';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { FilterForm } from '~/components/FilterForm';
import { Hero } from '~/components/Hero';
import { PartnerCard, PartnerGrid } from '~/components/PartnerCard';
import { Section } from '~/components/Section';
import { PlainText } from '~/components/StructuredText';
import { filterPlaceholder, index, projectsCountLabel } from '~/data/partners';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForPartner } from '~/lib/datocms/gqlUrlBuilder/partner';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import PartnersGlobe, { type GlobeCountry } from './_PartnersGlobe/Component.astro';
import { countersForDropdown, countersToOptions } from './_facets';
import { query } from './_graphql';
import s from './_style.module.css';

const { page, partners } = await executeQuery(Astro, query);

if (!page || partners.length === 0) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const projectsCountByPartner = new Map(
  partners.map((partner) => [partner.id, partner._allReferencingShowcaseProjectsMeta.count]),
);

const highlightedPartnerIds = new Set(page.highlightedPartners.map((p) => p.id));

const orderedPartnersWithStega = [
  ...page.highlightedPartners,
  ...sortBy(
    partners.filter((p) => !highlightedPartnerIds.has(p.id)),
    [(x) => -(projectsCountByPartner.get(x.id) || 0), 'name'],
  ),
];

// The filters compare plain text: the stega of Content Link is not part of it.
const orderedPartnersWithoutStega = stripStega(orderedPartnersWithStega);

// The countries of the globe. The code is a key of the globe: it must not
// hold the stega of Content Link.
const globeCountriesByCode = new Map<string, GlobeCountry>();
for (const partner of stripStega(partners)) {
  for (const location of partner.locations) {
    const label = `${location.emoji} ${location.name}`;
    const country = globeCountriesByCode.get(location.code) ?? {
      code: location.code,
      label,
      count: 0,
    };
    country.count += 1;
    globeCountriesByCode.set(location.code, country);
  }
}
const globeCountries = sortBy([...globeCountriesByCode.values()], [(c) => -c.count, 'label']);

const activeFilters = {
  technology: Astro.url.searchParams.get('technology'),
  areaOfExpertise: Astro.url.searchParams.get('areaOfExpertise'),
  country: Astro.url.searchParams.get('country'),
  continent: Astro.url.searchParams.get('continent'),
};

const filteredPartners = orderedPartnersWithoutStega.filter((partner) => {
  const { technology, areaOfExpertise, country, continent } = activeFilters;
  if (technology && !partner.technologies.some((t) => t.name === technology)) return false;
  if (areaOfExpertise && !partner.areasOfExpertise.some((t) => t.name === areaOfExpertise)) {
    return false;
  }
  if (country && !partner.locations.some((t) => `${t.emoji} ${t.name}` === country)) return false;
  if (continent && !partner.locations.some((t) => t.continent.name === continent)) return false;
  return true;
});

// Faceted search: the options of a dropdown count the partners that match
// all the other filters.
const counters = (key: keyof typeof activeFilters) =>
  countersForDropdown(orderedPartnersWithoutStega, activeFilters, key);

const filters = [
  {
    name: 'continent',
    label: index.filters.continent,
    options: countersToOptions(counters('continent').continents),
    value: activeFilters.continent,
    resets: ['country'],
  },
  {
    name: 'country',
    label: index.filters.country,
    options: countersToOptions(counters('country').countries),
    value: activeFilters.country,
  },
  {
    name: 'technology',
    label: index.filters.technology,
    options: countersToOptions(counters('technology').technologies),
    value: activeFilters.technology,
  },
  {
    name: 'areaOfExpertise',
    label: index.filters.areaOfExpertise,
    options: countersToOptions(counters('areaOfExpertise').areasOfExpertise),
    value: activeFilters.areaOfExpertise,
  },
];
---

<Layout
  theme="pink"
  seo={overrideSeo(page._seoMetaTags, seoTitle(index.seoTitle), seoDescription(index.hero.intro))}
  headerVariant="page"
>
  <Hero
    variant="page"
    label={index.hero.label}
    headline={index.hero.headline}
    subheadline={index.hero.subheadline}
  >
    <p slot="intro">{index.hero.intro}</p>
  </Hero>

  <Section background="accent" class={s.reachBand}>
    <div class={s.reach}>
      <PartnersGlobe countries={globeCountries} />
      <div class={s.announce}>
        <p class="bodyLong">
          <strong>{index.announce.strong}</strong>{' '}{index.announce.text}
        </p>
        <Button href={index.announce.href} size="l">
          {index.announce.button}
        </Button>
      </div>
    </div>
  </Section>

  <Section>
    <FilterForm filters={filters} action="/partners" placeholder={filterPlaceholder}>
      <PartnerGrid id="filtered-partners">
        {
          filteredPartners.map((partner) => {
            const full = orderedPartnersWithStega.find((p) => p.id === partner.id)!;
            return (
              <li>
                <PartnerCard
                  href={buildUrlForPartner(full)}
                  name={full.name}
                  locations={full.locations}
                  label={projectsCountLabel(full._allReferencingShowcaseProjectsMeta.count)}
                >
                  <PlainText data={full.shortDescription} />
                </PartnerCard>
              </li>
            );
          })
        }
      </PartnerGrid>
      {filteredPartners.length === 0 && <p class:list={[s.empty, 'title']}>{index.noResults}</p>}
    </FilterForm>
  </Section>

  <DraftModeQueryListener query={query} />
</Layout>
