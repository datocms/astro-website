---
// One page of the showcase of the projects of the partners. Page 1 is
// /partners/showcase. The query string keeps the filters.
import { stripStega } from '@datocms/astro';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { FilterForm } from '~/components/FilterForm';
import { Hero } from '~/components/Hero';
import { Pagination } from '~/components/Pagination';
import { Section } from '~/components/Section';
import { PlainText } from '~/components/StructuredText';
import { filterPlaceholder, showcase } from '~/data/partners';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForShowcaseProject } from '~/lib/datocms/gqlUrlBuilder/showcaseProject';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { countersToOptions } from '~/pages/partners/_facets';
import Card from '../../../_Card.astro';
import { countersForDropdown } from './_facets';
import { perPage, query } from './_graphql';
import s from './_style.module.css';

export interface Props {
  pageIndex?: number;
}

if (Astro.params.pageIndex === '1') {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const rawPageIndex =
  Astro.props.pageIndex ||
  (Astro.params.pageIndex ? Number.parseInt(Astro.params.pageIndex, 10) : 1) ||
  1;

const technologyFilter = Astro.url.searchParams.get('technology');
const areaOfExpertiseFilter = Astro.url.searchParams.get('areaOfExpertise');

const { projects: projectsWithStega } = await executeQuery(Astro, query);

if (!projectsWithStega || projectsWithStega.length === 0) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

// The filters compare plain text: the stega of Content Link is not part of it.
const projectsWithoutStega = stripStega(projectsWithStega);

// Faceted search: the options of a dropdown count the projects that match
// the other filter.
const activeFilters = {
  technology: technologyFilter,
  areaOfExpertise: areaOfExpertiseFilter,
};

const technologyOptions = countersToOptions(
  countersForDropdown(projectsWithoutStega, activeFilters, 'technology').technologies,
);
const areaOfExpertiseOptions = countersToOptions(
  countersForDropdown(projectsWithoutStega, activeFilters, 'areaOfExpertise').areasOfExpertise,
);

const filteredProjects = projectsWithoutStega.filter((project) => {
  if (technologyFilter && !project.technologies?.some((t) => t?.name === technologyFilter)) {
    return false;
  }
  if (
    areaOfExpertiseFilter &&
    !project.partner?.areasOfExpertise?.some((a) => a?.name === areaOfExpertiseFilter)
  ) {
    return false;
  }
  return true;
});

const totalEntries = filteredProjects.length;
const totalPages = Math.max(1, Math.ceil(totalEntries / perPage));
const pageIndex = Math.min(Math.max(rawPageIndex, 1), totalPages);

const start = (pageIndex - 1) * perPage;
const pageProjects = filteredProjects.slice(start, start + perPage);

const filters = [
  {
    name: 'technology',
    label: showcase.filters.technology,
    options: technologyOptions,
    value: technologyFilter,
  },
  {
    name: 'areaOfExpertise',
    label: showcase.filters.areaOfExpertise,
    options: areaOfExpertiseOptions,
    value: areaOfExpertiseFilter,
  },
];
---

<Layout
  seo={overrideSeo([], seoTitle(showcase.seoTitle), seoDescription(showcase.hero.intro))}
  theme="pink"
  headerVariant="light"
  footerTheme="pink"
>
  <Hero
    variant="light"
    label={showcase.hero.label}
    headline={showcase.hero.headline}
    subheadline={showcase.hero.subheadline}
  >
    <p slot="intro">{showcase.hero.intro}</p>
  </Hero>

  <Section>
    <FilterForm filters={filters} action="/partners/showcase" placeholder={filterPlaceholder}>
      <ul class={s.grid}>
        {
          pageProjects
            .map((p) => projectsWithStega.find((op) => op.id === p.id)!)
            .map((project) => (
              <li>
                <Card
                  href={buildUrlForShowcaseProject(project)}
                  title={project.name}
                  image={project.mainImage.responsiveImage}
                  logo={project.partner.logo}
                >
                  <PlainText data={project.headline} />
                </Card>
              </li>
            ))
        }
      </ul>
      {pageProjects.length === 0 && <p class:list={[s.empty, 'h2']}>{showcase.noResults}</p>}

      <Pagination
        current={pageIndex}
        total={totalPages}
        baseUrl="/partners/showcase"
        search={Astro.url.search}
      />
    </FilterForm>
  </Section>

  <DraftModeQueryListener query={query} />
</Layout>
