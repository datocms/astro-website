---
// The page of one partner: the introduction, the description, the
// locations, the services, the technologies, the chats, the projects of
// the showcase and the plugins that the partner released.
import { ensureValidStructuredTextProps } from '@datocms/astro';
import sortBy from 'lodash-es/sortBy';
import { Button } from '~/components/Button';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { PluginCard } from '~/components/PluginCard';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { PlainText, StructuredText } from '~/components/StructuredText';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { partner } from '~/data/partners';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForCustomerStory } from '~/lib/datocms/gqlUrlBuilder/customerStory';
import { buildUrlForShowcaseProject } from '~/lib/datocms/gqlUrlBuilder/showcaseProject';
import {
  overrideSeo,
  seoDescription,
  seoGeneratedCard,
  seoOgType,
  seoPageTitle,
  seoShareTitle,
} from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import Card from '../_Card.astro';
import { extraQuery, query } from './_graphql';
import s from './_style.module.css';

const variables = { partnerSlug: Astro.params.partnerSlug! };
const { page } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { plugins } = await executeQuery(Astro, extraQuery, {
  variables: { authorId: page.npmUser?.id || '' },
});

// The featured projects come first, in the order of the CMS.
const featuredProjectIds = page.featuredProjects.map((p) => p.id);

const sortedProjects = sortBy(page.projects, (project) =>
  featuredProjectIds.includes(project.id)
    ? featuredProjectIds.indexOf(project.id)
    : Number.MAX_SAFE_INTEGER,
);
---

<Layout
  seo={overrideSeo(
    page._seoMetaTags,
    seoPageTitle(page.name, 'DatoCMS Partners'),
    seoShareTitle(`DatoCMS Partner: ${page.name}`),
    // The meta description is plain text.
    seoDescription(toPlainText(page.shortDescription)!),
    seoGeneratedCard(Astro, {
      kicker: `DatoCMS Agency Partners: ${page.name}`,
      excerpt: toPlainText(page.shortDescription),
      pills: [`${page.projects.length} showcased projects`],
      logoPngUrl: page.logo.pngUrl,
    }),
    seoOgType('website'),
  )}
  theme="pink"
  headerVariant="light"
  footerTheme="pink"
>
  <Hero variant="light" label={partner.kicker} labelHref={partner.kickerHref} headline={page.name}>
    <div slot="intro">
      <StructuredText {...ensureValidStructuredTextProps({ data: page.shortDescription })} />
      <img
        class={s.logo}
        src={page.logo.url}
        alt={`${page.name} logo`}
        width={page.logo.width ?? undefined}
        height={page.logo.height ?? undefined}
      />
    </div>
  </Hero>

  <Section>
    <div class={s.layout}>
      <div class={s.main}>
        <h2 class="h2">{partner.description}</h2>
        <Prose>
          <StructuredText
            {...ensureValidStructuredTextProps({
              data: page.description,
              linkToRecordComponents: defaultLinkToRecordComponents,
              inlineRecordComponents: defaultInlineRecordComponents,
            })}
          />
        </Prose>
        <div class={s.actions}>
          <Button href={page.websiteUrl} appearance="deep-on-light" attrs={{ target: '_blank' }}>
            {partner.visitWebsite}
          </Button>
          {
            page.publicContactEmail && (
              <Button
                href={`mailto:${page.publicContactEmail}`}
                variant="soft"
                appearance="deep-on-light"
                attrs={{ target: '_blank' }}
              >
                {`${partner.contact} ${page.name}`}
              </Button>
            )
          }
        </div>
      </div>

      <aside class={s.aside}>
        <section class={s.facts}>
          <h2 class="bodyMedium">
            {page.locations.length > 1 ? partner.locations : partner.location}
          </h2>
          <ul class={s.list}>
            {
              page.locations.map((area) => (
                <li class="body">
                  {area.emoji} {area.name}
                </li>
              ))
            }
          </ul>
        </section>
        <section class={s.facts}>
          <h2 class="bodyMedium">{partner.services}</h2>
          <ul class={s.list}>
            {page.areasOfExpertise.map((area) => <li class="body">{area.name}</li>)}
          </ul>
        </section>
        <section class={s.facts}>
          <h2 class="bodyMedium">{partner.technologies}</h2>
          <ul class={s.list}>
            {page.technologies.map((technology) => <li class="body">{technology.name}</li>)}
          </ul>
        </section>
      </aside>
    </div>
  </Section>

  {
    page.chats.length > 0 && (
      <Section flushTop>
        <div class={s.header}>
          <h2 class="h2">{partner.chats}</h2>
          <p class:list={[s.muted, 'body']}>{partner.chatsIntro}</p>
        </div>
        <ul class={s.grid}>
          {page.chats.map((chat) => (
            <li>
              <Card
                href={buildUrlForCustomerStory(chat)}
                title={chat.title}
                image={chat.coverImage?.responsiveImage}
              >
                <PlainText data={chat.excerpt} />
              </Card>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    sortedProjects.length > 0 && (
      <Section flushTop>
        <div class={s.header}>
          <h2 class="h2">{partner.projects}</h2>
        </div>
        <ul class={s.grid}>
          {sortedProjects.map((project) => {
            const framework = project.technologies.find(
              (t) => t.integrationType.slug === 'framework',
            )?.logo;
            return (
              <li>
                <Card
                  href={buildUrlForShowcaseProject(project)}
                  title={project.name}
                  image={project.mainImage.responsiveImage}
                  logo={framework}
                >
                  <PlainText data={project.headline} />
                </Card>
              </li>
            );
          })}
        </ul>
      </Section>
    )
  }

  {
    plugins.length > 0 && (
      <Section flushTop>
        <div class={s.header}>
          <h2 class="h2">{partner.plugins}</h2>
        </div>
        <ul class:list={[s.grid, s.pluginsGrid]}>
          {plugins.map((plugin) => (
            <li>
              <PluginCard plugin={plugin} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
