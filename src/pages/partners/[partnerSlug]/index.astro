---
// The page of one partner: the introduction, the description, the
// locations, the services, the technologies, the testimonials, the chats,
// the projects of the showcase and the plugins that the partner released.
import { ensureValidStructuredTextProps } from '@datocms/astro';
import sortBy from 'lodash-es/sortBy';
import { Breadcrumb } from '~/components/Breadcrumb';
import { Button } from '~/components/Button';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Fact, Facts } from '~/components/Facts';
import { Headline } from '~/components/Headline';
import { PluginCard } from '~/components/PluginCard';
import { Prose } from '~/components/Prose';
import { hasText, Quote, QuoteCard, readQuote } from '~/components/Quote';
import { Section } from '~/components/Section';
import { PlainText, StructuredText } from '~/components/StructuredText';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { partner } from '~/data/partners';
import { indexes } from '~/data/breadcrumbs';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { readFragment } from '~/lib/datocms/graphql';
import { ResponsiveImageFragment } from '~/components/ResponsiveImage/graphql';
import { buildUrlForCustomerStory } from '~/lib/datocms/gqlUrlBuilder/customerStory';
import { buildUrlForShowcaseProject } from '~/lib/datocms/gqlUrlBuilder/showcaseProject';
import {
  overrideSeo,
  seoDescription,
  seoGeneratedCard,
  seoOgType,
  seoPageTitle,
  seoShareTitle,
} from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import Card from '../_Card.astro';
import { LogoPlate } from '~/components/LogoPlate';
import { extraQuery, query } from './_graphql';
import s from './_style.module.css';

const variables = { partnerSlug: Astro.params.partnerSlug! };
const { page } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { plugins } = await executeQuery(Astro, extraQuery, {
  variables: { authorId: page.npmUser?.id || '' },
});

// The meta description is plain text. A partner with no short description has none.
const description = toPlainText(page.shortDescription);

// The featured projects come first, in the order of the CMS.
const featuredProjectIds = page.featuredProjects.map((p) => p.id);

// The testimonials with text. One testimonial is a statement on the accent
// band, more are cards.
const testimonials = page.testimonials.filter((item) => hasText(readQuote(item)));
const quoteBand = testimonials.length === 1;

const sortedProjects = sortBy(page.projects, (project) =>
  featuredProjectIds.includes(project.id)
    ? featuredProjectIds.indexOf(project.id)
    : Number.MAX_SAFE_INTEGER,
);
---

<Layout
  theme="pink"
  seo={overrideSeo(
    page._seoMetaTags,
    seoPageTitle(page.name, 'DatoCMS Partners'),
    seoShareTitle(`DatoCMS Partner: ${page.name}`),
    description ? seoDescription(description) : null,
    seoGeneratedCard(Astro, {
      kicker: partner.kicker,
      title: page.name,
      excerpt: description,
      pills: [`${page.projects.length} showcased projects`],
      logoPngUrl: page.logo.pngUrl,
      theme: 'pink',
    }),
    seoOgType('website'),
  )}
  headerVariant="page"
>
  {
    /*
      The hero is a split. The text is in the left half, on the page. The
      right half is the white plate of the logo, cut by the right edge and
      by the bottom edge of the band, as the frame of a product scene.
    */
  }
  <Section flushBottom class={s.hero} contentClass={s.heroContent} data-hero>
    <div class={s.heroText}>
      <p class:list={[s.label, 'body']}>
        <a href={partner.kickerHref} data-datocms-nomd>{partner.kicker}</a>
      </p>
      <Headline as="h1" size="headline">{page.name}</Headline>
      <div class:list={[s.intro, 'body']}>
        <StructuredText {...ensureValidStructuredTextProps({ data: page.shortDescription })} />
      </div>
      <div class={s.actions}>
        <Button href={page.websiteUrl} attrs={{ target: '_blank' }}>
          {partner.visitWebsite}
        </Button>
        {
          page.publicContactEmail && (
            <Button
              href={`mailto:${page.publicContactEmail}`}
              variant="soft"
              attrs={{ target: '_blank' }}
            >
              {`${partner.contact} ${page.name}`}
            </Button>
          )
        }
      </div>
    </div>
    <LogoPlate class={s.plate} name={page.name} logo={page.logo} />
  </Section>
  <Breadcrumb trail={[indexes.partners]} current={page.name} />

  <Section>
    <div class={s.layout}>
      <div class={s.main}>
        <h2 class="title">{partner.description}</h2>
        <Prose>
          <StructuredText
            {...ensureValidStructuredTextProps({
              data: page.description,
              linkToRecordComponents: defaultLinkToRecordComponents,
              inlineRecordComponents: defaultInlineRecordComponents,
            })}
          />
        </Prose>
      </div>

      <aside>
        <Facts>
          <Fact
            label={page.locations.length > 1 ? partner.locations : partner.location}
            values={page.locations.map((area) => `${area.emoji} ${area.name}`)}
          />
          <Fact label={partner.services} values={page.areasOfExpertise.map((area) => area.name)} />
          <Fact
            label={partner.technologies}
            values={page.technologies.map((technology) => technology.name)}
          />
        </Facts>
      </aside>
    </div>
  </Section>

  {
    /*
      On this page the company of a testimonial is plain text: its link
      goes to this page.
    */
  }
  {quoteBand && <Quote quote={testimonials[0]} />}
  {
    testimonials.length > 1 && (
      <Section flushTop>
        <div class={s.header}>
          <h2 class="title">{partner.testimonials}</h2>
        </div>
        <ul class={s.grid}>
          {testimonials.map((item) => (
            <li>
              <QuoteCard quote={readQuote(item)} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    page.chats.length > 0 && (
      <Section flushTop={!quoteBand}>
        <div class={s.header}>
          <h2 class="title">{partner.chats}</h2>
          <p class:list={[s.muted, 'body']}>{partner.chatsIntro}</p>
        </div>
        <ul class={s.grid}>
          {page.chats.map((chat) => (
            <li>
              <Card
                href={buildUrlForCustomerStory(chat)}
                title={chat.title}
                image={chat.coverImage?.responsiveImage}
                sizes="auto, (min-width: 768px) 670px, 100vw"
              >
                <PlainText data={chat.excerpt} />
              </Card>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    sortedProjects.length > 0 && (
      <Section flushTop={!(quoteBand && page.chats.length === 0)}>
        <div class={s.header}>
          <h2 class="title">{partner.projects}</h2>
        </div>
        <ul class={s.gallery}>
          {sortedProjects.map((project) => {
            const { width, height } = readFragment(
              ResponsiveImageFragment,
              project.mainImage.responsiveImage,
            );
            const ratio = width && height ? width / height : 3 / 2;
            return (
              <li style={{ '--ratio': ratio }}>
                <Card
                  href={buildUrlForShowcaseProject(project)}
                  title={project.name}
                  image={project.mainImage.responsiveImage}
                  natural
                  sizes="auto, (min-width: 768px) 670px, 100vw"
                >
                  <PlainText data={project.headline} />
                </Card>
              </li>
            );
          })}
        </ul>
      </Section>
    )
  }

  {
    plugins.length > 0 && (
      <Section flushTop={!(quoteBand && page.chats.length === 0 && sortedProjects.length === 0)}>
        <div class={s.header}>
          <h2 class="title">{partner.plugins}</h2>
        </div>
        <ul class:list={[s.grid, s.pluginsGrid]}>
          {plugins.map((plugin) => (
            <li>
              <PluginCard plugin={plugin} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
