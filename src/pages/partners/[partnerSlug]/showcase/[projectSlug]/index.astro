---
// The page of one project of the showcase: the introduction next to the
// video or the main image, the explanation, the screenshots (with a lightbox
// to the large image), the partner, the services and the technologies.
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { Breadcrumb } from '~/components/Breadcrumb';
import { ButtonGroup } from '~/components/ButtonGroup';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Fact, Facts } from '~/components/Facts';
import { Headline } from '~/components/Headline';
import { Lightbox } from '~/components/Lightbox';
import { Prose } from '~/components/Prose';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { Section } from '~/components/Section';
import { PlainText, StructuredText } from '~/components/StructuredText';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { VideoPlayerFragment } from '~/components/VideoPlayer';
import { indexes } from '~/data/breadcrumbs';
import { project } from '~/data/partners';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForPartner } from '~/lib/datocms/gqlUrlBuilder/partner';
import { readFragment } from '~/lib/datocms/graphql';
import { overrideSeo, seoOgType } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import { LogoPlate } from '~/components/LogoPlate';
import ProjectFrame from './_ProjectFrame/Component.astro';
import s from './_style.module.css';

const variables = { projectSlug: Astro.params.projectSlug! };
const { page } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const video = page.video ? readFragment(VideoPlayerFragment, page.video).video : null;
const partnerUrl = buildUrlForPartner(page.partner);
const galleries = [
  { title: project.projectShots, shots: page.projectScreenshots },
  { title: project.backendShots, shots: page.datocmsScreenshots },
].filter((gallery) => gallery.shots.length > 0);
---

<Layout
  theme="pink"
  seo={overrideSeo(page._seoMetaTags, seoOgType('website'))}
  headerVariant="page"
>
  {
    /*
      The hero is a split, as the hero of the partner page. The text is in
      the left half, on the page. The right half is the video of the
      project, else its main image, cut by the right edge of the band, as
      the frame of a product scene. The video replaces the main image: the
      partner chose the video as the media of the project.
    */
  }
  <Section flushBottom class={s.hero} contentClass={s.heroContent} data-hero>
    <div class={s.heroText}>
      <p class:list={[s.label, 'body']}>{project.kicker}</p>
      <Headline as="h1" size="headline">{page.name}</Headline>
      <div class:list={[s.intro, 'body']}>
        <StructuredText {...ensureValidStructuredTextProps({ data: page.headline })} />
        <p class={s.madeBy}>
          {project.madeBy}{' '}
          <a href={partnerUrl}>{page.partner.name}</a>
        </p>
      </div>
      {
        page.projectUrl && (
          <ButtonGroup
            buttons={[{ label: project.visitProject, href: page.projectUrl, newTab: true }]}
            size="l"
            class={s.actions}
          />
        )
      }
    </div>
    {
      page.video && video?.muxPlaybackId ? (
        <ProjectFrame class={s.frame} video={page.video} thumbhash={page.video.video.thumbhash} />
      ) : (
        <ProjectFrame
          class={s.frame}
          image={page.mainImage.responsiveImage}
          pixelSrc={page.mainImage.pixelSrc}
          thumbhash={page.mainImage.thumbhash}
          sizes="(min-width: 1152px) 50vw, (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)"
        />
      )
    }
  </Section>
  <Breadcrumb
    trail={[indexes.partners, { label: page.partner.name, href: partnerUrl }]}
    current={page.name}
  />

  <Section>
    <div class={s.layout}>
      <section class={s.about}>
        <h2 class="title">{project.about}</h2>
        <Prose>
          <StructuredText
            {...ensureValidStructuredTextProps({
              data: page.inDepthExplanation,
              linkToRecordComponents: defaultLinkToRecordComponents,
              inlineRecordComponents: defaultInlineRecordComponents,
            })}
          />
        </Prose>
      </section>

      <aside class={s.aside} data-density="dense">
        <section class={s.partner}>
          <h2 class:list={[s.partnerLabel, 'label']}>{project.madeBy}</h2>
          <a href={partnerUrl} class={s.madeByPlate}>
            <LogoPlate framed name={page.partner.name} logo={page.partner.logo} />
          </a>
          <p class="body"><PlainText data={page.partner.shortDescription} /></p>
          <a href={partnerUrl} class:list={[s.partnerLink, 'labelMedium']}>{project.viewProfile}</a>
        </section>

        <Facts>
          <Fact label={project.services} values={page.areasOfExpertise.map((item) => item.name)} />
          <Fact label={project.technologies} values={page.technologies.map((item) => item.name)} />
        </Facts>
      </aside>

      {
        galleries.length > 0 && (
          <div class={s.shots}>
            {galleries.map((gallery) => (
              <section>
                <h2 class="title">{gallery.title}</h2>
                <ul class={s.gallery}>
                  {gallery.shots.map((screen) => (
                    <li>
                      <figure>
                        <div class={s.shot}>
                          <Lightbox
                            url={screen.lightboxImageUrl}
                            label={`Enlarge: ${screen.title ?? gallery.title}`}
                            alt={screen.title ?? ''}
                          >
                            <ResponsiveImage data={screen.responsiveImage} />
                          </Lightbox>
                        </div>
                        {screen.title && (
                          <figcaption class:list={[s.shotTitle, 'body']}>{screen.title}</figcaption>
                        )}
                      </figure>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </div>
  </Section>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
