---
// The Slack invite page. The form sends the e-mail to the action
// inviteEmailToSlackChannel, then goes to /slack/thanks.
import { WebClient } from '@slack/web-api';
import { SLACK_TOKEN } from 'astro:env/server';
import { ContactForm } from '~/components/ContactForm';
import { Hero } from '~/components/Hero';
import { Section } from '~/components/Section';
import { form, hero, seo as slackSeo } from '~/data/slack';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import s from './_style.module.css';

const web = new WebClient(SLACK_TOKEN);

const info = await web.conversations.info({
  channel: 'C7SS10UUW',
  include_num_members: true,
});

if (!info.channel) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const seo = overrideSeo([], seoTitle(slackSeo.title));
---

<Layout seo={seo} theme="blue" headerVariant="light" footerTheme="blue">
  <Hero
    variant="light"
    label={hero.label}
    headline={hero.headline}
    subheadline={hero.subheadline}
  />
  <Section>
    <div class={s.column}>
      <p class:list={['subtitleMedium', s.notice]}>
        Our Slack is a wonderful place for casual chats and quick questions! If you need official
        technical support, we kindly suggest checking out the <a
          href="https://community.datocms.com/"
          target="_blank"
          rel="noopener">Community Forum</a
        > or using the <a href="/support">Support Form</a>.
      </p>
      <ContactForm {...form} external>
        <div slot="extra" class={s.turnstile} data-turnstile></div>
      </ContactForm>
      <p class:list={['subtitleMedium', s.stats]}>
        <strong>{info.channel.num_members}</strong> people are already part of the community!
      </p>
      <p class:list={['subtitle', s.info]}>
        Already a member? Enter the channel from{' '}
        <a href="https://datocms.slack.com/">datocms.slack.com</a>.
      </p>
    </div>
  </Section>
</Layout>

<script>
  import { actions } from 'astro:actions';
  import { connectExternalForm } from '~/lib/externalForm';

  const root = document.querySelector<HTMLElement>('[data-contact-form]');
  if (root) {
    connectExternalForm(root, {
      turnstileAction: 'slack-invite',
      fallback: 'email us at support@datocms.com.',
      send: async (formData) => {
        await actions.inviteEmailToSlackChannel.orThrow(formData);
        return '/slack/thanks';
      },
    });
  }
</script>
