---
// The page after a Slack invite request.
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

const seo = overrideSeo([], seoTitle('Success | DatoCMS Community Slack Channel'));
---

<Layout seo={seo} theme="blue" headerVariant="light" footerTheme="blue">
  <Hero variant="light" label="DatoCMS Community Slack Channel" headline="Welcome on board! 🎉" />
  <ArticleBody tocTitle="On this page">
    <p>Thanks so much for your interest in joining our Slack channel!</p>
    <p>
      We're really excited to welcome you into our community. Please keep an eye on your email for
      the invitation that we've sent your way, and don't forget to check your spam or junk folder
      just in case it gets filtered there!
    </p>
  </ArticleBody>
</Layout>
