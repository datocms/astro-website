---
// The contact sales page. The copy comes from
// src/data/contact.ts. The form sends its data to the action
// forms.submitSalesRequest (Pipedrive and Front) and
// goes to /contact/thanks after the submit. The SEO is static.
import { ContactSection } from '~/components/ContactSection';
import { contact, seo as contactSeo } from '~/data/contact';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import s from './_style.module.css';

const seo = overrideSeo([], seoTitle(contactSeo.title), seoDescription(contactSeo.description));
---

<Layout theme="blue" seo={seo} headerVariant="accent">
  <sales-form class={s.salesForm}>
    <ContactSection {...contact} external>
      <Fragment slot="extra">
        <input type="hidden" name="issueType" value="sales" />
        <div class={s.turnstile} data-turnstile></div>
      </Fragment>
    </ContactSection>
  </sales-form>
</Layout>

<script>
  import '~/lib/salesForm';
</script>
