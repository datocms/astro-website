---
// The page after a contact sales request. The action
// forms.submitSalesRequest sends the visitor here. It shows the success
// state of the contact section and sends the Google Ads conversion.
import { ContactSection } from '~/components/ContactSection';
import { contact, thanksSeo } from '~/data/contact';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { GOOGLE_ADS_CONVERSIONS } from '~/lib/googleAds';

const seo = overrideSeo([], seoTitle(thanksSeo.title), seoDescription(thanksSeo.description));
---

<Layout seo={seo} headerVariant="light">
  <script is:inline define:vars={{ GADS_CONVERSION: GOOGLE_ADS_CONVERSIONS.contactSubmit }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('event', 'conversion', { send_to: GADS_CONVERSION });
  </script>
  <ContactSection {...contact} submitted />
</Layout>
