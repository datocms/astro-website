---
// The pricing page. The copy of the sections comes from
// src/data/pricing.ts. The limits come from the pricing plans of the
// dashboard API. The features, their descriptions and the FAQ come from
// the CMS.
import { stripStega } from '@datocms/astro';
import { render as renderAsPlainText } from 'datocms-structured-text-to-plain-text';
import { sortBy } from 'lodash-es';
import type { FAQPage, WithContext } from 'schema-dts';
import { CtaBanner } from '~/components/CtaBanner';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Faq, FaqQuestionFragment } from '~/components/Faq';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/JsonLd';
import { PageCloser } from '~/components/PageCloser';
import { PlanComparison } from '~/components/PlanComparison';
import { PricingOffers } from '~/components/PricingOffers';
import { PricingPlans } from '~/components/PricingPlans';
import * as pricing from '~/data/pricing';
import Layout from '~/layouts/Layout.astro';
import { canonicalUrl, webPageId } from '~/lib/jsonLd';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { readFragment } from '~/lib/datocms/graphql';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { fetchPerOwnerPricingPlans } from '~/lib/pricing/perOwnerPricingPlans';
import { query } from './_graphql';
import FreeLimitsDialog from './_sub/FreeLimitsDialog.astro';
import { freeLimitRows, limitCategories } from './_sub/limits';

const { page, faqs, planFeatureGroups, hints } = await executeQuery(Astro, query);

// The cheapest plan is the Free plan, the next one is the Professional plan.
const [freePlan, proPlan] = sortBy(
  await fetchPerOwnerPricingPlans(Astro),
  'attributes.monthly_price',
);

if (!page || !freePlan || !proPlan) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

// The questions that have an answer. The FAQPage JSON-LD needs strings:
// the question and the answer as plain text, without the stega of Content
// Link.
const questions = faqs.flatMap((faq) => {
  const { question, answer } = readFragment(FaqQuestionFragment, faq);
  const text = answer && renderAsPlainText(answer as Parameters<typeof renderAsPlainText>[0]);
  return question && text
    ? [{ faq, question: stripStega(question).trim(), answer: stripStega(text) }]
    : [];
});

const jsonLd: WithContext<FAQPage> | null =
  questions.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': webPageId(canonicalUrl(Astro)),
        mainEntity: questions.map(({ question, answer }) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
      }
    : null;
---

<Layout theme="blue" seo={page.seo} headerVariant="page">
  {jsonLd && <JsonLd slot="head" data={jsonLd} />}

  <Hero {...pricing.hero} variant="page" alignment="center" typewriter />
  <PricingPlans {...pricing.plans} />
  <PricingOffers {...pricing.offers} />
  <PlanComparison
    {...pricing.comparison}
    categories={limitCategories(proPlan, hints)}
    featureGroups={planFeatureGroups}
  >
    {pricing.freeReminder.lead}
    <strong>{pricing.freeReminder.strong}</strong>{pricing.freeReminder.text}{' '}
    <a href={pricing.freeReminder.link.href}>{pricing.freeReminder.link.label}</a>
  </PlanComparison>
  <CtaBanner {...pricing.aiBanner} face="surprised" />
  <Hero {...pricing.trustedBy} variant="accent" alignment="center" headingLevel="h2" />
  {questions.length > 0 && <Faq {...pricing.faq} questions={questions.map(({ faq }) => faq)} />}
  <PageCloser face="kiss" cta={pricing.ctaStart} video="/videos/hand-thumbs-up-2.pxv" />

  <FreeLimitsDialog {...pricing.freeLimits} rows={freeLimitRows(freePlan, proPlan, hints)} />
  <DraftModeQueryListener query={query} />
</Layout>
