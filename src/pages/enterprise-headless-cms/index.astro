---
// The enterprise page. The copy comes from src/data/enterprise.ts. The SEO,
// the H1 label and the quotes come from the CMS. The form sends its data
// to the action forms.submitSalesRequest with the issue type
// "enterprise".
import { ChapterHeader } from '~/components/ChapterHeader';
import { ContactSection } from '~/components/ContactSection';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { InlineText } from '~/components/InlineText';
import { LogosLine } from '~/components/LogosLine';
import { Quote } from '~/components/Quote';
import { Section } from '~/components/Section';
import { SplitPoints } from '~/components/SplitPoints';
import { StatementsSection } from '~/components/StatementsSection';
import { contact as contactData } from '~/data/contact';
import * as enterprise from '~/data/enterprise';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import s from './_style.module.css';

const { page, review1, review2, review3 } = await executeQuery(Astro, query);

if (!page || !review1 || !review2 || !review3) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const strips = [
  { strip: enterprise.security, quote: enterprise.quotes.security, review: review2 },
  { strip: enterprise.performance, quote: enterprise.quotes.performance, review: review1 },
  { strip: enterprise.support, quote: enterprise.quotes.support, review: review3 },
  { strip: enterprise.governance },
];
---

<Layout seo={page.seo} seoAnalysis={page.yoastAnalysis} headerTheme="orange">
  <Hero
    label={page.seoH1 ?? undefined}
    headline={enterprise.hero.headline}
    subheadline={enterprise.hero.subheadline}
  >
    <p slot="intro"><InlineText text={enterprise.hero.subtitle} /></p>
  </Hero>

  <Section flushTop>
    <p class:list={['subtitleMedium', s.logosTitle]}>{enterprise.logos.title}</p>
    <LogosLine logos={enterprise.logos.items} label={enterprise.logos.title} />
  </Section>

  {
    strips.map(({ strip, quote, review }) => (
      <>
        <SplitPoints {...strip} />
        {quote && review && <Quote review={review} fallback={quote} theme={strip.theme} />}
      </>
    ))
  }

  <ContactSection
    id="form"
    headingLevel="h2"
    external
    label=""
    headline={enterprise.contact.headline}
    muted=""
    face=""
    links={[]}
    form={contactData.form}
  >
    <p slot="description"><InlineText text={enterprise.contact.description} /></p>
    <Fragment slot="extra">
      <input type="hidden" name="issueType" value="enterprise" />
      <div class={s.turnstile} data-turnstile></div>
    </Fragment>
  </ContactSection>

  <StatementsSection {...enterprise.results} variant="statLight" />

  <ChapterHeader
    label={enterprise.closer.label}
    headline={enterprise.closer.title}
    intro={enterprise.closer.text}
    theme="orange"
    background="accent"
  />

  <DraftModeQueryListener query={query} />
</Layout>

<script>
  import { initSalesForm } from '~/lib/salesForm';

  initSalesForm();
</script>
