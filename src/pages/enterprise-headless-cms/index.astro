---
// The enterprise page. The copy comes from src/data/enterprise.ts. The SEO,
// the H1 label and the quote come from the CMS. The form sends its data
// to the action forms.submitSalesRequest with the issue type
// "enterprise".
import { CategoryNav } from '~/components/CategoryNav';
import { ContactSection } from '~/components/ContactSection';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Faq } from '~/components/Faq';
import { Hero } from '~/components/Hero';
import { InlineText } from '~/components/InlineText';
import { PageCloser } from '~/components/PageCloser';
import { Quote } from '~/components/Quote';
import { StatementsSection } from '~/components/StatementsSection';
import { contact as contactData } from '~/data/contact';
import * as enterprise from '~/data/enterprise';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import SecurityChapter from '~/scenes/Enterprise/SecurityChapter.astro';
import GovernanceChapter from '~/scenes/Enterprise/GovernanceChapter.astro';
import SupportChapter from '~/scenes/Enterprise/SupportChapter.astro';
import { query } from './_graphql';
import s from './_style.module.css';

const { page, review } = await executeQuery(Astro, query);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { subtitle, ...hero } = enterprise.hero;
---

<Layout seo={page.seo} seoAnalysis={page.yoastAnalysis} headerTheme="orange" footerTheme="orange">
  <Hero {...hero} label={page.seoH1 ?? undefined}>
    <p slot="intro"><InlineText text={subtitle} /></p>
  </Hero>
  <CategoryNav {...enterprise.chapterNav} />

  <SecurityChapter />

  <GovernanceChapter />

  <StatementsSection id="scale" {...enterprise.scale} variant="statLight" theme="orange" />

  <SupportChapter />
  <Quote quote={review} theme="orange" />

  <Faq id="faq" {...enterprise.faq} />

  <sales-form class={s.salesForm}>
    <ContactSection
      id="form"
      headingLevel="h2"
      external
      label=""
      headline={enterprise.contact.headline}
      muted=""
      face=""
      links={[]}
      form={contactData.form}
    >
      <p slot="description"><InlineText text={enterprise.contact.description} /></p>
      <Fragment slot="extra">
        <input type="hidden" name="issueType" value="enterprise" />
        <div class={s.turnstile} data-turnstile></div>
      </Fragment>
    </ContactSection>
  </sales-form>

  <PageCloser theme="orange" cta={enterprise.ctaClose} video="/videos/hand-ok-sign-1.pxv" />

  <DraftModeQueryListener query={query} />
</Layout>

<script>
  import '~/lib/salesForm';
</script>
