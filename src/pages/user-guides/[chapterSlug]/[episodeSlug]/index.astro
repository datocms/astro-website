---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { ArticleBody } from '~/components/ArticleBody';
import { Breadcrumb } from '~/components/Breadcrumb';
import { CourseOutline } from '~/components/CourseOutline';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/JsonLd';
import { PrevNext } from '~/components/PrevNext';
import { Section } from '~/components/Section';
import { StructuredText } from '~/components/StructuredText';
import { InternalVideo } from '~/components/StructuredText/blocks/InternalVideo';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { VideoPlayer } from '~/components/VideoPlayer';
import { indexes } from '~/data/breadcrumbs';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { buildUrlForUserGuidesEpisode } from '~/lib/datocms/gqlUrlBuilder/userGuidesEpisode';
import { readFragment } from '~/lib/datocms/graphql';
import { formatVideoDuration, toIso8601Duration } from '~/lib/formatters';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { EpisodeFragment, query } from './_graphql';
import s from './_style.module.css';

const { chapterSlug, episodeSlug } = Astro.params;

const variables = { episodeSlug: episodeSlug! };

const { episode, chapters } = await executeQuery(Astro, query, { variables });

const currentChapter = chapters.find((c) => c.slug === chapterSlug);

if (!episode || !currentChapter) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const chapterIndex = chapters.indexOf(currentChapter);
const episodeIndex = currentChapter.episodes.findIndex((e) => e.id === episode.id);
const previousChapter = chapters[chapterIndex - 1];
const nextChapter = chapters[chapterIndex + 1];

// Previous: the episode before, or the last episode of the chapter before.
const previousRef = currentChapter.episodes[episodeIndex - 1] ?? previousChapter?.episodes.at(-1);
const previousEpisode = previousRef && readFragment(EpisodeFragment, previousRef);

// Next: the episode after, or the first episode of the chapter after. At the
// end of a chapter the link names the chapter after, not the episode.
const nextRef = currentChapter.episodes[episodeIndex + 1];
const nextEpisode = nextRef && readFragment(EpisodeFragment, nextRef);
const firstOfNextChapter = nextChapter?.episodes[0];
const next = nextEpisode
  ? {
      label: 'Next episode',
      title: nextEpisode.title,
      href: buildUrlForUserGuidesEpisode(nextEpisode),
    }
  : nextChapter && firstOfNextChapter
    ? {
        label: 'Next chapter',
        title: nextChapter.title,
        href: buildUrlForUserGuidesEpisode(firstOfNextChapter),
      }
    : undefined;

// The chapters of the user guides. The chapter of the page is open, with its episodes.
const outline = chapters
  .filter((chapter) => chapter.episodes.length > 0)
  .map((chapter) => ({
    title: chapter.title,
    href:
      chapter === currentChapter
        ? `${indexes.userGuides.href}#${chapter.slug}`
        : buildUrlForUserGuidesEpisode(chapter.episodes[0]!),
    active: chapter === currentChapter,
    sections:
      chapter === currentChapter
        ? chapter.episodes.map((nthEpisode) => {
            const data = readFragment(EpisodeFragment, nthEpisode);
            return {
              text: data.title,
              href: buildUrlForUserGuidesEpisode(data),
              current: nthEpisode.id === episode.id,
            };
          })
        : undefined,
  }));
---

<Layout theme="orange" seo={episode._seoMetaTags} headerVariant="accent">
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: episode.title,
        uploadDate: episode._firstPublishedAt,
        duration: toIso8601Duration(episode.asset.video.duration!),
        thumbnailUrl: episode.asset.video.muxPlaybackId
          ? `https://image.mux.com/${episode.asset.video.muxPlaybackId}/thumbnail.jpg`
          : undefined,
        description: extractFromSeoTags(episode._seoMetaTags).description,
      }}
    />
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Course',
        name: currentChapter.title,
        provider: { '@type': 'Organization' as const, name: 'DatoCMS' },
      }}
    />
  </Fragment>
  <div id="main-content" class={s.episode}>
    <Hero variant="accent" headline={episode.title}>
      <p slot="intro">Video · {formatVideoDuration(episode.asset.video.duration)}</p>
    </Hero>
    {
      /*
        The stage: the player starts in the accent band of the hero, and the
        band stops at the middle of the player, with a hard edge.
      */
    }
    <Section flushTop class={s.stage} contentClass={s.stageContent} data-datocms-nomd>
      <span class:list={[s.band, 'surfaceAccent']} aria-hidden="true"></span>
      <VideoPlayer data={episode.asset} />
    </Section>
    <Breadcrumb
      trail={[
        indexes.userGuides,
        { label: currentChapter.title, href: `${indexes.userGuides.href}#${currentChapter.slug}` },
      ]}
      current={episode.title}
    />
    <ArticleBody>
      <CourseOutline
        slot="aside"
        title="User guides"
        note={`Episode ${episodeIndex + 1} of ${currentChapter.episodes.length}`}
        chapters={outline}
      />
      <StructuredText
        {...ensureValidStructuredTextProps({
          data: episode.content,
          blockComponents: {
            InternalVideoRecord: InternalVideo,
          },
          linkToRecordComponents: defaultLinkToRecordComponents,
          inlineRecordComponents: defaultInlineRecordComponents,
        })}
      />
    </ArticleBody>
  </div>
  <PrevNext
    ariaLabel="Previous and next episode"
    prev={previousEpisode && {
      label: 'Previous episode',
      title: previousEpisode.title,
      href: buildUrlForUserGuidesEpisode(previousEpisode),
    }}
    next={next}
  />

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
