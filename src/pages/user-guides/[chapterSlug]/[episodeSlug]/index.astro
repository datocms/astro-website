---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/JsonLd';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { StructuredText } from '~/components/StructuredText';
import { InternalVideo } from '~/components/StructuredText/blocks/InternalVideo';
import { muxThumbnailUrl } from '~/components/StructuredText/blocks/TutorialVideo/muxThumbnailUrl';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { VideoPlayer } from '~/components/VideoPlayer';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { buildUrlForUserGuidesEpisode } from '~/lib/datocms/gqlUrlBuilder/userGuidesEpisode';
import { readFragment } from '~/lib/datocms/graphql';
import { formatVideoDuration, toIso8601Duration } from '~/lib/formatters';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { EpisodeFragment, query } from './_graphql';
import s from './_style.module.css';

const { chapterSlug, episodeSlug } = Astro.params;

const variables = { episodeSlug: episodeSlug! };

const { episode, chapters } = await executeQuery(Astro, query, { variables });

const currentChapter = chapters.find((c) => c.slug === chapterSlug);

if (!episode || !currentChapter) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const otherChapters = chapters.filter((c) => c !== currentChapter && c.episodes.length);
const nextChapter = chapters[chapters.indexOf(currentChapter) + 1];
const nextEpisodeRef =
  currentChapter.episodes[currentChapter.episodes.findIndex((e) => e.id === episode.id) + 1] ||
  nextChapter?.episodes[0];
const nextEpisode = nextEpisodeRef && readFragment(EpisodeFragment, nextEpisodeRef);
const thumbnail = (video: { thumbnailUrl: string }, width: number, height: number) =>
  muxThumbnailUrl(video.thumbnailUrl, { width, height, fit_mode: 'crop' });
---

<Layout seo={episode._seoMetaTags} theme="purple" headerVariant="light" footerTheme="purple">
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: episode.title,
        uploadDate: episode._firstPublishedAt,
        duration: toIso8601Duration(episode.asset.video.duration!),
        thumbnailUrl: episode.asset.video.muxPlaybackId
          ? `https://image.mux.com/${episode.asset.video.muxPlaybackId}/thumbnail.jpg`
          : undefined,
        description: extractFromSeoTags(episode._seoMetaTags).description,
      }}
    />
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Course',
        name: currentChapter.title,
        provider: { '@type': 'Organization' as const, name: 'DatoCMS' },
      }}
    />
  </Fragment>
  <div id="main-content">
    <Hero
      variant="light"
      label="Back to All Videos"
      labelHref="/user-guides"
      headline={episode.title}
    >
      <p slot="intro">{formatVideoDuration(episode.asset.video.duration)}</p>
    </Hero>
    <Section flushBottom>
      <div data-datocms-nomd>
        <VideoPlayer data={episode.asset} />
      </div>
    </Section>
    <Section contentClass={s.layout}>
      <div class={s.main}>
        <Prose>
          <StructuredText
            {...ensureValidStructuredTextProps({
              data: episode.content,
              blockComponents: {
                InternalVideoRecord: InternalVideo,
              },
              linkToRecordComponents: defaultLinkToRecordComponents,
              inlineRecordComponents: defaultInlineRecordComponents,
            })}
          />
        </Prose>
        {
          nextEpisode && (
            <a class={s.next} href={buildUrlForUserGuidesEpisode(nextEpisode)}>
              <img
                class={s.nextImage}
                src={thumbnail(nextEpisode.asset.video, 320, 180)}
                alt=""
                width="320"
                height="180"
                loading="lazy"
                style={{
                  background: `center / cover url("${nextEpisode.asset.video.blurUpThumb}")`,
                }}
              />
              <span class={s.nextText}>
                <span class:list={[s.muted, 'caption']}>Next episode</span>
                <span class="h2">{nextEpisode.title}</span>
                <span class:list={[s.muted, 'body']}>
                  {formatVideoDuration(nextEpisode.asset.video.duration)}
                </span>
              </span>
            </a>
          )
        }
      </div>
      <aside class={s.aside} data-datocms-nomd>
        <section class={s.currentChapter}>
          <p class:list={[s.muted, 'subtitleMedium']}>
            Chapter #{chapters.indexOf(currentChapter) + 1}
          </p>
          <p class:list={[s.pill, 'caption']}>{currentChapter.episodes.length} episodes</p>
          <h2 class="h2">{currentChapter.title}</h2>
          <ul class={s.episodes}>
            {
              currentChapter.episodes.map((nthEpisode) => {
                const data = readFragment(EpisodeFragment, nthEpisode);
                return (
                  <li>
                    <a
                      class:list={[s.episode, nthEpisode.id === episode.id && s.active]}
                      href={buildUrlForUserGuidesEpisode(data)}
                      aria-current={nthEpisode.id === episode.id ? 'page' : undefined}
                    >
                      <img
                        class={s.episodeImage}
                        src={thumbnail(data.asset.video, 160, 90)}
                        alt=""
                        width="80"
                        height="45"
                        loading="lazy"
                        style={{
                          background: `center / cover url("${data.asset.video.blurUpThumb}")`,
                        }}
                      />
                      <span class={s.episodeText}>
                        <span class="body">{data.title}</span>
                        <span class:list={[s.muted, 'caption']}>
                          {formatVideoDuration(data.asset.video.duration)}
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>
        <section class={s.others}>
          <h3 class="subtitleMedium">Other chapters</h3>
          <ul class={s.otherChapters}>
            {
              otherChapters.map((chapter) => (
                <li>
                  <a
                    class={s.otherChapter}
                    href={buildUrlForUserGuidesEpisode(chapter.episodes[0]!)}
                  >
                    <span class={s.otherIntro}>
                      <span class:list={[s.muted, 'caption']}>Chapter #{chapter.position}</span>
                      <span class:list={[s.pill, 'caption']}>
                        {chapter.episodes.length} episodes
                      </span>
                    </span>
                    <span class="bodyMedium">{chapter.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </Section>
  </div>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
