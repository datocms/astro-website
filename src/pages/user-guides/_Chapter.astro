---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { sum } from 'lodash-es';
import { CardCarousel } from '~/components/CardCarousel';
import { CarouselCard } from '~/components/CarouselCard';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { StructuredText } from '~/components/StructuredText';
import { muxThumbnailUrl } from '~/lib/muxThumbnailUrl';
import { buildUrlForUserGuidesEpisode } from '~/lib/datocms/gqlUrlBuilder/userGuidesEpisode';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { formatVideoDuration } from '~/lib/formatters';
import { ChapterFragment } from './_graphql';
import { EpisodeFragment } from './[chapterSlug]/[episodeSlug]/_graphql';
import s from './_style.module.css';

interface Props {
  chapter: FragmentOf<typeof ChapterFragment>;
  number: number;
}

const chapter = readFragment(ChapterFragment, Astro.props.chapter);
const { number } = Astro.props;

const episodes = chapter.episodes.map((episode) => readFragment(EpisodeFragment, episode));
// The card shows the whole frame of the video: its ratio, with no crop.
const ratio = (video: { width: number | null; height: number | null }) =>
  video.width && video.height ? `${video.width} / ${video.height}` : '16 / 9';
const totalDuration = sum(chapter.episodes.map((episode) => episode.asset.video.duration || 0));
---

{
  /*
  A chapter: the title and the introduction, then one muted line with the
  number, the count of the episodes and the total time, then the episodes
  in a row of cards. The id is the slug of the chapter: the chapter nav and
  the breadcrumb of an episode link to it.
*/
}
<Section id={chapter.slug} class={s.chapter} contentClass={s.content}>
  <div class={s.intro}>
    <h2 class="headline">{chapter.title}</h2>
    <Prose>
      <StructuredText {...ensureValidStructuredTextProps({ data: chapter.introduction })} />
    </Prose>
    <p class:list={[s.meta, 'labelMedium']}>
      Chapter {number} · {episodes.length === 1 ? '1 episode' : `${episodes.length} episodes`} ·{
        ' '
      }
      {formatVideoDuration(totalDuration)}
    </p>
  </div>
  <CardCarousel label={`Episodes of ${chapter.title}`} wrap bleed class={s.row}>
    {
      episodes.map((data) => (
        <CarouselCard
          href={buildUrlForUserGuidesEpisode(data)}
          title={data.title}
          imageRatio={ratio(data.asset.video)}
        >
          <img
            slot="image"
            src={muxThumbnailUrl(data.asset.video.thumbnailUrl, { width: 640 })}
            alt=""
            width={data.asset.video.width ?? 16}
            height={data.asset.video.height ?? 9}
            loading="lazy"
            style={{ background: `center / cover url("${data.asset.video.blurUpThumb}")` }}
          />
          {formatVideoDuration(data.asset.video.duration)}
        </CarouselCard>
      ))
    }
  </CardCarousel>
</Section>
