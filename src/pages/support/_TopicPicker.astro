---
// The picker of the support page, in bands: the grid of the topics, the
// grid of the subtopics, the help text of the chosen topic (on the faint tint)
// and, when the topic needs it, a form. Each cell is a link (?topics=a/b),
// thus the page works without JS: the server renders the choice of the URL.
// The script does the same render after a click, without a new load.
import { stripStega } from '@datocms/astro';
import { render as renderAsHtmlString } from 'datocms-structured-text-to-html-string';
import { ContactForm } from '~/components/ContactForm';
import { ContactPeople } from '~/components/ContactPeople';
import { FormField } from '~/components/FormField';
import { Headline } from '~/components/Headline';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { contact } from '~/data/contact';
import { errorIdField, picker, shortcuts, supportForm } from '~/data/support';
import type { ResultOf } from '~/lib/datocms/graphql';
import type { SupportTopicFragment } from './_graphql';
import { computeView, hasErrorId, parseTopicSlugs, type FormMode, type TopicMeta } from './_state';
import s from './_style.module.css';
import TopicCell from './_TopicCell.astro';

type Topic = ResultOf<typeof SupportTopicFragment>;

interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;

const bySlug = new Map(topics.map((topic) => [topic.slug, topic]));
const rootTopics = topics.filter((topic) => !topic.parent);
const childrenOf = (slug: string) =>
  (bySlug.get(slug)?.children ?? []).flatMap((child) => bySlug.get(child.slug) ?? []);
const rootsWithChildren = rootTopics.filter((topic) => childrenOf(topic.slug).length > 0);

// The contact form shows when the topic is a leaf. With no guides, it shows
// at once. With guides, the visitor asks for it (a link, or #form).
function formModeOf(topic: Topic): FormMode {
  if (topic.children.length > 0) return 'none';
  if (topic.commonQuestions.length === 0) return topic.disableContactForm ? 'none' : 'auto';
  return 'on-request';
}

// The departments that answer the form of a topic: its own, else the ones
// of its parent. They give the faces and the intro above the form.
function departmentsOf(topic: Topic): Topic['departments'] {
  if (topic.departments.length > 0) return topic.departments;
  const parent = topic.parent ? bySlug.get(topic.parent.slug) : undefined;
  return parent ? departmentsOf(parent) : [];
}

const formTypeOf = (topic: Topic) => (topic.contactFormType === 'support' ? 'support' : 'sales');

interface Intro {
  key: string;
  formType: 'support' | 'sales';
  departments: string[];
  title: string;
  text: string;
}

// The intro of a topic: the title and the text of its first department.
function introOf(topic: Topic): Intro {
  const formType = formTypeOf(topic);
  const departments = departmentsOf(topic);
  const slugs = departments.map((department) => stripStega(department.slug ?? ''));
  return {
    key: `${formType}:${slugs.join(',')}`,
    formType,
    departments: slugs,
    title: departments[0]?.formTitle ?? '',
    text: departments[0]?.formText ?? '',
  };
}

// One intro for each distinct set of departments of the topics with a form.
const intros = [
  ...new Map(
    topics
      .filter((topic) => formModeOf(topic) !== 'none')
      .map((topic) => introOf(topic))
      .map((intro) => [intro.key, intro]),
  ).values(),
];

const metas: TopicMeta[] = topics.map((topic) => ({
  slug: topic.slug,
  title: stripStega(topic.title ?? ''),
  parentSlug: topic.parent?.slug,
  childSlugs: childrenOf(topic.slug).map((child) => child.slug),
  formMode: formModeOf(topic),
  formType: formTypeOf(topic),
  responder: topic.autoResponderType ?? '',
  intro: introOf(topic).key,
}));

// The first render follows the URL, as the script does after a change. A
// link with an error ID opens the form.
const withErrorId = hasErrorId(Astro.url.search);
const view = computeView(metas, parseTopicSlugs(Astro.url.search), withErrorId);
const currentIntro = metas.find((meta) => meta.slug === view.leafSlug)?.intro;
const formModeBySlug = new Map(metas.map((meta) => [meta.slug, meta.formMode]));
const hasHelp = (topic: (typeof topics)[number]) =>
  topic.commonQuestions.length > 0 || Boolean(topic.description);
const helpSlugs = new Set(topics.filter(hasHelp).map((topic) => topic.slug));
---

<topic-picker class={s.picker}>
  <script type="application/json" id="topics-data" set:html={JSON.stringify(metas)} />

  <p class="visuallyHidden" aria-live="polite" data-status></p>

  {/* A split: the title on the left, the options on the right. */}
  <div class={s.split}>
    <div class={s.splitText}>
      <Headline as="h2" size="headline">{picker.heading}</Headline>
      <nav aria-label="Shortcuts">
        <p class:list={['labelMedium', s.shortcuts]}>
          {
            shortcuts.map((part) =>
              'href' in part ? (
                <a href={part.href} class={s.shortcut}>
                  {part.label}
                </a>
              ) : (
                part.text
              ),
            )
          }
        </p>
      </nav>
    </div>
    <ul class={s.cells}>
      {
        rootTopics.map((topic) => (
          <li>
            <TopicCell
              href={`?topics=${topic.slug}`}
              slug={topic.slug}
              level={0}
              current={view.rootSlug === topic.slug}
              title={topic.title}
            />
          </li>
        ))
      }
    </ul>
  </div>
  {
    rootsWithChildren.map((root) => (
      <div
        class:list={[s.split, s.subtopics]}
        data-subtopics={root.slug}
        hidden={view.subtopicsOf !== root.slug}
      >
        <div class={s.splitText}>
          <h2 class="section" tabindex="-1">
            {root.subtopicQuestion}
          </h2>
        </div>
        <ul class={s.cells}>
          {childrenOf(root.slug).map((topic) => (
            <li>
              <TopicCell
                href={`?topics=${root.slug}/${topic.slug}`}
                slug={topic.slug}
                level={1}
                current={view.subSlug === topic.slug}
                title={topic.title}
              />
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <Section
    background="accent-faint"
    class={s.band}
    hidden={!view.leafSlug || !helpSlugs.has(view.leafSlug)}
    data-help-band
  >
    {
      topics.filter(hasHelp).map((topic) => (
        <div class={s.help} data-topic={topic.slug} hidden={view.leafSlug !== topic.slug}>
          <h2 class="headline" tabindex="-1">
            {topic.title}
          </h2>
          <Prose>
            {topic.description && (
              <Fragment set:html={renderAsHtmlString(topic.description) ?? ''} />
            )}
            {topic.commonQuestions.length > 0 && (
              <>
                <h3>{picker.guidesTitle}</h3>
                <p>{picker.guidesText}</p>
                <ul>
                  {topic.commonQuestions.map((question) => (
                    <li id={question.url}>
                      <a href={question.url}>{question.title}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {/* When the form opens at once, it is already below: no link. */}
            {formModeBySlug.get(topic.slug) === 'on-request' && (
              <p>
                {picker.moreTitle}{' '}
                <a href="#form" data-open-form>
                  {picker.moreLink}
                </a>
              </p>
            )}
          </Prose>
        </div>
      ))
    }
  </Section>

  <Section id="form" class:list={[s.band, s.formRegion]} hidden={!view.form} data-form-region>
    <div class={s.talk} data-form-kind="support" hidden={view.form !== 'support'}>
      {
        /* One intro for each set of departments. The script shows the
          intro of the chosen topic. */
      }
      {
        intros
          .filter((intro) => intro.formType === 'support')
          .map((intro) => (
            <div class={s.talkIntro} data-intro={intro.key} hidden={intro.key !== currentIntro}>
              <h2 class="headline" tabindex="-1">
                {intro.title}
              </h2>
              <ContactPeople departments={intro.departments} />
              {intro.text && <p class:list={['body', s.talkText]}>{intro.text}</p>}
            </div>
          ))
      }
      <div class={s.talkForm}>
        <ContactForm {...supportForm} external idPrefix="support">
          <div slot="start" class={s.errorId} data-error-id hidden={!withErrorId}>
            <FormField {...errorIdField} id="support-errorId" />
          </div>
          <input slot="extra" type="hidden" name="issueType" />
          <div slot="extra" class={s.turnstile} data-turnstile></div>
        </ContactForm>
      </div>
    </div>

    <div class={s.talk} data-form-kind="sales" hidden={view.form !== 'sales'}>
      {
        /* One intro for each set of departments. The script shows the
          intro of the chosen topic. */
      }
      {
        intros
          .filter((intro) => intro.formType === 'sales')
          .map((intro) => (
            <div class={s.talkIntro} data-intro={intro.key} hidden={intro.key !== currentIntro}>
              <h2 class="headline" tabindex="-1">
                {intro.title}
              </h2>
              <ContactPeople departments={intro.departments} />
              {intro.text && <p class:list={['body', s.talkText]}>{intro.text}</p>}
            </div>
          ))
      }
      <div class={s.talkForm}>
        <ContactForm {...contact.form} external idPrefix="sales">
          <input slot="extra" type="hidden" name="issueType" value="sales" />
          <div slot="extra" class={s.turnstile} data-turnstile></div>
        </ContactForm>
      </div>
    </div>
  </Section>
</topic-picker>

<script>
  import { actions } from 'astro:actions';
  import { connectExternalForm, savedAccountEmail } from '~/lib/externalForm';
  import { picker } from '~/data/support';
  import { WebComponent } from '~/lib/WebComponent';
  import { computeView, hasErrorId, parseTopicSlugs, type TopicMeta } from './_state';

  customElements.define(
    'topic-picker',
    class TopicPicker extends WebComponent {
      parsedCallback() {
        const metas: TopicMeta[] = JSON.parse(this.$('#topics-data').textContent ?? '[]');

        // The visitor asked for the form with the link, or with #form. A link
        // from the dashboard with an error ID also opens the form.
        let formRequested = window.location.hash === '#form' || hasErrorId(window.location.search);

        const cells = this.$$('a[data-topic-link]');
        const intros = this.$$('[data-intro]');
        const groups = this.$$('[data-subtopics]');
        const helpBand = this.$('[data-help-band]');
        const helps = this.$$('[data-topic]');
        const region = this.$('[data-form-region]');
        const forms = this.$$('[data-form-kind]');
        const support = this.$('[data-form-kind="support"]');
        const issueType = this.$<HTMLInputElement>(
          '[data-form-kind="support"] input[name="issueType"]',
        );
        const status = this.$('[data-status]');
        const titleOf = (slug: string | undefined) =>
          metas.find((meta) => meta.slug === slug)?.title ?? '';

        // After the choice of a topic, a screen reader reads what is now below.
        const announce = (view: ReturnType<typeof computeView>) => {
          const hasHelp = helps.some((help) => help.dataset.topic === view.leafSlug);
          const topic = titleOf(view.leafSlug);
          if (view.subtopicsOf && !view.subSlug) {
            status.textContent = picker.status.subtopics(titleOf(view.subtopicsOf));
          } else if (hasHelp && view.form) {
            status.textContent = picker.status.helpAndForm(topic);
          } else if (hasHelp) {
            status.textContent = picker.status.help(topic);
          } else if (view.form) {
            status.textContent = picker.status.form(topic);
          } else {
            status.textContent = '';
          }
        };

        const render = (scroll?: 'next' | 'form') => {
          const view = computeView(metas, parseTopicSlugs(window.location.search), formRequested);
          // The chosen cell of each grid is on the accent (TopicCell).
          for (const cell of cells) {
            const chosen = cell.dataset.level === '0' ? view.rootSlug : view.subSlug;
            const current = cell.dataset.topicLink === chosen;
            cell.toggleAttribute('aria-current', current);
            if (current) cell.setAttribute('aria-current', 'true');
            cell.classList.toggle('surfaceAccent', current);
          }
          for (const group of groups) group.hidden = group.dataset.subtopics !== view.subtopicsOf;
          let help: HTMLElement | undefined;
          for (const block of helps) {
            block.hidden = block.dataset.topic !== view.leafSlug;
            if (!block.hidden) help = block;
          }
          helpBand.hidden = !help;
          region.hidden = !view.form;
          for (const form of forms) form.hidden = form.dataset.formKind !== view.form;

          // The hidden field gives the auto-responder of the topic to the action.
          const leaf = metas.find((meta) => meta.slug === view.leafSlug);
          issueType.value = leaf?.responder ?? '';
          for (const intro of intros) intro.hidden = intro.dataset.intro !== leaf?.intro;

          // After a click, the page scrolls to the band that now follows, and
          // the focus goes to its title, thus the keyboard continues there.
          // 'next': the subtopics, else the help, else the form. 'form': the
          // form only (the link "Contact our support team", or #form).
          if (scroll) {
            const subtopics =
              view.subtopicsOf && !view.subSlug ? groups.find((group) => !group.hidden) : undefined;
            const form = view.form ? this.$(`[data-form-kind="${view.form}"]`) : undefined;
            const [band, block] =
              scroll === 'form'
                ? [region, form]
                : subtopics
                  ? [subtopics, subtopics]
                  : help
                    ? [helpBand, help]
                    : [region, form];
            if (block) {
              band.scrollIntoView({ behavior: 'smooth', block: 'start' });
              block
                .querySelector<HTMLElement>(':not([hidden]) > h2')
                ?.focus({ preventScroll: true });
            }
          }
          return view;
        };

        // A click on a cell changes the URL without a new load. The URL keeps
        // its other parameters (the fields that a link from the dashboard
        // fills). A click with a modifier key opens the link as usual.
        this.on(this, 'click', 'a[data-topic-link]', (event: MouseEvent, cell: HTMLElement) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          event.preventDefault();
          formRequested = false;
          const url = new URL(window.location.href);
          // The href of the cell has the full path of the topic (?topics=a/b).
          // The other parameters of the URL stay.
          const href = new URL(cell.getAttribute('href') ?? '', url);
          url.searchParams.set('topics', href.searchParams.get('topics') ?? '');
          url.hash = '';
          window.history.pushState({}, '', url);
          announce(render('next'));
        });

        this.on(this, 'click', '[data-open-form]', (event) => {
          event.preventDefault();
          formRequested = true;
          render('form');
        });

        window.addEventListener('popstate', () => render());
        // A link to #form after the load also opens the form.
        window.addEventListener('hashchange', () => {
          if (window.location.hash !== '#form') return;
          formRequested = true;
          render('form');
        });
        render(formRequested ? 'form' : undefined);

        // Fill the support form from the URL: a link from the dashboard can
        // carry the e-mail, the project, the subject, the text and an error ID.
        const params = new URLSearchParams(window.location.search);
        const fill = (name: string, value: string | null) => {
          const input = support.querySelector<HTMLInputElement | HTMLTextAreaElement>(
            `[name="${name}"]`,
          );
          if (input && value) input.value = value;
        };
        fill('email', params.get('email') || savedAccountEmail());
        fill('project', params.get('projectUrl'));
        fill('subject', params.get('subject'));
        fill('body', params.get('body'));
        fill('errorId', params.get('errorId'));

        for (const form of forms) {
          const kind = form.dataset.formKind;
          const contactForm = form.querySelector<HTMLElement>('[data-contact-form]');
          if (!contactForm) continue;
          connectExternalForm(contactForm, {
            // The same label as the action expects (isTurnstileTokenValid).
            turnstileAction: kind === 'support' ? 'support' : 'contact',
            fallback:
              kind === 'support'
                ? 'email us at support@datocms.com.'
                : 'email us at sales@datocms.com.',
            send: (formData) =>
              kind === 'support'
                ? actions.forms.submitSupportRequest.orThrow(formData)
                : actions.forms.submitSalesRequest.orThrow(formData),
          });
        }
      }
    },
  );
</script>
