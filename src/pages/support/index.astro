---
// The support page: a picker of topics, the help text of the topic and,
// when the topic needs it, a form. The topics come from the CMS. The URL
// holds the choice (?topics=a/b), thus a link can point to a topic. The
// forms send their data to the actions forms.submitSupportRequest and
// forms.submitSalesRequest, which give the next page (/support/thanks).
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { LogosLine } from '~/components/LogosLine';
import { Section } from '~/components/Section';
import { hero, logos, seo as supportSeo } from '~/data/support';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import TopicPicker from './_TopicPicker.astro';

const { topics } = await executeQuery(Astro, query);

if (topics.length === 0) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const seo = overrideSeo([], seoTitle(supportSeo.title));
---

<Layout theme="blue" seo={seo} headerVariant="accent">
  <Hero
    variant="accent"
    label={hero.label}
    headline={hero.headline}
    subheadline={hero.subheadline}
    face={hero.face}
    breakBeforeMuted
  />

  <Section>
    <TopicPicker topics={topics} />
  </Section>

  <Section flushTop>
    <LogosLine logos={logos.items} label={logos.label} marquee="overflow" />
  </Section>

  <DraftModeQueryListener query={query} />
</Layout>
