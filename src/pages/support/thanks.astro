---
// The page after a support request. The action forms.submitSupportRequest
// sends the visitor here.
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

const seo = overrideSeo([], seoTitle('Thanks for reaching out'));
---

<Layout theme="purple" seo={seo} headerVariant="accent">
  <Hero
    variant="accent"
    label="Support"
    headline="Thanks for reaching out."
    subheadline="We’re on it."
    face="grateful"
  />
  <ArticleBody tocTitle="On this page">
    <p>
      We have successfully received your request, and <strong
        >you will shortly receive an automated confirmation via email</strong
      >.
    </p>
    <p>We take great care of our customers. Our support team will be in touch shortly.</p>
    <p>
      In the meantime, you can look for answers in the{' '}
      <a href="/docs">documentation</a>, or in our{' '}
      <a href="https://community.datocms.com">community forum</a>.
    </p>
  </ArticleBody>
</Layout>
