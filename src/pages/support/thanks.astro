---
// The page after a support request. The action forms.submitSupportRequest
// sends the visitor here.
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

const seo = overrideSeo([], seoTitle('Success | Support page'));
---

<Layout seo={seo} theme="blue" headerVariant="light" footerTheme="blue">
  <Hero variant="light" label="Support page" headline="Thank you for reaching out!" />
  <ArticleBody tocTitle="On this page">
    <p>
      We have successfully received your request, and <strong
        >you will shortly receive an automated confirmation via email</strong
      >.
    </p>
    <p>
      We really try our best to take great care of our customers. Our support team will be in touch
      shortly!
    </p>
    <p>
      In the meantime you can perhaps look for answers in the{' '}
      <a href="/docs">documentation</a>, or in our awesome
      <a href="https://community.datocms.com">DatoCMS Community forum</a>?
    </p>
  </ArticleBody>
</Layout>
