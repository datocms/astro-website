---
// The page after a support request. The action forms.submitSupportRequest
// sends the visitor here. The row of people is the support team of
// ContactCard (contacts.ts), the same people as on the support form.
import { ArticleBody } from '~/components/ArticleBody';
import { ContactPeople } from '~/components/ContactPeople';
import { Hero } from '~/components/Hero';
import Layout from '~/layouts/Layout.astro';
import { replyTime } from '~/data/support';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

const seo = overrideSeo([], seoTitle('Thanks for reaching out'));
---

<Layout theme="purple" seo={seo} headerVariant="accent">
  <Hero
    variant="accent"
    label="Support"
    headline="Thanks for reaching out."
    subheadline="We’re on it."
    face="grateful"
  />
  <ArticleBody>
    <prose-island data-text-width>
      <ContactPeople departments={['support']} />
    </prose-island>
    <p>We have your request, and a copy is on its way to your inbox.</p>
    <p>Our support team reads it next. {replyTime}</p>
    <p>
      While you wait, the <a href="/docs">docs</a> and the{' '}
      <a href="https://community.datocms.com">community forum</a> may have the answer already.
    </p>
  </ArticleBody>
</Layout>
