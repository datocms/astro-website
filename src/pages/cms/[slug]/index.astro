---
// A framework page: DatoCMS with Next.js, Nuxt, SvelteKit or Astro. The
// copy comes from src/data/cms-<framework>.ts. Only the sites of the
// carousel and the review of the quote come from the CMS.
import { CardCarousel } from '~/components/CardCarousel';
import { CarouselCard } from '~/components/CarouselCard';
import { CategoryNav } from '~/components/CategoryNav';
import { ChapterHeader } from '~/components/ChapterHeader';
import { ChapterLayout } from '~/components/ChapterLayout';
import { CtaBanner } from '~/components/CtaBanner';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { PageCloser } from '~/components/PageCloser';
import { Quote } from '~/components/Quote';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { SceneFragment } from '~/components/SceneFragment';
import { SceneFrame } from '~/components/SceneFrame';
import { Section } from '~/components/Section';
import { Statement } from '~/components/Statement';
import * as cms from '~/data/cms';
import { page as astro } from '~/data/cms-astro';
import { page as nextjs } from '~/data/cms-nextjs';
import { page as nuxt } from '~/data/cms-nuxt';
import { page as sveltekit } from '~/data/cms-sveltekit';
import { waveVideo } from '~/data/videos';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import Deploys from '~/scenes/Automation/Deploys.astro';
import Hooks from '~/scenes/Automation/Hooks.astro';
import Wall from '~/scenes/Delivery/Wall.astro';
import { DynamicLayoutsScene } from '~/scenes/DynamicLayouts/DynamicLayouts';
import Ping from '~/scenes/Graphql/Ping.astro';
import Lab from '~/scenes/Images/Lab.astro';
import Stream from '~/scenes/RealTime/Stream.astro';
import { VisualEditingScene } from '~/scenes/VisualEditing/VisualEditing';
import { query } from './_graphql';

const fw = [nextjs, nuxt, sveltekit, astro].find((p) => p.slug === Astro.params.slug);

if (!fw) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const variables = { integrations: fw.integrations, reviewId: fw.reviewId };
const { integrations, review } = await executeQuery(Astro, query, { variables });

// The sites of the carousel: the websites and the showcase projects of all
// the integration records with a URL, newest first, each one once.
const sites = [
  ...new Map(
    integrations
      .flatMap((integration) => [...integration.websites, ...integration.showcaseProjects])
      .flatMap((site) => (site.url ? [[site.id, { ...site, url: site.url }] as const] : [])),
  ).values(),
]
  .sort((a, b) => b._createdAt.localeCompare(a._createdAt))
  .slice(0, 12);

// The host of a site, as the text under its name.
function host(url: string) {
  try {
    return new URL(url).host.replace(/^www\./, '');
  } catch {
    return url;
  }
}

const seo = overrideSeo([], seoTitle(fw.seo.title), seoDescription(fw.seo.description));
---

{
  /*
  One template for the four framework pages. The six chapters reuse the
  scenes of the pillars where the claim is the same: the Ping of
  /developers, the Lab of /media, the Sections field and the tab Visual of
  /editor-experience, the Stream of /developers with the code card of
  the framework. The last chapter is the Wall of /developers (a framework
  with a cache that takes tags) or the Hooks and Deploys of /developers
  (a framework without one).
*/
}
<Layout seo={seo} footerTheme="green">
  <Hero {...fw.hero} alignment="center" typewriter />
  <CategoryNav {...fw.chapterNav} />

  <ChapterLayout {...fw.fetch}>
    <SceneFragment slot="visual-1" fit="fill">
      <Ping />
    </SceneFragment>
  </ChapterLayout>

  <ChapterLayout {...fw.media}>
    <Fragment slot="scene">
      <SceneFrame preset="whole" theme={fw.media.theme}>
        <Lab />
      </SceneFrame>
    </Fragment>
  </ChapterLayout>

  <ChapterLayout {...fw.blocks}>
    <Fragment slot="scene">
      <SceneFrame preset="window" theme={fw.blocks.theme} height={540} zoom={1}>
        <DynamicLayoutsScene appearance={{ theme: fw.blocks.theme }} fields="sections" />
      </SceneFrame>
    </Fragment>
  </ChapterLayout>

  <ChapterLayout {...fw.drafts}>
    <Fragment slot="scene">
      <SceneFrame preset="fill" theme={fw.drafts.theme} height={640} zoom={1}>
        <VisualEditingScene appearance={{ theme: fw.drafts.theme }} chrome="app" height={1300} />
      </SceneFrame>
    </Fragment>
  </ChapterLayout>

  <ChapterLayout {...fw.realTime}>
    <Fragment slot="scene">
      <SceneFrame preset="whole" theme={fw.realTime.theme}>
        <Stream code={fw.liveCode} description={fw.realTime.scene} />
      </SceneFrame>
    </Fragment>
  </ChapterLayout>

  {
    fw.publishKind === 'cache-tags' ? (
      <ChapterLayout {...fw.publish}>
        <Fragment slot="scene">
          <SceneFrame preset="whole" theme={fw.publish.theme}>
            <Wall />
          </SceneFrame>
        </Fragment>
      </ChapterLayout>
    ) : (
      <ChapterLayout {...fw.publish}>
        <SceneFragment slot="visual-0" fit="fill">
          <Hooks />
        </SceneFragment>
        <SceneFragment slot="visual-1" fit="fill">
          <Deploys />
        </SceneFragment>
      </ChapterLayout>
    )
  }

  {
    sites.length > 0 && (
      <>
        <ChapterHeader {...fw.showcase} theme="green" />
        <Section theme="green" flushTop>
          <CardCarousel label={fw.showcase.label}>
            {sites.map((site) => (
              <CarouselCard href={site.url} title={site.title.trim()} external>
                {site.image?.responsiveImage && (
                  <ResponsiveImage slot="image" data={site.image.responsiveImage} />
                )}
                {host(site.url)}
              </CarouselCard>
            ))}
          </CardCarousel>
        </Section>
      </>
    )
  }

  <Statement {...cms.opinion} theme="green" variant="light" />
  <CtaBanner {...fw.starter} />
  <Quote review={review} fallback={fw.quote} theme="default" />
  <PageCloser theme="green" cta={cms.closer} video={waveVideo} />

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>

<script>
  import { initSceneSequences } from '~/lib/motion/sceneSequence';

  // The scenes with a sequence play it in view. The wall, the stream and
  // the lab have their own loops.
  initSceneSequences();
</script>
