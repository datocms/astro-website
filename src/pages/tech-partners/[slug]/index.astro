---
// The page of one technology partner: the logo, the short description,
// the description and the links to the website and to the contact email.
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import { Breadcrumb } from '~/components/Breadcrumb';
import { Button } from '~/components/Button';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { StructuredText } from '~/components/StructuredText';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { indexes } from '~/data/breadcrumbs';
import { techPartner } from '~/data/partners';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import {
  overrideSeo,
  seoDescription,
  seoGeneratedCard,
  seoOgType,
  seoPageTitle,
  seoShareTitle,
} from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import s from './_style.module.css';

const variables = { slug: Astro.params.slug! };
const { page } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

// The meta description is plain text. A partner with no short description has none.
const description = toPlainText(page.shortDescription);
---

<Layout
  theme="pink"
  seo={overrideSeo(
    page.seo,
    seoPageTitle(page.name, techPartner.seoSuffix),
    seoShareTitle(`DatoCMS Ecosystem Partner: ${page.name}`),
    description ? seoDescription(description) : null,
    seoGeneratedCard(Astro, {
      kicker: techPartner.kicker,
      title: page.name,
      excerpt: description,
      logoPngUrl: page.logo.pngUrl,
      theme: 'pink',
    }),
    seoOgType('website'),
  )}
  headerVariant="page"
>
  <Hero variant="page" label={techPartner.kicker} headline={page.name}>
    <div slot="intro">
      <StructuredText {...ensureValidStructuredTextProps({ data: page.shortDescription })} />
      <img
        class={s.logo}
        src={page.logo.url}
        alt={page.logo.alt || `${page.name} logo`}
        width={page.logo.width ?? undefined}
        height={page.logo.height ?? undefined}
      />
    </div>
  </Hero>
  <Breadcrumb trail={[indexes.techPartners]} current={page.name} />

  <Section>
    <div class={s.main}>
      <Prose>
        <StructuredText
          {...ensureValidStructuredTextProps({
            data: page.description,
            linkToRecordComponents: defaultLinkToRecordComponents,
            inlineRecordComponents: defaultInlineRecordComponents,
          })}
        />
      </Prose>
      <div class={s.actions}>
        <Button href={page.websiteUrl} attrs={{ target: '_blank' }}>
          {techPartner.visitWebsite}
        </Button>
        {
          page.publicContactEmail && (
            <Button
              href={`mailto:${page.publicContactEmail}`}
              variant="soft"
              attrs={{ target: '_blank' }}
            >
              {`${techPartner.contact} ${page.name}`}
            </Button>
          )
        }
      </div>
    </div>
  </Section>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
