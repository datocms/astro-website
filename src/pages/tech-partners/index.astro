---
// The list of the technology partners. The highlighted partners come
// first, then the other partners.
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { PartnerCard, PartnerGrid } from '~/components/PartnerCard';
import { Section } from '~/components/Section';
import { PlainText } from '~/components/StructuredText';
import { techIndex } from '~/data/partners';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForTechPartner } from '~/lib/datocms/gqlUrlBuilder/techPartner';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';

const { page, techPartners } = await executeQuery(Astro, query);

if (!page || techPartners.length === 0) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const isHighlighted = (partner: { slug: string }) =>
  page.highlightedPartners.some((h) => h.slug === partner.slug);

const sortedTechPartners = [
  ...techPartners.filter(isHighlighted),
  ...techPartners.filter((partner) => !isHighlighted(partner)),
];
---

<Layout theme="pink" seo={page.seo} headerVariant="page">
  <Hero
    variant="page"
    label={techIndex.hero.label}
    headline={techIndex.hero.headline}
    subheadline={techIndex.hero.subheadline}
  >
    <p slot="intro">{techIndex.hero.intro}</p>
  </Hero>

  <Section>
    <PartnerGrid>
      {
        sortedTechPartners.map((partner) => (
          <li>
            <PartnerCard href={buildUrlForTechPartner(partner)} name={partner.name}>
              <PlainText data={partner.shortDescription} />
            </PartnerCard>
          </li>
        ))
      }
    </PartnerGrid>
  </Section>

  <DraftModeQueryListener query={query} />
</Layout>
