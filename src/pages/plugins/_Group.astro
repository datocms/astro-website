---
// A group of plugins on the index: a heading, an optional link to the full
// list, and the plugins in the slot.
import { faArrowRight } from '@fortawesome/pro-regular-svg-icons';
import { Icon } from '~/components/Icon';
import { Section } from '~/components/Section';
import s from './_style.module.css';

interface Props {
  title: string;
  /** The address of the full list. It shows with `count`. */
  href?: string;
  count?: number;
  flushTop?: boolean;
  /**
   * The section has no side padding and no max width: the slot goes from
   * edge to edge of the page (for a CardCarousel with `bleed`). The header
   * stays in the centred column.
   */
  bleed?: boolean;
}

const { title, href, count, flushTop = true, bleed = false } = Astro.props;
---

<Section flushTop={flushTop} padding={bleed ? 'none' : 'default'}>
  <div class:list={[s.groupHeader, bleed && s.groupHeaderInset]}>
    <h2 class="title">{title}</h2>
    {
      href && (
        <a href={href} class:list={[s.viewAll, 'labelMedium']}>
          <span>View all ({count})</span>
          <Icon icon={faArrowRight} />
        </a>
      )
    }
  </div>
  <slot />
</Section>
