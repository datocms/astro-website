---
// A group of plugins on the index: a heading, an optional link to the full
// list, and the plugins in the slot.
import { Section } from '~/components/Section';
import { groups } from '~/data/plugins';
import ViewAll from './_ViewAll.astro';
import s from './_style.module.css';

interface Props {
  title: string;
  /** The address of the full list. It shows with `count`. */
  href?: string;
  count?: number;
  flushTop?: boolean;
  /**
   * The section has no side padding and no max width: the slot goes from
   * edge to edge of the page (for a CardCarousel with `bleed`). The header
   * stays in the centred column.
   */
  bleed?: boolean;
  /** The ground of the band. The collections share one tinted band. */
  background?: 'default' | 'accent-faint';
}

const { title, href, count, flushTop = true, bleed = false, background = 'default' } = Astro.props;
---

<Section flushTop={flushTop} padding={bleed ? 'none' : 'default'} background={background}>
  <div class:list={[s.groupHeader, bleed && s.groupHeaderInset]}>
    <h2 class="title">{title}</h2>
    {
      href && (
        <ViewAll
          href={href}
          label={count === undefined ? groups.viewAll : `${groups.viewAll} (${count})`}
        />
      )
    }
  </div>
  <slot />
</Section>
