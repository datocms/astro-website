---
// The README of a plugin on the README sheet. The author of the plugin
// writes it, not us: the byline says who wrote it. Without a README, the
// sheet links to the package on npm.
import { ReadmeSheet } from '~/components/ReadmeSheet';
import { detail } from '~/data/plugins';

interface Props {
  /** The HTML from prepareReadme(). Empty when the plugin has no README. */
  html: string;
  packageName: string;
  version: string;
  author: string;
  official: boolean;
}

const { html, packageName, version, author, official } = Astro.props;
const copy = detail.readme;
---

<ReadmeSheet html={html} source={`${packageName}@${version}`}>
  <Fragment slot="byline">
    {
      official ? (
        copy.official
      ) : (
        <>
          {copy.writtenBy} <strong>{author}</strong>, {copy.notUs}
        </>
      )
    }
  </Fragment>
  <Fragment slot="empty">
    <p class="body">{copy.empty}</p>
    <a
      class="label"
      href={`https://www.npmjs.com/package/${packageName}`}
      target="_blank"
      rel="noreferrer"
    >
      {copy.emptyLinks} →
    </a>
  </Fragment>
</ReadmeSheet>
