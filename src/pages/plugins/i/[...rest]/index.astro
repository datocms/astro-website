---
// The page of one plugin: the title, the description, the install link, the
// preview, the README and the facts about the plugin (publisher, homepage,
// package, version, installs, last update).
import xss from 'xss';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Fact, Facts } from '~/components/Facts';
import { Button } from '~/components/Button';
import { Hero } from '~/components/Hero';
import { Markdown } from '~/components/Markdown';
import { OfficialBadge } from '~/components/PluginCard';
import { Prose } from '~/components/Prose';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { Section } from '~/components/Section';
import { Breadcrumb } from '~/components/Breadcrumb';
import { indexes } from '~/data/breadcrumbs';
import { detail } from '~/data/plugins';
import Layout from '~/layouts/Layout.astro';
import { dashboardUrl } from '~/lib/datocms/dashboardUrl';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoOgType } from '~/lib/datocms/seo';
import { formatLongDate } from '~/lib/format/date';
import { getGravatarUrl } from '~/lib/gravatar';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import s from './_style.module.css';

const variables = {
  slug: Astro.params.rest!,
};

const { page } = await executeQuery(Astro, query, { variables });

if (!page || !page.readme) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const avatarUrl = getGravatarUrl(page.author.email);
const video = page.previewImage?.video;
---

<Layout theme="purple" seo={overrideSeo(page.seo, seoOgType('website'))} headerVariant="accent">
  <Hero variant="accent" headline={page.title} subheadline={page.description}>
    <div slot="intro" class={s.intro}>
      {
        page.author.official && (
          <p class:list={[s.officialNote, 'labelMedium']}>
            <OfficialBadge size={20} />
            {detail.officialBadge}
          </p>
        )
      }
      <set-plugin-install-url data-package-name={page.packageName}>
        <Button href={dashboardUrl()} attrs={{ target: '_blank' }}>
          {detail.install}
        </Button>
      </set-plugin-install-url>
    </div>
  </Hero>
  <Breadcrumb trail={[indexes.plugins]} current={page.title} />

  <Section>
    <div class={s.grid}>
      <div class={s.media}>
        {
          page.previewImage?.responsiveImage && (
            <div class={s.preview}>
              <ResponsiveImage data={page.previewImage.responsiveImage} />
            </div>
          )
        }

        {
          video && (
            <figure class={s.preview}>
              <video
                controls
                playsinline
                preload="none"
                poster={video.thumbnailUrl}
                width={video.width}
                height={video.height}
                aria-label={video.alt ?? video.title ?? undefined}
                style={{
                  aspectRatio: `${video.width} / ${video.height}`,
                  background: video.blurUpThumb
                    ? `center / cover url("${video.blurUpThumb}")`
                    : undefined,
                }}
              >
                <source src={video.streamingUrl} type="application/vnd.apple.mpegurl" />
                {video.mp4Url && <source src={video.mp4Url} type="video/mp4" />}
              </video>
              {video.title && <figcaption class="caption">{video.title}</figcaption>}
            </figure>
          )
        }

        <a href={detail.noteHref} class:list={[s.note, 'body']}>
          <strong>{page.author.official ? detail.officialNote : detail.communityNote}</strong>{' '}
          {detail.noteBody}
        </a>
      </div>

      <aside class={s.aside}>
        {
          page.coverImage && (
            <div class={s.cover}>
              <ResponsiveImage data={page.coverImage.responsiveImage} />
            </div>
          )
        }

        <set-plugin-install-url class={s.asideInstall} data-package-name={page.packageName}>
          <Button href={dashboardUrl()} attrs={{ target: '_blank' }}>
            {detail.install}
          </Button>
        </set-plugin-install-url>

        <Facts>
          <Fact label="Publisher">
            <span class={s.publisher}>
              <img src={avatarUrl} alt="" width="24" height="24" />
              <span>{page.author.name}</span>
            </span>
          </Fact>
          {
            page.homepage && (
              <Fact label="Homepage">
                <a href={page.homepage} target="_blank" rel="noreferrer">
                  Visit homepage
                </a>
              </Fact>
            )
          }
          <Fact label="Package">
            <a
              href={`https://www.npmjs.com/package/${page.packageName}`}
              target="_blank"
              rel="noreferrer"
            >
              Visit npm
            </a>
          </Fact>
          <Fact label="Current version" tabular>{page.version}</Fact>
          <Fact label="Install count" tabular>{page.installs.toLocaleString('en-US')}</Fact>
          <Fact label="Last update" tabular>
            <time datetime={page.lastUpdate}>{formatLongDate(page.lastUpdate)}</time>
          </Fact>
        </Facts>
      </aside>

      <div class={s.readme}>
        <Prose>
          <Markdown of={xss(page.readme)} />
        </Prose>
      </div>
    </div>
  </Section>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  // Points the install link to the project of the visitor. The index page
  // saves the project in the session when the dashboard opens it.
  window.customElements.define(
    'set-plugin-install-url',
    class SetPluginInstallUrl extends WebComponent {
      parsedCallback() {
        const packageName = this.dataset?.packageName;
        const linkEl = this.$('a');
        const project = this.getProject();

        const url = project
          ? `https://${project.domain}${project.environment ? `/environments/${project.environment}` : ''}/configuration/plugins/install/${packageName}`
          : `${linkEl.getAttribute('href')}projects/redirect-to-project?preference=login&path=/configuration/plugins/install/${packageName}`;

        linkEl.setAttribute('href', url);
      }

      getProject() {
        const value = sessionStorage.getItem('pluginsProject');

        if (!value) {
          return undefined;
        }

        try {
          return JSON.parse(value) as { domain: string; environment: string | undefined };
        } catch {
          return undefined;
        }
      }
    },
  );
</script>
