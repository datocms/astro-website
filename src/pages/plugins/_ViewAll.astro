---
// The link from a group of plugins to a full list: a label and an arrow
// that moves on hover.
import { ArrowRight } from 'lucide';
import { Icon } from '~/components/Icon';
import s from './_style.module.css';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a href={href} class:list={[s.viewAll, 'labelMedium']}>
  <span class="capTrim">{label}</span>
  <Icon icon={ArrowRight} />
</a>
