---
// The index of the plugins: the search, the plugins that the editors
// picked, the most popular, the official ones, the collections and the
// newest. The "View all" links go to the list of all plugins.
import { CardCarousel } from '~/components/CardCarousel';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { PluginCard } from '~/components/PluginCard';
import { Section } from '~/components/Section';
import { groups, hero } from '~/data/plugins';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import SearchBox from './_SearchBox.astro';
import Group from './_Group.astro';
import { officialPluginsQuery, query } from './_graphql';
import s from './_style.module.css';

const { page, collections, meta, popular, latest, officialAuthors } = await executeQuery(
  Astro,
  query,
);

if (!page || popular.length === 0 || latest.length === 0 || collections.length === 0) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { official, officialMeta } = await executeQuery(Astro, officialPluginsQuery, {
  variables: { authorIds: officialAuthors.map((author) => author.id) },
});
---

<Layout seo={page.seo} theme="orange" headerVariant="light" footerTheme="orange">
  <Hero variant="light" {...hero} />

  <Section>
    <SearchBox />
  </Section>

  <Group title={groups.highlighted}>
    <ul class={s.highlighted}>
      {
        page.highlighted.map((item) => (
          <li>
            <PluginCard plugin={item} />
          </li>
        ))
      }
    </ul>
  </Group>

  <Group title={groups.popular} href="/plugins/browse?sort=popular" count={meta.count}>
    <ul class={s.list}>
      {
        popular.map((item) => (
          <li>
            <PluginCard plugin={item} orientation="horizontal" />
          </li>
        ))
      }
    </ul>
  </Group>

  {
    official.length > 0 && (
      <Group
        title={groups.official}
        href="/plugins/browse?official=true"
        count={officialMeta.count}
      >
        <ul class={s.list}>
          {official.map((item) => (
            <li>
              <PluginCard plugin={item} orientation="horizontal" />
            </li>
          ))}
        </ul>
      </Group>
    )
  }

  {
    collections.map((collection) => (
      <Group title={collection.title}>
        <CardCarousel label={collection.title}>
          {collection.plugins.map((item) => (
            <div role="listitem">
              <PluginCard plugin={item} />
            </div>
          ))}
        </CardCarousel>
      </Group>
    ))
  }

  <Group title={groups.latest}>
    <ul class={s.list}>
      {
        latest.map((item) => (
          <li>
            <PluginCard plugin={item} orientation="horizontal" />
          </li>
        ))
      }
    </ul>
  </Group>

  <DraftModeQueryListener query={query} />
</Layout>

<script>
  // The dashboard can open this page with a project. The plugin pages read
  // the project from the session, to build the install link.
  const urlParams = new URLSearchParams(window.location.search);
  const projectDomain = urlParams.get('projectDomain');
  const projectEnvironment = urlParams.get('projectEnvironment');

  if (projectDomain) {
    sessionStorage.setItem(
      'marketplaceProject',
      JSON.stringify({ domain: projectDomain, environment: projectEnvironment }),
    );
  }
</script>
