---
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import FeedPage from '../../../../_FeedPage.astro';
import { feedBaseUrl, loadFeedPage, parsePageIndex, type FeedFilter } from '../../../../_feed';

const filter: FeedFilter = { kind: 'category', slug: Astro.params.slug! };

const page = parsePageIndex(Astro.params.pageIndex);
if (page === 'redirect') return Astro.redirect(feedBaseUrl(filter), 301);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const feed = await loadFeedPage(Astro, page, filter);
if (!feed) {
  // A page past the last one goes to the category. A category that does not exist has no first page.
  if (await loadFeedPage(Astro, 1, filter)) return Astro.redirect(feedBaseUrl(filter), 301);
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}
---

<FeedPage feed={feed} />
