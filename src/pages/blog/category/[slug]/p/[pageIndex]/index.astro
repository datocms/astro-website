---
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { readPageIndex, redirectToFirstPage } from '~/lib/pageIndex';
import FeedPage from '../../../../_FeedPage.astro';
import { feedBaseUrl, loadFeedPage, type FeedFilter } from '../../../../_feed';

const filter: FeedFilter = { kind: 'category', slug: Astro.params.slug! };

const page = readPageIndex(Astro, feedBaseUrl(filter));
if (page instanceof Response) return page;

const feed = await loadFeedPage(Astro, page, filter);
// A page past the last one goes to the category. A category that does not
// exist, or has no posts, gives 404: its first page gives 404 too.
if (feed === 'past-end') return redirectToFirstPage(Astro, feedBaseUrl(filter));
if (!feed) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}
---

<FeedPage feed={feed} />
