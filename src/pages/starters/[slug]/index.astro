---
// The page of one starter: the title, the description, the link that
// starts a free project, the screenshots, the README and the facts about
// the starter (technology, publisher, preview, GitHub repository). The
// manifest in the GitHub repository gives the preview address.
import ky from 'ky';
import { Button } from '~/components/Button';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { Markdown } from '~/components/Markdown';
import { Prose } from '~/components/Prose';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { Section } from '~/components/Section';
import { detail } from '~/data/starters';
import Layout from '~/layouts/Layout.astro';
import { dashboardUrl } from '~/lib/datocms/dashboardUrl';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoOgType } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import s from './_style.module.css';
import { normalizeManifest, type RawManifest } from './_utils';

const variables = { slug: Astro.params.slug! };
const { page } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const parts = page.githubRepo.split(':');

if (parts.length === 1) {
  parts.push('master');
}

const manifest = normalizeManifest(
  await ky<RawManifest>(`https://raw.githubusercontent.com/${parts.join('/')}/datocms.json`).json(),
  parts[0]!,
  parts[1]!,
);

const githubRepoWebUrl = `https://www.github.com/${page.githubRepo.replace(':', '/tree/')}`;
const datoDeployUrl = dashboardUrl(`/deploy?repo=${page.githubRepo}`);
---

<Layout
  seo={overrideSeo(page.seo, seoOgType('website'))}
  seoAnalysis={page.yoastAnalysis}
  theme="orange"
  headerVariant="light"
  footerTheme="orange"
>
  <Hero
    variant="light"
    label={page.seoH1 ?? undefined}
    headline={page.name}
    subheadline={page.cmsDescription}
  >
    <div slot="intro">
      <Button href={datoDeployUrl} appearance="deep-on-light" attrs={{ target: '_blank' }}>
        {detail.start}
      </Button>
    </div>
  </Hero>

  <Section>
    <div class={s.grid}>
      <div class={s.content}>
        <div class={s.slides}>
          <div class={s.slide}>
            <ResponsiveImage data={page.screenshot.responsiveImage} />
          </div>
          <div class={s.slide}>
            <ResponsiveImage data={page.backendScreenshot.responsiveImage} />
          </div>
        </div>

        <a href={detail.note.href} class:list={[s.note, 'body']}>
          <strong>{detail.note.lead}</strong>{' '}{detail.note.body}
        </a>

        {
          page.readme && (
            <Prose>
              <Markdown of={page.readme} />
            </Prose>
          )
        }
      </div>

      <aside class={s.aside}>
        <img
          class={s.technology}
          src={page.technology.logo.url}
          alt={page.technology.logo.alt ?? page.technology.name}
          width={page.technology.logo.width ?? undefined}
          height={page.technology.logo.height ?? undefined}
        />

        <Button href={datoDeployUrl} appearance="deep-on-light" attrs={{ target: '_blank' }}>
          {detail.start}
        </Button>

        <dl class={s.facts}>
          <div class={s.fact}>
            <dt class="subtitleMedium">Publisher</dt>
            <dd class="body">DatoCMS</dd>
          </div>

          {
            manifest.livePreviewUrl && (
              <div class={s.fact}>
                <dt class="subtitleMedium">Preview URL</dt>
                <dd class="body">
                  <a href={manifest.livePreviewUrl} target="_blank" rel="noreferrer">
                    Visit preview website
                  </a>
                </dd>
              </div>
            )
          }

          <div class={s.fact}>
            <dt class="subtitleMedium">GitHub repo</dt>
            <dd class="body">
              <a href={githubRepoWebUrl} target="_blank" rel="noreferrer">
                {page.githubRepo.split(':')[0]}
              </a>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </Section>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
