---
// The index of the starters: the demos with all the features, then the
// starter kits for each framework.
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { Section } from '~/components/Section';
import {
  fullyFledged as demosCopy,
  hero,
  seo as startersSeo,
  techStarters as kitsCopy,
} from '~/data/starters';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import StarterCard from './_StarterCard.astro';
import s from './_style.module.css';

const { starters } = await executeQuery(Astro, query);

if (!starters) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const demos = starters.filter((starter) => starter.starterType === 'fully_fledged');
const kits = starters.filter((starter) => starter.starterType === 'tech_starter');

const seo = overrideSeo([], seoTitle(startersSeo.title));
---

<Layout theme="blue" seo={seo} headerVariant="accent">
  <Hero variant="accent" {...hero} />

  <Section>
    <div class={s.intro}>
      <h2 class="title">{demosCopy.headline}</h2>
      <p class="bodyLong" set:html={demosCopy.body} />
    </div>
    <ul class={s.demos}>
      {
        demos.map((starter) => (
          <li>
            <StarterCard starter={starter} variant="demo" />
          </li>
        ))
      }
    </ul>
  </Section>

  {
    kits.length > 0 && (
      <Section flushTop>
        <div class={s.intro}>
          <h2 class="title">{kitsCopy.headline}</h2>
          <p class="bodyLong" set:html={kitsCopy.body} />
        </div>
        <ul class={s.kits}>
          {kits.map((starter) => (
            <li>
              <StarterCard starter={starter} variant="kit" />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <DraftModeQueryListener query={query} />
</Layout>
