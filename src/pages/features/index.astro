---
// The features index. The hero, the groups, the buddy and
// the closer come from src/data/features.ts. The SEO and the features of
// the groups come from the CMS record `featuresIndex`.
import type { ResultOf } from 'gql.tada';
import type { SoftwareApplication, WithContext } from 'schema-dts';
import { CategoryNav } from '~/components/CategoryNav';
import { DraftModeQueryListener } from '~/components/legacy/DraftModeQueryListener';
import { FeatureCategory } from '~/components/FeatureCategory';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/legacy/JsonLd';
import { ListBuddy } from '~/components/ListBuddy';
import { PageCloser } from '~/components/PageCloser';
import * as features from '~/data/features';
import { danceVideo } from '~/data/videos';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { baseUrl } from '~/lib/draftMode';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';

type Page = NonNullable<ResultOf<typeof query>['page']>;
type GroupField = Exclude<keyof Page, '_seoMetaTags'>;

/**
 * The 9 groups of the CMS record, in the order of the page. `title` is the
 * title of the group in src/data/features.ts. `legacyId` is the anchor that
 * former links use for the group (the slug of its former title).
 */
const groups: { field: GroupField; title: string; legacyId: string }[] = [
  { field: 'coreFeaturesBlocks', title: 'Core Features', legacyId: 'core-features' },
  { field: 'editorExperienceBlocks', title: 'Editor Experience', legacyId: 'editor-experience' },
  {
    field: 'developerExperienceBlocks',
    title: 'Developer Experience',
    legacyId: 'developer-experience',
  },
  {
    field: 'imageVideoManagementBlocks',
    title: 'Image & Video Management',
    legacyId: 'image-video-management',
  },
  { field: 'localizationBlocks', title: 'Localization', legacyId: 'localization' },
  { field: 'extensibilityBlocks', title: 'Extensibility', legacyId: 'extensibility' },
  { field: 'contentIntegrityBlocks', title: 'Content Integrity', legacyId: 'content-integrity' },
  {
    field: 'governanceAndComplianceBlocks',
    title: 'Governance & Compliance',
    legacyId: 'governance-compliance',
  },
  {
    field: 'securityAndInfrastructureBlocks',
    title: 'Security & Infrastructure',
    legacyId: 'security-infrastructure',
  },
];

function findCategory(title: string) {
  const category = features.categories.find((c) => c.title === title);
  if (!category) throw new Error(`No group with the title "${title}"`);
  return category;
}

// The former anchors of the groups that differ from the current anchors.
const legacyAnchors: Record<string, string> = {};
for (const { title, legacyId } of groups) {
  const { id } = findCategory(title);
  if (id !== legacyId) legacyAnchors[legacyId] = id;
}

const { page } = await executeQuery(Astro, query);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const categories = groups.map(({ field, title }) => ({
  ...findCategory(title),
  entries: page[field].filter((block) => block.__typename === 'FeatureRegularCardRecord'),
}));
const last = categories.length - 1;
// The score of the CategoryNav: the number of features on the page.
const total = categories.reduce((n, c) => n + c.entries.length, 0);

const jsonLd: WithContext<SoftwareApplication> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DatoCMS',
  applicationCategory: 'WebApplication',
  operatingSystem: 'Web',
  url: new URL(Astro.url.pathname, baseUrl(Astro)).href,
  description: extractFromSeoTags(page._seoMetaTags).description,
};
---

<Layout seo={page._seoMetaTags} theme="green" footerTheme="blue">
  <JsonLd slot="head" data={jsonLd} />
  <Fragment slot="head">
    {/* Some groups had other anchors. Send a link with a former anchor to the current anchor. */}
    <script is:inline define:vars={{ anchors: legacyAnchors }}>
      const target = anchors[location.hash.slice(1)];
      if (target) addEventListener('DOMContentLoaded', () => location.replace(`#${target}`));
    </script>
  </Fragment>

  <Hero {...features.hero} alignment="center" typewriter />
  <CategoryNav {...features.categoryNav} theme="blue" total={total} />
  <ListBuddy {...features.buddy}>
    {
      categories.map((category, i) => (
        <FeatureCategory {...category} open={i === last ? features.openSlot : undefined} />
      ))
    }
  </ListBuddy>
  <PageCloser theme="blue" cta={features.ctaStart} video={danceVideo} />

  <DraftModeQueryListener query={query} />
</Layout>
