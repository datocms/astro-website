---
import * as productUpdates from '~/data/product-updates';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import IndexPage from '../../_IndexPage.astro';
import { legacyLastPage, pageQuery } from './_graphql';

const param = Astro.params.pageIndex ?? '';
const page = /^[1-9]\d*$/.test(param) ? Number.parseInt(param, 10) : null;

// Page 1 is /product-updates.
if (page === 1) return Astro.redirect('/product-updates', 301);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { perPage } = productUpdates;
const variables = { first: perPage, skip: (page - 1) * perPage };
const data = await executeQuery(Astro, pageQuery, { variables });

if (data.entries.length === 0) {
  const lastPage = Math.ceil(data.meta.count / perPage);
  if (page <= legacyLastPage && lastPage > 0) {
    return Astro.redirect(
      lastPage > 1 ? `/product-updates/p/${lastPage}` : '/product-updates',
      301,
    );
  }
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}
---

<IndexPage page={page} data={data} variables={variables} />
