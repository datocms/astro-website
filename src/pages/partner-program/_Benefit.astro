---
import type { Benefit } from '~/data/partner-program';
import s from './_style.module.css';

type Props = Benefit;

const { title, body, link } = Astro.props;
---

<li class={s.benefit}>
  <h3 class="h2">{title}</h3>
  <p class:list={[s.text, 'body']} set:html={body} />
  {
    link && (
      <p class="bodyMedium">
        <a class={s.link} href={link.href}>
          {link.label}
        </a>
      </p>
    )
  }
</li>
