---
// The agency partner program page. The CMS gives the logos of the
// highlighted partners and the testimonials. The form sends its data to the
// action forms.submitPartnerProgramRequest, then goes to
// /partner-program/thanks. The SEO is static: the page has no CMS record.
import { stripStega } from '@datocms/astro';
import { ContactForm } from '~/components/ContactForm';
import { CtaBanner } from '~/components/CtaBanner';
import { Headline } from '~/components/Headline';
import { Hero } from '~/components/Hero';
import { LogosLine, type LogoItem } from '~/components/LogosLine';
import { Section } from '~/components/Section';
import { Step, Steps } from '~/components/Steps';
import { ButtonGroup } from '~/components/ButtonGroup';
import { QuoteGrid } from '~/components/Quote';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import {
  benefits,
  form,
  hero,
  logos,
  plans,
  seo as partnerSeo,
  steps,
  talk,
  testimonials,
} from '~/data/partner-program';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import Benefit from './_Benefit.astro';
import { query } from './_graphql';
import s from './_style.module.css';

const { partnerTestimonials, page } = await executeQuery(Astro, query);

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const seo = overrideSeo([], seoTitle(partnerSeo.title));

const partnerLogos: LogoItem[] = page.highlightedPartners.slice(0, 7).map((partner) => ({
  mask: partner.logo.url,
  alt: stripStega(partner.logo.alt || partner.name),
  width: partner.logo.width ?? 0,
  height: partner.logo.height ?? 0,
}));
---

<Layout theme="blue" seo={seo} headerVariant="accent">
  <Hero
    variant="accent"
    label={hero.label}
    headline={hero.headline}
    subheadline={hero.subheadline}
    buttons={[{ ...hero.button, appearance: 'deep-on-light' }]}
  />

  <Section>
    <div class={s.logos}>
      <p class:list={['subtitleMedium', s.logosLabel]}>{logos.label}</p>
      <LogosLine logos={partnerLogos} label={logos.label} marquee="overflow" />
    </div>
  </Section>

  <Section flushTop>
    <div class={s.benefits}>
      <Headline as="h2" size="h1" muted={benefits.muted}>{benefits.headline}</Headline>
      <ul class={s.benefitList}>
        {benefits.items.map((benefit) => <Benefit {...benefit} />)}
      </ul>
    </div>
  </Section>

  {
    partnerTestimonials.length > 0 && (
      <QuoteGrid items={partnerTestimonials}>
        <ButtonGroup slot="footer" buttons={[testimonials.button]} />
      </QuoteGrid>
    )
  }

  <CtaBanner
    variant={plans.variant}
    headline={plans.headline}
    muted={plans.muted}
    subline={plans.subline}
    buttons={[{ ...plans.button, appearance: 'deep-on-light' }]}
  />

  <Steps title={steps.title} muted={steps.muted}>
    {steps.items.map((step) => <Step title={step.title}>{step.text}</Step>)}
  </Steps>

  <Section id="partner-form">
    <div class={s.talk}>
      <Headline as="h2" size="h1" muted={talk.muted}>{talk.headline}</Headline>
      <partner-form class={s.form}>
        <ContactForm {...form} external>
          <div slot="extra" class={s.turnstile} data-turnstile></div>
        </ContactForm>
      </partner-form>
    </div>
  </Section>

  <DraftModeQueryListener query={query} />
</Layout>

<script>
  import { actions } from 'astro:actions';
  import { connectExternalForm, fillAccountEmail } from '~/lib/externalForm';
  import { WebComponent } from '~/lib/WebComponent';

  // <partner-form> connects the contact form inside it to the action
  // forms.submitPartnerProgramRequest.
  customElements.define(
    'partner-form',
    class PartnerForm extends WebComponent {
      parsedCallback() {
        const root = this.$('[data-contact-form]');

        fillAccountEmail(this.$<HTMLInputElement>('input[name="email"]'));

        connectExternalForm(root, {
          // The same label as the action expects (isTurnstileTokenValid).
          turnstileAction: 'partner-program',
          fallback: 'email us at support@datocms.com.',
          send: (formData) => actions.forms.submitPartnerProgramRequest.orThrow(formData),
        });
      }
    },
  );
</script>
