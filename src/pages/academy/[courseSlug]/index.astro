---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { CourseVideo } from '~/components/CourseVideo';
import { Hero } from '~/components/Hero';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { StructuredText } from '~/components/StructuredText';
import { JsonLd } from '~/components/JsonLd';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import Layout from '~/layouts/Layout.astro';
import { readFragment } from '~/lib/datocms/graphql';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForAcademyChapter } from '~/lib/datocms/gqlUrlBuilder/academyChapter';
import { AcademyCourseUrlFragment } from '~/lib/datocms/gqlUrlBuilder/academyCourse';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { baseUrl } from '~/lib/draftMode';
import { courseId, publisherRef } from '~/lib/jsonLd';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import s from './_style.module.css';
import { query } from './_graphql';

const variables = { courseSlug: Astro.params.courseSlug! };

const { course } = await executeQuery(Astro, query, { variables });

if (!course) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { slug } = readFragment(AcademyCourseUrlFragment, course);
const pageUrl = new URL(Astro.url.pathname, baseUrl(Astro)).href;
---

<Layout seo={course.seo} theme="green" headerVariant="light" footerTheme="green">
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Course',
        '@id': courseId(baseUrl(Astro), variables.courseSlug),
        name: course.name,
        url: pageUrl,
        description: extractFromSeoTags(course.seo).description,
        image: extractFromSeoTags(course.seo).image,
        provider: publisherRef(baseUrl(Astro)),
        isAccessibleForFree: true,
        offers: {
          '@type': 'Offer',
          price: 0,
          priceCurrency: 'EUR',
        },
        hasCourseInstance: {
          '@type': 'CourseInstance',
          courseMode: 'online',
          courseWorkload: 'PT2H',
        },
        hasPart: course.chapters.map((chapter) => ({
          '@type': 'CreativeWork',
          name: chapter.title,
          url: new URL(buildUrlForAcademyChapter(chapter), baseUrl(Astro)).href,
        })),
      }}
    />
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'DatoCMS Academy',
            item: new URL('/academy', baseUrl(Astro)).href,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: course.name,
            item: pageUrl,
          },
        ],
      }}
    />
  </Fragment>
  <Hero variant="light" label="DatoCMS Academy" labelHref="/academy" headline={course.name}>
    <Prose slot="intro">
      <StructuredText {...ensureValidStructuredTextProps({ data: course.introduction })} />
    </Prose>
  </Hero>
  <Section contentClass={s.layout}>
    <CourseVideo slug={slug} class={s.video} />
    <ol class={s.chapters}>
      {
        course.chapters.map((chapter, index) => (
          <li class={s.chapter}>
            <span class:list={[s.chapterNumber, 'subtitleMedium']}>
              {String(index + 1).padStart(2, '0')}
            </span>
            <a class:list={[s.chapterLink, 'h2']} href={buildUrlForAcademyChapter(chapter)}>
              {chapter.title}
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
