---
import type { Heading as HeadingNode } from 'datocms-structured-text-utils';
import { Heading } from '~/components/Heading';
import { headingAnchor } from '~/lib/academyAnchors';

interface Props {
  node: HeadingNode;
}

const { node } = Astro.props;
---

<Heading as={`h${node.level}`} anchor={headingAnchor(node)}><slot /></Heading>
