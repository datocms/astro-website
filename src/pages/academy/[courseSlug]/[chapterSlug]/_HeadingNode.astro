---
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import type { Heading } from 'datocms-structured-text-utils';
import { HeadingAnchor } from '~/components/HeadingAnchor';
import { headingAnchor } from '~/lib/academyAnchors';

interface Props {
  node: Heading;
}

const { node } = Astro.props;
const Tag = `h${node.level}` as const;
const anchor = headingAnchor(node);
---

{/* The anchor is unique in the page: two equal headings get a number. */}
<Tag id={anchor}><slot /><HeadingAnchor id={anchor} text={toPlainText(node) ?? ''} /></Tag>
