---
import type { Heading } from 'datocms-structured-text-utils';
import { headingAnchor } from '~/lib/academyAnchors';
import s from './_style.module.css';

interface Props {
  node: Heading;
}

const { node } = Astro.props;
const Tag = `h${node.level}` as const;
const anchor = headingAnchor(node);
---

{/* The anchor is unique in the page: two equal headings get a number. */}
<Tag id={anchor}>
  <slot />
  <a class={s.permalink} href={`#${anchor}`} aria-label="Link to this section"></a>
</Tag>
