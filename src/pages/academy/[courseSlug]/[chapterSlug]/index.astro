---
import { PrevNext } from '~/components/PrevNext';
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import findIndex from 'lodash-es/findIndex';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { notFoundResponse, avoidAstroTypeCheckBug } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import { assignHeadingAnchors } from '~/lib/academyAnchors';
import { type StructuredTextDocument } from 'datocms-structured-text-to-plain-text';
import { ArticleBody } from '~/components/ArticleBody';
import { Breadcrumb } from '~/components/Breadcrumb';
import { CourseOutline } from '~/components/CourseOutline';
import { Hero } from '~/components/Hero';
import { Prose } from '~/components/Prose';
import { StructuredText } from '~/components/StructuredText';
import { Image } from '~/components/StructuredText/blocks/Image';
import { InternalVideo } from '~/components/StructuredText/blocks/InternalVideo';
import { Table } from '~/components/StructuredText/blocks/Table';
import { TabsBlock } from '~/components/StructuredText/blocks/TabsBlock';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { indexes } from '~/data/breadcrumbs';
import Layout from '~/layouts/Layout.astro';
import HeadingNode from './_HeadingNode.astro';
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { buildUrlForAcademyChapter } from '~/lib/datocms/gqlUrlBuilder/academyChapter';
import { buildUrlForAcademyCourse } from '~/lib/datocms/gqlUrlBuilder/academyCourse';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { JsonLd } from '~/components/JsonLd';
import { canonicalUrl, courseId, mainEntityRefs, publisherRef } from '~/lib/jsonLd';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { baseUrl } from '~/lib/draftMode';

const variables = { courseSlug: Astro.params.courseSlug!, chapterSlug: Astro.params.chapterSlug! };

const { chapter } = await executeQuery(Astro, query, { variables });

if (!chapter) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const course = chapter.matchingCourses[0];

if (!course) {
  return notFoundResponse();
}

const allChapters = course.chapters;

const courseUrl = new URL(buildUrlForAcademyCourse(course), baseUrl(Astro)).href;

const chapterIndex = findIndex(allChapters, (c) => c.id === chapter.id);

const prevChapter = chapterIndex > 0 ? allChapters[chapterIndex - 1] : undefined;

const nextChapter =
  chapterIndex < allChapters.length - 1 ? allChapters[chapterIndex + 1] : undefined;

// The sections are the headings up to h3. The anchors are unique in the page.
const sections = assignHeadingAnchors((chapter.content.value as StructuredTextDocument).document)
  .filter(({ heading }) => heading.level < 4)
  .map(({ heading, anchor }) => ({ id: anchor, text: toPlainText(heading) ?? '' }));

const outline = allChapters.map((nthChapter) => ({
  title: nthChapter.title,
  href: buildUrlForAcademyChapter(nthChapter),
  active: nthChapter.id === chapter.id,
  sections: nthChapter.id === chapter.id ? sections : undefined,
}));
---

<Layout theme="orange" seo={chapter.seo} headerVariant="accent">
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        ...mainEntityRefs(canonicalUrl(Astro)),
        headline: chapter.title,
        url: new URL(Astro.url.pathname, baseUrl(Astro)).href,
        datePublished: chapter._firstPublishedAt ?? undefined,
        dateModified: chapter._publishedAt ?? undefined,
        image: extractFromSeoTags(chapter.seo).image,
        isPartOf: {
          '@type': 'Course',
          '@id': courseId(baseUrl(Astro), variables.courseSlug),
          name: course.name,
          url: courseUrl,
        },
        publisher: publisherRef(baseUrl(Astro)),
        description: extractFromSeoTags(chapter.seo).description,
      }}
    />
  </Fragment>
  <Hero variant="accent" label="DatoCMS Academy" headline={chapter.title}>
    <Prose slot="intro">
      <StructuredText {...ensureValidStructuredTextProps({ data: course.introduction })} />
    </Prose>
  </Hero>
  <Breadcrumb
    trail={[indexes.academy, { label: course.name, href: buildUrlForAcademyCourse(course) }]}
    current={chapter.title}
  />
  <ArticleBody>
    <CourseOutline slot="aside" title="Course chapters" chapters={outline} />
    <StructuredText
      {...ensureValidStructuredTextProps({
        data: chapter.content,
        blockComponents: {
          ImageRecord: Image,
          TableRecord: Table,
          TabsBlockRecord: TabsBlock,
          InternalVideoRecord: InternalVideo,
        },
        linkToRecordComponents: defaultLinkToRecordComponents,
        inlineRecordComponents: defaultInlineRecordComponents,
      })}
      nodeOverrides={{ heading: HeadingNode }}
    />
  </ArticleBody>
  <PrevNext
    ariaLabel="Previous and next chapter"
    prev={prevChapter && {
      label: 'Previous chapter',
      title: prevChapter.title,
      href: buildUrlForAcademyChapter(prevChapter),
    }}
    next={nextChapter && {
      label: 'Next chapter',
      title: nextChapter.title,
      href: buildUrlForAcademyChapter(nextChapter),
    }}
  />

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
