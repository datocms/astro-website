---
// The Wall of love page. The copy of the hero comes from
// src/data/wall-of-love.ts. The quotes come from the CMS: all the reviews
// and all the partner testimonials. The SEO is static.
import { stripStega } from '@datocms/astro';
import { render as renderAsPlainText } from 'datocms-structured-text-to-plain-text';
import type { Review } from 'schema-dts';
import { DraftModeQueryListener } from '~/components/legacy/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/legacy/JsonLd';
import { PageCloser } from '~/components/PageCloser';
import {
  Testimonials,
  TestimonialsPartnerTestimonialFragment,
  TestimonialsReviewFragment,
} from '~/components/Testimonials';
import { robotVideo } from '~/data/videos';
import * as wall from '~/data/wall-of-love';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { query } from './_graphql';

type ReviewItem = FragmentOf<typeof TestimonialsReviewFragment>;
type PartnerTestimonialItem = FragmentOf<typeof TestimonialsPartnerTestimonialFragment>;

const { allReviews, allPartnerTestimonials } = await executeQuery(Astro, query);

// The reviews and the partner testimonials in one list, the newest first.
const items = [...allPartnerTestimonials, ...allReviews].sort((a, b) =>
  b._updatedAt.localeCompare(a._updatedAt),
);

// The Review JSON-LD of the old wall. JSON-LD needs strings: the quote is
// plain text, without the stega of Content Link.
const reviews = items.map((item): Review => {
  const data =
    item.__typename === 'ReviewRecord'
      ? { ...readFragment(TestimonialsReviewFragment, item as ReviewItem), partner: null }
      : readFragment(TestimonialsPartnerTestimonialFragment, item as PartnerTestimonialItem);
  const { partner } = data;
  const quote = renderAsPlainText(data.quote as Parameters<typeof renderAsPlainText>[0]);
  const reviewBody = stripStega(quote ?? '')
    .replace(/\s+/g, ' ')
    .trim();
  return {
    '@type': 'Review',
    itemReviewed: { '@type': 'SoftwareApplication', name: 'DatoCMS' },
    author: {
      '@type': 'Person',
      name: data.name ?? undefined,
      ...(data.role ? { jobTitle: data.role } : {}),
      ...(partner ? { worksFor: { '@type': 'Organization', name: partner.name } } : {}),
    },
    reviewBody: reviewBody || undefined,
  };
});

const seo = overrideSeo([], seoTitle(wall.seo.title), seoDescription(wall.seo.description));
---

{
  /*
  The quotes of the CMS are longer than the quotes of the design: the grid
  uses the `long` size of the quotes.
*/
}
<Layout seo={seo} theme="pink" headerVariant="light" footerTheme="purple">
  <Fragment slot="head">
    <JsonLd data={{ '@context': 'https://schema.org', '@graph': reviews }} />
  </Fragment>

  <Hero {...wall.hero} variant="light" alignment="center" typewriter />
  <Testimonials items={items} long />
  <PageCloser theme="purple" video={robotVideo} />

  <DraftModeQueryListener query={query} />
</Layout>
