---
// The Wall of love page. The copy of the hero comes from
// src/data/wall-of-love.ts. The quotes come from the CMS: all the reviews
// and all the partner testimonials. The SEO is static. The face at the
// right edge of the quotes comes from src/data/wall-of-love.ts too.
import { stripStega } from '@datocms/astro';
import type { Review } from 'schema-dts';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { JsonLd } from '~/components/JsonLd';
import { ListBuddy } from '~/components/ListBuddy';
import { PageCloser } from '~/components/PageCloser';
import { QuoteGrid, readQuote } from '~/components/Quote';
import * as wall from '~/data/wall-of-love';
import Layout from '~/layouts/Layout.astro';
import { baseUrl } from '~/lib/draftMode';
import { softwareId } from '~/lib/jsonLd';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { query } from './_graphql';

const { allReviews, allPartnerTestimonials, reviewsMeta, partnerTestimonialsMeta } =
  await executeQuery(Astro, query);

if (
  reviewsMeta.count > allReviews.length ||
  partnerTestimonialsMeta.count > allPartnerTestimonials.length
) {
  console.warn('[wall] Some quotes do not show: a list is longer than the page of 500 records.');
}

// The reviews and the partner testimonials in one list, the newest first.
// The featured quotes are large and wide: they go at equal distances in
// the list, from the top, thus the wall has one from time to time.
const newest = [...allPartnerTestimonials, ...allReviews].sort((a, b) =>
  b._createdAt.localeCompare(a._createdAt),
);
const featured = newest.filter((item) => item.featured);
const others = newest.filter((item) => !item.featured);
const step = featured.length > 0 ? Math.ceil(others.length / featured.length) : 0;
const items = featured.length
  ? featured.flatMap((item, i) => [item, ...others.slice(i * step, (i + 1) * step)])
  : others;

// The Review JSON-LD of the old wall. JSON-LD needs strings, without the
// stega of Content Link.
const base = baseUrl(Astro);
const reviews = items.map((item): Review => {
  const quote = readQuote(item);
  const reviewBody = stripStega(quote.text).replace(/\s+/g, ' ').trim();
  return {
    '@type': 'Review',
    itemReviewed: { '@type': 'SoftwareApplication', '@id': softwareId(base), name: 'DatoCMS' },
    author: {
      '@type': 'Person',
      name: stripStega(quote.name),
      ...(quote.role ? { jobTitle: stripStega(quote.role) } : {}),
      ...(quote.company
        ? { worksFor: { '@type': 'Organization', name: stripStega(quote.company) } }
        : {}),
    },
    reviewBody: reviewBody || undefined,
  };
});

const seo = overrideSeo([], seoTitle(wall.seo.title), seoDescription(wall.seo.description));
---

<Layout theme="pink" seo={seo} headerVariant="accent">
  <Fragment slot="head">
    <JsonLd data={{ '@context': 'https://schema.org', '@graph': reviews }} />
  </Fragment>

  <Hero {...wall.hero} variant="accent" alignment="center" typewriter />
  <ListBuddy {...wall.buddy} track="list">
    <QuoteGrid items={items} layout="masonry" />
  </ListBuddy>
  <PageCloser face="love" cta={wall.ctaStart} video="/videos/hand-heart.pxv" />

  <DraftModeQueryListener query={query} />
</Layout>
