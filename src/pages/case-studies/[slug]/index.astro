---
// A case study, from a SuccessStory record of the CMS.
import { stripStega } from '@datocms/astro';
import { render as structuredTextToPlainText } from 'datocms-structured-text-to-plain-text';
import { CaseStudies } from '~/components/CaseStudies';
import { CaseStudyBody } from '~/components/CaseStudyBody';
import { ChallengeSolution } from '~/components/ChallengeSolution';
import { DraftModeQueryListener } from '~/components/DraftModeQueryListener';
import { JsonLd } from '~/components/JsonLd';
import { PageCloser } from '~/components/PageCloser';
import { Stats } from '~/components/Stats';
import { TextWithImage } from '~/components/TextWithImage';
import * as cs from '~/data/case-studies';
import { victoryVideo } from '~/data/videos';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { extractFromSeoTags } from '~/lib/datocms/seo';
import { baseUrl } from '~/lib/draftMode';
import { publisherRef } from '~/lib/jsonLd';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';

const variables = { slug: Astro.params.slug! };
const { page, latest } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

// The JSON-LD headline is a plain string: it must not contain stega.
const headline = stripStega(structuredTextToPlainText(page.title) || page.name);
const others = latest.filter((story) => story.id !== page.id).slice(0, 3);
---

<Layout seo={page.seo} theme="orange" footerTheme="orange">
  <Fragment slot="head">
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline,
        url: new URL(Astro.url.pathname, baseUrl(Astro)).href,
        datePublished: page._firstPublishedAt ?? undefined,
        publisher: publisherRef(baseUrl(Astro)),
        description: extractFromSeoTags(page.seo).description,
        image: page.coverImage.url,
      }}
    />
  </Fragment>

  <TextWithImage story={page} media="photo" headingLevel="h1" theme="orange" />
  {page.numbers.length > 0 && <Stats stats={page.numbers} theme="orange" />}
  <CaseStudyBody title="The full story" story={page} theme="orange" />
  <ChallengeSolution story={page} />
  <CaseStudies {...cs.moreCaseStudies} stories={others} rows={1} theme="orange" />
  <PageCloser theme="orange" cta={cs.ctaBuildShort} video={victoryVideo} videoLayout="centre" />

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
