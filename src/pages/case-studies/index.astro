---
// The index of the case studies, from the SuccessStory records of the CMS.
import { CaseStudyGrid } from '~/components/CaseStudyGrid';
import { DraftModeQueryListener } from '~/components/legacy/DraftModeQueryListener';
import { Hero } from '~/components/Hero';
import { PageCloser } from '~/components/PageCloser';
import { Quote } from '~/components/Quote';
import { Stats } from '~/components/Stats';
import { TextWithImage } from '~/components/TextWithImage';
import * as cs from '~/data/case-studies';
import { danceTwoVideo } from '~/data/videos';
import Layout from '~/layouts/Layout.astro';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { buildUrlForSuccessStory } from '~/lib/datocms/gqlUrlBuilder/successStory';
import { avoidAstroTypeCheckBug, notFoundResponse } from '~/lib/notFoundResponse';
import { query } from './_graphql';

const { page, stories, testimonial } = await executeQuery(Astro, query);

if (!page || stories.length === 0) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}

const { highlight } = page;
const others = stories.filter((story) => story.id !== highlight.id);
const topStories = others.slice(0, 4);
const moreStories = others.slice(4);
---

<Layout seo={page.seo} headerVariant="light" footerTheme="orange">
  <Hero {...cs.hero} variant="light" alignment="center" typewriter />
  <TextWithImage
    story={highlight}
    button={{ ...cs.featuredButton, href: buildUrlForSuccessStory(highlight) }}
    media="photo"
    theme="orange"
  />
  {highlight.numbers.length > 0 && <Stats stats={highlight.numbers} theme="orange" />}
  <CaseStudyGrid stories={topStories} theme="orange" />
  <Quote testimonial={testimonial} fallback={cs.quote} />
  {moreStories.length > 0 && <CaseStudyGrid stories={moreStories} theme="orange" />}
  <PageCloser theme="orange" cta={cs.ctaBuild} video={danceTwoVideo} />

  <DraftModeQueryListener query={query} />
</Layout>
