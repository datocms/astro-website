---
import Wrapper from '~/components/legacy/Wrapper/ReactComponent';
import { Button } from '~/components/legacy/LegacyButton';
import { Carousel } from '~/components/legacy/Carousel';
import { Image } from '~/components/legacy/blocks/Image';
import { InternalVideo } from '~/components/legacy/blocks/InternalVideo';
import { Layout } from '~/layouts/LegacyLayout';
import { overrideSeo, seoOgType } from '~/lib/datocms/seo';
import { Card } from '~/components/legacy/Card';
import { Prose } from '~/components/legacy/LegacyProse';
import { ResponsiveImage } from '~/components/legacy/LegacyResponsiveImage';
import { Space } from '~/components/legacy/Space';
import { Svg } from '~/components/legacy/Svg';
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { Text } from '~/components/legacy/LegacyStructuredText/Text';
import { Video } from '~/components/legacy/blocks/Video';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { notFoundResponse, avoidAstroTypeCheckBug } from '~/lib/notFoundResponse';
import { query } from './_graphql';
import s from './_style.module.css';
import { DraftModeQueryListener } from '~/components/legacy/DraftModeQueryListener';
import { defaultLinkToRecordComponents } from '~/components/legacy/linkToRecords';
import { defaultInlineRecordComponents } from '~/components/legacy/inlineRecords';
import { dashboardUrl } from '~/lib/datocms/dashboardUrl';

const variables = { slug: Astro.params.slug! };
const { page } = await executeQuery(Astro, query, { variables });

if (!page) {
  avoidAstroTypeCheckBug(notFoundResponse);
  return notFoundResponse();
}
---

<Layout noFinalCta seo={overrideSeo(page.seo, seoOgType('website'))}>
  <div id="main-content">
    <Space top={2}>
      <Wrapper>
        <div class={s.grid}>
          <div class={s.content}>
            <div class={s.titleWrapper}>
              <h1 class={s.title}>{page.title}</h1>
            </div>
            <h3 class={s.subtitle}>{page.description}</h3>
            <Space top={1}>
              <div class={s.ctaMobile} data-datocms-nomd>
                <Button
                  as="a"
                  href={dashboardUrl(
                    '/projects/redirect-to-project?preference=login&path=/admin/build_triggers/new',
                  )}
                  target="_blank"
                  fs="small"
                >
                  Setup integration
                </Button>
              </div>
            </Space>
            {
              page.gallery.length && (
                <Space top={1}>
                  <div data-datocms-nomd>
                    <Carousel buttonsY="50%">
                      {page.gallery.map(
                        (item) =>
                          item.responsiveImage && (
                            <div class={s.slide}>
                              <ResponsiveImage data={item.responsiveImage} />
                            </div>
                          ),
                      )}
                    </Carousel>
                  </div>
                </Space>
              )
            }
            <Space top={1}>
              <Prose>
                <Text
                  {...ensureValidStructuredTextProps({
                    data: page.content,
                    blockComponents: {
                      ImageRecord: Image,
                      InternalVideoRecord: InternalVideo,
                      VideoRecord: Video,
                    },
                    linkToRecordComponents: defaultLinkToRecordComponents,
                    inlineRecordComponents: defaultInlineRecordComponents,
                  })}
                />
              </Prose>
            </Space>
          </div>

          <aside class={s.aside} data-datocms-nomd>
            <div class={s.asideContentDesktop}>
              <Card title={page.title} background="azure" svgLogo={page.logo}>
                {page.shortDescription}
                <Fragment slot="below">
                  <div class={s.cardCta}>
                    <Button
                      as="a"
                      href={dashboardUrl(
                        '/projects/redirect-to-project?preference=login&path=/admin/build_triggers/new',
                      )}
                      target="_blank"
                      fs="small"
                      block
                    >
                      Setup integration
                    </Button>
                  </div>
                </Fragment>
              </Card>

              <div class={s.publisher}>
                <h4>Publisher</h4>
                <article>
                  <div class={s.publisherIcon}>
                    <Svg name="svg/datocms/icon/color/color_d_icon" />
                  </div>
                  <p>DatoCMS</p>
                </article>
              </div>
            </div>
          </aside>
        </div>
      </Wrapper>
    </Space>
  </div>

  <DraftModeQueryListener query={query} variables={variables} />
</Layout>
