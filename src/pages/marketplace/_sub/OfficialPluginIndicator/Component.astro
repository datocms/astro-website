---
import { Svg } from '~/components/Svg';
import { Tooltip } from '~/components/Tooltip';
import s from './style.module.css';

type Props = { size: number };
const { size } = Astro.props;
const label = 'Official DatoCMS plugin';
---

<span class={s.root} style={`--indicator-size: ${size}px`}>
  <Tooltip class={s.trigger}>
    <Svg
      name="icons/brands/datocms"
      width={size}
      height={size}
      role="img"
      aria-label={label}
      focusable="false"
    />
    <Fragment slot="tooltip">{label}</Fragment>
  </Tooltip>
</span>
