---
// GDPR compliance: Markdown (src/documents/gdpr.md).
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import { tableOfContentsItems } from '~/components/TableOfContents';
import { Content, getHeadings } from '~/documents/gdpr.md';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

const seo = overrideSeo([], seoTitle('GDPR Compliance'));
// Astro gives each heading an id. The table lists the h2 and h3 headings.
const items = tableOfContentsItems(
  getHeadings()
    .filter((heading) => heading.depth <= 3)
    .map((heading) => ({ id: heading.slug, text: heading.text, level: heading.depth })),
);
---

<Layout seo={seo} theme="blue" headerVariant="light" footerTheme="blue">
  <Hero variant="light" label="Legal" headline="GDPR Compliance" />
  <ArticleBody items={items} tocTitle="In this document">
    <Content />
  </ArticleBody>
</Layout>
