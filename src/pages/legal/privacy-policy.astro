---
// The privacy policy: HTML that iubenda makes (src/documents/privacy.json).
// The text is not ours to change. The table of contents lists the h2 headings.
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import { tableOfContentsItems } from '~/components/TableOfContents';
import privacy from '~/documents/privacy.json';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';
import { prepareIubendaHtml } from '~/lib/iubenda';
import styles from './_iubenda.module.css';

const seo = overrideSeo([], seoTitle('Privacy Policy'));
const { html, items } = prepareIubendaHtml(privacy.content);
---

<Layout theme="blue" seo={seo} headerVariant="accent">
  <Hero variant="accent" label="Legal" headline="Privacy Policy" />
  <ArticleBody items={tableOfContentsItems(items)} tocTitle="In this policy">
    <div class={styles.policy}>
      <policy-boxes class={styles.boxes}>
        <Fragment set:html={html} />
      </policy-boxes>
    </div>
  </ArticleBody>
</Layout>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  // <policy-boxes> holds the HTML of the policy. A click on the text of a
  // service opens or closes its box. A click on the summary or on a
  // control keeps its normal action.
  customElements.define(
    'policy-boxes',
    class PolicyBoxes extends WebComponent {
      parsedCallback() {
        for (const details of this.$$<HTMLDetailsElement>('details')) {
          this.on(details, 'click', (event) => {
            const control = 'summary, a, button, input, select, textarea';
            if ((event.target as Element).closest(control)) return;
            event.preventDefault();
            details.open = !details.open;
          });
        }
      }
    },
  );
</script>
