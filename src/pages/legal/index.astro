---
// The index of the legal pages: a list of links.
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoTitle } from '~/lib/datocms/seo';

const seo = overrideSeo([], seoTitle('Policies'));
---

<Layout theme="purple" seo={seo} headerVariant="accent">
  <Hero variant="accent" label="Legal" headline="Policies" />
  <ArticleBody tocTitle="On this page">
    <p class="lead">The following pages cover our security and policies:</p>
    <ul>
      <li>
        <strong><a href="/legal/cookie-policy">Cookie policy</a></strong>{': '}<span
          >Understand our use of cookies and tracking.</span
        >
      </li>
      <li>
        <strong><a href="/legal/gdpr">GDPR compliance</a></strong>{': '}<span
          >Information on how we handle personally identifiable data.</span
        >
      </li>
      <li>
        <strong><a href="/legal/privacy-policy">Privacy policy</a></strong>{': '}<span
          >How we collect and process your data.</span
        >
      </li>
      <li>
        <strong><a href="/security">Security</a></strong>{': '}<span
          >Our internal security policies.</span
        >
      </li>
      <li>
        <strong><a href="/legal/terms">Terms of service</a></strong>{': '}<span
          >The terms and conditions for using DatoCMS.</span
        >
      </li>
    </ul>
  </ArticleBody>
</Layout>
