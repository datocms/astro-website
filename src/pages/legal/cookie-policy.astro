---
// The cookie policy: HTML that iubenda makes (src/documents/cookie-policy.json).
// The text is not ours to change. It has only 3 h2 headings, thus no table of contents.
import { ArticleBody } from '~/components/ArticleBody';
import { Hero } from '~/components/Hero';
import { tableOfContentsItems } from '~/components/TableOfContents';
import policy from '~/documents/cookie-policy.json';
import Layout from '~/layouts/Layout.astro';
import { overrideSeo, seoDescription, seoTitle } from '~/lib/datocms/seo';
import { prepareIubendaHtml } from '~/lib/iubenda';
import styles from './_iubenda.module.css';

const seo = overrideSeo(
  [],
  seoTitle('Cookie policy'),
  seoDescription(
    'The cookies and the tracking tools of the DatoCMS website, and what each one does.',
  ),
);
const { html, items } = prepareIubendaHtml(policy.content);
---

<Layout theme="purple" seo={seo} headerVariant="accent">
  <Hero variant="accent" label="Legal" headline="Cookie policy" />
  <ArticleBody items={tableOfContentsItems(items)} tocTitle="In this policy">
    <div class={styles.policy}>
      <Fragment set:html={html} />
    </div>
  </ArticleBody>
</Layout>
