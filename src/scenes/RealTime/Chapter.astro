---
import { ChapterLayout } from '~/components/ChapterLayout';
import { SceneFrame } from '~/components/SceneFrame';
import * as dev from '~/data/developers-pillar';
import Stream from './Stream.astro';
---

<ChapterLayout {...dev.realTime}>
  <Fragment slot="scene">
    <SceneFrame preset="whole" theme={dev.realTime.theme}>
      <Stream />
    </SceneFrame>
  </Fragment>
</ChapterLayout>
