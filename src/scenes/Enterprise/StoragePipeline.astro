---
import { faCloud } from '@fortawesome/pro-regular-svg-icons/faCloud';
import { faGlobe } from '@fortawesome/pro-regular-svg-icons/faGlobe';
import { Icon } from '~/components/Icon';
import diagram from '../diagram/style.module.css';
import Link from './Link.astro';
import styles from './flow.module.css';
import { GROUP_NAME, STORAGE } from './story';

// The storage of the assets, in the grammar of the diagrams
// (../diagram/style.module.css). The assets go along a track to the bucket
// of the customer, and the file is served from the domain of the customer.
// The providers are text, never a drawn interface. It is a column. The
// still is the markup; the script (flow.ts) plays the loop in view only.
---

<scene-enterprise-storage
  class:list={[diagram.root, styles.flow]}
  role="img"
  aria-label={STORAGE.description}
>
  <div class:list={[diagram.panel, diagram.change, styles.panel]} data-node data-tint>
    <p class={diagram.panelLabel}>{GROUP_NAME}</p>
    <ul class={styles.chips}>
      {STORAGE.assets.map((asset) => <li class={styles.chip}>{asset}</li>)}
    </ul>
  </div>
  <Link />
  <p class:list={[diagram.pill, diagram.change]} data-node>
    <span class={diagram.symbol}><Icon icon={faCloud} /></span>
    <span>{STORAGE.bucket}</span>
  </p>
  <p class={styles.caption}>{STORAGE.providers}</p>
  <Link />
  <p class:list={[diagram.pill, diagram.change]} data-node>
    <span class={diagram.symbol}><Icon icon={faGlobe} /></span>
    <span>{STORAGE.url}</span>
  </p>
</scene-enterprise-storage>

<script>
  import { FlowDiagram } from './flow';

  customElements.define('scene-enterprise-storage', class extends FlowDiagram {});
</script>
