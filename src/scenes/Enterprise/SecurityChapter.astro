---
import { ChapterLayout } from '~/components/ChapterLayout';
import { SceneFragment } from '~/components/SceneFragment';
import * as ent from '~/data/enterprise';
import BackupsArchive from './BackupsArchive.astro';
import StoragePipeline from './StoragePipeline.astro';
---

{
  /* The frame and the first two fragments are boxes until their scenes exist. The two last fragments are diagrams: these features have no screen in the cms. */
}
<ChapterLayout {...ent.security}>
  <SceneFragment slot="visual-2" fit="fill">
    <BackupsArchive />
  </SceneFragment>
  <SceneFragment slot="visual-3" fit="fill">
    <StoragePipeline />
  </SceneFragment>
</ChapterLayout>
