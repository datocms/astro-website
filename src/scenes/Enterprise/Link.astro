---
import diagram from '../diagram/style.module.css';
import styles from './flow.module.css';

interface Props {
  /**
   * The track has a way back: a second line with a pulse that goes up
   * (`data-back`), next to the line that goes down (`data-link`).
   */
  twoWay?: boolean;
}

const { twoWay = false } = Astro.props;
const lines = twoWay ? (['30%', '70%'] as const) : (['50%'] as const);
---

{/* A track between two parts of a column, and its pulse. */}
<svg class:list={[styles.link, twoWay && styles.twoWay]} aria-hidden="true">
  {
    lines.map((x, i) => {
      const back = twoWay && i === 1;
      return (
        <g data-link={back ? undefined : ''} data-back={back ? '' : undefined}>
          <line class={diagram.track} x1={x} y1="0" x2={x} y2="100%" />
          <line
            class={diagram.pulse}
            x1={x}
            y1={back ? '100%' : '0'}
            x2={x}
            y2={back ? '0' : '100%'}
            pathLength="100"
          />
        </g>
      );
    })
  }
</svg>
