---
import { AppWindow } from '~/components/AppWindow';
import { WhiteLabelScene } from './Governance';
import { WHITE_LABEL } from './story';
import styles from './whiteLabel.module.css';

// The picture of the fragment "Your brand on the CMS": a browser window at
// the address of the group, with the cms in it. The cms shows the logo of
// Northwind in the navigation bar and the green of the brand. The picture
// shows the result, not the settings: the address, the logo and the
// colours have their settings in three different places of DatoCMS. The
// window is wider than the box, thus the box cuts it at the right and at
// the bottom. There is no motion.
---

<AppWindow class={styles.window} address={WHITE_LABEL.address}>
  <WhiteLabelScene height={640} />
</AppWindow>
