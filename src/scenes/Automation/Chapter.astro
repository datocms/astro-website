---
import { ChapterLayout } from '~/components/ChapterLayout';
import { SceneFragment } from '~/components/SceneFragment';
import * as dev from '~/data/developers-pillar';
import Deploys from './Deploys.astro';
import Hooks from './Hooks.astro';
---

<ChapterLayout {...dev.automation}>
  <SceneFragment slot="visual-0" fit="fill">
    <Hooks />
  </SceneFragment>
  <SceneFragment slot="visual-1" fit="fill">
    <Deploys />
  </SceneFragment>
</ChapterLayout>
