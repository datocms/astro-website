---
import { ChapterLayout } from '~/components/ChapterLayout';
import { SceneFrame } from '~/components/SceneFrame';
import * as dev from '~/data/developers-pillar';
import Graph from './Graph.astro';
---

<ChapterLayout {...dev.environments}>
  <Fragment slot="scene">
    <SceneFrame preset="whole" theme={dev.environments.theme}>
      <Graph />
    </SceneFrame>
  </Fragment>
</ChapterLayout>
