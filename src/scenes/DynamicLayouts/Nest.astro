---
import diagram from '../diagram/style.module.css';
import { FEATURE_BLOCKS, FEATURE_GRID_TITLE, NESTED_MODELS } from './story';
import styles from './nest.module.css';

// The nested blocks of the Feature grid, in the grammar of the diagrams
// (../diagram/style.module.css). The picture has two views of the same
// blocks. "On the page": the Feature grid is a box, with its three Features
// in a row and a Button at the bottom of each. "From the API": each block is
// a row of a tree, with the type of its record, below the row of its parent.
// Each block shows its text in the two views (the title of the Feature grid
// and of a Feature, the label of a Button): in its box on the page, and at
// the right of its row in the tree. The script below drives the loop (in
// view only; not with reduced motion): the boxes go to the rows of the tree,
// the lines of the tree draw, and then the rows go back to the boxes. Without
// it the picture is the still, the boxes.

type Level = keyof typeof NESTED_MODELS;

/**
 * A block of the picture. `row` is its row in the tree, from the top.
 * `column` is the place of its Feature in the row of the page, from the
 * left. `text` is the text of the block in the record.
 */
type Node = { level: Level; depth: number; row: number; column: number; text: string };

const nodes: Node[] = [
  { level: 'grid', depth: 0, row: 0, column: 0, text: FEATURE_GRID_TITLE },
  ...FEATURE_BLOCKS.flatMap(({ title, button }, column): Node[] => [
    { level: 'feature', depth: 1, row: 1 + column * 2, column, text: title },
    { level: 'button', depth: 2, row: 2 + column * 2, column, text: button },
  ]),
];

/**
 * The right edge of the widest row of the tree, from the left edge of the
 * tree, with no padding: the texts of the rows start in one column after
 * it. A row starts at its depth, and is as wide as the type of its record.
 */
const WIDEST = `max(${[...new Map(nodes.map(({ level, depth }) => [level, depth]))]
  .map(
    ([level, depth]) =>
      `${depth} * var(--indent) + ${NESTED_MODELS[level].type.length} * var(--char)`,
  )
  .join(', ')})`;

/**
 * The lines of the tree. A trunk goes down from a block (`row`) to the row
 * of its last child (`end`). A twig goes from the trunk to a child (`row`).
 * `depth` is the depth of the parent. `step` is the order in which the
 * script draws the lines: the trunk of the Feature grid, its twigs, the
 * trunks of the Features, their twigs.
 */
type Line = { kind: 'trunk' | 'twig'; depth: number; row: number; end: number; step: number };

const features = nodes.filter(({ level }) => level === 'feature');
const lines: Line[] = [
  { kind: 'trunk', depth: 0, row: 0, end: features.at(-1)!.row, step: 0 },
  ...features.map(({ row }): Line => ({ kind: 'twig', depth: 0, row, end: row, step: 1 })),
  // The Button of a Feature is in the row after it
  ...features.map(({ row }): Line => ({ kind: 'trunk', depth: 1, row, end: row + 1, step: 2 })),
  ...features.map(({ row }): Line => ({
    kind: 'twig',
    depth: 1,
    row: row + 1,
    end: row + 1,
    step: 3,
  })),
];

const STEPS = 4;

const list = (items: readonly string[]) => items.map((item) => `“${item}”`).join(', ');

const DESCRIPTION = `Blocks inside blocks, in two views. On the page: the ${NESTED_MODELS.grid.name} block “${FEATURE_GRID_TITLE}” is a box with three ${NESTED_MODELS.feature.name} blocks in a row (${list(FEATURE_BLOCKS.map(({ title }) => title))}), and each has a ${NESTED_MODELS.button.name} block (${list(FEATURE_BLOCKS.map(({ button }) => button))}). From the API: the same blocks are a tree, a ${NESTED_MODELS.grid.type} with three ${NESTED_MODELS.feature.type} below it, and a ${NESTED_MODELS.button.type} below each of them.`;
---

<scene-dynamic-layouts-nest
  class:list={[diagram.root, styles.nest]}
  role="img"
  aria-label={DESCRIPTION}
  style={`--widest: ${WIDEST}`}
  data-view="page"
  data-steps={STEPS}
>
  <p class={styles.views}>
    <span class:list={[diagram.panelLabel, styles.view]} data-for="page">On the page</span>
    <span class:list={[diagram.panelLabel, styles.view]} data-for="api">From the API</span>
  </p>

  {
    /* A Button is after its Feature, and a Feature is after the Feature grid: a block is above the block that holds it */
  }
  {
    nodes.map(({ level, depth, row, column, text }) => (
      <div
        class:list={['pictureLabel', styles.node, styles[level]]}
        style={`--depth: ${depth}; --row-index: ${row}; --column: ${column}; --chars: ${NESTED_MODELS[level].type.length}; --name-chars: ${NESTED_MODELS[level].name.length}`}
      >
        <span class:list={[diagram.panelLabel, styles.name]}>{NESTED_MODELS[level].name}</span>
        <span class={styles.type}>{NESTED_MODELS[level].type}</span>
        <span class={styles.content}>{text}</span>
        <span class={styles.value}>{text}</span>
      </div>
    ))
  }

  {
    lines.map(({ kind, depth, row, end, step }) => (
      <span
        class:list={[styles.line, styles[kind]]}
        style={`--depth: ${depth}; --row-index: ${row}; --end: ${end}`}
        data-line={step}
        data-hidden
      />
    ))
  }
</scene-dynamic-layouts-nest>

<script>
  import { DIAGRAM_MS, reflow, sleep, startDiagramLoop, type Live } from '~/lib/motion/diagramLoop';
  import { WebComponent } from '~/lib/WebComponent';

  /** The time of the move of a block between its two places: --nest-move in nest.module.css */
  const MOVE = 1100;
  const LOOK = DIAGRAM_MS.hold * 2;

  customElements.define(
    'scene-dynamic-layouts-nest',
    class extends WebComponent {
      parsedCallback() {
        const root = this as HTMLElement;
        const steps = Number(root.dataset.steps);
        const lines = this.$$<HTMLElement>('[data-line]');
        const linesOf = (step: number) =>
          lines.filter((line) => Number(line.dataset.line) === step);

        async function play(live: Live): Promise<void> {
          await sleep(LOOK);
          if (!live()) return;

          root.dataset.view = 'api';
          await sleep(MOVE);

          for (let step = 0; step < steps; step++) {
            if (!live()) return;
            for (const line of linesOf(step)) delete line.dataset.hidden;
            await sleep(DIAGRAM_MS.draw / 2);
          }
          await sleep(DIAGRAM_MS.draw / 2 + LOOK);
          if (!live()) return;

          for (const line of lines) line.dataset.faded = '';
          await sleep(DIAGRAM_MS.fade);
          for (const line of lines) {
            line.dataset.hidden = '';
            delete line.dataset.faded;
          }

          root.dataset.view = 'page';
          await sleep(MOVE);
        }

        startDiagramLoop(root, play, {
          // Each session starts from the still, with no transition: the
          // boxes, and no lines
          start: () => {
            root.dataset.instant = '';
            root.dataset.view = 'page';
            for (const line of lines) {
              line.dataset.hidden = '';
              delete line.dataset.faded;
            }
            reflow(root);
            delete root.dataset.instant;
          },
        });
      }
    },
  );
</script>
