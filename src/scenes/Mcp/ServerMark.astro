---
import styles from './style.module.css';

// The mark of DatoCMS, as the chat apps show the icon of an MCP server.
// `hidden` keeps its space with no mark, thus the text after it aligns.

interface Props {
  hidden?: boolean;
}

const { hidden } = Astro.props;
