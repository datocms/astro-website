---
import { ChapterLayout } from '~/components/ChapterLayout';
import { SceneFrame } from '~/components/SceneFrame';
import * as media from '~/data/media';
import Lab from './Lab.astro';
---

<ChapterLayout {...media.images}>
  <Fragment slot="scene">
    <SceneFrame preset="whole" theme={media.images.theme}>
      <Lab />
    </SceneFrame>
  </Fragment>
</ChapterLayout>
