---
import {
  faChevronDown,
  faEllipsisVertical,
  faMagnifyingGlass,
  faMinus,
  faPlus,
} from '@fortawesome/pro-regular-svg-icons';
import { faCircleHalfStroke } from '@fortawesome/pro-solid-svg-icons';
import { Button } from '~/components/Button';
import { DatoLogo } from '~/components/DatoLogo';
import { Icon } from '~/components/Icon';
import { NavLink } from '~/components/NavLink';
import { type NavGroup, groupPaths } from '~/data/navigation';
import { dashboardUrl } from '~/lib/datocms/dashboardUrl';
import styles from './style.module.css';

interface Props {
  /** The ground of the hero of the page: `page` or `accent`. The header takes the theme of the page. */
  variant?: 'page' | 'accent';
  nav: NavGroup[];
  /**
   * The look of the CTA. Without it, the CTA is soft on the header on the page ground
   * and solid on the other headers.
   */
  ctaVariant?: 'solid' | 'soft';
}

const { variant = 'page', nav, ctaVariant: ctaVariantProp } = Astro.props;

const variantClass = {
  page: undefined,
  accent: [styles.variantAccent, 'surfaceAccent'],
}[variant];

// On the page ground the CTA is a soft pill.
const ctaVariant = ctaVariantProp ?? (variant === 'page' ? 'soft' : 'solid');

// The group of the page that the visitor reads. When two groups hold the
// page ('/blog' and '/blog/casual-chats'), the longer path wins.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isBelow = (path: string) => pathname === path || pathname.startsWith(`${path}/`);
let currentGroup = -1;
let currentPathLength = 0;
nav.forEach((group, i) => {
  for (const path of groupPaths(group)) {
    if (isBelow(path) && path.length > currentPathLength) {
      currentPathLength = path.length;
      currentGroup = i;
    }
  }
});

const cardId = (i: number) => `site-header-card-${i}`;
---

<site-header class={styles.root}>
  <header class:list={[styles.header, variantClass]}>
    <div class={styles.bar}>
      <a href="/" class={styles.logo} aria-label="DatoCMS home">
        <DatoLogo version="long" height={20} />
      </a>

      <nav aria-label="Main" class={styles.nav} data-nav>
        <ul class={styles.navList} data-nav-list>
          {
            /* The tint pill. It slides to the item under the cursor, the open item or the item of the page. */
          }
          <li class={styles.indicator} aria-hidden="true"></li>
          {
            nav.map((group, i) =>
              group.columns ? (
                <li>
                  <button
                    type="button"
                    class:list={[styles.navItem, 'labelMedium']}
                    aria-expanded="false"
                    aria-controls={cardId(i)}
                    aria-current={currentGroup === i ? 'true' : undefined}
                    data-nav-item
                    data-card-trigger
                  >
                    {group.label}
                    <Icon icon={faChevronDown} class={styles.chevron} />
                  </button>
                </li>
              ) : (
                <li>
                  <a
                    href={group.href}
                    class:list={[styles.navItem, 'labelMedium']}
                    aria-current={
                      pathname === group.href ? 'page' : currentGroup === i ? 'true' : undefined
                    }
                    data-nav-item
                    data-card-plain
                  >
                    {group.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>

        {/* One shell holds the cards: it glides and resizes from one card to the next. */}
        <div class:list={[styles.shell, 'surfaceInverse']} data-card-shell>
          {
            nav.map(
              (group, i) =>
                group.columns && (
                  <div id={cardId(i)} class={styles.card} data-card>
                    {group.columns.map((column) => (
                      <div class={styles.cardColumn}>
                        {column.sections.map((section) => (
                          <div class={styles.cardSection}>
                            <p class:list={[styles.heading, 'labelMedium']} data-card-row>
                              {section.heading}
                            </p>
                            <ul class={styles.cardLinks}>
                              {section.links.map((link) => (
                                <li data-card-row>
                                  <NavLink href={link.href} description={link.description}>
                                    {link.label}
                                  </NavLink>
                                </li>
                              ))}
                            </ul>
                            {section.allLink && (
                              <a
                                href={section.allLink.href}
                                class:list={[styles.allLink, 'labelMedium']}
                                data-card-row
                              >
                                <span aria-hidden="true">→</span>
                                <span class={styles.allLabel}>{section.allLink.label}</span>
                              </a>
                            )}
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                ),
            )
          }
        </div>
      </nav>

      <div class={styles.actions}>
        <button
          type="button"
          class={styles.search}
          aria-label="Search"
          aria-haspopup="dialog"
          aria-keyshortcuts="Meta+K Control+K"
          data-search-open
        >
          <Icon icon={faMagnifyingGlass} />
        </button>
        <button
          type="button"
          class={styles.scheme}
          aria-label="Dark mode"
          aria-pressed="false"
          data-scheme-toggle
        >
          <Icon icon={faCircleHalfStroke} />
        </button>
        <a href={dashboardUrl('/login')} class:list={[styles.login, 'labelMedium']}>Login</a>
        <Button variant={ctaVariant} href={dashboardUrl('/signup')} arrow={false}
          >Get Started</Button
        >
        <button
          type="button"
          class={styles.dots}
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="site-header-mobile-nav"
          data-mobile-trigger
        >
          <Icon icon={faEllipsisVertical} />
        </button>
      </div>
    </div>

    {/* The nav of the bar is hidden below 1152: this one is the landmark then. */}
    <nav
      id="site-header-mobile-nav"
      aria-label="Main"
      class:list={[styles.mobileNav, 'surfacePage']}
      hidden
      data-mobile-panel
    >
      <ul class={styles.mobileList}>
        {
          nav.map((group, i) => (
            <li class={styles.mobileItem}>
              {group.columns ? (
                <details name="site-header-mobile-nav" class={styles.mobileGroup}>
                  <summary class:list={[styles.mobileSummary, 'headline']}>
                    {group.label}
                    <span class={styles.toggle} aria-hidden="true">
                      <Icon icon={faPlus} class={styles.plus} />
                      <Icon icon={faMinus} class={styles.minus} />
                    </span>
                  </summary>
                  <div class={styles.mobileGroupBody}>
                    {group.columns
                      .flatMap((column) => column.sections)
                      .map((section) => (
                        <div class={styles.mobileSection}>
                          <p class:list={[styles.heading, styles.mobileHeading, 'labelMedium']}>
                            {section.heading}
                          </p>
                          <ul class={styles.mobileLinks}>
                            {section.links.map((link) => (
                              <li>
                                <NavLink
                                  href={link.href}
                                  description={link.description}
                                  class={styles.mobileRow}
                                >
                                  {link.label}
                                </NavLink>
                              </li>
                            ))}
                            {section.allLink && (
                              <li>
                                <a
                                  href={section.allLink.href}
                                  class:list={[styles.allLink, styles.mobileRow, 'title']}
                                >
                                  <span aria-hidden="true">→</span>
                                  <span class={styles.allLabel}>{section.allLink.label}</span>
                                </a>
                              </li>
                            )}
                          </ul>
                        </div>
                      ))}
                  </div>
                </details>
              ) : (
                <a
                  href={group.href}
                  class:list={[styles.mobileSummary, styles.mobileLink, 'headline']}
                  aria-current={
                    pathname === group.href ? 'page' : currentGroup === i ? 'true' : undefined
                  }
                >
                  {group.label}
                </a>
              )}
            </li>
          ))
        }
        {/* Below 768 the bar has no search button: the menu has it. */}
        <li class:list={[styles.mobileItem, styles.mobileOnly]}>
          <button
            type="button"
            class:list={[styles.mobileSummary, styles.mobileLink, 'headline']}
            aria-haspopup="dialog"
            data-search-open
          >
            Search
          </button>
        </li>
        <li class:list={[styles.mobileItem, styles.mobileOnly]}>
          <a
            href={dashboardUrl('/login')}
            class:list={[styles.mobileSummary, styles.mobileLink, 'headline']}>Login</a
          >
        </li>
      </ul>
    </nav>
  </header>
</site-header>

<script>
  import { chooseColorScheme, currentColorScheme } from '~/lib/colorScheme';
  import { WebComponent } from '~/lib/WebComponent';

  const DESKTOP = window.matchMedia('(min-width: 1152px)');
  const HOVER = window.matchMedia('(hover: hover)');
  const EASE = 'cubic-bezier(0.3, 0, 0, 1)';

  // The durations are 0 when the visitor asks for reduced motion (Layout
  // sets data-motion="on" on <html> only when they do not).
  const ms = (duration: number) =>
    document.documentElement.dataset.motion === 'on' ? duration : 0;

  const FOCUSABLE = 'a[href], button';

  customElements.define(
    'site-header',
    class SiteHeader extends WebComponent {
      openTrigger: HTMLButtonElement | null = null;
      // The card that the shell shows, also during a close.
      shownCard: HTMLElement | null = null;
      // The item under the cursor or with the focus. The pill rests elsewhere only when there is none.
      pointed: HTMLElement | null = null;
      list!: HTMLElement;
      shell!: HTMLElement;
      items!: HTMLElement[];
      mobileTrigger!: HTMLButtonElement;
      mobilePanel!: HTMLElement;
      schemeToggle!: HTMLButtonElement;
      // The close in progress. A new open cancels it.
      closing: Animation | null = null;

      parsedCallback() {
        this.list = this.$('[data-nav-list]');
        this.shell = this.$('[data-card-shell]');
        this.items = this.$$('[data-nav-item]');
        this.mobileTrigger = this.$<HTMLButtonElement>('[data-mobile-trigger]');
        this.mobilePanel = this.$('[data-mobile-panel]');
        this.schemeToggle = this.$<HTMLButtonElement>('[data-scheme-toggle]');

        // The pill follows the cursor and the focus. When they leave the
        // row, it rests on the open item or on the item of the page.
        for (const item of this.items) {
          this.on(item, 'mouseenter', () => this.point(item));
          this.on(item, 'focus', () => this.point(item));
        }
        this.on(this.list, 'mouseleave', () => this.point(null));
        this.on(this.list, 'focusout', (event) => {
          if (!this.list.contains(event.relatedTarget as Node)) this.point(null);
        });
        // The first placement is instant: the pill does not slide in from the edge.
        this.restIndicator();
        requestAnimationFrame(() => this.list.setAttribute('data-indicator', ''));
        // The fonts can land after this script: the items change width.
        document.fonts.ready.then(() => this.restIndicator());

        // The cards.
        for (const trigger of this.$$<HTMLButtonElement>('[data-card-trigger]')) {
          this.on(trigger, 'mouseenter', () => {
            if (DESKTOP.matches && HOVER.matches) this.openCard(trigger);
          });
          this.on(trigger, 'click', (event) => {
            // With a mouse, the hover opened the card: the click does not
            // close it. On touch, the tap toggles it. A click from the
            // keyboard (Enter or Space, detail 0) toggles it too.
            if (this.openTrigger === trigger) {
              if (!HOVER.matches || event.detail === 0) this.closeCard();
            } else {
              this.openCard(trigger);
            }
          });
          // Arrow down goes into the open card.
          this.on(trigger, 'keydown', (event) => {
            if (event.key === 'ArrowDown' && this.openTrigger === trigger) {
              event.preventDefault();
              this.firstLinkOf(this.cardOf(trigger))?.focus();
            }
          });
        }
        for (const plain of this.$$('[data-card-plain]')) {
          this.on(plain, 'mouseenter', () => this.closeCard());
        }
        this.on(this, 'mouseleave', () => {
          if (HOVER.matches) this.closeCard();
        });
        // The focus goes to the page, by keyboard: the card closes. A
        // modal (the search) keeps it open, as Escape does. Without a
        // target (the window loses the focus), the card stays.
        this.on(this, 'focusout', (event) => {
          const to = event.relatedTarget;
          if (!(to instanceof Element) || this.contains(to)) return;
          if (to.closest('[aria-modal="true"]')) return;
          this.closeCard();
        });

        // The shell is after the row in the DOM. Tab from the open item goes
        // into its card, and Tab out of the last link goes to the next item.
        // After the last item, the default order goes on to the actions.
        this.on(this, 'keydown', (event) => {
          if (event.key !== 'Tab' || !this.openTrigger) return;
          const target = event.target as HTMLElement;
          const card = this.cardOf(this.openTrigger);
          const links = Array.from(card.querySelectorAll<HTMLElement>(FOCUSABLE));
          if (target === this.openTrigger && !event.shiftKey && links[0]) {
            event.preventDefault();
            links[0].focus();
          } else if (target === links[0] && event.shiftKey) {
            event.preventDefault();
            this.openTrigger.focus();
          } else if (target === links[links.length - 1] && !event.shiftKey) {
            const next = this.items[this.items.indexOf(this.openTrigger) + 1];
            this.closeCard();
            if (next) {
              event.preventDefault();
              next.focus();
            }
          }
        });

        this.on(this.mobileTrigger, 'click', () => {
          this.setMobile(this.mobileTrigger.getAttribute('aria-expanded') !== 'true');
        });

        // The switch shows the scheme of the page, also after a change of the system.
        this.on(this.schemeToggle, 'click', () => {
          chooseColorScheme(currentColorScheme() === 'dark' ? 'light' : 'dark');
        });

        // These listeners are on <html> and on the media query.
        // disconnectedCallback() removes them.
        const root = document.documentElement;
        this.on(root, 'colorschemechange', () => this.showScheme());
        this.on(root, 'click', (event) => {
          if (!this.contains(event.target as Node)) this.closeCard();
        });
        this.on(root, 'keydown', (event) => {
          if (event.key !== 'Escape') return;
          // An open modal (the search) closes on Escape. The menu stays open
          // under it, thus the focus can go back to the menu.
          if (document.querySelector('[aria-modal="true"]')) return;
          if (this.openTrigger) this.closeCard(true);
          if (this.mobileTrigger.getAttribute('aria-expanded') === 'true') {
            this.setMobile(false, true);
          }
        });

        const onDesktopChange = () => {
          this.closeCard();
          this.setMobile(false);
          this.restIndicator();
        };
        DESKTOP.addEventListener('change', onDesktopChange);
        this.eventListenerRemovers.push(() =>
          DESKTOP.removeEventListener('change', onDesktopChange),
        );

        this.showScheme();
      }

      point(item: HTMLElement | null) {
        this.pointed = item;
        this.restIndicator();
      }

      // The pill goes to the pointed item, else to the open item, else to
      // the item of the page. With none of them, it fades out where it is.
      restIndicator() {
        const target =
          this.pointed ??
          this.openTrigger ??
          this.items.find((item) => item.hasAttribute('aria-current'));
        if (!target) {
          this.list.removeAttribute('data-indicator-shown');
          return;
        }
        this.list.style.setProperty('--indicator-x', `${target.offsetLeft}px`);
        this.list.style.setProperty('--indicator-width', `${target.offsetWidth}px`);
        this.list.setAttribute('data-indicator-shown', '');
      }

      cardOf(trigger: HTMLButtonElement) {
        return this.$(`#${trigger.getAttribute('aria-controls')}`);
      }

      firstLinkOf(card: HTMLElement) {
        return card.querySelector<HTMLElement>(FOCUSABLE);
      }

      // The shell takes the place and the size of the card of the trigger.
      // From closed, it grows down from the header and the rows arrive one
      // after the other. From another card, it glides to the new shape while
      // the two contents cross-fade.
      openCard(trigger: HTMLButtonElement) {
        if (this.openTrigger === trigger) return;
        const previous = this.openTrigger;
        const card = this.cardOf(trigger);
        const shell = this.shell;
        // The card on screen now: of the open item, or of a close in
        // progress. Only that card and the new one stay active.
        const shownCard = this.shownCard;
        this.shownCard = card;
        for (const other of this.$$('[data-card]')) {
          if (other !== card && other !== shownCard) other.removeAttribute('data-active');
        }

        previous?.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-expanded', 'true');
        this.openTrigger = trigger;

        // The shape on screen now, under the animations in progress. Then
        // the animations stop: a running one overrides the layout, and the
        // target must be measured from the plain layout.
        const from = {
          left: shell.offsetLeft,
          width: shell.offsetWidth,
          height: shell.offsetHeight,
        };
        for (const animation of shell.getAnimations()) animation.cancel();
        this.closing = null;
        // The fade-out of an earlier morph fills forwards: it must not hide the card now.
        for (const animation of card.getAnimations()) animation.cancel();
        card.setAttribute('data-active', '');
        shell.style.setProperty('--card-x', `${trigger.offsetLeft}px`);
        shell.style.setProperty('--card-width', `${card.offsetWidth}px`);
        shell.style.setProperty('--card-height', `${card.offsetHeight}px`);
        shell.setAttribute('data-open', '');
        const to = { left: shell.offsetLeft, width: shell.offsetWidth, height: shell.offsetHeight };
        this.restIndicator();

        // The shell already shows this card: a close in progress stopped.
        if (shownCard === card) return;

        if (shownCard) {
          for (const animation of shownCard.getAnimations()) animation.cancel();
          shownCard
            .animate([{ opacity: 1 }, { opacity: 0 }], { duration: ms(120), fill: 'forwards' })
            .finished.then(
              () => {
                // The card can be open again by now.
                if (this.shownCard !== shownCard) shownCard.removeAttribute('data-active');
              },
              () => {},
            );
          card.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: ms(200),
            delay: ms(60),
            fill: 'backwards',
          });
          shell.animate(
            [
              { left: `${from.left}px`, width: `${from.width}px`, height: `${from.height}px` },
              { left: `${to.left}px`, width: `${to.width}px`, height: `${to.height}px` },
            ],
            { duration: ms(300), easing: EASE },
          );
        } else {
          shell.animate([{ height: '0px' }, { height: `${to.height}px` }], {
            duration: ms(260),
            easing: EASE,
          });
          card.querySelectorAll<HTMLElement>('[data-card-row]').forEach((row, i) => {
            row.animate(
              [
                { opacity: 0, transform: 'translateY(4px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: ms(200), delay: ms(60 + i * 20), easing: 'ease-out', fill: 'backwards' },
            );
          });
        }
      }

      closeCard(returnFocus = false) {
        const trigger = this.openTrigger;
        if (!trigger) return;
        const card = this.cardOf(trigger);
        const shell = this.shell;
        trigger.setAttribute('aria-expanded', 'false');
        this.openTrigger = null;
        const closing = shell.animate([{ opacity: 1 }, { opacity: 0 }], { duration: ms(100) });
        this.closing = closing;
        closing.finished.then(
          () => {
            shell.removeAttribute('data-open');
            card.removeAttribute('data-active');
            this.shownCard = null;
            this.closing = null;
          },
          // A new open cancelled the close: the shell stays.
          () => {},
        );
        this.restIndicator();
        if (returnFocus) trigger.focus();
      }

      // Mobile nav. The panel hangs from the header, thus the page goes to
      // the top, and it does not scroll while the panel is open.
      setMobile(open: boolean, returnFocus = false) {
        this.mobileTrigger.setAttribute('aria-expanded', String(open));
        this.mobilePanel.hidden = !open;
        if (open) window.scrollTo({ top: 0, behavior: 'instant' });
        document.documentElement.style.overflow = open ? 'hidden' : '';
        if (!open && returnFocus) this.mobileTrigger.focus();
      }

      showScheme() {
        this.schemeToggle.setAttribute('aria-pressed', String(currentColorScheme() === 'dark'));
      }
    },
  );
</script>
