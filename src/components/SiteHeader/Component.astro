---
import {
  faChevronDown,
  faEllipsisVertical,
  faMagnifyingGlass,
  faMinus,
  faPlus,
} from '@fortawesome/pro-regular-svg-icons';
import { faCircleHalfStroke } from '@fortawesome/pro-solid-svg-icons';
import { Button } from '~/components/Button';
import { DatoLogo } from '~/components/DatoLogo';
import { Icon } from '~/components/Icon';
import { NavLink } from '~/components/NavLink';
import type { NavGroup } from '~/data/navigation';
import { dashboardUrl } from '~/lib/datocms/dashboardUrl';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props {
  /** Must match the hero of the page. */
  variant?: 'default' | 'light' | 'dark';
  nav: NavGroup[];
  /** Must match the hero of the page. Without a theme, the header inherits the theme of the page. */
  theme?: Theme;
  /**
   * The look of the CTA. Without it, the CTA is soft on the default header
   * and solid on the other headers.
   */
  ctaVariant?: 'solid' | 'soft';
}

const { variant = 'default', nav, theme, ctaVariant: ctaVariantProp } = Astro.props;

const variantClass = {
  default: styles.variantDefault,
  light: styles.variantLight,
  dark: styles.variantDark,
}[variant];

const ctaAppearance = {
  default: 'deep-on-white',
  light: 'deep-on-light',
  dark: 'light-on-deep',
}[variant] as 'deep-on-white' | 'deep-on-light' | 'light-on-deep';

// On the default header the CTA is a soft pill.
const ctaVariant = ctaVariantProp ?? (variant === 'default' ? 'soft' : 'solid');

const panelId = (i: number) => `site-header-mega-${i}`;
---

<site-header class={styles.root}>
  <header class:list={[styles.header, variantClass]} data-theme={theme}>
    <div class={styles.bar}>
      <a href="/" class={styles.logo} aria-label="DatoCMS home">
        <DatoLogo version="long" height={20} />
      </a>

      <nav aria-label="Main" class={styles.nav}>
        <ul class={styles.navList}>
          {
            nav.map((group, i) => (
              <li>
                {group.columns ? (
                  <button
                    type="button"
                    class:list={[styles.navItem, 'subtitleMedium']}
                    aria-expanded="false"
                    aria-controls={panelId(i)}
                    data-mega-trigger
                  >
                    {group.label}
                    <span class={styles.chevron}>
                      <Icon icon={faChevronDown} />
                    </span>
                  </button>
                ) : (
                  <a
                    href={group.href}
                    class:list={[styles.navItem, 'subtitleMedium']}
                    data-mega-plain
                  >
                    {group.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>

        {
          nav.map(
            (group, i) =>
              group.columns && (
                <div id={panelId(i)} class={styles.mega} hidden data-mega-panel>
                  <div class={styles.megaColumns}>
                    {group.columns.map((column) => (
                      <div class={styles.megaColumn}>
                        {column.sections.map((section) => (
                          <div class={styles.megaSection}>
                            <div class={styles.megaGroup}>
                              <p class:list={[styles.megaHeading, 'subtitleMedium']}>
                                {section.heading}
                              </p>
                              <ul class={styles.megaLinks}>
                                {section.links.map((link) => (
                                  <li class={styles.megaLink}>
                                    <NavLink href={link.href}>{link.label}</NavLink>
                                    {link.description && (
                                      <p class:list={[styles.description, 'caption']}>
                                        {link.description}
                                      </p>
                                    )}
                                  </li>
                                ))}
                              </ul>
                            </div>
                            {section.allLink && (
                              <a href={section.allLink.href} class:list={[styles.allLink, 'h2']}>
                                <span aria-hidden="true">→</span>
                                <span class={styles.allLabel}>{section.allLink.label}</span>
                              </a>
                            )}
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              ),
          )
        }
      </nav>

      <div class={styles.actions}>
        <button
          type="button"
          class={styles.search}
          aria-label="Search"
          aria-haspopup="dialog"
          aria-keyshortcuts="Meta+K Control+K"
          data-search-open
        >
          <Icon icon={faMagnifyingGlass} />
        </button>
        <button
          type="button"
          class={styles.scheme}
          aria-label="Dark mode"
          aria-pressed="false"
          data-scheme-toggle
        >
          <Icon icon={faCircleHalfStroke} />
        </button>
        <a href={dashboardUrl('/login')} class:list={[styles.login, 'subtitleMedium']}>Login</a>
        <Button
          appearance={ctaAppearance}
          variant={ctaVariant}
          href={dashboardUrl('/signup')}
          arrow={false}>Get Started</Button
        >
        <button
          type="button"
          class={styles.dots}
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="site-header-mobile-nav"
          data-mobile-trigger
        >
          <Icon icon={faEllipsisVertical} />
        </button>
      </div>
    </div>

    <div id="site-header-mobile-nav" class={styles.mobileNav} hidden data-mobile-panel>
      <ul class={styles.mobileList}>
        {
          nav.map((group) => (
            <li class={styles.mobileItem}>
              {group.columns ? (
                <details name="site-header-mobile-nav" class={styles.mobileGroup}>
                  <summary class:list={[styles.mobileSummary, 'h1']}>
                    {group.label}
                    <span class={styles.toggle} aria-hidden="true">
                      <Icon icon={faPlus} class={styles.plus} />
                      <Icon icon={faMinus} class={styles.minus} />
                    </span>
                  </summary>
                  <div class={styles.mobileGroupBody}>
                    {group.columns
                      .flatMap((column) => column.sections)
                      .map((section) => (
                        <div class={styles.mobileSection}>
                          <p class:list={[styles.megaHeading, 'subtitleMedium']}>
                            {section.heading}
                          </p>
                          {section.links.map((link) =>
                            link.description ? (
                              <div class={styles.megaLink}>
                                <NavLink href={link.href}>{link.label}</NavLink>
                                <p class:list={[styles.description, 'caption']}>
                                  {link.description}
                                </p>
                              </div>
                            ) : (
                              <NavLink href={link.href}>{link.label}</NavLink>
                            ),
                          )}
                          {section.allLink && (
                            <a href={section.allLink.href} class:list={[styles.allLink, 'h2']}>
                              <span aria-hidden="true">→</span>
                              <span class={styles.allLabel}>{section.allLink.label}</span>
                            </a>
                          )}
                        </div>
                      ))}
                  </div>
                </details>
              ) : (
                <a
                  href={group.href ?? '#'}
                  class:list={[styles.mobileSummary, styles.mobileLink, 'h1']}
                >
                  {group.label}
                </a>
              )}
            </li>
          ))
        }
        {/* Below 768 the bar has no search button: the menu has it. */}
        <li class:list={[styles.mobileItem, styles.mobileOnly]}>
          <button
            type="button"
            class:list={[styles.mobileSummary, styles.mobileLink, 'h1']}
            aria-haspopup="dialog"
            data-search-open
          >
            Search
          </button>
        </li>
        <li class:list={[styles.mobileItem, styles.mobileOnly]}>
          <a
            href={dashboardUrl('/login')}
            class:list={[styles.mobileSummary, styles.mobileLink, 'h1']}>Login</a
          >
        </li>
      </ul>
    </div>
  </header>
</site-header>

<script>
  import { chooseColorScheme, currentColorScheme } from '~/lib/colorScheme';
  import { WebComponent } from '~/lib/WebComponent';

  const DESKTOP = window.matchMedia('(min-width: 1152px)');
  const HOVER = window.matchMedia('(hover: hover)');

  customElements.define(
    'site-header',
    class SiteHeader extends WebComponent {
      openTrigger: HTMLButtonElement | null = null;
      mobileTrigger!: HTMLButtonElement;
      mobilePanel!: HTMLElement;
      schemeToggle!: HTMLButtonElement;

      parsedCallback() {
        this.mobileTrigger = this.$<HTMLButtonElement>('[data-mobile-trigger]');
        this.mobilePanel = this.$('[data-mobile-panel]');
        this.schemeToggle = this.$<HTMLButtonElement>('[data-scheme-toggle]');

        // Mega-menu. No animation: the panels swap at once.
        for (const trigger of this.$$<HTMLButtonElement>('[data-mega-trigger]')) {
          this.on(trigger, 'mouseenter', () => {
            if (DESKTOP.matches && HOVER.matches) this.openMega(trigger);
          });
          this.on(trigger, 'click', () => {
            if (this.openTrigger === trigger) this.closeMega();
            else this.openMega(trigger);
          });
        }
        for (const plain of this.$$('[data-mega-plain]')) {
          this.on(plain, 'mouseenter', () => this.closeMega());
        }
        this.on(this, 'mouseleave', () => {
          if (HOVER.matches) this.closeMega();
        });

        this.on(this.mobileTrigger, 'click', () => {
          this.setMobile(this.mobileTrigger.getAttribute('aria-expanded') !== 'true');
        });

        // The switch shows the scheme of the page, also after a change of the system.
        this.on(this.schemeToggle, 'click', () => {
          chooseColorScheme(currentColorScheme() === 'dark' ? 'light' : 'dark');
        });

        // These listeners are on <html> and on the media query.
        // disconnectedCallback() removes them.
        const root = document.documentElement;
        this.on(root, 'colorschemechange', () => this.showScheme());
        this.on(root, 'click', (event) => {
          if (!this.contains(event.target as Node)) this.closeMega();
        });
        this.on(root, 'keydown', (event) => {
          if (event.key !== 'Escape') return;
          // An open modal (the search) closes on Escape. The menu stays open
          // under it, thus the focus can go back to the menu.
          if (document.querySelector('[aria-modal="true"]')) return;
          if (this.openTrigger) this.closeMega(true);
          if (this.mobileTrigger.getAttribute('aria-expanded') === 'true') {
            this.setMobile(false, true);
          }
        });

        const onDesktopChange = () => {
          this.closeMega();
          this.setMobile(false);
        };
        DESKTOP.addEventListener('change', onDesktopChange);
        this.eventListenerRemovers.push(() =>
          DESKTOP.removeEventListener('change', onDesktopChange),
        );

        this.showScheme();
      }

      panelOf(trigger: HTMLButtonElement) {
        return this.$(`#${trigger.getAttribute('aria-controls')}`);
      }

      openMega(trigger: HTMLButtonElement) {
        if (this.openTrigger === trigger) return;
        this.closeMega();
        trigger.setAttribute('aria-expanded', 'true');
        this.panelOf(trigger).removeAttribute('hidden');
        this.openTrigger = trigger;
      }

      closeMega(returnFocus = false) {
        const trigger = this.openTrigger;
        if (!trigger) return;
        trigger.setAttribute('aria-expanded', 'false');
        this.panelOf(trigger).setAttribute('hidden', '');
        this.openTrigger = null;
        if (returnFocus) trigger.focus();
      }

      // Mobile nav. The page does not scroll while it is open.
      setMobile(open: boolean, returnFocus = false) {
        this.mobileTrigger.setAttribute('aria-expanded', String(open));
        this.mobilePanel.hidden = !open;
        document.documentElement.style.overflow = open ? 'hidden' : '';
        if (!open && returnFocus) this.mobileTrigger.focus();
      }

      showScheme() {
        this.schemeToggle.setAttribute('aria-pressed', String(currentColorScheme() === 'dark'));
      }
    },
  );
</script>
