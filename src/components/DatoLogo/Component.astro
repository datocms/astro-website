---
import long from '~/assets/logo/wordmark.svg?raw';
import short from '~/assets/logo/symbol.svg?raw';
import styles from './style.module.css';

interface Props {
  /** `long` is the wordmark. `short` is the symbol alone. */
  version?: 'short' | 'long';
  /** Height in px. The width follows the aspect ratio. */
  height?: number;
  /** Accessible name. Without it, the logo is decorative. */
  label?: string;
  class?: string;
}

const { version = 'long', height = 20, label, class: className } = Astro.props;

const svg = { short, long }[version];
---

<span
  class:list={[styles.logo, className]}
  style={`--logo-height: ${height}px`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={svg}
/>
