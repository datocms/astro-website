---
import styles from './style.module.css';

interface Props {
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

{
  /*
  A row of cards (CarouselCard) that scrolls on the horizontal axis. The
  cards snap to the start of the row. Only CSS: no buttons, no JS.
*/
}
<div class:list={[styles.carousel, className]} role="list" aria-label={label}>
  <slot />
</div>
