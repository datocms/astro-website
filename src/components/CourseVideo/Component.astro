---
import { courseVideo } from '~/data/academy';
import { PixelVideo } from '~/components/PixelVideo';
import { pxvHeader } from '~/lib/pixel-video/headers';
import styles from './style.module.css';

interface Props {
  /** The slug of the course. It selects the video. */
  slug: string;
  /**
   * Set the height here, from `--cells` (the height of the file in cells):
   * `calc(var(--cells) * 3px)` gives squares of 3px to each video.
   */
  class?: string;
  /**
   * `tonal`: for the inverse surface. `onAccent`: for the accent
   * surface.
   */
  palette?: 'tonal' | 'onAccent';
}

const { slug, class: className, palette = 'tonal' } = Astro.props;
const { src } = courseVideo(slug);
const cells = pxvHeader(src).height;
---

{
  /*
  The picture of a course: a pixel video with no frame. The palette of the
  file does not apply: the palette is tonal on the inverse surface, or
  onAccent on the accent surface. The ground of the palette fills
  the element.
*/
}
<PixelVideo
  src={src}
  palette={palette}
  class:list={[styles.video, className]}
  style={`--cells: ${cells}`}
/>
