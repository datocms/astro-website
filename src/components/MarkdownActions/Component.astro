---
import { faClaude, faMarkdown, faOpenai } from '@fortawesome/free-brands-svg-icons';
import { faCheck, faChevronDown, faCopy, faLink } from '@fortawesome/pro-regular-svg-icons';
import { Icon } from '~/components/Icon';
import styles from './style.module.css';

interface Props {
  /** The address of the Markdown version of the page (the page address + ".md"). */
  markdownUrl: string;
  /**
   * "soft" (default): a soft button of 40px, with the menu centred under it.
   * "quiet": a smaller pill with no fill and a hairline, with the menu at its
   * left edge. For a narrow column, for example the table of contents.
   */
  variant?: 'soft' | 'quiet';
  class?: string;
}

const { markdownUrl, variant = 'soft', class: className } = Astro.props;
const request = `Read ${markdownUrl} so I can ask questions about it.`;
const links = [
  { label: 'View as Markdown', href: markdownUrl, icon: faMarkdown },
  {
    label: 'Open in ChatGPT',
    href: `https://chatgpt.com/?hints=search&q=${encodeURIComponent(request)}`,
    icon: faOpenai,
  },
  {
    label: 'Open in Claude',
    href: `https://claude.ai/new?q=${encodeURIComponent(request)}`,
    icon: faClaude,
  },
];
---

{
  /*
  A button that copies the page as Markdown, and a menu with more actions
  on the Markdown version. Without JS the buttons cannot copy, thus the
  control stays hidden. The search index skips it.
*/
}
<markdown-actions
  class:list={[styles.root, variant === 'quiet' && styles.quiet, className]}
  data-markdown-actions={markdownUrl}
  data-datocms-noindex
  hidden
>
  <div class={styles.pill}>
    <button type="button" class:list={[styles.part, 'labelMedium']} data-action="copy-page">
      <span class={styles.icon} data-icon="copy"><Icon icon={faCopy} /></span>
      <span class={styles.icon} data-icon="done" hidden><Icon icon={faCheck} /></span>
      <span data-label>Copy page</span>
    </button>
    <button
      type="button"
      class:list={[styles.part, styles.toggle]}
      aria-label="More actions on the Markdown version"
      aria-expanded="false"
      data-action="toggle"
    >
      <span class={styles.chevron}><Icon icon={faChevronDown} /></span>
    </button>
  </div>
  <ul class={styles.menu} data-menu hidden>
    <li>
      <button type="button" class:list={[styles.item, 'caption']} data-action="copy-link">
        <span class={styles.icon}><Icon icon={faLink} /></span>
        Copy Markdown link
      </button>
    </li>
    {
      links.map((link) => (
        <li>
          <a
            class:list={[styles.item, 'caption']}
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class={styles.icon}>
              <Icon icon={link.icon} />
            </span>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</markdown-actions>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  customElements.define(
    'markdown-actions',
    class extends WebComponent {
      #documentListeners = new AbortController();

      parsedCallback() {
        const url = this.dataset.markdownActions ?? '';
        const copyPage = this.$<HTMLButtonElement>('[data-action="copy-page"]');
        const copyLink = this.$<HTMLButtonElement>('[data-action="copy-link"]');
        const toggle = this.$<HTMLButtonElement>('[data-action="toggle"]');
        const menu = this.$('[data-menu]');
        const label = this.$('[data-label]');
        const copyIcon = this.$('[data-icon="copy"]');
        const doneIcon = this.$('[data-icon="done"]');
        let timer: ReturnType<typeof setTimeout> | undefined;
        this.hidden = false;

        const setOpen = (open: boolean) => {
          menu.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        };

        // For one second, the button shows that the copy is done.
        const showDone = () => {
          copyIcon.hidden = true;
          doneIcon.hidden = false;
          label.textContent = 'Copied';
          clearTimeout(timer);
          timer = setTimeout(() => {
            copyIcon.hidden = false;
            doneIcon.hidden = true;
            label.textContent = 'Copy page';
          }, 1000);
        };

        const fetchMarkdown = async () => {
          const response = await fetch(url);
          if (!response.ok) throw new Error(`Status ${response.status}`);
          return response.text();
        };

        const copyPageText = async () => {
          // Safari keeps the user gesture only when the promise goes into the ClipboardItem.
          if (typeof ClipboardItem !== 'undefined') {
            const blob = fetchMarkdown().then((text) => new Blob([text], { type: 'text/plain' }));
            await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
          } else {
            await navigator.clipboard.writeText(await fetchMarkdown());
          }
        };

        this.on(copyPage, 'click', async () => {
          copyPage.setAttribute('aria-busy', 'true');
          try {
            await copyPageText();
            showDone();
          } catch (error) {
            console.error('[MarkdownActions] cannot copy the page', error);
          } finally {
            copyPage.removeAttribute('aria-busy');
          }
        });

        this.on(copyLink, 'click', async () => {
          setOpen(false);
          try {
            await navigator.clipboard.writeText(url);
            showDone();
          } catch (error) {
            console.error('[MarkdownActions] cannot copy the link', error);
          }
        });

        this.on(toggle, 'click', () => setOpen(menu.hidden));
        this.on(menu, 'click', 'a', () => setOpen(false));
        document.addEventListener(
          'click',
          (event) => {
            if (!this.contains(event.target as Node)) setOpen(false);
          },
          { signal: this.#documentListeners.signal },
        );
        this.on(this, 'keydown', (event) => {
          if (event.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });
      }

      disconnectedCallback() {
        super.disconnectedCallback();
        this.#documentListeners.abort();
      }
    },
  );
</script>
