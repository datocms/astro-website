---
import type { HTMLAttributes } from 'astro/types';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';
import type { ButtonImage, ButtonSize, ButtonVariant } from './types';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  /** A 20px userpic or a stack of 20px logos before the label. */
  leading?: 'userpic' | 'logos';
  leadingImages?: ButtonImage[];
  arrow?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /**
   * `span` draws the button inside a control that already is a link or a
   * button (a card that links). It has no behaviour of its own.
   */
  as?: 'span';
  /** Overrides the theme of the section. Use only for deliberate exceptions. */
  theme?: Theme;
  class?: string;
  attrs?: HTMLAttributes<'a'> & HTMLAttributes<'button'>;
}

const {
  variant = 'solid',
  size = 'm',
  leading,
  leadingImages = [],
  arrow = true,
  href,
  type = 'button',
  disabled = false,
  as,
  theme,
  class: className,
  attrs,
} = Astro.props;

const classes = [
  styles.button,
  'labelMedium',
  variant === 'accent' && styles.accent,
  variant === 'soft' && styles.soft,
  size === 'l' && styles.large,
  leading && styles.hasLeading,
  className,
];

// The leading images keep the same inset from the top, the side and the bottom.
const imageSize = size === 'l' ? 24 : 20;

const Tag = as ?? (href && !disabled ? 'a' : 'button');
const tagProps = Tag === 'a' ? { href } : Tag === 'button' ? { type, disabled } : {};
---

<Tag class:list={classes} data-theme={theme} {...tagProps} {...attrs}>
  {
    leading && (
      <span class:list={[styles.leading, leading === 'logos' && styles.logos]}>
        {leadingImages.map((img) => (
          <img src={img.src} alt={img.alt ?? ''} width={imageSize} height={imageSize} />
        ))}
      </span>
    )
  }
  <span class={styles.label}>
    <slot />
    {arrow && <span aria-hidden="true"> →</span>}
  </span>
</Tag>
