---
import type { HTMLAttributes } from 'astro/types';
import type { Theme } from '~/lib/theme';
import { ContactCard } from '~/components/ContactCard';
import styles from './style.module.css';
import { logos as logoMarks } from '~/components/Emoji/emojis';
import type { ButtonSize, ButtonVariant, ContactPoint, FrameworkLogo } from './types';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  /** The marks of frameworks before the label, 20px tall (24px in size l). */
  logos?: FrameworkLogo[];
  /**
   * The team that answers this button. On hover and on focus, a card above
   * the button shows the faces, the names and the role of the people.
   */
  contact?: ContactPoint;
  arrow?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  /**
   * `span` draws the button inside a control that already is a link or a
   * button (a card that links). It has no behaviour of its own.
   */
  as?: 'span';
  /** Overrides the theme of the section. Use only for deliberate exceptions. */
  theme?: Theme;
  class?: string;
  attrs?: HTMLAttributes<'a'> & HTMLAttributes<'button'>;
}

const {
  variant = 'solid',
  size = 'm',
  logos = [],
  contact,
  arrow = true,
  href,
  type = 'button',
  disabled = false,
  as,
  theme,
  class: className,
  attrs,
} = Astro.props;

// A button inside a link has no card: the link is the control.
const card = contact && !as && !disabled ? contact : undefined;

const classes = [
  styles.button,
  'labelMedium',
  variant === 'accent' && styles.accent,
  variant === 'soft' && styles.soft,
  size === 'l' && styles.large,
  logos.length > 0 && styles.hasLeading,
  card && styles.hasContact,
  className,
];

const Tag = as ?? (href && !disabled ? 'a' : 'button');
const tagProps = Tag === 'a' ? { href } : Tag === 'button' ? { type, disabled } : {};
---

<Tag
  class:list={classes}
  data-theme={theme}
  data-contact-host={card ? '' : undefined}
  {...tagProps}
  {...attrs}
>
  {
    logos.length > 0 && (
      <span class={styles.logos} aria-hidden="true">
        {logos.map((name) => (
          <span class={styles.logo} data-logo={name} set:html={logoMarks[name]} />
        ))}
      </span>
    )
  }
  {card && <ContactCard contact={card} />}
  <span class:list={[styles.label, 'capTrim']}>
    <slot />
    {arrow && <span aria-hidden="true"> →</span>}
  </span>
</Tag>
