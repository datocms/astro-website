---
import { stripStega } from '@datocms/astro';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { buildUrlForPlugin } from '~/lib/datocms/gqlUrlBuilder/plugin';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { PluginCardFragment } from './graphql';
import OfficialBadge from './OfficialBadge.astro';
import styles from './style.module.css';

interface Props {
  plugin: FragmentOf<typeof PluginCardFragment>;
  /**
   * `horizontal` puts a small image at the left of the text. `responsive`
   * is horizontal on a phone and vertical from 768px.
   */
  orientation?: 'vertical' | 'horizontal' | 'responsive';
  /** Show the install count below the description (for a list in the order of installs). */
  showInstalls?: boolean;
}

const { plugin: maskedPlugin, orientation = 'vertical', showInstalls = false } = Astro.props;
const plugin = readFragment(PluginCardFragment, maskedPlugin);

/*
 * A plugin with no cover gets a cover of its name, on the accent of a
 * theme. The name selects the theme, thus a plugin always has the same
 * colour, and the next plugin usually has a different colour.
 */
const coverThemes = ['yellow', 'orange', 'green', 'purple', 'blue', 'pink'] as const;

function themeForName(name: string) {
  let hash = 0;
  for (const char of name) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
  return coverThemes[hash % coverThemes.length];
}

/*
 * The official badge stays on the line of the last word: it never wraps
 * alone. In draft mode the title ends with the stega of Content Link: the
 * words come from the text without it, and the stega stays at the end.
 */
const cleanTitle = stripStega(plugin.title);
const stega = plugin.title.startsWith(cleanTitle) ? plugin.title.slice(cleanTitle.length) : '';
const titleWords = cleanTitle.trim().split(/\s+/);
const lastWord = titleWords.pop();
const firstWords = titleWords.length > 0 ? `${titleWords.join(' ')} ` : '';

/*
 * The width of the cover on the screen, for a browser with no
 * `sizes="auto"` (Safari): 96px in a row, at most 360px in a card.
 */
const sizes = {
  horizontal: 'auto, 96px',
  responsive: 'auto, (min-width: 768px) 360px, 96px',
  vertical: 'auto, (min-width: 768px) 360px, 100vw',
};

// The search results come from Algolia. A result can have no install count.
const installs = showInstalls && typeof plugin.installs === 'number' ? plugin.installs : undefined;
---

<a
  href={buildUrlForPlugin(plugin)}
  class:list={[
    styles.card,
    orientation === 'horizontal' && styles.horizontal,
    orientation === 'responsive' && styles.responsive,
  ]}
>
  <span class={styles.image}>
    {
      plugin.coverImage ? (
        <ResponsiveImage data={plugin.coverImage.responsiveImage} sizes={sizes[orientation]} />
      ) : (
        <span
          class:list={[styles.nameCover, 'surfaceAccent']}
          data-theme={themeForName(plugin.title)}
          aria-hidden="true"
        >
          <span class={styles.nameCoverText}>{plugin.title}</span>
        </span>
      )
    }
  </span>
  <span class={styles.text}>
    <span class:list={[styles.title, 'bodyMedium']}>
      {
        plugin.author?.official ? (
          <>
            {firstWords}
            <span class={styles.lastWord}>
              {lastWord}
              {stega}
              <OfficialBadge />
            </span>
          </>
        ) : (
          plugin.title
        )
      }
    </span>
    <span class:list={[styles.description, 'label']}>{plugin.description}</span>
    {
      installs !== undefined && (
        <span class:list={[styles.installs, 'caption', 'tabular']}>
          {installs.toLocaleString('en-US')} {installs === 1 ? 'install' : 'installs'}
        </span>
      )
    }
  </span>
</a>
