---
import { Tooltip } from '~/components/Tooltip';
import symbol from '~/assets/logo/dato-symbol.svg?raw';
import styles from './badge.module.css';

interface Props {
  /**
   * The size of the icon in px. Without it, the D has the height of the
   * capital letters of the text around it, as a letter of the text.
   */
  size?: number;
  class?: string;
}

const { size, class: className } = Astro.props;
---

{
  /*
    The "D" of DatoCMS, in the color of the text around it. The tooltip
    shows the text on hover, the hidden text is for screen readers.
  */
}
<Tooltip class:list={[styles.badge, className]}>
  <span class={styles.icon} style={size ? `--badge-size: ${size}px` : undefined} aria-hidden="true">
    <Fragment set:html={symbol} />
  </span>
  <span class="visuallyHidden">DatoCMS Official Plugin</span>
  <Fragment slot="tooltip">DatoCMS Official Plugin</Fragment>
</Tooltip>
