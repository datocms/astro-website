---
import dIcon from '~/svg/datocms/icon/color/color_d_icon.svg?raw';
import styles from './badge.module.css';

interface Props {
  /** The size of the icon in px. */
  size?: number;
  class?: string;
}

const { size = 16, class: className } = Astro.props;
---

{/* The "D" of DatoCMS. The title shows on hover, the hidden text is for screen readers. */}
<span
  class:list={[styles.badge, className]}
  title="DatoCMS Official Plugin"
  style={`--badge-size: ${size}px`}
>
  <Fragment set:html={dIcon} />
  <span class="visuallyHidden">DatoCMS Official Plugin</span>
</span>
