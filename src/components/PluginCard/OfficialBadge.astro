---
import { Tooltip } from '~/components/Tooltip';
import dIcon from '~/svg/datocms/icon/color/color_d_icon.svg?raw';
import styles from './badge.module.css';

interface Props {
  /** The size of the icon in px. */
  size?: number;
  class?: string;
}

const { size = 16, class: className } = Astro.props;

// Remove the <title> of the file: the browser shows it on hover.
const icon = dIcon.replace(/<title>[\s\S]*?<\/title>/, '');
---

{
  /* The "D" of DatoCMS. The tooltip shows the text on hover, the hidden text is for screen readers. */
}
<Tooltip class:list={[styles.badge, className]}>
  <span class={styles.icon} style={`--badge-size: ${size}px`} aria-hidden="true">
    <Fragment set:html={icon} />
  </span>
  <span class="visuallyHidden">DatoCMS Official Plugin</span>
  <Fragment slot="tooltip">DatoCMS Official Plugin</Fragment>
</Tooltip>
