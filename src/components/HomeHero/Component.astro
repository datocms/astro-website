---
import { ButtonGroup } from '~/components/ButtonGroup';
import { Headline } from '~/components/Headline';
import { LogosLine } from '~/components/LogosLine';
import { Section } from '~/components/Section';
import type { HomeHeroData } from '~/data/home';
import { faceStep, faces } from '~/lib/motion/faces';
import type { Step } from '~/lib/motion/typewriter';
import styles from './style.module.css';

type Props = HomeHeroData;

const { headline, subheadline, face, buttons, logosLabel, logos } = Astro.props;

// The timeline of the Hero component, with a human
// rhythm: the words come in bursts, a full stop makes a stop, and the
// writer thinks before the subheadline. The headline and the subheadline
// are typed, then the face plays. The buttons come with the subheadline.
const script: Step[] = [
  { type: 'pause', ms: 750 },
  { type: 'cursor', glyphs: ['•', '~', '-', 'ᴗ', '•'], msPerGlyph: 75 },
  { type: 'pause', ms: 120 },
  { type: 'text', text: headline, speedCps: 42, rhythm: 'human' },
  { type: 'pause', ms: 600 },
  // The buttons fade in when the subheadline starts.
  { type: 'mark', name: 'subheadline' },
  { type: 'text', text: subheadline, speedCps: 52, rhythm: 'human' },
];
// The face (src/lib/motion/faces.ts) comes after a short stop.
if (face) {
  script.push({ type: 'pause', ms: 300 }, faceStep(face));
}
---

<Section
  background="default"
  theme="orange"
  class={styles.hero}
  contentClass={styles.content}
  flush
  data-home-hero
>
  <home-hero-text class={styles.text}>
    <Headline
      as="h1"
      size="headline"
      muted={face ? `${subheadline}\u00A0${faces[face].face}` : subheadline}
      breakBeforeMuted
      typewriter={script}
      typewriterStart="load"
      class={styles.headline}
    >
      {headline}
    </Headline>
    <ButtonGroup
      buttons={buttons}
      size="l"
      class={styles.buttons}
      data-home-hero-buttons=""
      data-await-typewriter=""
    />
  </home-hero-text>

  <div class={styles.trust}>
    <LogosLine logos={logos} label={logosLabel} size="small" class={styles.logos} />
  </div>
</Section>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  // The buttons fade in when the script reaches the `subheadline` mark.
  // If the mark was missed, the end of the typewriter shows them.
  customElements.define(
    'home-hero-text',
    class extends WebComponent {
      parsedCallback() {
        const tw = this.$('[data-typewriter]');
        const buttons = this.$('[data-home-hero-buttons]');
        if (document.documentElement.dataset.motion !== 'on') return;
        if (tw.dataset.twState === 'done') return;
        buttons.dataset.twArmed = '';
        const show = () => (buttons.dataset.visible = 'true');
        this.on<CustomEvent<string>, HTMLElement>(tw, 'typewriter:mark', (event) => {
          if (event.detail === 'subheadline') show();
        });
        this.on(tw, 'typewriter:done', show);
      }
    },
  );
</script>
