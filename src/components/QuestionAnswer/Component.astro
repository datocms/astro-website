---
import { Face } from '~/components/Face';
import { ButtonGroup } from '~/components/ButtonGroup';
import { Section } from '~/components/Section';
import { Typewriter } from '~/components/Typewriter';
import type { QuestionAnswerData } from '~/data/home';
import type { Step } from '~/lib/motion/typewriter';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props extends QuestionAnswerData {
  theme?: Theme;
  /**
   * `square`: the homepage cards, 4:3. `landscape`: 570 × 514 at 1320.
   */
  cardShape?: 'square' | 'landscape';
}

const {
  headline,
  face,
  subline,
  ask,
  install,
  more,
  theme = 'blue',
  cardShape = 'square',
} = Astro.props;
const model = ask.models[0] ?? '';

// Card 1 starts at 0.15s.
const askScript: Step[] = [
  { type: 'text', text: ask.question, speedCps: 55 },
  { type: 'pause', ms: 500 },
  { type: 'shuffle', words: ask.models, ms: 750, every: 100, final: model },
  { type: 'text', text: `: ${ask.answer} `, speedCps: 55 },
  {
    type: 'face',
    frames: [
      { text: '[••]', ms: 400 },
      { text: '[>.<]', ms: 0 },
    ],
  },
];

// Card 2 starts 1.2s after card 1.
const installScript: Step[] = [
  { type: 'cursor', glyphs: ['•', '••', '•', '••'], msPerGlyph: 100 },
  { type: 'face', frames: [{ text: '[••]', ms: 150 }] },
  { type: 'text', text: ` ${install.command}`, speedCps: 55 },
  { type: 'text', text: '~/.', speedCps: 55 },
  { type: 'pause', ms: 350 },
  { type: 'text', text: 'claude/skills/', speedCps: 55 },
  // A mark shows the branch of the folder before the name types.
  ...install.folders.flatMap((folder, index): Step[] => [
    { type: 'mark', name: `branch:${index}` },
    { type: 'text', text: folder, speedCps: 55 },
  ]),
  { type: 'hideCursor' },
];
---

<Section theme={theme} background="accent" contentClass={styles.content}>
  <h2 class:list={[styles.header, 'headline']}>
    {headline}
    {
      face && (
        <>
          {'\u00A0'}
          <Face name={face} />
        </>
      )
    }
    <span class={styles.subline}>{subline}</span>
  </h2>

  <div class:list={[styles.cards, cardShape === 'landscape' && styles.landscape]}>
    <ask-card data-models={JSON.stringify(ask.models)}>
      <article class={styles.card}>
        <h3 class:list={[styles.cardHeader, 'headline']}>
          <a href={ask.href} class={styles.cardLink}>{ask.title}</a>
          <span class={styles.arrow} aria-hidden="true">→</span>
        </h3>
        <div class={styles.body}>
          <Typewriter
            as="div"
            script={askScript}
            start="view"
            threshold={0.5}
            delay={150}
            class={styles.chat}
          >
            <p class:list={[styles.question, 'headline']}>{ask.question}</p>
            <p class:list={[styles.answer, 'headline']}>
              <span data-model>{model}</span><span class={styles.caret} data-caret hidden></span>: {
                ask.answer
              } [&gt;.&lt;]
            </p>
          </Typewriter>
        </div>
      </article>
    </ask-card>

    <article class={styles.card}>
      <h3 class:list={[styles.cardHeader, 'headline']}>
        <a href={install.href} class={styles.cardLink}>{install.title}</a>
        <span class={styles.arrow} aria-hidden="true">→</span>
      </h3>
      <div class={styles.body}>
        <install-tree>
          <Typewriter
            as="div"
            script={installScript}
            start="view"
            threshold={0.5}
            delay={1350}
            class:list={[styles.terminal, 'headline']}
          >
            <p class={styles.question}>{`[••] ${install.command}`}</p>
            <p class={styles.root}>~/.claude/skills/</p>
            <ul class={styles.tree}>
              {
                install.folders.map((folder) => (
                  <li class={styles.branch} data-branch>
                    {folder}
                  </li>
                ))
              }
            </ul>
          </Typewriter>
        </install-tree>
      </div>
    </article>
  </div>

  {
    more && (
      <div class={styles.more}>
        <p class:list={[styles.moreText, 'body']}>{more.text}</p>
        <ButtonGroup buttons={[more.button]} />
      </div>
    )
  }
</Section>

<script>
  import { prefersReducedMotion } from '~/lib/motion/inView';
  import { WebComponent } from '~/lib/WebComponent';

  const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

  // The same question gets the same answer from each model. When the
  // pointer or the focus comes to the card, the name of the model is
  // deleted and the next model types in. The answer does not change.
  customElements.define(
    'ask-card',
    class extends WebComponent {
      parsedCallback() {
        const models = JSON.parse(this.dataset.models || '[]') as string[];
        const card = this.$('article');
        const typewriter = this.$('type-writer');
        const name = this.$('[data-model]');
        const caret = this.$('[data-caret]');
        let current = 0;
        let busy = false;

        const swap = async () => {
          // Wait for the typewriter. Do not start a new swap during a swap.
          if (busy || models.length < 2 || typewriter.dataset.twState !== 'done') return;
          busy = true;
          current = (current + 1) % models.length;
          const next = models[current]!;
          if (prefersReducedMotion()) {
            name.textContent = next;
            busy = false;
            return;
          }
          caret.hidden = false;
          // Delete fast, stop, then type at the speed of the typewriter.
          for (let text = name.textContent ?? ''; text.length > 0;) {
            text = text.slice(0, -1);
            name.textContent = text;
            await sleep(35);
          }
          await sleep(160);
          for (let i = 1; i <= next.length; i += 1) {
            name.textContent = next.slice(0, i);
            await sleep(55 + Math.random() * 30);
          }
          await sleep(450);
          caret.hidden = true;
          busy = false;
        };

        this.on(card, 'pointerenter', (event) => {
          if (event.pointerType === 'mouse') void swap();
        });
        this.on(card, 'focusin', () => void swap());
      }
    },
  );

  // The CSS draws the branches of the tree. While the typewriter runs, a
  // branch shows when its mark comes (`branch:<index>`).
  customElements.define(
    'install-tree',
    class extends WebComponent {
      parsedCallback() {
        const branches = this.$$('[data-branch]');
        this.on<CustomEvent<string>, HTMLElement>(this, 'typewriter:mark', (event) => {
          const [kind, index] = event.detail.split(':');
          if (kind !== 'branch') return;
          branches[Number(index)]?.toggleAttribute('data-shown', true);
        });
      }
    },
  );
</script>
