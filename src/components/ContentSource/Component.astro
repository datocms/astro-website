---
import { ButtonGroup } from '~/components/ButtonGroup';
import { Face } from '~/components/Face';
import symbol from '~/assets/logo/symbol.svg?raw';
import { Section } from '~/components/Section';
import type { ContentSourceData } from '~/data/home';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props extends ContentSourceData {
  /** Without a theme, the section takes the theme of its parent. */
  theme?: Theme;
  /** The ground of the band: the deep ink of the theme, or its paper. */
  background?: 'inverse' | 'default';
}

const {
  headline,
  face,
  paragraph,
  button,
  channels,
  activeChannel,
  theme,
  background = 'inverse',
} = Astro.props;
// Three copies of the list. The active item stays in the middle copy,
// thus there are always items above it and below it.
const activeIndex = channels.length + Math.max(0, channels.indexOf(activeChannel));
const rows = [...channels, ...channels, ...channels];
---

<Section
  theme={theme}
  background={background}
  class:list={[styles.contentSource, background === 'default' && styles.onPage]}
  contentClass={styles.content}
>
  <h2 class:list={[styles.headline, 'title']}>
    {headline}
    {
      face && (
        <>
          {'\u00A0'}
          <Face name={face} />
        </>
      )
    }
  </h2>
  <div class={styles.text}>
    <p class:list={[styles.paragraph, 'body']}>{paragraph}</p>
    <ButtonGroup buttons={[button]} />
  </div>

  <div class={styles.visual} aria-hidden="true">
    <content-source class={styles.lockup}>
      <span class={styles.label}>
        <span class={styles.labelLong}>Single Source</span>
        <span class={styles.labelShort}>Source</span>
      </span>
      <span class={styles.symbol} data-symbol set:html={symbol} />
      <span
        class={styles.reel}
        data-reel
        data-count={channels.length}
        data-start={activeIndex}
        style={`--active-start: ${activeIndex}`}
      >
        <span class={styles.list}>
          {rows.map((channel) => <span class={styles.item}>{channel}</span>)}
        </span>
        {/* The same list in the text colour, cut to the line of the source. */}
        <span class={styles.lit}>
          <span class={styles.list}>
            {rows.map((channel) => <span class={styles.item}>{channel}</span>)}
          </span>
        </span>
      </span>
    </content-source>
  </div>
</Section>

<script>
  import { onVisibilityChange, prefersReducedMotion } from '~/lib/motion/inView';
  import { WebComponent } from '~/lib/WebComponent';

  // The scroll of the page turns the reel a little, and a spring stops it
  // on a channel. At rest, the reel moves one channel every STEP_MS.
  // Units: rows and seconds.
  const STEP_MS = 800;
  // After a scroll, the reel stays on its channel for this time.
  const REST_AFTER_SCROLL_MS = 1600;
  // The scroll that turns the reel by one row.
  const PX_PER_ROW = 150;
  // A fast scroll turns the reel at this speed at most, and by this many rows at most.
  const MAX_SPEED = 8;
  const MAX_PENDING = 3;
  const STIFFNESS = 170;
  const DAMPING = 2 * 0.55 * Math.sqrt(STIFFNESS);
  // At the maximum speed, the rows stretch this much in height.
  const MAX_STRETCH = 0.08;

  customElements.define(
    'content-source',
    class extends WebComponent {
      parsedCallback() {
        const reel = this.$('[data-reel]');
        const symbol = this.$('[data-symbol]');
        if (prefersReducedMotion()) return;

        const count = Number(reel.dataset.count);
        const start = Number(reel.dataset.start);
        // pos: where the reel is. aim: where the scroll and the steps send it.
        // The spring takes pos to the row nearest to aim.
        let pos = 0;
        let speed = 0;
        let aim = 0;
        // The scroll that the reel has not turned yet.
        let pending = 0;
        let target = 0;
        let landed = true;
        // The time since the last step. It is negative after a scroll.
        let sinceStep = 0;
        let lastY = 0;
        let lastTime = 0;
        let frame = 0;

        const nod = () => {
          symbol.animate([{ scale: 1 }, { scale: 0.92, offset: 0.35 }, { scale: 1 }], {
            duration: 360,
            easing: 'cubic-bezier(0.3, 0, 0, 1)',
          });
        };

        const step = (time: number) => {
          const dt = Math.min((time - lastTime) / 1000, 1 / 30);
          lastTime = time;

          // Keep the centre row in the middle copy. The jump of one copy
          // does not show: the copies are the same.
          const shift = start + pos >= 2 * count ? -count : start + pos < count ? count : 0;
          pos += shift;
          aim += shift;
          target += shift;

          const scrolled = window.scrollY - lastY;
          lastY = window.scrollY;
          if (scrolled !== 0) {
            pending = Math.max(
              -MAX_PENDING,
              Math.min(MAX_PENDING, pending + scrolled / PX_PER_ROW),
            );
            sinceStep = -REST_AFTER_SCROLL_MS / 1000;
          }

          if (pending !== 0) {
            const turn = Math.max(-MAX_SPEED * dt, Math.min(MAX_SPEED * dt, pending));
            aim += turn;
            pending -= turn;
          } else {
            sinceStep += dt;
            if (sinceStep >= STEP_MS / 1000) {
              sinceStep = 0;
              aim = target + 1;
            }
          }

          if (Math.round(aim) !== target) {
            target = Math.round(aim);
            landed = false;
          }

          const before = target - pos;
          speed += (STIFFNESS * before - DAMPING * speed) * dt;
          pos += speed * dt;
          const after = target - pos;
          if (!landed && before * after <= 0) {
            landed = true;
            nod();
          }
          if (Math.abs(after) < 0.001 && Math.abs(speed) < 0.01) {
            pos = target;
            speed = 0;
          }

          const stretch = 1 + Math.min(Math.abs(speed) / MAX_SPEED, 1) * MAX_STRETCH;
          reel.style.setProperty('--offset', pos.toFixed(4));
          reel.style.setProperty('--stretch', stretch.toFixed(3));
          frame = requestAnimationFrame(step);
        };

        onVisibilityChange(this.parentElement ?? this, (visible) => {
          cancelAnimationFrame(frame);
          if (!visible) return;
          lastY = window.scrollY;
          frame = requestAnimationFrame((time) => {
            lastTime = time;
            step(time);
          });
        });
      }
    },
  );
</script>
