---
import { Pagination } from '~/components/Pagination';
import { Section } from '~/components/Section';
import { ProductUpdateRow } from '~/components/ProductUpdateRow';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { formatMonth } from '~/lib/format/date';
import { ProductUpdateListFragment } from './graphql';
import styles from './style.module.css';

interface Props {
  entries: FragmentOf<typeof ProductUpdateListFragment>[];
  /** The links to the other pages of the index. */
  pagination: { page: number; totalPages: number; baseUrl: string };
}

const { pagination } = Astro.props;
const entries = Astro.props.entries.map((entry) => readFragment(ProductUpdateListFragment, entry));

// The entries come newest first: a new group starts at each new month.
const months: { month: string; entries: typeof entries }[] = [];
for (const entry of entries) {
  const month = formatMonth(entry._firstPublishedAt);
  const last = months.at(-1);
  if (last?.month === month) last.entries.push(entry);
  else months.push({ month, entries: [entry] });
}
---

{
  /*
  The index of the changelog: the rows of ProductUpdates on the home
  (ProductUpdateRow), on the default surface of the page, in groups by
  month. Each group has the month as a large heading, and the rows show
  only the day. Each row links to the page
  of its entry, which has the content. Pagination is in its own section,
  under the rows.
*/
}
<Section padding="none" flush>
  {
    months.map(({ month, entries }) => (
      <section class={styles.month}>
        <h2 class:list={[styles.monthHeading, 'headline']}>{month}</h2>
        <ol class={styles.list}>
          {entries.map((entry) => (
            <ProductUpdateRow entry={entry} date="day" />
          ))}
        </ol>
      </section>
    ))
  }
</Section>
{
  pagination.totalPages > 1 && (
    <Section>
      <Pagination
        current={pagination.page}
        total={pagination.totalPages}
        baseUrl={pagination.baseUrl}
      />
    </Section>
  )
}
