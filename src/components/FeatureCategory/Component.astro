---
import { stripStega } from '@datocms/astro';
import { Button } from '~/components/Button';
import { ButtonGroup } from '~/components/ButtonGroup';
import { Lightbox } from '~/components/Lightbox';
import { Section } from '~/components/Section';
import { InlineParagraphs } from '~/components/StructuredText';
import type { FeatureCategoryData, OpenSlotData } from '~/data/features';
import type { ButtonData } from '~/components/Button';
import { buildUrlFromGql } from '~/lib/datocms/gqlUrlBuilder';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { FeatureCategoryEntryFragment } from './graphql';
import styles from './style.module.css';

interface Props extends FeatureCategoryData {
  /** The features of the group, from the CMS. */
  entries: FragmentOf<typeof FeatureCategoryEntryFragment>[];
  /** The last card of the group: the slot of the next feature, dashed. */
  open?: OpenSlotData;
}

const { id, title, description, theme, open } = Astro.props;

/** The labels of the links of a feature, by the value of `linkTitle`. */
const linkLabels: Record<string, string> = {
  docs: 'Docs',
  guide: 'Guide',
  learn_more: 'Learn more',
  watch_demo: 'Watch demo',
};

// The emoji, the badge and the screenshot of an entry are optional.
// Without them, the markup is the basic markup of an entry.
const entries = Astro.props.entries.map((data) => {
  const entry = readFragment(FeatureCategoryEntryFragment, data);
  return {
    ...entry,
    screenshot: entry.image?.lightboxImageUrl,
    plainTitle: stripStega(entry.title),
    buttons: entry.links.map((link): ButtonData => {
      // In draft mode the title carries the invisible marks of the content link.
      const key = stripStega(link.linkTitle ?? '');
      return {
        label: linkLabels[key] ?? key,
        href: buildUrlFromGql(link.content),
        variant: 'soft',
      };
    }),
  };
});
---

<Section theme={theme} id={id} class={styles.category} contentClass={styles.content} data-category>
  <header class={styles.header}>
    <h2 class="headline">{title}</h2>
    <p class:list={[styles.description, 'title']}>{description}</p>
  </header>
  <ul class={styles.entries}>
    {
      entries.map((entry) => (
        <li class={styles.entry} data-counted>
          <div class={styles.text}>
            {entry.badge && <span class:list={[styles.badge, 'caption']}>{entry.badge}</span>}
            <h3 class:list={[styles.entryTitle, 'title']}>{entry.emoji && <span class={styles.emoji} aria-hidden="true">{entry.emoji}</span>}{entry.title}</h3>
            <p class:list={[styles.entryDescription, 'body']}><InlineParagraphs data={entry.description} /></p>
          </div>
          {(entry.buttons.length > 0 || entry.screenshot) && (
            <div class={styles.actions}>
              {/* Text links under 1152, buttons from 1152. */}
              {entry.buttons.length > 0 && (
                <>
                  <ButtonGroup buttons={entry.buttons} class={styles.buttons} />
                  <ul class={styles.links}>
                    {entry.buttons.map((b) => (
                      <li>
                        <a class:list={[styles.link, 'title']} href={b.href}>
                          <span aria-hidden="true">→</span>
                          <span class={styles.linkLabel}>{b.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {entry.screenshot && (
                <Lightbox
                  url={entry.screenshot}
                  label={`Screenshot: ${entry.plainTitle}`}
                  alt={entry.plainTitle}
                >
                  <Button as="span" variant="soft" arrow={false} class={styles.screenshotButton}>
                    Screenshot
                  </Button>
                  <span class:list={[styles.screenshotLink, styles.linkLabel, 'title']}>
                    Screenshot
                  </span>
                </Lightbox>
              )}
            </div>
          )}
        </li>
      ))
    }
    {
      open && (
        <li class:list={[styles.entry, styles.open]} data-open-slot>
          <div class={styles.text}>
            <h3 class:list={[styles.entryTitle, 'title']}>{open.title}</h3>
            <p class:list={[styles.entryDescription, 'body']}>{open.description}</p>
          </div>
          <ButtonGroup buttons={[open.button]} class={styles.openButton} />
        </li>
      )
    }
  </ul>
</Section>
