---
import { faMagnifyingGlass, faXmark } from '@fortawesome/pro-regular-svg-icons';
import { Button } from '~/components/Button';
import { Icon } from '~/components/Icon';
import * as search from '~/data/search';
import styles from './style.module.css';

// Each element with `data-search-open` opens the popup. Cmd/Ctrl+K also
// opens it. Mount it one time, in the layout.
---

<dialog class={styles.dialog} data-theme="default" aria-label="Search the site" data-search-popup>
  <div class={styles.panel}>
    <div class={styles.bar}>
      <span class={styles.barIcon}><Icon icon={faMagnifyingGlass} /></span>
      <input
        class:list={[styles.input, 'h2']}
        type="text"
        enterkeyhint="search"
        placeholder={search.placeholder}
        aria-label="Search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="true"
        aria-controls="search-popup-quick-links"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <span class={styles.ask} data-search-ask hidden>
        {/* The AI assistant does not exist yet: the button has no action. */}
        <Button appearance="deep-on-white" variant="soft">{search.askAiLabel}</Button>
      </span>
      <button type="button" class={styles.close} aria-label="Close search" data-search-close>
        <Icon icon={faXmark} />
      </button>
    </div>

    <div class={styles.body} data-search-body>
      <div class={styles.quickLinks} data-search-state="empty">
        <p class:list={[styles.quickHeading, 'h2']} id="search-popup-quick-heading">
          {search.quickLinksHeading}
        </p>
        <div
          class={styles.quickList}
          role="listbox"
          id="search-popup-quick-links"
          aria-labelledby="search-popup-quick-heading"
          data-search-list
        >
          {
            search.quickLinks.map((link, i) => (
              <a
                href={link.href}
                class:list={[styles.quickLink, 'h2']}
                role="option"
                aria-selected="false"
                id={`search-popup-quick-${i}`}
                tabindex="-1"
              >
                {link.label}
                <span aria-hidden="true"> →</span>
              </a>
            ))
          }
        </div>
      </div>

      <div
        class={styles.results}
        role="listbox"
        id="search-popup-results"
        aria-label="Results"
        data-search-state="results"
        data-search-list
        hidden
      >
      </div>

      <div class={styles.noResults} data-search-state="none" hidden>
        <p class="h2">{search.noResults.heading}</p>
        <p class:list={[styles.noResultsText, 'body']}>{search.noResults.text}</p>
      </div>

      <p class="visuallyHidden" role="status" aria-live="polite" data-search-status></p>
    </div>
  </div>

  <template data-search-row>
    <a class={styles.result} role="option" aria-selected="false" tabindex="-1">
      <span class:list={[styles.breadcrumb, 'subtitleMedium']} data-field="breadcrumb"></span>
      <span class:list={[styles.title, 'h2']} data-field="title"></span>
      <span class:list={[styles.excerpt, 'body']} data-field="excerpt"></span>
    </a>
  </template>
</dialog>

<script>
  import { index } from '~/data/search';
  import styles from './style.module.css';

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-popup]');
  if (dialog) setup(dialog);

  function setup(dialog: HTMLDialogElement) {
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const ask = dialog.querySelector<HTMLElement>('[data-search-ask]')!;
    const body = dialog.querySelector<HTMLElement>('[data-search-body]')!;
    const empty = dialog.querySelector<HTMLElement>('[data-search-state="empty"]')!;
    const results = dialog.querySelector<HTMLElement>('[data-search-state="results"]')!;
    const none = dialog.querySelector<HTMLElement>('[data-search-state="none"]')!;
    const quickList = empty.querySelector<HTMLElement>('[data-search-list]')!;
    const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
    const row = dialog.querySelector<HTMLTemplateElement>('[data-search-row]')!;

    let trigger: HTMLElement | null = null;
    let active = -1;

    // The list that shows now: the quick links or the results.
    function currentList(): HTMLElement | null {
      if (!results.hidden) return results;
      if (!empty.hidden) return quickList;
      return null;
    }

    function options(): HTMLElement[] {
      const list = currentList();
      return list ? Array.from(list.querySelectorAll<HTMLElement>('[role="option"]')) : [];
    }

    function setActive(next: number) {
      const items = options();
      items.forEach((item, i) => item.setAttribute('aria-selected', String(i === next)));
      active = next;
      const item = items[next];
      if (item) {
        input.setAttribute('aria-activedescendant', item.id);
        item.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    // Put the text into `target`. Each match of `query` goes into a <mark>.
    function highlight(target: HTMLElement, text: string, query: string) {
      target.replaceChildren();
      const lower = text.toLowerCase();
      let from = 0;
      let at = lower.indexOf(query, from);
      while (at !== -1 && query) {
        target.append(text.slice(from, at));
        const mark = document.createElement('mark');
        mark.className = styles.match!;
        mark.textContent = text.slice(at, at + query.length);
        target.append(mark);
        from = at + query.length;
        at = lower.indexOf(query, from);
      }
      target.append(text.slice(from));
    }

    function render() {
      const query = input.value.trim().toLowerCase();
      ask.hidden = !query;
      results.replaceChildren();

      if (!query) {
        showState(empty);
        status.textContent = '';
        return;
      }

      const matches = index.filter((entry) =>
        [entry.title, entry.breadcrumb, entry.excerpt].some((field) =>
          field.toLowerCase().includes(query),
        ),
      );

      matches.forEach((entry, i) => {
        const link = row.content.firstElementChild!.cloneNode(true) as HTMLAnchorElement;
        link.href = entry.href;
        link.id = `search-popup-result-${i}`;
        link.querySelector<HTMLElement>('[data-field="breadcrumb"]')!.textContent =
          entry.breadcrumb;
        link.querySelector<HTMLElement>('[data-field="title"]')!.textContent = entry.title;
        highlight(link.querySelector<HTMLElement>('[data-field="excerpt"]')!, entry.excerpt, query);
        results.append(link);
      });

      showState(matches.length ? results : none);
      status.textContent = matches.length
        ? `${matches.length} result${matches.length === 1 ? '' : 's'}`
        : 'No results';
    }

    function showState(state: HTMLElement) {
      for (const el of [empty, results, none]) el.hidden = el !== state;
      const list = currentList();
      input.setAttribute('aria-expanded', String(Boolean(list)));
      if (list) input.setAttribute('aria-controls', list.id);
      else input.removeAttribute('aria-controls');
      body.scrollTop = 0;
      setActive(-1);
    }

    function open(from: Element | null) {
      if (dialog.open) {
        input.focus();
        return;
      }
      trigger = from instanceof HTMLElement ? from : null;
      render();
      dialog.showModal();
      input.focus();
      document.documentElement.classList.add(styles.locked!);
    }

    function closePopup() {
      if (dialog.open) dialog.close();
    }

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove(styles.locked!);
      input.value = '';
      render();
      // Put the focus back on the element that opened the popup.
      trigger?.focus();
      trigger = null;
    });

    input.addEventListener('input', render);

    input.addEventListener('keydown', (event) => {
      const items = options();
      if (event.key === 'ArrowDown' && items.length) {
        event.preventDefault();
        setActive((active + 1) % items.length);
      } else if (event.key === 'ArrowUp' && items.length) {
        event.preventDefault();
        setActive(active <= 0 ? items.length - 1 : active - 1);
      } else if (event.key === 'Enter') {
        // Without an active row, Enter follows the first result.
        const target = items[active] ?? (results.hidden ? undefined : items[0]);
        if (target) {
          event.preventDefault();
          target.click();
        }
      }
    });

    // The pointer also sets the active row, so the keys continue from it.
    body.addEventListener('pointermove', (event) => {
      const item = (event.target as Element).closest<HTMLElement>('[role="option"]');
      if (!item) return;
      const next = options().indexOf(item);
      if (next !== active) setActive(next);
    });

    dialog.querySelector('[data-search-close]')!.addEventListener('click', closePopup);

    // A click on the backdrop has the dialog itself as its target.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closePopup();
    });

    document.addEventListener('click', (event) => {
      const opener = (event.target as Element).closest('[data-search-open]');
      if (!opener) return;
      event.preventDefault();
      open(opener);
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) closePopup();
        else open(document.activeElement);
      }
    });
  }
</script>
