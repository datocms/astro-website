---
import styles from './style.module.css';

/*
 * A box of form fields with 1px lines between them. Put each row in a
 * FormRow: see ./style.module.css.
 */
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div class:list={[styles.box, className]}><slot /></div>
