---
import { Section } from '~/components/Section';
import type { CaseStudyBodyData } from '~/data/case-studies';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props extends CaseStudyBodyData {
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const { title, paragraphs, facts, theme } = Astro.props;
---

<Section theme={theme} contentClass={styles.content}>
  <h2 class:list={[styles.title, 'display']}>{title}</h2>
  <div class={styles.columns}>
    <div class:list={[styles.body, 'bodyLong']}>
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <dl class:list={[styles.facts, 'bodyLong']}>
      {
        facts.map((fact) => (
          <div>
            <dt class={styles.label}>{fact.label}</dt>
            {fact.values.map((value) => (
              <dd>{value}</dd>
            ))}
          </div>
        ))
      }
    </dl>
  </div>
</Section>
