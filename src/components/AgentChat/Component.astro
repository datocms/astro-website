---
import type { AgentChatData } from '~/data/ai';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props extends AgentChatData {
  theme?: Theme;
}

const { status, question, options, placeholder, theme = 'default' } = Astro.props;
---

{/* A picture of the UI, not a form. */}
<div
  class={styles.chat}
  data-theme={theme}
  role="img"
  aria-label={`${status} ${question} ${options.join(', ')}.`}
>
  <div class={styles.content} aria-hidden="true">
    <p class:list={[styles.status, 'subtitle']}>{status}</p>
    <p class:list={[styles.question, 'h2']}>{question}</p>
    <ul class={styles.options}>
      {options.map((option) => <li class:list={[styles.option, 'bodyMedium']}>{option}</li>)}
      <li class:list={[styles.option, styles.placeholder, 'bodyMedium']}>{placeholder}</li>
    </ul>
  </div>
</div>
