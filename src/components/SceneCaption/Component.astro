---
import styles from './style.module.css';
import type { SceneCaptionData } from './types';

interface Props extends SceneCaptionData {
  /**
   * How the lines show.
   * - `one`: the line of the step on screen, alone, in the centre.
   * - `list`: all the lines, numbered, one under the other; the line of
   *   the step on screen is lit, the others dim. Use it when the steps of
   *   the scene are hard to tell apart on the screen alone.
   * @default 'one'
   */
  mode?: 'one' | 'list';
}

const { lines, still, mode = 'one' } = Astro.props;
---

{
  /*
  The lines that tell the steps of the scene of a SceneFrame, in its slot
  "caption". The line of the step on screen shows, or is lit. The screen
  reader hears the description of the scene, thus it does not hear the
  lines.
*/
}
{
  mode === 'list' ? (
    <ol class:list={['subtitleMedium', styles.list]} aria-hidden="true" data-scene-caption>
      {lines.map(({ step, text }) => (
        <li class={styles.item} data-step={step} data-active={step === still ? '' : undefined}>
          {text}
        </li>
      ))}
    </ol>
  ) : (
    <p class:list={['subtitleMedium', styles.caption]} aria-hidden="true" data-scene-caption>
      {lines.map(({ step, text }) => (
        <span class={styles.line} data-step={step} data-active={step === still ? '' : undefined}>
          {text}
        </span>
      ))}
    </p>
  )
}

<script>
  import { SCENE_STEP_EVENT } from '~/lib/motion/sceneSequence';

  // The scene of the frame sends the steps of its sequence (sceneSequence.ts)
  for (const caption of document.querySelectorAll<HTMLElement>('[data-scene-caption]')) {
    const frame = caption.closest('[data-scene-frame]');
    const lines = caption.querySelectorAll<HTMLElement>('[data-step]');

    frame?.addEventListener(SCENE_STEP_EVENT, (event) => {
      const step = (event as CustomEvent<string>).detail;
      for (const line of lines) line.toggleAttribute('data-active', line.dataset.step === step);
    });
  }
</script>
