---
import { ButtonGroup } from '~/components/ButtonGroup';
import { Headline } from '~/components/Headline';
import { Section } from '~/components/Section';
import { InlineParagraphs } from '~/components/StructuredText';
import type { VersusSplitData } from '~/data/compare';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props extends VersusSplitData {
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const { halves, theme } = Astro.props;
---

<Section theme={theme} padding="none" flush contentClass={styles.split}>
  {
    halves.map((half) => (
      <div class:list={[styles.half, half.surface === 'inverse' ? styles.inverse : styles.accent]}>
        <div class={styles.text}>
          {half.layout === 'stacked' ? (
            <div class={styles.stacked}>
              <h2 class="h1">{half.headline}</h2>
              <p class:list={[styles.muted, 'h2']}>
                {half.text ? <InlineParagraphs data={half.text} /> : half.muted}
              </p>
            </div>
          ) : (
            <Headline as="h2" size="h1" muted={half.muted}>
              {half.headline}
            </Headline>
          )}
          {half.button && <ButtonGroup buttons={[half.button]} />}
        </div>
      </div>
    ))
  }
</Section>
