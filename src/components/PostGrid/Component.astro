---
import { Pagination } from '~/components/Pagination';
import { PostCard, type PostCardItem } from '~/components/PostCard';
import { Section } from '~/components/Section';
import styles from './style.module.css';

interface Props {
  /** The cards of the featured row. Only page 1 of an index has them. */
  featured?: PostCardItem[];
  /** The cards of the text grid. */
  posts: PostCardItem[];
  /** The number of the current page, from 1. */
  page: number;
  totalPages: number;
  /** The address of page 1. */
  baseUrl: string;
  /** The links above the grid that show a part of the posts. One is current. */
  filters?: { label: string; href: string; current: boolean }[];
}

const { featured = [], posts, page, totalPages, baseUrl, filters } = Astro.props;
---

<Section contentClass={styles.content}>
  {
    filters && (
      <nav aria-label="Filter the posts">
        <ul class={styles.filters}>
          {filters.map((filter) => (
            <li>
              <a
                class:list={[styles.filter, 'subtitleMedium']}
                href={filter.href}
                aria-current={filter.current ? 'page' : undefined}
              >
                {filter.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  {
    featured.length > 0 && (
      <section aria-labelledby="featured-posts">
        <h2 id="featured-posts" class="visuallyHidden">
          Latest posts
        </h2>
        <ul class={styles.featured}>
          {featured.map((post, index) => (
            <li class={styles.featuredItem}>
              <PostCard {...post} variant="featured" tint={index % 2 === 0 ? 'faint' : 'subtle'} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section aria-labelledby="all-posts">
    <h2 id="all-posts" class="visuallyHidden">All posts</h2>
    <ul class={styles.grid}>
      {
        posts.map((post) => (
          <li class={styles.item}>
            <PostCard {...post} variant="dense" />
          </li>
        ))
      }
    </ul>
  </section>
  <Pagination current={page} total={totalPages} baseUrl={baseUrl} />
</Section>
