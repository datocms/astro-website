---
import { stripStega } from '@datocms/astro';
import { JsonLd } from '~/components/JsonLd';
import { baseUrl } from '~/lib/draftMode';
import { breadcrumbId, webPageId } from '~/lib/jsonLd';
import type { BreadcrumbItem } from './types';
import styles from './style.module.css';

interface Props {
  /** The pages above this page, from the top. */
  trail: BreadcrumbItem[];
  /** The name of the current page. */
  current: string;
}

const { trail, current } = Astro.props;
const origin = baseUrl(Astro);
const pageUrl = new URL(Astro.url.pathname, origin).href;
const hasActions = Astro.slots.has('actions');
---

{
  /*
  The band at the top of the screen on a detail page, below the site
  header. At the left, the trail of the pages above this page and the name
  of the page. At the right, the slot "actions" takes the actions on the
  page, for example MarkdownActions. The band shows only when the h1 of the
  page goes out of the screen: before that, the BreadcrumbLabel above the
  h1 shows the trail.
*/
}
<breadcrumb-bar class={styles.bar}>
  <div class={styles.content}>
    <nav class={styles.nav} aria-label="Breadcrumb">
      <span class={styles.arrow} aria-hidden="true">←</span>
      <ol class={styles.trail}>
        {
          trail.map((item) => (
            <li class={styles.item}>
              <a class:list={[styles.link, 'labelMedium']} href={item.href} data-datocms-nomd>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class:list={[styles.item, styles.current]}>
          <span class:list={[styles.link, 'labelMedium']} aria-current="page">{current}</span>
        </li>
      </ol>
    </nav>
    {
      hasActions && (
        <div class={styles.actions}>
          <slot name="actions" />
        </div>
      )
    }
  </div>
</breadcrumb-bar>
<JsonLd
  data={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebPage',
        '@id': webPageId(pageUrl),
        breadcrumb: { '@id': breadcrumbId(pageUrl) },
      },
      {
        '@type': 'BreadcrumbList',
        '@id': breadcrumbId(pageUrl),
        itemListElement: [
          ...trail.map((item, index) => ({
            '@type': 'ListItem' as const,
            position: index + 1,
            name: stripStega(item.label),
            item: new URL(item.href, origin).href,
          })),
          {
            '@type': 'ListItem' as const,
            position: trail.length + 1,
            name: stripStega(current),
            item: pageUrl,
          },
        ],
      },
    ],
  }}
/>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  customElements.define(
    'breadcrumb-bar',
    class extends WebComponent {
      parsedCallback() {
        // Every page has an h1. Without it, the band shows when the page scrolls.
        const heading = document.querySelector('h1');
        let frame = 0;
        // The band shows when the bottom of the h1 goes above the top of the
        // band (the top of the screen, or the bottom of the site header).
        const update = () => {
          frame = 0;
          const top = parseFloat(getComputedStyle(this).top) || 0;
          const shown = heading
            ? heading.getBoundingClientRect().bottom <= top
            : window.scrollY > 0;
          this.toggleAttribute('data-shown', shown);
        };
        const onScroll = () => {
          if (!frame) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        this.eventListenerRemovers.push(() => window.removeEventListener('scroll', onScroll));
        update();
      }
    },
  );
</script>
