---
import styles from './style.module.css';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  /*
  The styles of long-form text: headings, lists, quotes, images, tables and code.
  Put a block with its own design in <prose-island>: Prose does not style it.
*/
}
<div class:list={[styles.prose, className]} data-datocms-content-link-group>
  <slot />
</div>
