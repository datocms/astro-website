---
import {
  faChevronRight,
  faCircleInfo,
  faMagnifyingGlass,
} from '@fortawesome/pro-regular-svg-icons';
import { faCircleCheck } from '@fortawesome/pro-solid-svg-icons';
import { render as renderAsPlainText } from 'datocms-structured-text-to-plain-text';
import { Button } from '~/components/Button';
import { Icon } from '~/components/Icon';
import { InlineParagraphs } from '~/components/StructuredText';
import type {
  ComparisonCategory,
  ComparisonRow,
  PlanComparisonData,
  PlanValue,
} from '~/data/pricing';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { PlanComparisonFeatureGroupFragment } from './graphql';
import styles from './style.module.css';

interface Props extends PlanComparisonData {
  /** The first categories of the table. */
  categories?: ComparisonCategory[];
  /** The groups of features of the CMS, after `categories`. */
  featureGroups?: FragmentOf<typeof PlanComparisonFeatureGroupFragment>[];
}

/** A row can have a tooltip from the CMS: a Structured Text field. */
type Row = ComparisonRow & { infoText?: { value: unknown } };

const { headline, differencesLabel, columns } = Astro.props;

const categories: (Omit<ComparisonCategory, 'rows'> & { rows: Row[] })[] = [
  ...(Astro.props.categories ?? []),
  ...(Astro.props.featureGroups ?? []).map((data) => {
    const group = readFragment(PlanComparisonFeatureGroupFragment, data);
    return {
      title: group.name,
      rows: group.features.map((feature): Row => {
        // The search needs the description as a string.
        const description = feature.description
          ? renderAsPlainText(feature.description as Parameters<typeof renderAsPlainText>[0])
          : null;
        const tags = Array.isArray(feature.tags) ? (feature.tags as string[]) : [];
        return {
          feature: feature.name,
          infoText: (description && feature.description) || undefined,
          // A search finds a feature also by its description, its group and its tags.
          keywords: [description, group.name, ...tags].filter(Boolean).join(' '),
          pro: feature.availableOnProfessionalPlan,
          enterprise: true,
        };
      }),
    };
  }),
];

const id = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<plan-comparison class={styles.root}>
  <section class={styles.planComparison} data-plan-comparison data-density="dense">
    <h2 class:list={[styles.headline, 'headline']}>{headline}</h2>

    <div data-table-start></div>
    <div class={styles.header} data-header data-datocms-nomd>
      <div class={styles.searchCell}>
        <label class={styles.search}>
          <span class="visuallyHidden">Filter features</span>
          <Icon icon={faMagnifyingGlass} width="24" height="24" />
          <input
            type="search"
            class="title"
            placeholder="Filter features…"
            autocomplete="off"
            data-search
          />
        </label>
        {
          differencesLabel && (
            <label class:list={[styles.differences, 'labelMedium']}>
              <input type="checkbox" role="switch" class={styles.switchInput} data-differences />
              <span class={styles.switchTrack} aria-hidden="true" />
              <span class="capTrim">{differencesLabel}</span>
            </label>
          )
        }
      </div>
      {
        columns.map((col) => (
          <div class={styles.planCell} data-plan-cell>
            <div class={styles.planName}>
              <p class="title">{col.name}</p>
              <p class:list={[styles.muted, 'body', 'tabular']}>{col.price}</p>
            </div>
            <Button variant={col.button.variant} arrow={col.button.arrow} href={col.button.href}>
              {col.button.label}
            </Button>
          </div>
        ))
      }
    </div>

    {
      categories.map((cat) => (
        <details class={styles.category} open={cat.open} data-category>
          <summary class={styles.categoryHeader}>
            <span class={styles.chevron} aria-hidden="true">
              <Icon icon={faChevronRight} width="16" height="16" />
            </span>
            <span class:list={[styles.categoryTitle, 'title']}>
              {cat.title}
              <span class:list={[styles.count, 'tabular']} data-count data-datocms-nomd>
                {cat.rows.length}
              </span>
            </span>
          </summary>
          <div role="list">
            {cat.rows.map((row) => {
              const hasInfo = Boolean(row.info || row.infoText);
              const tipId = hasInfo ? `tip-${id(cat.title)}-${id(row.feature)}` : undefined;
              // The search finds the name and the keywords of the row.
              const searchText = [row.feature, row.keywords]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();
              return (
                <div
                  class={styles.row}
                  role="listitem"
                  data-row
                  data-name={searchText}
                  data-same={row.pro === row.enterprise || undefined}
                >
                  <div class={styles.feature}>
                    <span class="body" data-datocms-as-tag="h4">
                      {row.feature}
                    </span>
                    {hasInfo && (
                      <span class={styles.info}>
                        <button
                          type="button"
                          class={styles.infoButton}
                          aria-describedby={tipId}
                          aria-expanded="false"
                          data-info-button
                          data-datocms-nomd
                        >
                          <span class="visuallyHidden">About {row.feature}</span>
                          <Icon icon={faCircleInfo} width="16" height="16" />
                        </button>
                        <span
                          id={tipId}
                          role="tooltip"
                          class:list={[styles.tooltip, 'body']}
                          data-datocms-as-tag="p"
                        >
                          {row.infoText ? <InlineParagraphs data={row.infoText} /> : row.info}
                        </span>
                      </span>
                    )}
                  </div>
                  {([row.pro, row.enterprise] as PlanValue[]).map((value, i) => (
                    <div
                      class:list={[styles.value, i === 1 && styles.enterprise, 'body', 'tabular']}
                    >
                      <span class="visuallyHidden">{columns[i]!.name}: </span>
                      {value === true ? (
                        <span class={styles.check}>
                          <Icon icon={faCircleCheck} width="20" height="20" />
                          <span class="visuallyHidden">Included</span>
                        </span>
                      ) : value === false ? (
                        <span class={styles.dash}>
                          <span class="visuallyHidden">Not included</span>
                        </span>
                      ) : (
                        value.split('\n').map((line, j) => (
                          <>
                            {j > 0 && ' '}
                            <span class:list={[j > 0 && styles.valueNote]}>{line}</span>
                          </>
                        ))
                      )}
                    </div>
                  ))}
                </div>
              );
            })}
          </div>
        </details>
      ))
    }
    <p class:list={[styles.empty, 'body']} hidden data-empty>No features match your search.</p>
    {
      Astro.slots.has('default') && (
        <div class:list={[styles.footnote, 'body']}>
          <slot />
        </div>
      )
    }
  </section>
</plan-comparison>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  customElements.define(
    'plan-comparison',
    class extends WebComponent {
      #documentListeners = new AbortController();

      parsedCallback() {
        this.setUpTips();
        this.setUpFilters();
        this.setUpStickyHeader();
      }

      disconnectedCallback() {
        super.disconnectedCallback();
        this.#documentListeners.abort();
        this.#observers.forEach((observer) => observer.disconnect());
      }

      #observers: (ResizeObserver | IntersectionObserver)[] = [];

      // The header row is sticky. The header of an open category is sticky
      // below it, thus the CSS needs the visible height of the header row
      // (--cmpHeaderHeight). On phones the search is above the plan cells,
      // and the header row sticks with the search above the viewport: the
      // CSS needs the height of that part (--cmpHeaderHide). From 768 the
      // search is in the row of the plan cells, and the value is 0. The
      // header row gets data-stuck when the start of the table is above the
      // viewport: then the CSS shows its bottom line.
      setUpStickyHeader() {
        const header = this.$('[data-header]');
        const plan = this.$('[data-plan-cell]');
        const start = this.$('[data-table-start]');

        const resize = new ResizeObserver(() => {
          const box = header.getBoundingClientRect();
          const paddingTop = parseFloat(getComputedStyle(header).paddingTop);
          const hide = Math.max(0, plan.getBoundingClientRect().top - box.top - paddingTop);
          this.style.setProperty('--cmpHeaderHide', `${hide}px`);
          // Round down: a category header goes a fraction of a pixel under
          // the header row, and no row shows through a gap.
          this.style.setProperty('--cmpHeaderHeight', `${Math.floor(box.height - hide)}px`);
        });
        resize.observe(header);

        const intersection = new IntersectionObserver(([entry]) => {
          if (!entry) return;
          const stuck = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          header.toggleAttribute('data-stuck', stuck);
        });
        intersection.observe(start);

        this.#observers.push(resize, intersection);
      }

      // Tooltips: a click or a tap on the icon opens or closes its bubble.
      // Only one bubble is open at a time. A click outside or Escape closes it.
      // Touch screens have no hover, thus they need this.
      setUpTips() {
        const signal = this.#documentListeners.signal;
        const closeTips = (except?: Element) => {
          for (const el of this.$$('[data-open]')) {
            if (el === except) continue;
            el.removeAttribute('data-open');
            el.querySelector('[data-info-button]')?.setAttribute('aria-expanded', 'false');
          }
        };
        document.addEventListener(
          'click',
          (event) => {
            const button = (event.target as Element).closest?.('[data-info-button]');
            const info = button && this.contains(button) ? button.parentElement : null;
            closeTips(info ?? undefined);
            if (!button || !info) return;
            const open = !info.hasAttribute('data-open');
            info.toggleAttribute('data-open', open);
            button.setAttribute('aria-expanded', String(open));
          },
          { signal },
        );
        document.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'Escape') closeTips();
          },
          { signal },
        );
      }

      // Search: show only the rows whose name (or keywords) contains the
      // query. The switch "only show differences" (when the table has one)
      // hides the rows with the same value on the two plans. The two filters
      // do not work together: a search turns the switch off, and the switch
      // clears the search. Categories with no match go away; categories with
      // a match open. When no filter is active again, the categories get
      // their open state from before the filter.
      setUpFilters() {
        const input = this.$<HTMLInputElement>('[data-search]');
        // The switch shows only when the page gives its label.
        const differences = this.querySelector<HTMLInputElement>('[data-differences]');
        const empty = this.$('[data-empty]');
        const start = this.$('[data-table-start]');
        const categories = this.$$<HTMLDetailsElement>('[data-category]');
        let saved: boolean[] | null = null;

        const apply = () => {
          const query = input.value.trim().toLowerCase();
          const onlyDifferences = differences?.checked ?? false;
          const filtering = Boolean(query) || onlyDifferences;
          if (filtering && !saved) saved = categories.map((c) => c.open);
          let total = 0;
          for (const cat of categories) {
            const rows = [...cat.querySelectorAll<HTMLElement>('[data-row]')];
            let count = 0;
            for (const row of rows) {
              const match =
                (!query || (row.dataset.name ?? '').includes(query)) &&
                (!onlyDifferences || !row.hasAttribute('data-same'));
              row.hidden = !match;
              if (match) count += 1;
            }
            total += count;
            cat.hidden = count === 0;
            if (filtering) cat.open = count > 0;
            const countEl = cat.querySelector('[data-count]');
            if (countEl) countEl.textContent = String(count);
          }
          if (!filtering && saved) {
            categories.forEach((c, i) => (c.open = saved![i]!));
            saved = null;
          }
          empty.hidden = total > 0;
        };

        this.on(input, 'input', () => {
          if (differences && input.value.trim()) differences.checked = false;
          apply();
        });

        if (differences) {
          this.on(differences, 'change', () => {
            if (differences.checked) input.value = '';
            apply();
            // The table gets shorter or longer. When the start of the table is
            // above the viewport, go back to it.
            if (start.getBoundingClientRect().top < 0) {
              const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
              start.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
            }
          });
        }
      }
    },
  );
</script>
