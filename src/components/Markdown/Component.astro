---
import { markdownToHtml } from './utils';

interface Props {
  /** The Markdown source. Pass trusted text, or clean it first. */
  of: string;
}

const html = await markdownToHtml(Astro.props.of);
---

{
  /*
  Renders Markdown as HTML: GitHub Flavored Markdown, code blocks with
  Expressive Code, headings with anchors and callouts. Put it inside Prose.
*/
}
<Fragment set:html={html} />
