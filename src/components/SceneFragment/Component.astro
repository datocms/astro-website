---
import { DevConfig } from '~/components/DevConfig';
import styles from './style.module.css';

/** The props of every fit. */
interface Common {
  /** The slot of FeatureFragments, for example `visual-0`. */
  slot?: string;
}

/**
 * `scale`: the box scales the picture by the zoom and by its width divided
 * by 500px, thus each box shows the same part of the picture, and the text
 * follows the width of the box. The picture is in a window with a border
 * and four round corners, from its top left corner. The window fills the
 * box, with no margin and no surface, and cuts the picture at the right
 * and the bottom.
 */
interface Scale extends Common {
  fit: 'scale';
  height?: never;
  phoneHeight?: never;
  /**
   * The zoom of the picture in a box of 500px (the box from 1280px). A
   * scene with little in it can be larger.
   * @default 1
   */
  zoom?: number;
  /**
   * Replaces `zoom` on phones (below 650px). The box of a phone is narrower
   * than at desktop, thus a picture that fills the box at desktop shows
   * only a slice: a smaller zoom shows more of it. It is the zoom in a box
   * of 500px too, and the box scales it by its width: 1.3 in a box of 350px
   * is 0.9. Thus `phoneZoom` is usually larger than `zoom`.
   * @default `zoom`
   */
  phoneZoom?: number;
  /**
   * The corner of the picture that the window shows. `start`: the window
   * shows the picture from its top left corner, and cuts it at the right.
   * `end`: the window shows the picture from its top right corner, and
   * cuts it at the left.
   * @default 'start'
   */
  align?: 'start' | 'end';
  /**
   * The border and the round corners of the window (--radius-sm). `true`:
   * the border of a field (--border-default). `inverse`: the border of a
   * window on the inverse surface (AppWindow: --border-on-inverse-strong),
   * for a picture in a browser window without its own border. `false`: the picture draws its own edges (a stack of cards).
   * It takes --fragment-visible-width and --fragment-visible-height, thus
   * its edges are in the box, and it cuts its content inside them.
   * @default true
   */
  border?: boolean | 'inverse';
}

/**
 * `crop`: the picture keeps its size at each width (a CodeSnippetPreview
 * with `fill`), at the top left corner of the box, with no margin and no
 * surface. It has the width of the box, and the box cuts it at the bottom
 * inside the border and the four round corners of the window of `scale`.
 */
interface Crop extends Common {
  fit: 'crop';
  height?: never;
  phoneHeight?: never;
  zoom?: never;
  phoneZoom?: never;
  align?: never;
  border?: never;
}

/**
 * `fill`: the picture (a diagram) fills all the box, with no margin, and
 * the box cuts nothing. The fragment is on the surface of the page (the
 * ground `surfacePage`), in the scheme of the page: in the dark scheme it
 * is dark, also in the accent box of FeatureFragments. The box does not
 * show, thus the picture has no padding: it takes all the width of the
 * box, from the left edge of the caption under it, and it is at the
 * bottom of the box, on the caption (src/scenes/AGENTS.md).
 */
interface Fill extends Common {
  fit: 'fill';
  /**
   * The height of the box. `box`: the box keeps the ratio of
   * FeatureFragments. `content`: the box takes the height of the picture,
   * at every width. Use it for a diagram with a height of its own (a panel,
   * a column of pills): a box with a fixed ratio adds an empty band above
   * it. In a row of FeatureFragments, the band of the pictures is as high
   * as the highest picture, thus a lower picture is at the bottom of its
   * box, on the caption.
   * @default 'box'
   */
  height?: 'box' | 'content';
  /**
   * The height of the box on phones (below 650px). `content`: the box has
   * no fixed ratio and takes the height of the picture, thus there is no
   * empty band above and below it. `box`: the box keeps its ratio, for a
   * picture that puts its parts against the edges of the box (a map, a
   * picture with parts at the corners).
   * @default 'content'
   */
  phoneHeight?: 'content' | 'box';
  zoom?: never;
  phoneZoom?: never;
  align?: never;
  border?: never;
}

/*
 * The fragment fills the 4:3 box of a FeatureFragments item with the
 * tinted surface. The window of the picture is in the box, with its four
 * edges.
 */
type Props = Scale | Crop | Fill;

const { fit, zoom, phoneZoom, align, border = true, height, phoneHeight } = Astro.props;

/** A `fill` box that takes the height of its picture at every width (FeatureFragments reads the attribute). */
const content = fit === 'fill' && height === 'content';
/** A `fill` box that takes the height of its picture on phones (FeatureFragments reads the attribute). */
const phoneContent = content || (fit === 'fill' && phoneHeight !== 'box');

// style.module.css chooses the zoom of the breakpoint (--fragment-current-zoom)
const vars = [
  zoom !== undefined && `--fragment-zoom: ${zoom}`,
  phoneZoom !== undefined && `--fragment-phone-zoom: ${phoneZoom}`,
]
  .filter(Boolean)
  .join('; ');
---

<div
  class:list={[
    styles.fragment,
    styles[fit],
    align === 'end' && styles.end,
    fit === 'scale' && !border && styles.noBorder,
    fit === 'scale' && border === 'inverse' && styles.inverseBorder,
    fit === 'fill' && 'surfacePage',
  ]}
  style={vars || undefined}
  data-fit={fit}
  data-phone-content={phoneContent || undefined}
  data-content={content || undefined}
>
  <div class={styles.clip}>
    {
      fit === 'scale' ? (
        <div class={styles.window}>
          <div class={styles.screen}>
            <slot />
          </div>
        </div>
      ) : (
        <div class={styles.surface}>
          <slot />
        </div>
      )
    }
  </div>
  <DevConfig
    name="SceneFragment"
    config={{
      fit,
      zoom,
      phoneZoom,
      align,
      border: fit === 'scale' && border !== true ? border : undefined,
      height,
      phoneHeight,
    }}
  />
</div>
