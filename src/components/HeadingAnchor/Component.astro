---
import { anchorLink } from './anchorLink';

interface Props {
  /** The id of the heading. */
  id: string;
  /** The text of the heading, as plain text. */
  text: string;
}

const { id, text } = Astro.props;
---

{
  /*
  The link to a heading. Put it as a direct child of the heading, and put
  the id on the heading. The styles are in src/styles/global.css and the
  script is element.ts: BaseLayout loads them, because autolinkHeadings
  makes this markup in HTML that has no component. Without the script, this
  is a plain link.
*/
}
<heading-anchor><a {...anchorLink(id, text)}></a></heading-anchor>
