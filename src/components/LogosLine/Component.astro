---
import { Logo } from '~/components/Logo';
import styles from './style.module.css';
import type { LogoItem } from './types';

interface Props {
  logos: LogoItem[];
  label?: string;
  /** `small` keeps the logos 28px tall at all widths. */
  size?: 'default' | 'small';
  /**
   * `always` scrolls the logos at all widths. `overflow` scrolls them only
   * when they do not fit: else they stay static in the centre.
   */
  marquee?: 'always' | 'overflow';
  class?: string;
}

const {
  logos,
  label = 'Trusted by',
  size = 'default',
  marquee = 'always',
  class: className,
} = Astro.props;
---

<logos-line
  class:list={[
    styles.logosLine,
    size === 'small' && styles.small,
    marquee === 'overflow' && styles.overflow,
    className,
  ]}
  data-logos-line
  data-marquee={marquee}
>
  <ul class={styles.track} aria-label={label} data-logos-track>
    {
      logos.map((logo) => (
        <li class={styles.item}>
          {logo.href ? (
            <a class={styles.link} href={logo.href} data-description={logo.description}>
              <Logo
                logo={logo}
                class:list={[styles.logo, logo.svg && styles.inline]}
                loading="eager"
              />
              {logo.description && <span class="visuallyHidden">: {logo.description}</span>}
            </a>
          ) : (
            <Logo
              logo={logo}
              class:list={[styles.logo, logo.svg && styles.inline]}
              loading="eager"
            />
          )}
        </li>
      ))
    }
  </ul>
  {
    /*
      One bubble for all the links of the line. It is a popover, thus it is in
      the top layer: the overflow and the transform of the track do not cut it.
      Screen readers do not read it: each link has the text in a hidden span.
    */
    logos.some((logo) => logo.description) && (
      <span
        class:list={[styles.bubble, 'caption']}
        popover="manual"
        aria-hidden="true"
        data-logos-bubble
      >
        <span data-logos-bubble-text />
        <span class={styles.arrow} data-logos-bubble-arrow />
      </span>
    )
  }
</logos-line>

<script>
  import { arrow, autoUpdate, computePosition, flip, offset, shift } from '@floating-ui/dom';
  import { onVisibilityChange, prefersReducedMotion } from '~/lib/motion/inView';
  import { WebComponent } from '~/lib/WebComponent';

  const SPEED = 32;

  customElements.define(
    'logos-line',
    class extends WebComponent {
      parsedCallback() {
        const track = this.$('[data-logos-track]');
        if (this.querySelector('[data-logos-bubble]')) this.setUpTooltip(track);
        if (prefersReducedMotion()) return;
        const items = [...track.children] as HTMLElement[];

        const build = () => {
          for (const clone of track.querySelectorAll('[data-clone]')) clone.remove();
          delete this.dataset.running;
          const setWidth = track.scrollWidth;
          if (setWidth === 0) return;
          // In the `overflow` mode, logos that fit stay static. The last gap
          // is not part of the visible width.
          if (this.dataset.marquee === 'overflow') {
            const gap = parseFloat(getComputedStyle(items[0]!).paddingRight) || 0;
            if (setWidth - gap <= this.clientWidth) return;
          }
          // Add copies until the track covers the viewport plus one set.
          const copies = Math.ceil(this.clientWidth / setWidth) + 1;
          for (let i = 0; i < copies; i += 1) {
            for (const item of items) {
              const clone = item.cloneNode(true) as HTMLElement;
              clone.dataset.clone = '';
              clone.setAttribute('aria-hidden', 'true');
              // The copies are not in the tab order: the keyboard goes through each link one time.
              for (const link of clone.querySelectorAll('a')) link.tabIndex = -1;
              track.appendChild(clone);
            }
          }
          this.style.setProperty('--marquee-distance', `${setWidth}px`);
          this.style.setProperty('--marquee-duration', `${setWidth / SPEED}s`);
          this.dataset.running = '';
        };

        const images = [...track.querySelectorAll('img')];
        Promise.all(
          images.map((img) => (img.complete ? null : img.decode().catch(() => null))),
        ).then(build);

        let width = this.clientWidth;
        new ResizeObserver(() => {
          if (this.clientWidth === width) return;
          width = this.clientWidth;
          build();
        }).observe(this);

        onVisibilityChange(this, (visible) => {
          this.dataset.paused = visible ? 'false' : 'true';
        });
      }

      /** Show the description of a link in the bubble, on hover and on focus. */
      setUpTooltip(track: HTMLElement) {
        const bubble = this.$('[data-logos-bubble]');
        const text = this.$('[data-logos-bubble-text]');
        const arrowElement = this.$('[data-logos-bubble-arrow]');
        let current: HTMLElement | null = null;
        let stop: (() => void) | null = null;

        const hide = () => {
          stop?.();
          stop = null;
          current = null;
          if (bubble.matches(':popover-open')) bubble.hidePopover();
        };

        const show = (link: HTMLElement) => {
          if (link === current) return;
          hide();
          current = link;
          text.textContent = link.dataset.description ?? '';
          bubble.showPopover();
          stop = autoUpdate(link, bubble, async () => {
            const { x, y, placement, middlewareData } = await computePosition(link, bubble, {
              placement: 'top',
              strategy: 'fixed',
              middleware: [
                offset(10),
                flip({ fallbackPlacements: ['bottom'] }),
                shift({ padding: 10 }),
                arrow({ element: arrowElement, padding: 5 }),
              ],
            });
            Object.assign(bubble.style, { left: `${x}px`, top: `${y}px` });
            const side = placement.startsWith('top') ? 'bottom' : 'top';
            Object.assign(arrowElement.style, {
              left: `${middlewareData.arrow?.x ?? 0}px`,
              top: '',
              bottom: '',
              [side]: `${-arrowElement.offsetWidth / 2}px`,
            });
          });
        };

        this.on(track, 'mouseover', (event) => {
          const link = (event.target as Element).closest<HTMLElement>('a[data-description]');
          if (link) show(link);
          else hide();
        });
        this.on(track, 'mouseleave', hide);
        this.on(track, 'focusin', 'a[data-description]', (_event, link) => show(link));
        this.on(track, 'focusout', hide);
      }
    },
  );
</script>
