---
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import { VideoPlayer } from 'react-datocms';
import { VideoPlayerFragment } from './graphql';
import type { ComponentProps } from 'astro/types';

interface Props extends Omit<ComponentProps<typeof VideoPlayer>, 'data'> {
  data: FragmentOf<typeof VideoPlayerFragment>;
}

const { data, ...rest } = Astro.props;

const unmaskedData = readFragment(VideoPlayerFragment, data);
---

{
  /*
    This component is a wrapper for the <VideoPlayer />` component provided by
    react-datocms, optimized for use with graphql.tada. We define the necessary
    GraphQL fragment for this component to function only once, then reuse it
    wherever needed.

    The `client:visible` prop is used to ensure that the component loads and
    hydrates once the component has entered the user’s viewport.
  */
}

{
  /*
    `preferPlayback="mse"` forces hls.js instead of the browser's native HLS
    engine. Recent Chromium versions report
    `canPlayType('application/vnd.apple.mpegurl')` as "maybe" (verified on
    Chrome 152), so mux-player started handing the .m3u8 straight to <video>: in
    that mode the browser exposes neither the renditions nor the subtitle tracks
    of the manifest, and the player silently drops the quality ("…") and CC
    buttons. Firefox has no native HLS, so it kept using hls.js and kept both
    buttons. This is only a preference: where MSE is unavailable (iOS Safari)
    mux-player still falls back to native playback.
  */
}

<VideoPlayer
  {...rest}
  data={unmaskedData.video}
  accentColor="var(--accent-color)"
  preferPlayback="mse"
  client:visible
/>
