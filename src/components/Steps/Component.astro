---
import { Headline } from '~/components/Headline';
import { Section } from '~/components/Section';
import styles from './style.module.css';

interface Props {
  title: string;
  /** The muted run of the title. */
  muted?: string;
  class?: string;
}

const { title, muted, class: className } = Astro.props;
---

{
  /* Numbered steps in a row of columns. The slot takes the `Step` elements. The CSS counter gives the numbers. */
}
<div class={className}>
  <Section flushBottom contentClass={styles.head}>
    <Headline as="h2" size="headline" muted={muted}>{title}</Headline>
  </Section>
  <Section flushTop>
    <ol class={styles.list}>
      <slot />
    </ol>
  </Section>
</div>
