---
import { type IconData, iconParts } from './data';

interface Props extends astroHTML.JSX.SVGAttributes {
  /** A Lucide icon or a Simple Icons brand mark. */
  icon: IconData;
  /** The accessible name. Without it, the icon is hidden from assistive technology. */
  label?: string;
}

const { icon, label, ...attrs } = Astro.props;
const { svgAttrs, children } = iconParts(icon);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  {...svgAttrs}
  width="1em"
  height="1em"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...attrs}
>
  {children.map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
</svg>
