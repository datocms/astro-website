---
import type { MarketplaceLogo } from '~/data/developers';
import styles from './style.module.css';

interface Props {
  logos: MarketplaceLogo[];
}

const { logos } = Astro.props;
---

<ul class={styles.grid}>
  {
    logos.map((logo) => (
      <li class={styles.card}>
        <img
          class={styles.logo}
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          style={logo.displayWidth ? `width: ${logo.displayWidth}px` : undefined}
          loading="lazy"
        />
      </li>
    ))
  }
</ul>
