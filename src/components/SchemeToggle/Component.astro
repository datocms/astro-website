---
import { faMoon, faSun } from '@fortawesome/pro-regular-svg-icons';
import { Icon } from '~/components/Icon';
import { Tooltip } from '~/components/Tooltip';
import s from './style.module.css';

interface Props {
  /**
   * `circle` is a 40px circle with a border. `bare` is the icon alone, with
   * the 40px hit area of the icon buttons of the site header.
   */
  variant?: 'circle' | 'bare';
}

const { variant = 'circle' } = Astro.props;
---

<scheme-toggle class={s.root}>
  <Tooltip>
    <button
      type="button"
      class:list={[s.toggle, variant === 'bare' && s.bare]}
      aria-label="Dark mode"
      aria-pressed="false"
    >
      <Icon icon={faMoon} class={s.moon} />
      <Icon icon={faSun} class={s.sun} />
    </button>
    <Fragment slot="tooltip"
      ><span class={s.moon}>Dark mode</span><span class={s.sun}>Light mode</span></Fragment
    >
  </Tooltip>
</scheme-toggle>

<script>
  import { chooseColorScheme, currentColorScheme } from '~/lib/colorScheme';
  import { WebComponent } from '~/lib/WebComponent';

  // The page can hold more than one toggle. Each toggle follows the scheme
  // of the page.
  customElements.define(
    'scheme-toggle',
    class SchemeToggle extends WebComponent {
      parsedCallback() {
        const button = this.$<HTMLButtonElement>('button');

        const showScheme = () => {
          button.setAttribute('aria-pressed', String(currentColorScheme() === 'dark'));
        };

        this.on(button, 'click', () => {
          chooseColorScheme(currentColorScheme() === 'dark' ? 'light' : 'dark');
        });
        this.on(document.documentElement, 'colorschemechange', showScheme);
        showScheme();
      }
    },
  );
</script>
