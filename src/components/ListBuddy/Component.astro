---
// The face of the brand at the right edge of the features index, with a
// speech bubble. The component wraps the list (its children): the face is
// sticky in a column as tall as the list, thus it stays in the middle of
// the screen while the list scrolls and goes away with the end of the
// list. It comes in once the list reaches the top 40% of the screen, and
// says a line at each quarter of the list (the score of the CategoryNav,
// event `categorynav:score`). Each quarter is said one time, on
// the way down. A new line cuts the line on show short (after 0.9s) and
// replaces the line that waits: a fast scroll does not play all the lines.
// With each line the face plays the reaction of its face (src/lib/motion/
// faces.ts): it is on the page already, thus it is not drawn again. A ghost
// of the final face gives the width, thus the bubble does not move with the
// frames. From 768px only: on phones there is no buddy. With reduced motion
// the face does not hop and shows its final face, the lines still show.
import type { BuddyData } from '~/data/features';
import { faceReaction, faces } from '~/lib/motion/faces';
import styles from './style.module.css';

type Props = BuddyData & {
  /** The source of the share of the list scrolled past. */
  track?: 'categorynav' | 'list';
};

const { lines, track = 'categorynav' } = Astro.props;

const script = lines.map(({ at, face, text }) => ({
  at,
  text,
  face: faces[face].face,
  frames: faceReaction(face),
}));
const first = script[0]?.face ?? faces.wink.face;
---

<list-buddy class={styles.list} data-track={track}>
  <slot />
  <div class={styles.column} aria-hidden="true" data-datocms-nomd>
    <aside class={styles.buddy} data-theme="default" data-list-buddy data-hidden>
      <span class={styles.face}>
        <span class={styles.ghost} data-buddy-ghost>{first}</span>
        <span data-buddy-face>{first}</span>
      </span>
      <span class={styles.bubble} data-buddy-bubble></span>
      <script
        type="application/json"
        data-buddy-lines
        set:html={JSON.stringify({ lines: script })}
      />
    </aside>
  </div>
</list-buddy>

<script>
  import { prefersReducedMotion } from '~/lib/motion/inView';
  import type { Frame } from '~/lib/motion/typewriter';
  import { WebComponent } from '~/lib/WebComponent';

  interface Line {
    at: number;
    /** The final face. */
    face: string;
    /** The frames of the reaction, up to the final face. */
    frames: Frame[];
    text: string;
  }

  customElements.define(
    'list-buddy',
    class extends WebComponent {
      #globalListeners = new AbortController();
      #frameTimer = 0;

      parsedCallback() {
        const buddy = this.$('[data-list-buddy]');
        const face = this.$('[data-buddy-face]');
        const ghost = this.$('[data-buddy-ghost]');
        const bubble = this.$('[data-buddy-bubble]');
        const json = this.$('[data-buddy-lines]').textContent ?? '';
        if (!window.matchMedia('(min-width: 768px)').matches) return;

        const { lines } = JSON.parse(json) as { lines: Line[] };
        const signal = this.#globalListeners.signal;
        let stage = -1;

        // The face plays its frames one after the other. A new line stops
        // the frames of the line before it.
        const reduced = prefersReducedMotion();
        const play = ({ face: final, frames }: Pick<Line, 'face' | 'frames'>) => {
          window.clearTimeout(this.#frameTimer);
          ghost.textContent = final;
          if (reduced) {
            face.textContent = final;
            return;
          }
          let i = 0;
          const next = () => {
            const frame = frames[i];
            if (!frame) return;
            const { text, ms } = typeof frame === 'string' ? { text: frame, ms: 120 } : frame;
            face.textContent = text;
            i += 1;
            this.#frameTimer = window.setTimeout(next, ms);
          };
          next();
        };

        // One line on show at a time, and at most one line that waits.
        type Said = { line: Omit<Line, 'at'>; ms: number };
        const MIN_MS = 900;
        let pending: Said | null = null;
        let busy = false;
        let shownAt = 0;
        let timer = 0;
        const hush = () => {
          buddy.removeAttribute('data-talk');
          timer = window.setTimeout(() => {
            busy = false;
            if (pending) {
              const next = pending;
              pending = null;
              show(next);
            }
          }, 400);
        };
        const show = (said: Said) => {
          busy = true;
          shownAt = performance.now();
          play(said.line);
          bubble.textContent = said.line.text;
          buddy.setAttribute('data-talk', '');
          timer = window.setTimeout(hush, said.ms);
        };
        const say = (line: Omit<Line, 'at'>, ms = 2200) => {
          if (!busy) {
            show({ line, ms });
            return;
          }
          pending = { line, ms };
          if (!buddy.hasAttribute('data-talk')) return;
          // Cut the line on show short, once it had its minimum time.
          window.clearTimeout(timer);
          timer = window.setTimeout(hush, Math.max(0, MIN_MS - (performance.now() - shownAt)));
        };

        // A line at each quarter, one time, on the way down: the last line
        // of the lines passed, when it is further than the last line said.
        const reach = (ratio: number) => {
          const next = lines.findLastIndex((line) => ratio >= line.at);
          if (next <= stage || buddy.hasAttribute('data-hidden')) return;
          stage = next;
          say(lines[next]!, next === lines.length - 1 ? 4000 : 2200);
        };
        const ownTrack = this.dataset.track === 'list';
        if (!ownTrack) {
          document.addEventListener(
            'categorynav:score',
            (event) => reach((event as CustomEvent<number>).detail),
            { signal },
          );
        }

        // The buddy comes in once the list reaches the top 40% of the screen.
        // With the track `list`, the share is the part of the list above the
        // middle of the screen. The end of the list is also the last line.
        let queued = false;
        const check = () => {
          queued = false;
          const rect = this.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.4) {
            buddy.removeAttribute('data-hidden');
          }
          if (ownTrack && rect.height > 0) {
            const middle = window.innerHeight / 2;
            const atEnd = rect.bottom <= window.innerHeight + 1;
            reach(atEnd ? 1 : Math.min(1, Math.max(0, (middle - rect.top) / rect.height)));
          }
        };
        window.addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(check);
          },
          { passive: true, signal },
        );
        check();
      }

      disconnectedCallback() {
        super.disconnectedCallback();
        this.#globalListeners.abort();
        window.clearTimeout(this.#frameTimer);
      }
    },
  );
</script>
