---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { Fact, Facts, type FactValue } from '~/components/Facts';
import { Prose } from '~/components/Prose';
import { Section } from '~/components/Section';
import { StructuredText } from '~/components/StructuredText';
import { Image } from '~/components/StructuredText/blocks/Image';
import { InDepthCtaBlock } from '~/components/StructuredText/blocks/InDepthCtaBlock';
import { InternalVideo } from '~/components/StructuredText/blocks/InternalVideo';
import { Video } from '~/components/StructuredText/blocks/Video';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { cleanDomain } from '~/lib/cleanDomain';
import { buildUrlForFeature } from '~/lib/datocms/gqlUrlBuilder/feature';
import { buildUrlForPartner } from '~/lib/datocms/gqlUrlBuilder/partner';
import { buildUrlForUseCasePage } from '~/lib/datocms/gqlUrlBuilder/useCasePage';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import type { Theme } from '~/lib/theme';
import { CaseStudyBodyStoryFragment } from './graphql';
import styles from './style.module.css';

interface Props {
  title: string;
  story: FragmentOf<typeof CaseStudyBodyStoryFragment>;
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const { title, theme } = Astro.props;
const story = readFragment(CaseStudyBodyStoryFragment, Astro.props.story);

const tags = story.tags.map((tag) => tag.name.trim()).filter(Boolean);
const keyFeatures: FactValue[] = story.keyFeatures.flatMap((feature) =>
  'seoH1' in feature && feature.seoH1
    ? [{ text: feature.seoH1, href: buildUrlForFeature(feature) }]
    : [],
);
---

<Section theme={theme} contentClass={styles.content}>
  <h2 class:list={[styles.title, 'display']}>{title}</h2>
  <div class={styles.slot}>
    <Prose>
      <StructuredText
        {...ensureValidStructuredTextProps({
          data: story.content,
          blockComponents: {
            ImageRecord: Image,
            VideoRecord: Video,
            InternalVideoRecord: InternalVideo,
            InDepthCtaBlockRecord: InDepthCtaBlock,
          },
          linkToRecordComponents: defaultLinkToRecordComponents,
          inlineRecordComponents: defaultInlineRecordComponents,
        })}
      />
    </Prose>
  </div>
  <Facts class={styles.facts}>
    {
      story.projectUrl && (
        <Fact label="Project">
          <a href={story.projectUrl} target="_blank" rel="noopener noreferrer">
            {cleanDomain(story.projectUrl)}
          </a>
        </Fact>
      )
    }
    {
      story.useCase && (
        <Fact label="Use case">
          <a href={buildUrlForUseCasePage(story.useCase)}>{story.useCase.navigationBarTitle}</a>
        </Fact>
      )
    }
    {
      story.partner && (
        <Fact label="Partner">
          <a href={buildUrlForPartner(story.partner)}>{story.partner.name}</a>
        </Fact>
      )
    }
    <Fact label="Industry" values={story.industry.map((item) => item.name)} />
    <Fact label="Solved" values={tags} />
    <Fact label="Key Features" values={keyFeatures} />
  </Facts>
</Section>
