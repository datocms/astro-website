---
import { DatoLogo } from '~/components/DatoLogo';
import { Section } from '~/components/Section';
import type { VideoSectionData } from '~/data/case-studies';
import styles from './style.module.css';

type Props = VideoSectionData;

const { eyebrow, headline, image, video } = Astro.props;
const label = `Play video: ${headline}`;
---

<Section theme="default">
  <div class={styles.cover} data-video-section>
    <div class={styles.media}>
      {/* The image has the shader of the solar pixel palette applied before. */}
      <img
        class={styles.image}
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
      />
    </div>
    <div class={styles.content}>
      <DatoLogo height={20} />
      <div>
        <p class:list={[styles.eyebrow, 'h2']}>{eyebrow}</p>
        <h2 class:list={[styles.headline, 'h1']}>{headline}</h2>
      </div>
      <button type="button" class={styles.play} aria-label={label} data-video-play>
        <svg viewBox="0 0 80 80" aria-hidden="true">
          <circle cx="40" cy="40" r="40" class={styles.playDisc}></circle>
          <path
            class={styles.playIcon}
            d="M55.09 38.11c1.46.84 1.46 2.94 0 3.78l-24 13.86c-1.45.84-3.27-.21-3.27-1.89V26.14c0-1.68 1.82-2.73 3.27-1.89l24 13.86Z"
          ></path>
        </svg>
      </button>
    </div>
    <div class={styles.player} data-video-inline hidden>
      <video class={styles.video} src={video.src} controls playsinline preload="none"></video>
    </div>
  </div>
  <dialog class={styles.dialog} aria-label={headline} data-video-dialog>
    <form method="dialog" class={styles.dialogBar}>
      <button class={styles.close} aria-label="Close video">×</button>
    </form>
    <video class={styles.video} src={video.src} controls playsinline preload="none"></video>
  </dialog>
</Section>

<script>
  // Below 768 the video plays in a modal. From 768 it plays in the cover.
  const MOBILE = window.matchMedia('(max-width: 767px)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-video-section]')) {
    const play = root.querySelector<HTMLButtonElement>('[data-video-play]')!;
    const inline = root.querySelector<HTMLElement>('[data-video-inline]')!;
    const dialog = root.parentElement!.querySelector<HTMLDialogElement>('[data-video-dialog]')!;

    play.addEventListener('click', () => {
      if (MOBILE.matches) {
        dialog.showModal();
        dialog.querySelector('video')!.play();
        return;
      }
      inline.hidden = false;
      const video = inline.querySelector('video')!;
      video.focus();
      video.play();
    });

    // Stop the video when the modal closes.
    dialog.addEventListener('close', () => dialog.querySelector('video')!.pause());
  }
</script>
