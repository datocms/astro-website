---
import { Section } from '~/components/Section';
import type { FooterColumn } from '~/data/navigation';
import styles from './style.module.css';

interface Props {
  columns: FooterColumn[];
}

// The footer takes the theme of the page (DESIGN.md, "Page themes").
const { columns } = Astro.props;
---

<Section
  as="nav"
  aria-label="Footer"
  background="inverse"
  class={styles.footerLinks}
  contentClass={styles.grid}
>
  {
    columns.map((column) => (
      <div class={styles.column}>
        {column.groups.map((group) => (
          <div class={styles.group}>
            <p class:list={[styles.title, 'label']}>{group.title}</p>
            <ul class={styles.links}>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class:list={[styles.link, 'labelMedium']}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        {column.status && (
          // The colour of the status comes from the status, not from the
          // theme of the footer: status.ts sets data-theme. When the status
          // is not known, the element has no data-theme and the dot is a ring.
          <status-badge class={styles.group} data-up-text={column.status.text}>
            <p class:list={[styles.statusLabel, 'label']}>{column.status.label}</p>
            <a href={column.status.href} class:list={[styles.link, styles.status, 'labelMedium']}>
              <span class={styles.statusDot} aria-hidden="true" />
              <span class="capTrim" data-status-text>
                Checking…
              </span>
            </a>
          </status-badge>
        )}
      </div>
    ))
  }
</Section>

<script>
  import { defineStatusBadge } from './status';

  defineStatusBadge();
</script>
