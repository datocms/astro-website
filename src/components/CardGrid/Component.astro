---
import styles from './style.module.css';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  /*
  The grid of the case studies index and of the blog index: the slot gives one <li> for each card.
*/
}
<ul class:list={[styles.grid, className]}>
  <slot />
</ul>
