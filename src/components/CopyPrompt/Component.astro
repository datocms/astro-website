---
import { faCheck, faCopy } from '@fortawesome/pro-regular-svg-icons';
import { Button } from '~/components/Button';
import { Icon } from '~/components/Icon';
import styles from './style.module.css';

interface Props {
  /** The prompt for the AI agent. */
  text: string;
  /** The position of the button and of the hint in the column. */
  align?: 'start' | 'center';
}

const { text, align = 'start' } = Astro.props;
const prompt = text.trim();
const firstLine = prompt.split('\n').find((line) => line.trim()) ?? '';
---

{
  /*
  A button that copies a prompt for an AI agent. The prompt is in a
  template, thus it is in the DOM but not on the page. The hint shows the
  first line of the prompt, then a message when the copy is done. Without
  JS the button cannot copy, thus the element stays hidden.
*/
}
<copy-prompt class:list={[styles.root, align === 'center' && styles.center]} hidden>
  <Button arrow={false}>
    <span class={styles.label}>
      <Icon icon={faCopy} />
      Copy prompt
    </span>
  </Button>
  <p class:list={[styles.hint, 'caption']} aria-live="polite">
    <span class={styles.firstLine}>“{firstLine}”</span>
    <span class={styles.done}>
      <Icon icon={faCheck} />
      Copied: now paste that into your preferred AI agent!
    </span>
  </p>
  <template>{prompt}</template>
</copy-prompt>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  customElements.define(
    'copy-prompt',
    class extends WebComponent {
      parsedCallback() {
        const button = this.$<HTMLButtonElement>('button');
        const template = this.$<HTMLTemplateElement>('template');
        let timer: ReturnType<typeof setTimeout> | undefined;
        this.hidden = false;

        this.on(button, 'click', async () => {
          try {
            await navigator.clipboard.writeText(template.content.textContent ?? '');
          } catch {
            return;
          }
          this.dataset.copied = '';
          clearTimeout(timer);
          // After 3 seconds, show the first line again.
          timer = setTimeout(() => delete this.dataset.copied, 3000);
        });
      }
    },
  );
</script>
