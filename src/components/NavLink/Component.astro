---
import styles from './style.module.css';

interface Props {
  href: string;
  current?: boolean;
  class?: string;
}

const { href, current = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['h2', styles.navLink, className]}
  aria-current={current ? 'page' : undefined}><slot /></a
>
