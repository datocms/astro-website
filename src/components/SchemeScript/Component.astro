---
/*
 * Inline script for the head. It sets the color scheme before the first
 * paint: the choice of the visitor, else light. The key and the attribute
 * names come from src/lib/colorScheme.ts.
 */
import { STORAGE_KEY } from '~/lib/colorScheme';
---

<script is:inline define:vars={{ STORAGE_KEY }}>
  (function () {
    var root = document.documentElement;
    var scheme = null;
    try {
      scheme = localStorage.getItem(STORAGE_KEY);
    } catch (e) {}
    if (scheme !== 'dark') scheme = 'light';
    root.dataset.colorScheme = scheme;
    root.dataset.productScenesScheme = scheme;
  })();
</script>
