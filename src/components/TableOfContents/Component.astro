---
import type { Heading } from 'datocms-structured-text-utils';
import { render as toPlainText } from 'datocms-structured-text-to-plain-text';
import { PlainText } from '~/components/StructuredText';
import { headingId } from '~/components/StructuredText/headingId';
import { TocShell } from '~/components/TocShell';
import type { TableOfContentsItem } from './headings';

interface Props {
  /** For example "In this article". */
  title: string;
  /** The headings of a Structured Text field, from tableOfContentsHeadings(). */
  headings?: Heading[];
  /** The links for a Markdown or HTML document, from tableOfContentsItems(). Use this or `headings`. */
  items?: TableOfContentsItem[];
  class?: string;
}

const { title, headings = [], items = [], class: className } = Astro.props;
const count = headings.length + items.length;
---

{
  /*
  The links to the headings of an article, at all levels, in one flat
  list. The ids of a Structured Text field come from headingId(), as in
  HeadingNode. The ids of a document come from the document. TocShell
  gives the box, the float and the mark on the heading that the visitor
  reads.
*/
}
<TocShell title={title} note={`${count} sections`} class={className}>
  <ol>
    {
      headings.map((heading) => (
        <li>
          <a href={`#${headingId(heading)}`} title={toPlainText(heading)}>
            <PlainText
              data={{ value: { schema: 'dast', document: { type: 'root', children: [heading] } } }}
            />
          </a>
        </li>
      ))
    }
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} title={item.text}>
            {item.text}
          </a>
        </li>
      ))
    }
  </ol>
</TocShell>
