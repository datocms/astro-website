---
import type { Heading } from 'datocms-structured-text-utils';
import { PlainText } from '~/components/StructuredText';
import { headingId } from '~/components/StructuredText/headingId';
import type { TableOfContentsItem } from './headings';
import styles from './style.module.css';

interface Props {
  /** For example "In this article". */
  title: string;
  /** The headings of a Structured Text field, from tableOfContentsHeadings(). */
  headings?: Heading[];
  /** The links for a Markdown or HTML document, from tableOfContentsItems(). Use this or `headings`. */
  items?: TableOfContentsItem[];
  class?: string;
}

const { title, headings = [], items = [], class: className } = Astro.props;
const topLevel = Math.min(...headings.map((heading) => heading.level));
const topItemLevel = Math.min(...items.map((item) => item.level));
---

{
  /*
  The links to the headings of an article. The ids of a Structured Text
  field come from headingId(), as in HeadingNode. The ids of a document
  come from the document. A heading below the top level is indented.
  The search index and the Markdown version of the page skip this list.
*/
}
<nav
  class:list={[styles.root, className]}
  aria-label={title}
  data-datocms-noindex
  data-datocms-nomd
>
  <p class:list={[styles.title, 'subtitleMedium']}>{title}</p>
  <ol class={styles.list}>
    {
      headings.map((heading) => (
        <li class={heading.level > topLevel ? styles.nested : undefined}>
          <a class:list={[styles.link, 'body']} href={`#${headingId(heading)}`}>
            <PlainText
              data={{ value: { schema: 'dast', document: { type: 'root', children: [heading] } } }}
            />
          </a>
        </li>
      ))
    }
    {
      items.map((item) => (
        <li class={item.level > topItemLevel ? styles.nested : undefined}>
          <a class:list={[styles.link, 'body']} href={`#${item.id}`}>
            {item.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
