---
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props {
  /** The theme of the chapter: it gives the accent of the left half. */
  theme?: Theme;
}

const { theme } = Astro.props;
---

{
  /*
  The ChapterHeader (`background="split"`) and the SceneFrame of a chapter
  on one background, as VersusSplit. Put them as direct children.
*/
}
<div class={styles.split} data-theme={theme}>
  <slot />
</div>
