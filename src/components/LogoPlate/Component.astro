---
// The logo of a partner on a white plate. The plate is white in both
// schemes, thus the logo always keeps its own colours on white. When the
// plate comes into view, the logo develops: it starts as large square cells
// in its own colours, and the cells get smaller in steps until the logo is
// sharp. While the logo loads, the working mark of the diagrams shows. Without
// motion, the logo is sharp at once.
import { stripStega } from '@datocms/astro';
import { WorkingMark } from '~/components/WorkingMark';
import s from './style.module.css';

interface Props {
  name: string;
  logo: {
    url: string;
    alt?: string | null;
    width?: number | null;
    height?: number | null;
    /** A PNG of the logo. The canvas reads this file, because an SVG can have no size. */
    pngUrl: string;
  };
  /**
   * The plate is a box with a hairline on all its edges, not a plate that the
   * band cuts. The logo is smaller and it loads when it comes near the view.
   */
  framed?: boolean;
  class?: string;
}

const { name, logo, framed = false, class: className } = Astro.props;
---

<logo-plate class:list={[s.plate, framed && s.framed, className]} data-src={logo.pngUrl}>
  <span class={s.box}>
    <img
      class={s.logo}
      src={logo.url}
      alt={stripStega(logo.alt ?? '') || `${stripStega(name)} logo`}
      width={logo.width ?? undefined}
      height={logo.height ?? undefined}
      fetchpriority={framed ? undefined : 'high'}
      loading={framed ? 'lazy' : undefined}
    />
    <canvas class={s.canvas} aria-hidden="true"></canvas>
    <WorkingMark class={s.working} />
  </span>
</logo-plate>

<script>
  import { defineLogoPlate } from './element';

  defineLogoPlate();
</script>
