---
import { Button } from '~/components/Button';
import { Headline } from '~/components/Headline';
import { Section } from '~/components/Section';
import { faceStep, faces, type FaceName } from '~/lib/motion/faces';
import type { Step } from '~/lib/motion/typewriter';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props {
  label?: string;
  /** The first sentence of the headline, in text/primary. */
  headline?: string;
  /** The rest of the headline, muted. */
  muted?: string;
  /** The face at the end of the muted text, from src/lib/motion/faces.ts. */
  face?: FaceName;
  homeLabel?: string;
  searchLabel?: string;
  helpText?: string;
  helpLink?: { label: string; href: string };
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const {
  label = 'Error 404',
  headline = 'Page not found.',
  muted = 'The link may be broken or the page has moved somewhere new',
  face = 'confused',
  homeLabel = 'Back to homepage',
  searchLabel = 'Search the site',
  helpText = 'Still stuck?',
  helpLink = { label: 'Contact support', href: '/support' },
  theme,
} = Astro.props;

// The timeline of the Hero typewriter: the headline, the muted text, then
// the face.
const script: Step[] = [
  { type: 'pause', ms: 750 },
  { type: 'cursor', glyphs: ['•', '~', '-', 'ᴗ', '•'], msPerGlyph: 75 },
  { type: 'pause', ms: 25 },
  { type: 'text', text: headline, speedCps: 80 },
  { type: 'pause', ms: 500 },
  { type: 'text', text: muted, speedCps: 80 },
  { type: 'pause', ms: 150 },
  faceStep(face),
];
---

<Section theme={theme}>
  <not-found-section class={styles.intro}>
    <div class={styles.headlineGroup}>
      <p class:list={[styles.label, 'label']}>{label}</p>
      <Headline
        as="h1"
        size="headline"
        muted={muted}
        faceGlyphs={faces[face].face}
        typewriter={script}
        typewriterStart="load"
      >
        {headline}
      </Headline>
    </div>
    <div class={styles.buttons} data-not-found-after data-await-typewriter>
      <Button href="/" size="l" arrow={false}>{homeLabel}</Button>
      {/* The search of the site opens from each element with data-search-open. */}
      <Button size="l" variant="soft" attrs={{ 'data-search-open': '', 'aria-haspopup': 'dialog' }}>
        {searchLabel}
      </Button>
    </div>
    <p class:list={[styles.help, 'labelMedium']} data-not-found-after data-await-typewriter>
      {helpText}{' '}
      <a href={helpLink.href} class={styles.helpLink}>
        <span class={styles.helpLabel}>{helpLink.label}</span>
        <span aria-hidden="true"> →</span>
      </a>
    </p>
  </not-found-section>
</Section>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  // The buttons and the help link fade in 150ms after the typewriter ends.
  customElements.define(
    'not-found-section',
    class NotFoundSection extends WebComponent {
      parsedCallback() {
        const typewriter = this.$('[data-typewriter]');
        const after = this.$$('[data-not-found-after]');

        // Without motion, the CSS shows them. When the typing is done before
        // this element starts, the fallback of the CSS shows them after 3s.
        if (document.documentElement.dataset.motion !== 'on') return;
        if (typewriter.dataset.twState === 'done') return;

        for (const el of after) el.dataset.twArmed = '';
        this.on(typewriter, 'typewriter:done', () => {
          setTimeout(() => {
            for (const el of after) el.dataset.visible = 'true';
          }, 150);
        });
      }
    },
  );
</script>
