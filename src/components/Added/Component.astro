---
// A mark for review: a section that Ronak added to Stefano's design, or
// that he extended. A dashed frame and a badge over the section. It is not
// part of the design: the design phase removes it.
import styles from './style.module.css';

interface Props {
  /** What was added, e.g. "Two fragments: locales and assets". */
  note?: string;
  /** An anchor, for a section that has none of its own. */
  id?: string;
  /** A sticker on each item of the section too: each fragment is new. */
  each?: boolean;
  /** The first words of the badge: who and what. A question for review is "Note from Ronak". */
  by?: string;
}

const { note, id, each = false, by = 'Added by Ronak' } = Astro.props;
---

<div class:list={[styles.root, each && styles.each]} id={id} data-added>
  <span class={styles.frame} data-theme="pink" aria-hidden="true"></span>
  <p class={styles.badge} data-theme="pink">
    <span class={styles.by}>{by}</span>
    {note && <span class={styles.note}>{note}</span>}
  </p>
  <slot />
</div>
