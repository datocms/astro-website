---
import type { FragmentOf } from '~/lib/datocms/graphql';
import { pixelCover } from './cover';
import type { PixelCoverFragment } from './graphql';
import styles from './style.module.css';

interface Props {
  /** The post of the cover. A post with no cover file or no theme shows nothing. */
  post: FragmentOf<typeof PixelCoverFragment>;
  class?: string;
  [attribute: `data-${string}`]: unknown;
}

const { post, class: className, ...rest } = Astro.props;
const cover = pixelCover(post);
---

{
  /*
  A blog cover: a grid of square cells with a gap between them: a part of
  the cell, at most one CSS pixel. The file has one pixel for each cell, and
  only tones: the script gives each cell the colour of its tone in the theme,
  and draws the grid on a canvas. The pitch of the cells is a whole number of
  device pixels.
  When the browser scales an image, the gaps become blurred lines. Thus the
  script does not scale an image, it draws the cells.
  The script reads the pixels of the file, thus the image needs `crossorigin`.
  The image is not a ResponsiveImage: the file must come as a PNG with no
  loss, at its own size (see graphql.ts).
*/
}
{
  cover && (
    <pixel-cover class:list={[styles.cover, className]} data-theme={cover.theme} {...rest}>
      <img
        class={styles.image}
        src={cover.url}
        alt=""
        width={cover.width}
        height={cover.height}
        crossorigin="anonymous"
      />
      <canvas class={styles.canvas} aria-hidden="true" />
    </pixel-cover>
  )
}

<script>
  import { drawCover, pixelsToGrid, type Grid, type Rgb } from '~/lib/pixel-cover/cover';
  import { WebComponent } from '~/lib/WebComponent';

  // A canvas of one pixel gives the RGB of a CSS colour in each notation.
  const probe = document.createElement('canvas');
  probe.width = 1;
  probe.height = 1;
  const probeContext = probe.getContext('2d', { willReadFrequently: true })!;

  function rgbOf(colour: string): Rgb {
    probeContext.fillStyle = colour;
    probeContext.fillRect(0, 0, 1, 1);
    const [r, g, b] = probeContext.getImageData(0, 0, 1, 1).data;
    return [r!, g!, b!];
  }

  customElements.define(
    'pixel-cover',
    class PixelCover extends WebComponent {
      #grid?: Grid;
      #size?: { width: number; height: number };

      parsedCallback() {
        const image = this.$<HTMLImageElement>('img');
        const canvas = this.$<HTMLCanvasElement>('canvas');

        const observer = new ResizeObserver(([entry]) => {
          // The size in device pixels. Safari does not give it, and the device emulation of
          // Chrome gives the CSS size: then the script calculates it.
          const ratio = window.devicePixelRatio || 1;
          const css = entry!.contentRect;
          const device = entry!.devicePixelContentBoxSize?.[0];
          this.#size =
            device && Math.abs(device.inlineSize - css.width * ratio) < 2
              ? { width: device.inlineSize, height: device.blockSize }
              : { width: Math.round(css.width * ratio), height: Math.round(css.height * ratio) };
          this.#draw(canvas);
        });
        observer.observe(this);
        this.eventListenerRemovers.push(() => observer.disconnect());

        const read = () => {
          const buffer = document.createElement('canvas');
          buffer.width = image.naturalWidth;
          buffer.height = image.naturalHeight;
          const context = buffer.getContext('2d')!;
          context.drawImage(image, 0, 0);
          const { data } = context.getImageData(0, 0, buffer.width, buffer.height);
          const { grid, error } = pixelsToGrid(data, buffer.width, buffer.height);
          if (!grid) throw new Error(`[pixel-cover]: ${error}`);
          this.#grid = grid;
          this.#draw(canvas);
        };
        if (image.complete && image.naturalWidth) read();
        else this.on(image, 'load', read);
      }

      #draw(canvas: HTMLCanvasElement) {
        const grid = this.#grid;
        const size = this.#size;
        if (!grid || !size || !size.width || !size.height) return;

        const { width, height } = size;
        const ratio = window.devicePixelRatio || 1;
        // One pixel of the canvas is one device pixel. The box can be a part of a
        // device pixel larger or smaller. It clips the canvas.
        canvas.width = width;
        canvas.height = height;
        canvas.style.width = `${width / ratio}px`;
        canvas.style.height = `${height / ratio}px`;

        const style = getComputedStyle(this);
        const token = (name: string) => rgbOf(style.getPropertyValue(name));
        drawCover(
          canvas.getContext('2d')!,
          grid,
          {
            accent: token('--theme-accent'),
            ink: token('--theme-ink'),
            paper: token('--theme-paper'),
            highlight: token('--theme-pixel-highlight'),
          },
          width,
          height,
          ratio,
        );
      }
    },
  );
</script>
