---
import { faCode, faLightbulb } from '@fortawesome/pro-regular-svg-icons';
import { inlineMarkdown } from '~/components/docs/Markdown/utils';
import { Prose } from '~/components/docs/DocsProse';
import { intersperse } from '~/lib/intersperse';
import type { JsonSchemaPropertyAnalysis } from '../../analyzeSchemaProperties';
import { ExpandablePane } from '../../ExpandablePane';
import { JsonSchemaObjectAnalysis } from '..';
import s from './style.module.css';
import { Markdown } from '~/components/docs/Markdown';
import { Icon } from '~/components/Icon';

type Props = {
  property: JsonSchemaPropertyAnalysis;
  showRequiredOptional?: boolean;
};

const { property, showRequiredOptional = true } = Astro.props;

/* An example longer than this is not inline: a short preview opens the full value. */
const MAX_INLINE_EXAMPLE_LENGTH = 120;
const PREVIEW_LENGTH = 60;

const oneLine = (example: string) => example.replace(/\s+/g, ' ').trim();

const examples = await Promise.all(property.examples);
const inlineExamples = examples.filter((e) => oneLine(e).length <= MAX_INLINE_EXAMPLE_LENGTH);
const longExamples = examples.filter((e) => oneLine(e).length > MAX_INLINE_EXAMPLE_LENGTH);
---

<div class={s.schema}>
  <div class={s.header}>
    <span>
      {property.prefix && <span class={s.prefix}>{property.prefix}</span>}<span class={s.name}
        >{property.property}</span
      >{property.suffix && <span class={s.prefix}>{property.suffix}</span>}
    </span>

    {
      JSON.stringify(property.types).length < 20 && (
        <span class={s.inlineTypes}>
          {intersperse(
            property.types.map((type) => (
              <span
                class:list={[s.type, 'codeInline']}
                set:html={inlineMarkdown(type).then(String)}
              />
            )),
            ', ',
          )}
        </span>
      )
    }

    {
      property.deprecated ? (
        <span class:list={[s.required, 'caption']}>Deprecated</span>
      ) : (
        showRequiredOptional &&
        (property.required ? (
          <span class:list={[s.required, 'caption']}>Required</span>
        ) : (
          <span class:list={[s.optional, 'caption']}>Optional</span>
        ))
      )
    }
  </div>

  {
    (property.description || property.deprecated) && (
      <Prose class={s.description}>
        <Markdown of={property.description} />

        {property.deprecated && (
          <div class={s.deprecatedDescription}>
            <Markdown of={property.deprecated} />
          </div>
        )}
      </Prose>
    )
  }

  {
    JSON.stringify(property.types).length >= 20 && (
      <div class={s.types}>
        <Icon icon={faCode} />
        <div>
          Type:{' '}
          {intersperse(
            property.types.map((type) => (
              <span
                class:list={[s.type, 'codeInline']}
                set:html={inlineMarkdown(type).then(String)}
              />
            )),
            ', ',
          )}
        </div>
      </div>
    )
  }

  {
    property.examples.length > 0 && (
      <div class={s.examples}>
        <Icon icon={faLightbulb} />
        <div>
          {property.examples.length > 1 ? <>Examples:</> : <>Example:</>}{' '}
          {intersperse(
            inlineExamples.map((example) => (
              <code class:list={[s.example, 'codeInline']}>{example}</code>
            )),
            ', ',
          )}
          {longExamples.map((example) => (
            <details class={s.longExample}>
              <summary>
                <code class:list={[s.example, s.preview, 'codeInline']}>
                  {oneLine(example).slice(0, PREVIEW_LENGTH)}…
                </code>
                <span class={s.showFull}>Show full</span>
                <span class={s.hideFull}>Hide</span>
              </summary>
              <pre class="codeSmall">{example.trim()}</pre>
            </details>
          ))}
        </div>
      </div>
    )
  }

  {
    property.moreInfo &&
      property.moreInfo.map((info) => (
        <ExpandablePane label={`Show ${info.title}`}>
          <div class={s.properties}>
            <JsonSchemaObjectAnalysis
              object={info.properties}
              showRequiredOptional={showRequiredOptional}
              emitMarkdown={false}
            />
          </div>
        </ExpandablePane>
      ))
  }
</div>
