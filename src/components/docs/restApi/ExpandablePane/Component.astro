---
import { faMinus, faPlus } from '@fortawesome/pro-regular-svg-icons';
import { Icon } from '~/components/Icon';
import { TargetToggler } from '~/components/docs/TargetToggler';
import s from './style.module.css';
import { nanoid } from 'nanoid';

type Props = {
  label: string;
};

const { label } = Astro.props;
const id = nanoid();
---

<TargetToggler targetId={id}>
  <button type="button" class={s.button}>
    <Icon icon={faPlus} class={s.plus} /><Icon icon={faMinus} class={s.minus} />
    <span>{label}</span>
  </button>
</TargetToggler>

<div class={s.content} id={id}>
  <slot />
</div>
