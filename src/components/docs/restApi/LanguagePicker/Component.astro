---
import s from './style.module.css';
import { addLanguageToUrl, currentLanguage } from './utils';

const language = currentLanguage(Astro);
---

<div class:list={[s.picker, 'label']} data-docs-sticky-bar>
  <div class:list={[s.pickerLabel, 'capTrim']}>Show examples in:</div>
  <a
    href={addLanguageToUrl(Astro, Astro.url, 'javascript')}
    class:list={[s.pickerButton, language === 'javascript' && s.pickerButtonActive]}
    aria-current={language === 'javascript' ? 'true' : undefined}
  >
    JavaScript</a
  >
  <a
    href={addLanguageToUrl(Astro, Astro.url, 'http')}
    class:list={[s.pickerButton, language === 'http' && s.pickerButtonActive]}
    aria-current={language === 'http' ? 'true' : undefined}>HTTP</a
  >
</div>

<slot />
