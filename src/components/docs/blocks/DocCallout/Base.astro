---
import { Info, Smile, TriangleAlert, WandSparkles } from 'lucide';
import s from './style.module.css';
import { Icon } from '~/components/Icon';
import { Prose } from '~/components/docs/DocsProse';

interface Props {
  calloutType: string;
  title?: string | null;
}

const { calloutType, title } = Astro.props;
---

<figure data-datocms-content-link-boundary>
  <prose-island>
    <div
      class:list={[
        s.docCallout,
        s[`docCallout${calloutType.charAt(0).toUpperCase()}${calloutType.slice(1)}`],
      ]}
      data-callout-type={calloutType}
    >
      {
        title && (
          <div class={s.docCalloutTitle}>
            {calloutType === 'neutral' ? (
              <Icon icon={Info} />
            ) : calloutType === 'warning' ? (
              <Icon icon={TriangleAlert} />
            ) : calloutType === 'positive' ? (
              <Icon icon={Smile} />
            ) : calloutType === 'protip' ? (
              <Icon icon={WandSparkles} />
            ) : null}{' '}
            <span data-callout-title>
              {calloutType === 'protip' && 'Pro tip: '}
              {title}
            </span>
          </div>
        )
      }
      <div data-callout-content>
        <Prose class={s.content}>
          <slot />
        </Prose>
      </div>
    </div>
  </prose-island>
</figure>
