---
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import { stripStega } from '@datocms/astro';
import { readFragment, type FragmentOf } from 'gql.tada';
import { AppWindow } from '~/components/AppWindow';
import { Button } from '~/components/Button';
import { Icon } from '~/components/Icon';
import { Logo } from '~/components/Logo';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { dashboardUrl } from '~/lib/datocms/dashboardUrl';
import { DemoFragment } from './graphql';
import s from './style.module.css';

interface Props {
  block: FragmentOf<typeof DemoFragment>;
}

const { demo } = readFragment(DemoFragment, Astro.props.block);
const { technology } = demo;

// The repo is `owner/name:branch`. The link opens the branch on GitHub.
const [repo, branch] = stripStega(demo.githubRepo).split(':');
// The width of the window: the column less the padding of the column and
// of the block, then 560px to 760px (the content column of the docs, less
// the padding of the block).
const sizes =
  'auto, (max-width: 767px) calc(100vw - 115px), (max-width: 899px) calc(100vw - 135px), (min-width: 1320px) and (max-width: 1599px) 660px, 760px';
const githubUrl = `https://github.com/${repo}${branch ? `/tree/${branch}` : ''}`;
---

{
  /*
  A starter to launch from a docs page, on a tinted block: its screenshot
  in a small window, then its name, the logo of its technology,
  its description, and the actions (deploy it, read its code).
*/
}
<figure data-datocms-content-link-boundary>
  <prose-island>
    <div class={s.demo}>
      <AppWindow address={demo.name} class={s.window} size="s">
        <ResponsiveImage data={demo.screenshot.responsiveImage} sizes={sizes} />
      </AppWindow>
      <div class={s.details}>
        <div class={s.heading}>
          <p class="bodyMedium">{demo.name}</p>
          <span class={s.technology}>
            <Logo
              logo={{
                mask: technology.logo.url,
                alt: stripStega(technology.logo.alt ?? technology.name),
                width: technology.logo.width ?? 1,
                height: technology.logo.height ?? 1,
              }}
            />
          </span>
        </div>
        {demo.cmsDescription && <p class:list={[s.description, 'body']}>{demo.cmsDescription}</p>}
        <div class={s.actions}>
          <Button
            href={dashboardUrl(`/deploy?repo=${demo.githubRepo}`)}
            attrs={{ target: '_blank', rel: 'noreferrer' }}
          >
            Deploy the demo project
          </Button>
          <a
            class:list={[s.github, 'labelMedium']}
            href={githubUrl}
            target="_blank"
            rel="noreferrer"
          >
            <Icon icon={faGithub} />
            Code on GitHub
          </a>
        </div>
        <p class:list={[s.note, 'caption']}>Online in three clicks, in a few minutes.</p>
      </div>
    </div>
  </prose-island>
</figure>
