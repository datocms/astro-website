---
import { faChevronDown, faChevronRight } from '@fortawesome/pro-regular-svg-icons';
import { Icon } from '~/components/Icon';
import s from './style.module.css';

type Props = {
  label?: string;
};

const { label } = Astro.props;
---

<details class={s.pane}>
  <summary class={s.expandablePaneButton}>
    <Icon icon={faChevronRight} class={s.closedSvg} /><Icon
      icon={faChevronDown}
      class={s.openSvg}
    />
    {label}
  </summary>

  <div class={s.expandablePaneContent}>
    <slot />
  </div>
</details>
