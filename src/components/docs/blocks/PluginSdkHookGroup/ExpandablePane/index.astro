---
import { ChevronDown, ChevronRight } from 'lucide';
import { Icon } from '~/components/Icon';
import s from './style.module.css';

type Props = {
  label?: string;
};

const { label } = Astro.props;
---

<details class={s.pane}>
  <summary class={s.expandablePaneButton}>
    <Icon icon={ChevronRight} class={s.closedSvg} /><Icon icon={ChevronDown} class={s.openSvg} />
    {label}
  </summary>

  <div class={s.expandablePaneContent}>
    <slot />
  </div>
</details>
