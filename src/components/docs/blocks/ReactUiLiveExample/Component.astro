---
import { ReactUiLiveExampleFragment } from './graphql';
import type { FragmentOf } from 'gql.tada';
import { readFragment } from 'gql.tada';
import { stripStega } from '@datocms/astro';
import s from './style.module.css';

interface Props {
  block: FragmentOf<typeof ReactUiLiveExampleFragment>;
}

const { block } = Astro.props;

const { componentName } = readFragment(ReactUiLiveExampleFragment, block);
---

{/* A placeholder. The live examples of datocms-react-ui are not on this site. */}
<div class={s.placeholder}>
  Examples of the <code>{stripStega(componentName)}</code> component
</div>
