---
import { Space } from '~/components/docs/Space';
import s from './style.module.css';
import { FormBox, FormRow } from '~/components/FormBox';
import { FormField } from '~/components/FormField';
import { Tab, Tabs } from '~/components/docs/Tabs';
import { CodeSnippet } from '~/components/docs/CodeSnippet';
---

<clone-button-form>
  <Space top={1} bottom={1}>
    <form action="https://dashboard.datocms.com/clone" method="GET" class={s.form}>
      <FormBox>
        <FormRow>
          <FormField
            type="text"
            name="projectId"
            id="cbg-projectId"
            label="Project ID"
            placeholder="54321"
          />
        </FormRow>
        <FormRow>
          <FormField
            type="text"
            name="name"
            id="cbg-name"
            label="Project name"
            placeholder="Your project name"
          />
        </FormRow>
      </FormBox>
    </form>
  </Space>

  <div>
    <p>Use the following code to share the button on your README file or documentation:</p>
    <Space top={1} bottom={1}>
      <Tabs>
        <Tab title="Markdown" noPadding>
          <CodeSnippet lang="markdown" wrap data-markdown />
        </Tab>
        <Tab title="HTML" noPadding>
          <CodeSnippet lang="html" data-html />
        </Tab>
        <Tab title="URL" noPadding>
          <CodeSnippet lang="text" wrap data-url />
        </Tab>
        <Tab title="Preview">
          <a target="_blank" rel="noopener noreferrer" class={s.button} data-href>
            <img src="https://dashboard.datocms.com/clone/button.svg" alt="Clone with DatoCMS" />
          </a>
        </Tab>
      </Tabs>
    </Space>
  </div>
</clone-button-form>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  window.customElements.define(
    'clone-button-form',
    class CloneButtonForm extends WebComponent {
      form!: HTMLFormElement;
      url!: HTMLElement;
      markdown!: HTMLElement;
      html!: HTMLElement;
      href!: HTMLLinkElement;

      parsedCallback() {
        this.form = this.$('form');
        this.url = this.$('[data-url]');
        this.markdown = this.$('[data-markdown]');
        this.html = this.$('[data-html]');
        this.href = this.$('[data-href]');

        this.on(this.form, 'input', this.render);

        this.render();
      }

      render() {
        const data = new FormData(this.form);
        const params = new URLSearchParams(data as unknown as Record<string, string>).toString();
        const url = `https://dashboard.datocms.com/clone?${params}`;

        this.url.setAttribute('code', url);
        this.markdown.setAttribute(
          'code',
          `[![Clone with DatoCMS](https://dashboard.datocms.com/clone/button.svg)](${url})`,
        );
        this.html.setAttribute(
          'code',
          `<a
  href="${url}"
  target="_blank"
  rel="noopener"
>
  <img
    src="https://dashboard.datocms.com/clone/button.svg"
    alt="Clone with DatoCMS"
  />
</a>`,
        );
        this.href.href = url;
      }
    },
  );
</script>
