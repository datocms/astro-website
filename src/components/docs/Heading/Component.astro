---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { fromHtml } from 'hast-util-from-html';
import { toString } from 'hast-util-to-string';
import { HeadingAnchor } from '~/components/HeadingAnchor';

type Props<T extends HTMLTag = 'h1'> = Polymorphic<{
  as: T;
  anchor?: string;
}>;

const { as: Tag = 'h1' as any, anchor, children, ...props } = Astro.props;
const html = await Astro.slots.render('default');
---

<Tag {...props} id={anchor} class={props.class}>
  <Fragment set:html={html} />
  {anchor && <HeadingAnchor id={anchor} text={toString(fromHtml(html, { fragment: true }))} />}
</Tag>
