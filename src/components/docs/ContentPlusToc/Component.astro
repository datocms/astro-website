---
import s from './style.module.css';
import { Toc } from './Toc';
import type { TocGroup } from './types';

type Props = {
  tocGroups: TocGroup[];
};

const { tocGroups } = Astro.props;
---

{
  /*
  The article and its table of contents. The breadcrumb and the actions on
  the page are not here: the page gives them to the header of the layout
  (PageBar, in the slot "pagebar").
*/
}
<div class={s.articleContainer} data-docs-toc={tocGroups.length > 0 ? '' : undefined}>
  <article class={s.article} data-datocms-md-root>
    <h1 class={s.title}>
      <slot name="title" />
    </h1>
    <slot />
  </article>
  {
    tocGroups.length > 0 && (
      <div class={s.toc} data-datocms-noindex>
        <Toc groups={tocGroups} />
      </div>
    )
  }
</div>
