---
import { Prose as BaseProse } from '~/components/Prose';
import s from './style.module.css';

type Props = {
  class?: string;
};
---

{
  /*
  The Prose of the site, plus the rules that only the docs need: callouts,
  details, tables, video and the anchors of the headings. The extras follow
  the same scope as Prose: they stop at the children of <prose-island>.
*/
}
<BaseProse class:list={[s.extras, Astro.props.class]}>
  <slot />
</BaseProse>
