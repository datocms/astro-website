---
import { PixelEmoji } from '~/components/PixelEmoji';
import { emojiTexts, logos, pixelEmojis, type EmojiName } from './emojis';
import styles from './style.module.css';

// An emoji inside a line of text. It takes the size of the text around it.
// The words of the line stay in the DOM: a crawler and a screen reader read
// the text of the emoji, or nothing when it only decorates.

interface Props {
  name: EmojiName;
}

const { name } = Astro.props;
const text = emojiTexts[name];
const logo = name in logos ? logos[name as keyof typeof logos] : undefined;
const pixel = name in pixelEmojis ? pixelEmojis[name as keyof typeof pixelEmojis] : undefined;
---

<span
  class:list={[styles.emoji, styles[name], logo && styles.logo, pixel && styles.drawing]}
  data-emoji={name}
>
  {logo && <span class={styles.mark} aria-hidden="true" set:html={logo} />}
  {pixel && <PixelEmoji emoji={pixel} class={styles.pixel} animated trim />}{
    text && <span class="visuallyHidden">{text}</span>
  }
</span>
