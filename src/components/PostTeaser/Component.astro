---
import {
  render as toPlainText,
  type StructuredTextDocument,
} from 'datocms-structured-text-to-plain-text';
import { MediaCard } from '~/components/MediaCard';
import { buildUrlForBlogPost } from '~/lib/datocms/gqlUrlBuilder/blogPost';
import { buildUrlForCustomerStory } from '~/lib/datocms/gqlUrlBuilder/customerStory';
import { readFragment } from '~/lib/datocms/graphql';
import { formatLongDate } from '~/lib/format/date';
import { ChatTeaserFragment, PostTeaserFragment } from './graphql';
import type { PostTeaserItem } from './types';
import styles from './style.module.css';

type Props = PostTeaserItem;

const chat = Astro.props.chat ? readFragment(ChatTeaserFragment, Astro.props.chat) : undefined;
const post = Astro.props.post ? readFragment(PostTeaserFragment, Astro.props.post) : undefined;
const item = (chat ?? post)!;
const href = chat ? buildUrlForCustomerStory(chat) : buildUrlForBlogPost(post!);
const date = item._firstPublishedAt ?? item._createdAt;
const people = chat ? chat.people : post!.author;
const names = new Intl.ListFormat('en', { type: 'conjunction' }).format(
  people.map((person) => person.name),
);
const excerpt = toPlainText(item.excerpt.value as StructuredTextDocument) ?? undefined;
---

{
  /*
  The card of the case studies (MediaCard): the excerpt in
  place of the description, a byline in place of the logo.
*/
}
<MediaCard
  href={href}
  image={item.coverImage ? { src: item.coverImage.url, alt: item.coverImage.alt ?? '' } : undefined}
  imageShape="cover"
  title={item.title}
  description={excerpt}
>
  <span class={styles.byline}>
    <span class={styles.avatars}>
      {
        people.map((person) => (
          <img
            class={styles.avatar}
            src={person.avatar.url}
            alt=""
            width="30"
            height="30"
            loading="lazy"
          />
        ))
      }
    </span>
    <span class:list={[styles.text, 'caption']}>
      <span class={styles.names}>{chat ? `Casual chat with ${names}` : names}</span>
      <time class={styles.date} datetime={date}>{formatLongDate(date)}</time>
    </span>
  </span>
</MediaCard>
