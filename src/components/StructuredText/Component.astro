---
import { StructuredText as DatoStructuredText } from '@datocms/astro';
import type { ComponentProps } from 'astro/types';
import CodeNode from './CodeNode.astro';
import HeadingNode from './HeadingNode.astro';

type Props = ComponentProps<typeof DatoStructuredText>;

const { nodeOverrides, ...props } = Astro.props;
---

{/* A Structured Text field of DatoCMS. Put it in Prose: Prose styles the HTML. */}
<DatoStructuredText
  {...props}
  nodeOverrides={{ heading: HeadingNode, code: CodeNode, ...nodeOverrides }}
/>
