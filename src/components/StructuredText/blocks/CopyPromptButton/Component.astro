---
import { CopyPrompt } from '~/components/CopyPrompt';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { CopyPromptButtonFragment } from './graphql';

interface Props {
  block: FragmentOf<typeof CopyPromptButtonFragment>;
}

const { prompt } = readFragment(CopyPromptButtonFragment, Astro.props.block);
---

<prose-island data-text-width data-datocms-content-link-boundary>
  <CopyPrompt text={prompt} />
</prose-island>
