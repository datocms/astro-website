---
import { ensureValidStructuredTextProps } from '@datocms/astro';
import { DocCallout } from '~/components/docs/blocks/DocCallout';
import { Prose } from '~/components/docs/DocsProse';
import { Tab, Tabs } from '~/components/docs/Tabs';
import { StructuredText } from '~/components/StructuredText';
import AnchoredHeadingNode from '~/components/StructuredText/AnchoredHeadingNode.astro';
import { defaultInlineRecordComponents } from '~/components/StructuredText/inlineRecords';
import { defaultLinkToRecordComponents } from '~/components/StructuredText/linkToRecords';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { Image } from '../Image';
import { Video } from '../Video';
import { TabBlockFragment, TabsBlockFragment } from './graphql';

interface Props {
  block: FragmentOf<typeof TabsBlockFragment>;
}

const block = readFragment(TabsBlockFragment, Astro.props.block);
const tabs = block.tabs.map((tab) => readFragment(TabBlockFragment, tab));
---

{
  /*
  Tabs, with the design of the tabs of the docs: the same tabs as the
  Markdown of the docs and the code of the forms. Each panel has its own
  Prose, and its headings have a link to them.
*/
}
<figure>
  <Tabs>
    {
      tabs.map((tab) => (
        <Tab title={tab.title} noPadding>
          <Prose>
            <StructuredText
              nodeOverrides={{ heading: AnchoredHeadingNode }}
              {...ensureValidStructuredTextProps({
                data: tab.content,
                blockComponents: {
                  ImageRecord: Image,
                  VideoRecord: Video,
                  DocCalloutRecord: DocCallout,
                },
                linkToRecordComponents: defaultLinkToRecordComponents,
                inlineRecordComponents: defaultInlineRecordComponents,
              })}
            />
          </Prose>
        </Tab>
      ))
    }
  </Tabs>
</figure>
