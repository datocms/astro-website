---
import { VideoPlayer } from '~/components/VideoPlayer';
import { readFragment, type FragmentOf } from '~/lib/datocms/graphql';
import { InternalVideoFragment } from './graphql';

interface Props {
  block: FragmentOf<typeof InternalVideoFragment>;
}

const { video } = readFragment(InternalVideoFragment, Astro.props.block);
---

{
  /*
  A video of the DatoCMS Media Area, in the Mux player. The player has its
  own design, thus it is in an island. The title of the video is the
  caption.
*/
}
<figure data-datocms-content-link-boundary>
  <prose-island>
    <VideoPlayer data={video} />
  </prose-island>
  {video.title && <figcaption>{video.title}</figcaption>}
</figure>
