---
// The grid of the partner cells: one, two or three columns, with a
// hairline between the cells. Each child is an `<li>` with a PartnerCard.
import styles from './style.module.css';

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<div class={styles.gridFrame}>
  <ul class={styles.grid} id={id}>
    <slot />
  </ul>
</div>
