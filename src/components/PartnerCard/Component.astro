---
// One partner in a list: the name, the flags of the locations, the short
// description (the default slot) and a label.
import { stripStega } from '@datocms/astro';
import styles from './style.module.css';

interface Props {
  href: string;
  name: string;
  /** The locations of the partner: the card shows the first five flags. */
  locations?: { name: string; emoji: string }[];
  /** A short text below the description, such as the count of the showcase projects. */
  label?: string;
}

const { href, name, locations = [], label } = Astro.props;

const flagsMax = 5;
---

<a href={href} class={styles.card}>
  <span class={styles.title}>
    <span class="title">{name}</span>
    {
      locations.length > 0 && (
        <span class={styles.flags}>
          {locations.slice(0, flagsMax).map((location) => (
            <span role="img" aria-label={stripStega(location.name)}>
              {location.emoji}
            </span>
          ))}
          {locations.length > flagsMax && (
            <span class:list={[styles.more, 'label']}>+ {locations.length - flagsMax} more</span>
          )}
        </span>
      )
    }
  </span>
  <span class:list={[styles.description, 'label']}>
    <slot />
  </span>
  {label && <span class:list={[styles.label, 'caption', 'tabular']}>{label}</span>}
</a>
