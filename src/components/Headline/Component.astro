---
import { Typewriter } from '~/components/Typewriter';
import type { Step, TypewriterStart } from '~/lib/motion/typewriter';
import styles from './style.module.css';

interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'p';
  size?: 'display' | 'headline' | 'title';
  /** The muted run after the main text. The `muted` slot can replace it. */
  muted?: string;
  /**
   * The glyphs of the face at the end of the muted run, for a typewriter
   * script that plays the face. A no-break space joins it to the last word.
   * It is decoration, thus it is hidden from assistive technology.
   */
  faceGlyphs?: string;
  breakBeforeMuted?: boolean;
  /** Animate the full headline (main and muted runs) with these steps. */
  typewriter?: Step[];
  typewriterStart?: TypewriterStart;
  typewriterDelay?: number;
  /** See `hurryOnInteraction` of Typewriter. */
  typewriterHurry?: boolean;
  class?: string;
  id?: string;
}

const {
  as: Tag = 'h2',
  size = 'headline',
  muted,
  faceGlyphs,
  breakBeforeMuted = false,
  typewriter,
  typewriterStart,
  typewriterDelay,
  typewriterHurry,
  class: className,
  id,
} = Astro.props;

// A conditional `muted` slot counts as present also when it is empty: thus
// the check uses the rendered content.
const mutedHtml = Astro.slots.has('muted') ? (await Astro.slots.render('muted')).trim() : '';
const hasMuted = Boolean(muted) || mutedHtml !== '';
const Wrapper = typewriter ? Typewriter : Fragment;
const wrapperProps = typewriter
  ? {
      script: typewriter,
      start: typewriterStart,
      delay: typewriterDelay,
      hurryOnInteraction: typewriterHurry,
    }
  : {};
---

<Tag class:list={[size, styles.headline, className]} id={id}>
  <Wrapper {...wrapperProps}>
    <slot />{
      hasMuted && (
        <>
          {' '}
          <span
            class:list={[
              styles.muted,
              size === 'title' && styles.mutedSmall,
              breakBeforeMuted && styles.mutedBlock,
            ]}
            data-datocms-subline
          >
            {mutedHtml ? <Fragment set:html={mutedHtml} /> : muted}
            {faceGlyphs && (
              <>
                {'\u00A0'}
                <span aria-hidden="true" data-datocms-nomd>
                  {faceGlyphs}
                </span>
              </>
            )}
          </span>
        </>
      )
    }
  </Wrapper>
</Tag>
