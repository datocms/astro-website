---
import { CtaBanner } from '~/components/CtaBanner';
import { DevConfig } from '~/components/DevConfig';
import { PixelVideo } from '~/components/PixelVideo';
import type { CtaBannerData } from '~/data/home';
import type { FaceName } from '~/lib/motion/faces';
import { pxvDevConfig, pxvLook } from '~/lib/pixel-video/headers';
import styles from './style.module.css';

// The block (the copy, the video and the band) takes the theme of the page,
// the same as the footer below it (DESIGN.md, "Page themes").
type Cta =
  | {
      /**
       * The closing call to action above the video. The closer ignores its
       * theme. With a video, the closer also sets its surface and the
       * appearance of its buttons (see below).
       */
      cta: CtaBannerData;
      /**
       * The face at the end of the headline of the cta. It is necessary with
       * a cta. Each page selects its own, not the face of its hero.
       */
      face: FaceName;
    }
  | { cta?: undefined; face?: undefined };

type Props = Cta & {
  /**
   * The URL of a .pxv file of public/videos, above the band. The file
   * gives all the look: the palette (thus the surface of the copy and of
   * the video), the focus, the edges.
   */
  video?: string;
  /**
   * `band`: the video fills the band (default).
   * `centre`: a square video in the centre.
   */
  videoLayout?: 'band' | 'centre';
  href?: string;
  text?: string;
};

const {
  cta,
  face,
  video,
  videoLayout = 'band',
  href = '/contact',
  text = 'Questions? Ask away',
} = Astro.props;

// The copy and the video are on one surface: the surface of the palette of
// the file. Without a video, the variant of the cta sets it.
const look = video ? pxvLook(video) : undefined;
const surface = look?.palette.surface;
const ctaVariant = surface ? (surface === 'inverse' ? 'dark' : 'light') : cta?.variant;
---

<div class={styles.pageCloser}>
  {
    cta && ctaVariant && (
      <CtaBanner
        {...cta}
        buttons={cta?.buttons}
        face={face}
        theme={undefined}
        variant={ctaVariant}
        class={video && styles.cta}
      />
    )
  }
  {
    video && look && (
      <div
        class:list={[
          styles.video,
          surface === 'inverse' && styles.inverse,
          surface === 'default' && styles.default,
          surface === 'inverse' ? 'surfaceInverse' : 'surfaceAccent',
          look.palette.extend === false && styles.noExtend,
          videoLayout === 'centre' && styles.centre,
        ]}
      >
        <PixelVideo src={video} devTag={false} />
        {/* The band can cut the top and the sides of the video, thus the tag is on the band. */}
        {import.meta.env.DEV && <DevConfig name="PixelVideo" config={pxvDevConfig(video)} />}
      </div>
    )
  }
  <a href={href} class:list={[styles.band, 'surfaceInverse']}>
    <span class:list={[styles.inner, 'headline']}>
      <span class={styles.arrow} aria-hidden="true">→</span>
      <span>
        {text}{' '}
        <span class={styles.faceDefault} aria-hidden="true">[••]</span>
        <span class={styles.faceHover} aria-hidden="true">[•ᴗ•]</span>
      </span>
    </span>
  </a>
</div>
