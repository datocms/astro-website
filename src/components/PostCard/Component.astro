---
import { PixelCover } from '~/components/PixelCover';
import { PlainText } from '~/components/StructuredText';
import { buildUrlForBlogPost } from '~/lib/datocms/gqlUrlBuilder/blogPost';
import { buildUrlForCustomerStory } from '~/lib/datocms/gqlUrlBuilder/customerStory';
import { readFragment } from '~/lib/datocms/graphql';
import { blogCoverForHref } from '~/data/blogCovers';
import { formatLongDate } from '~/lib/format/date';
import { ChatCardFragment, PostCardFragment } from './graphql';
import { maxAvatars, shortByline } from './names';
import type { PostCardItem } from './types';
import styles from './style.module.css';

type Props = PostCardItem & {
  /**
   * "featured" is a square cell of the featured row: the title, the
   * excerpt and the byline, on a tint. "dense" is a cell of the text grid:
   * the title and the byline. The cell is one link.
   */
  variant: 'featured' | 'dense';
  /** The tint of a featured cell. */
  tint?: 'faint' | 'subtle';
};

const { variant, tint = 'faint' } = Astro.props;
const chat = Astro.props.chat ? readFragment(ChatCardFragment, Astro.props.chat) : undefined;
const post = Astro.props.post ? readFragment(PostCardFragment, Astro.props.post) : undefined;
const item = (chat ?? post)!;
const href = chat ? buildUrlForCustomerStory(chat) : buildUrlForBlogPost(post!);
const date = item._firstPublishedAt ?? item._createdAt;
// A casual chat has no category: its label says what it is.
const kind = chat ? 'Casual chat' : post!.category?.name;
const people = chat ? chat.people : post!.author;
const short = shortByline(people.map((person) => person.name));
const shown = people.slice(0, maxAvatars);
const isFeatured = variant === 'featured';
// A featured cell shows the cover of the post when the post has one.
const cover = isFeatured && post ? blogCoverForHref(href) : undefined;
---

<a
  href={href}
  class:list={[
    styles.cell,
    isFeatured ? [styles.featured, cover ? styles.withCover : styles[tint]] : styles.dense,
  ]}
>
  {cover && <PixelCover cover={cover} class={styles.cover} data-cover />}
  <span class:list={[styles.label, 'caption']}>
    <time class={styles.date} datetime={date}>{formatLongDate(date)}</time>
    {kind && <span class={styles.kind}>{kind}</span>}
  </span>
  <h3 class:list={[styles.title, isFeatured ? 'title' : 'bodyMedium']}>{item.title}</h3>
  {
    isFeatured && (
      <span class={styles.excerpt}>
        <PlainText data={item.excerpt} />
      </span>
    )
  }
  <span class={styles.byline}>
    <span class={styles.avatars}>
      {
        shown.map((person) => (
          <img
            class={styles.avatar}
            src={person.avatar.url}
            alt=""
            width="20"
            height="20"
            loading="lazy"
          />
        ))
      }
    </span>
    <span class:list={[styles.names, 'caption']}>
      {short.first}
      {
        short.others > 0 && (
          <>
            <span aria-hidden="true"> +{short.others}</span>
            <span class="visuallyHidden"> {short.spoken}</span>
          </>
        )
      }
    </span>
  </span>
</a>
