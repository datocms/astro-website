---
import { PixelVideo } from '~/components/PixelVideo';
import { Section } from '~/components/Section';
import { pxvHeader } from '~/lib/pixel-video/headers';
import type { Theme } from '~/lib/theme';
import Attribution from './Attribution.astro';
import { hasText, readQuote, type QuoteItem } from './data';
import styles from './style.module.css';

interface Props {
  /** The review or the partner testimonial. Without it, nothing shows. */
  quote: QuoteItem | null | undefined;
  /**
   * `centered`: the quote and the person on the accent band. `split`: the
   * quote and the person on the accent half, a hand on the inverse half.
   * Use `split` on a page with few split bands, and `centered` on a page
   * with many.
   */
  variant?: 'centered' | 'split';
  /**
   * The hand of the inverse half (only for `split`). Each hand comes in
   * from the right edge, toward the quote. Do not use the hand of the
   * PageCloser of the same page.
   */
  hand?: 'point-left' | 'ok-reach' | 'snap';
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const { variant = 'centered', hand = 'point-left', theme } = Astro.props;
const handSrc = `/videos/hand-${hand}.pxv`;
// The ratio of the video, before the player reads the file.
const handHeader = pxvHeader(handSrc);
const handAspect = handHeader.width / handHeader.height;
const read = Astro.props.quote ? readQuote(Astro.props.quote) : null;
const quote = read && hasText(read) ? read : null;

/*
 * A page asks for its quote by ID. When the record is deleted or has no
 * text, the page shows no quote, and the log tells why.
 */
if (!quote) {
  console.warn(
    `[Quote] ${Astro.url.pathname}: no quote to show (the record is missing or has no text).`,
  );
}
---

{/* The quote that closes a chapter: the full quote, in the headline type. */}
{
  quote && variant === 'centered' && (
    <Section theme={theme} background="accent" padding="headlines" width="headline">
      <figure class={styles.centered}>
        <blockquote class:list={[styles.quote, 'h1']}>
          <p>
            “{quote.text}
            {'⁠”'}
            {quote.stega}
          </p>
        </blockquote>
        <Attribution quote={quote} size="statement" />
      </figure>
    </Section>
  )
}
{
  quote && variant === 'split' && (
    <Section theme={theme} padding="none" flush>
      <figure class={styles.split}>
        <div class:list={[styles.half, styles.accent, 'surfaceLight']}>
          <blockquote class:list={[styles.quote, 'h1']}>
            <p>
              “{quote.text}
              {'⁠”'}
              {quote.stega}
            </p>
          </blockquote>
          <Attribution quote={quote} size="statement" />
        </div>
        <div class={styles.inverse} style={`--hand-aspect: ${handAspect}`}>
          <PixelVideo src={handSrc} class={styles.hand} />
        </div>
      </figure>
    </Section>
  )
}
