---
import { Section } from '~/components/Section';
import type { Theme } from '~/lib/theme';
import Attribution from './Attribution.astro';
import Card from './Card.astro';
import { readQuote, statementText, type QuoteItem } from './data';
import styles from './style.module.css';

interface Props {
  /** The review or the partner testimonial. Without it, nothing shows. */
  quote: QuoteItem | null | undefined;
  /**
   * `centered`: the quote and the person on the accent band. `split`: the
   * quote on the accent half, the person on the inverse half. Use `split`
   * on a page with few split bands, and `centered` on a page with many.
   */
  variant?: 'centered' | 'split';
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const { variant = 'centered', theme } = Astro.props;
const quote = Astro.props.quote ? readQuote(Astro.props.quote) : null;
const text = quote ? statementText(quote) : null;
---

{
  /*
  The quote that closes a chapter, in the headline type. It shows the
  excerpt, or the full quote when it is short (see statementText). A quote
  that is too long for the headline type shows as a card.
*/
}
{
  quote && !text && (
    <Section theme={theme} width="reading">
      <Card quote={quote} />
    </Section>
  )
}
{
  quote && text && variant === 'centered' && (
    <Section theme={theme} background="accent" padding="headlines" width="headline">
      <figure class={styles.centered}>
        <blockquote class:list={[styles.quote, 'h1']}>
          <p>
            “{text}
            {'⁠”'}
          </p>
        </blockquote>
        <Attribution quote={quote} size="statement" />
      </figure>
    </Section>
  )
}
{
  quote && text && variant === 'split' && (
    <Section theme={theme} padding="none" flush>
      <figure class={styles.split}>
        <div class:list={[styles.half, styles.accent, 'surfaceLight']}>
          <blockquote class:list={[styles.quote, 'h1']}>
            <p>
              “{text}
              {'⁠”'}
            </p>
          </blockquote>
        </div>
        <div class:list={[styles.half, styles.inverse]}>
          <Attribution quote={quote} size="statement" />
        </div>
      </figure>
    </Section>
  )
}
