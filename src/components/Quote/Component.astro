---
import { PlainText } from '~/components/StructuredText';
import { Section } from '~/components/Section';
import type { QuoteData } from '~/data/case-studies';
import { type FragmentOf, readFragment } from '~/lib/datocms/graphql';
import type { Theme } from '~/lib/theme';
import { QuotePartnerTestimonialFragment, QuoteReviewFragment } from './graphql';
import styles from './style.module.css';

interface Props {
  /** The review of the CMS. Without it, the quote is the fallback. */
  review?: FragmentOf<typeof QuoteReviewFragment> | null;
  /**
   * A testimonial of a partner. It replaces the review. The role shows the
   * name of the partner, and the photo comes from the CMS.
   */
  testimonial?: FragmentOf<typeof QuotePartnerTestimonialFragment> | null;
  /** The quote of the data file. It also gives a missing name or role. */
  fallback: QuoteData;
  /** Without a theme, the section inherits the theme of its parent. */
  theme?: Theme;
}

const { fallback, theme } = Astro.props;
const testimonial = readFragment(QuotePartnerTestimonialFragment, Astro.props.testimonial);
const review = testimonial ?? readFragment(QuoteReviewFragment, Astro.props.review);

const name = review?.name ?? fallback.name;
const role = testimonial
  ? [testimonial.role, testimonial.partner?.name].filter(Boolean).join(' at ')
  : (review?.role ?? fallback.role);
const avatar = testimonial ? testimonial.image?.url : fallback.avatar;
---

<Section theme={theme} background="accent" padding="headlines" width="headline">
  <figure class={styles.figure}>
    <blockquote class:list={[styles.quote, 'h1']}>
      <p>
        {
          review ? (
            <>
              “<PlainText data={review.quote} typographic />”
            </>
          ) : (
            fallback.quote
          )
        }
      </p>
    </blockquote>
    <figcaption class={styles.author}>
      {
        avatar && (
          <img class={styles.avatar} src={avatar} alt="" width="40" height="40" loading="lazy" />
        )
      }
      <span class="subtitleMedium">
        {name}
        <span class={styles.role}>{role}</span>
      </span>
    </figcaption>
  </figure>
</Section>
