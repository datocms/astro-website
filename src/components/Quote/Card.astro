---
import Attribution from './Attribution.astro';
import type { QuoteData } from './data';
import styles from './Card.module.css';

interface Props {
  quote: QuoteData;
  /** `large`: a featured quote, one type step larger, with the larger photo. */
  size?: 'default' | 'large';
  class?: string;
}

const { quote, size = 'default', class: className } = Astro.props;
---

{
  /*
  The full quote, then the person. The highlight of the CMS is a <mark>. The
  word joiner keeps the closing mark on the line of the last word. The
  stega of Content Link comes after the closing mark (see quoteText).
*/
}
<figure class:list={[styles.card, size === 'large' && styles.large, className]}>
  <blockquote class={styles.quote}>
    <p>
      “{
        quote.lines.map((line, i) => [
          i > 0 && <br />,
          line.map((run) => (run.highlight ? <mark>{run.text}</mark> : run.text)),
        ])
      }{'⁠”'}{quote.stega}
    </p>
  </blockquote>
  <Attribution quote={quote} size={size === 'large' ? 'statement' : 'card'} />
</figure>
