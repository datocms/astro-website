---
import Attribution from './Attribution.astro';
import type { QuoteData } from './data';
import styles from './Card.module.css';

interface Props {
  quote: QuoteData;
  class?: string;
}

const { quote, class: className } = Astro.props;
const lines = quote.text.split('\n');
---

{
  /*
  The full quote, then the person. The word joiner keeps the closing mark on
  the line of the last word.
*/
}
<figure class:list={[styles.card, className]}>
  <blockquote class={styles.quote}>
    <p>
      “{lines.map((line, i) => (i === 0 ? line : [<br />, line]))}{'⁠”'}
    </p>
  </blockquote>
  <Attribution quote={quote} />
</figure>
