---
import { ButtonGroup } from '~/components/ButtonGroup';
import { Headline } from '~/components/Headline';
import { Section } from '~/components/Section';
import type { FeaturesData } from '~/data/home';
import type { Theme } from '~/lib/theme';
import styles from './style.module.css';

interface Props extends FeaturesData {
  titleSize?: 'headline' | 'title';
  /**
   * ≥1152: the image stays at the top of the screen while the list
   * scrolls. Use it for a long list.
   */
  stickyVisual?: boolean;
  /**
   * The list half is on surface/accent and the visual half on
   * surface/inverse.
   */
  inverted?: boolean;
  /**
   * The placeholder cards. `stacked`: a tall card above a small centred
   * card, in a 374×500 frame.
   */
  placeholder?: 'default' | 'stacked';
  /**
   * A fixed theme for the list half. The visual half keeps the theme of
   * the active feature.
   */
  listTheme?: Theme;
  /**
   * ≥1152: the frame fills the visual half, with no padding. Use it for
   * pictures in the slots: each picture sets its own margin (a window at
   * the padding, cut at the right and the bottom, or a diagram in the
   * middle of the half).
   */
  bleed?: boolean;
}

const {
  title,
  features,
  titleSize = 'headline',
  button,
  stickyVisual = false,
  inverted = false,
  placeholder = 'default',
  listTheme,
  bleed = false,
} = Astro.props;
const first = features[0];

// The slot `visual` is one picture for all the rows: the theme changes
// with the active row. An element in
// the slot with `data-features-pane="<index>"` shows only while its row
// is active: one window, with a different screen for each row.
// Else render each named slot `visual-<index>` in the frame of its row. A
// missing slot gives the image of the feature, or the placeholder cards.
const shared = Astro.slots.has('visual');
const visuals = await Promise.all(
  features.map((_, i) =>
    Astro.slots.has(`visual-${i}`) ? Astro.slots.render(`visual-${i}`) : undefined,
  ),
);
---

<features-list class={styles.root}>
  <Section
    theme={first?.theme}
    padding="none"
    flush
    class:list={[
      styles.features,
      inverted && styles.inverted,
      bleed && styles.bleed,
      placeholder === 'stacked' && styles.stacked,
    ]}
    contentClass={[styles.split, stickyVisual && styles.stickyVisual].filter(Boolean).join(' ')}
    data-features
  >
    <div
      class:list={[
        styles.visualHalf,
        shared && styles.sharedHalf,
        inverted ? 'surfaceInverse' : 'surfaceAccent',
      ]}
      data-features-visual
    >
      <span class={styles.fade} aria-hidden="true" data-features-fade></span>
      <div class={styles.stage}>
        <div
          class:list={[
            styles.frame,
            (shared || visuals.some(Boolean)) && styles.slotted,
            shared && styles.shared,
          ]}
        >
          {
            shared ? (
              <div class={styles.image} data-active>
                <slot name="visual" />
              </div>
            ) : (
              features.map((feature, i) =>
                visuals[i] ? (
                  <div
                    class={styles.image}
                    data-features-image={i}
                    data-active={i === 0 ? '' : undefined}
                  >
                    <Fragment set:html={visuals[i]} />
                  </div>
                ) : feature.image ? (
                  <img
                    src={feature.image.src}
                    alt={feature.image.alt}
                    width="500"
                    height="580"
                    class={styles.image}
                    data-features-image={i}
                    data-active={i === 0 ? '' : undefined}
                    loading="lazy"
                  />
                ) : (
                  <div
                    class={styles.image}
                    data-features-image={i}
                    data-active={i === 0 ? '' : undefined}
                    aria-hidden="true"
                  >
                    <span class={styles.placeholderTop} />
                    <span class={styles.placeholderBottom} />
                  </div>
                ),
              )
            )
          }
        </div>
      </div>
    </div>

    <div
      class:list={[styles.listHalf, inverted ? 'surfaceAccent' : 'surfaceInverse']}
      data-theme={listTheme}
    >
      <span class={styles.fade} aria-hidden="true" data-features-fade></span>
      <div class={styles.list}>
        {
          title && (
            <Headline size="display" class={styles.heading}>
              {title}
            </Headline>
          )
        }
        <ul class={styles.rows}>
          {
            features.map((feature, i) => (
              <li
                class={styles.row}
                data-features-row={i}
                data-row-theme={feature.theme}
                data-open={i === 0 ? '' : undefined}
                data-active={i === 0 ? '' : undefined}
              >
                <h3 class:list={[styles.title, titleSize]}>
                  {feature.href ? (
                    <a href={feature.href} class={styles.link}>
                      {feature.title}
                    </a>
                  ) : (
                    feature.title
                  )}
                  <span class={styles.arrow} aria-hidden="true">
                    →
                  </span>
                </h3>
                <p class:list={[styles.description, 'body']}>{feature.description}</p>
              </li>
            ))
          }
        </ul>
        {button && <ButtonGroup buttons={[button]} />}
      </div>
    </div>
  </Section>
</features-list>

<script>
  import { onVisibilityChange, prefersReducedMotion } from '~/lib/motion/inView';
  import { WebComponent } from '~/lib/WebComponent';

  // A pointer on a row makes it active, and with no pointer the rows become
  // active in turn. The theme, the text and the picture change in one frame.
  // Only the grounds of the two halves fade: a change of these large areas in
  // one frame is a flash. Each half has a layer below its content. The layer
  // gets the old ground colour, and its opacity goes from 1 to 0 on the GPU.
  // Do not fade the theme colours on the main thread or with a view
  // transition: the fade then drops frames.
  const DESKTOP = window.matchMedia('(min-width: 1152px)');
  const FADE_MS = 200;

  customElements.define(
    'features-list',
    class extends WebComponent {
      #globalListeners = new AbortController();

      parsedCallback() {
        const section = this.$('[data-features]');
        // The attributes have the prefix of the section: a picture in a slot can
        // have its own `data-row`.
        const rows = [...section.querySelectorAll<HTMLElement>('[data-features-row]')];
        const images = [...section.querySelectorAll<HTMLElement>('[data-features-image]')];
        const panes = [...section.querySelectorAll<HTMLElement>('[data-features-pane]')];
        const visual = this.$('[data-features-visual]');
        const fades = this.$$('[data-features-fade]');
        let active = 0;

        // The open row shows its arrow and its description.
        const open = (index: number) =>
          rows.forEach((row, i) => row.toggleAttribute('data-open', i === index));

        // Show the active row, its picture and its theme. The active row is
        // also open.
        const render = () => {
          open(active);
          rows.forEach((row, i) => row.toggleAttribute('data-active', i === active));
          images.forEach((img, i) => img.toggleAttribute('data-active', i === active));
          panes.forEach((pane) =>
            pane.toggleAttribute('data-active', pane.dataset.featuresPane === String(active)),
          );
          section.dataset.theme = rows[active]!.dataset.rowTheme;
        };

        // While a fade runs, a new row changes the page at once, and the same
        // fade continues to the ground of the newest row.
        const activate = (index: number) => {
          if (!rows[index]) return;
          if (index === active) return open(index);
          active = index;
          const fade =
            !prefersReducedMotion() && fades.every((layer) => !layer.getAnimations().length);
          if (!fade) return render();
          const grounds = fades.map(
            (layer) => getComputedStyle(layer.parentElement!).backgroundColor,
          );
          render();
          fades.forEach((layer, i) => {
            layer.style.backgroundColor = grounds[i]!;
            layer.animate({ opacity: [1, 0] }, { duration: FADE_MS, easing: 'ease-out' });
          });
        };

        // ≥1152: only a pointer on a row changes the active row. A pointer that
        // moves onto a row makes it active at once. The pointer on the picture
        // does not change it, and the last active row stays active. A page that
        // scrolls below a pointer that does not move changes nothing: the
        // coordinates of the pointer stay the same.
        let previous: { x: number; y: number } | undefined;
        this.on(section, 'pointermove', (event) => {
          if (!DESKTOP.matches || event.pointerType === 'touch') return;
          const { clientX: x, clientY: y } = event;
          const moved = previous !== undefined && (previous.x !== x || previous.y !== y);
          previous = { x, y };
          // The first event in the section can come from a scroll.
          if (!moved) return;
          const row =
            event.target instanceof Element
              ? event.target.closest<HTMLElement>('[data-features-row]')
              : null;
          const index = row ? rows.indexOf(row) : -1;
          if (index >= 0) activate(index);
        });
        this.on(section, 'pointerleave', () => {
          previous = undefined;
        });
        // A touch or a click on a row is a clear intent.
        rows.forEach((row, i) => {
          this.on(row, 'pointerdown', () => {
            if (DESKTOP.matches) activate(i);
          });
        });

        // <1152: the active row is the topmost row fully visible under the sticky image.
        let frame = 0;
        const onScroll = () => {
          if (DESKTOP.matches || frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            const imageBottom = visual.getBoundingClientRect().bottom;
            const i = rows.findIndex((row) => {
              const r = row.getBoundingClientRect();
              return r.top >= imageBottom && r.bottom <= window.innerHeight;
            });
            if (i >= 0) activate(i);
          });
        };
        window.addEventListener('scroll', onScroll, {
          passive: true,
          signal: this.#globalListeners.signal,
        });

        // ≥1152, with a pointer: while the visitor does not use the section,
        // the next row becomes active each 5s, and the first row follows the
        // last. The rotation stops while the pointer is in the section (on
        // the picture also: the scene must not change while the visitor
        // looks at it), while the focus is in the section, while the section
        // is not on the middle line of the viewport, and while the tab is
        // hidden. After a stop, a full interval goes by before the next
        // change. With reduced motion, there is no rotation.
        const ROTATE_MS = 5000;
        const ROTATES = window.matchMedia('(min-width: 1152px) and (hover: hover)');
        let rotateTimer = 0;
        let inView = false;
        let pointerInside = false;
        let focusInside = false;
        const rotate = () => {
          clearTimeout(rotateTimer);
          if (
            !ROTATES.matches ||
            !inView ||
            pointerInside ||
            focusInside ||
            document.hidden ||
            prefersReducedMotion()
          ) {
            return;
          }
          rotateTimer = window.setTimeout(() => {
            // A pointer that did not move after the page load, or a page that
            // scrolled below it, gives no `pointerenter`.
            if (!section.matches(':hover')) activate((active + 1) % rows.length);
            rotate();
          }, ROTATE_MS);
        };
        this.on(section, 'pointerenter', () => {
          pointerInside = true;
          rotate();
        });
        this.on(section, 'pointerleave', () => {
          pointerInside = false;
          rotate();
        });
        this.on(section, 'focusin', () => {
          focusInside = true;
          rotate();
        });
        this.on(section, 'focusout', (event) => {
          focusInside =
            event.relatedTarget instanceof Node && section.contains(event.relatedTarget);
          rotate();
        });
        const { signal } = this.#globalListeners;
        document.addEventListener('visibilitychange', rotate, { signal });
        ROTATES.addEventListener('change', rotate, { signal });
        const stopObserver = onVisibilityChange(
          section,
          (visible) => {
            inView = visible;
            rotate();
          },
          { rootMargin: '-50% 0px' },
        );
        signal.addEventListener('abort', () => {
          stopObserver();
          clearTimeout(rotateTimer);
        });
      }

      disconnectedCallback() {
        super.disconnectedCallback();
        this.#globalListeners.abort();
      }
    },
  );
</script>
