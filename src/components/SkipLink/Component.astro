---
import s from './style.module.css';

/*
 * The first link of the page. It is hidden until it has the keyboard
 * focus. Then it shows at the top left, above the header. It moves the
 * focus past the navigation, to the content of the page.
 */
type Props = {
  /** The id of the element that holds the content of the page. */
  target: string;
};

const { target } = Astro.props;
---

<a
  href={`#${target}`}
  class:list={[s.root, 'surfaceInverse', 'labelMedium', 'capTrim']}
  data-datocms-nomd
>
  Skip to content
</a>
