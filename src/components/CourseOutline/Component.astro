---
import { TocShell } from '~/components/TocShell';
import styles from './style.module.css';

interface Chapter {
  title: string;
  href: string;
  /** The chapter of the page. Its sections show under it. */
  active?: boolean;
  /** The headings of the chapter: the links go to the anchors of the page. */
  sections?: { id: string; text: string }[];
}

interface Props {
  /** For example "Course chapters". */
  title: string;
  chapters: Chapter[];
  class?: string;
}

const { title, chapters, class: className } = Astro.props;
const position = chapters.findIndex((chapter) => chapter.active) + 1;
const note = position > 0 ? `${position} of ${chapters.length}` : undefined;
---

{
  /*
  The chapters of a course, with the sections of the open chapter under it.
  The slot takes the text under the list. TocShell gives the box, the
  float and the mark on the section that the visitor reads.
*/
}
<TocShell title={title} note={note} class={className}>
  <ol>
    {
      chapters.map((chapter) => (
        <li>
          <a
            href={chapter.href}
            title={chapter.title}
            aria-current={chapter.active ? 'page' : undefined}
          >
            {chapter.title}
          </a>
          {chapter.active && chapter.sections && chapter.sections.length > 0 && (
            <ul class={styles.sections}>
              {chapter.sections.map((section) => (
                <li>
                  <a class={styles.section} href={`#${section.id}`} title={section.text}>
                    {section.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
  {
    Astro.slots.has('default') && (
      <Fragment slot="footer">
        <slot />
      </Fragment>
    )
  }
</TocShell>
