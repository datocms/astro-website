---
import styles from './style.module.css';

interface Chapter {
  title: string;
  href: string;
  /** The chapter of the page. Its sections show under it. */
  active?: boolean;
  /** The headings of the chapter: the links go to the anchors of the page. */
  sections?: { id: string; text: string }[];
}

interface Props {
  /** For example "Course chapters". */
  title: string;
  chapters: Chapter[];
  class?: string;
}

const { title, chapters, class: className } = Astro.props;
---

{
  /*
  The chapters of a course, with the sections of the open chapter under it.
  The slot takes the text under the list. From 1152, the list is always
  open. Below 1152, it is a closed box that the visitor opens.
  The search index and the Markdown version of the page skip this list.
*/
}
<course-outline class={styles.wrapper}>
  <nav
    class:list={[styles.root, className]}
    aria-label={title}
    data-course-outline
    data-datocms-noindex
    data-datocms-nomd
  >
    <details class={styles.details} open>
      <summary class:list={[styles.title, 'subtitleMedium']}>{title}</summary>
      <ol class={styles.list}>
        {
          chapters.map((chapter) => (
            <li>
              <a
                class:list={[styles.link, 'body', chapter.active && styles.active]}
                href={chapter.href}
                aria-current={chapter.active ? 'page' : undefined}
              >
                {chapter.title}
              </a>
              {chapter.active && chapter.sections && chapter.sections.length > 0 && (
                <ul class={styles.sections}>
                  {chapter.sections.map((section) => (
                    <li>
                      <a
                        class:list={[styles.section, 'body']}
                        href={`#${section.id}`}
                        title={section.text}
                      >
                        {section.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
      {
        Astro.slots.has('default') && (
          <div class:list={[styles.footer, 'caption']}>
            <slot />
          </div>
        )
      }
    </details>
  </nav>
</course-outline>

<script>
  import { WebComponent } from '~/lib/WebComponent';

  // From 1152 the box is always open. Below, it starts closed.
  const wide = window.matchMedia('(min-width: 1152px)');

  customElements.define(
    'course-outline',
    class extends WebComponent {
      #globalListeners = new AbortController();

      parsedCallback() {
        const box = this.$<HTMLDetailsElement>(':scope > nav > details');
        const sync = () => {
          box.open = wide.matches;
        };

        sync();
        wide.addEventListener('change', sync, { signal: this.#globalListeners.signal });
        this.on(box, 'toggle', () => {
          if (wide.matches && !box.open) box.open = true;
        });
      }

      disconnectedCallback() {
        super.disconnectedCallback();
        this.#globalListeners.abort();
      }
    },
  );
</script>
