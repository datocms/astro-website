---
import { TocShell } from '~/components/TocShell';
import styles from './style.module.css';

interface Chapter {
  title: string;
  href: string;
  /** The chapter of the page. Its sections show under it. */
  active?: boolean;
  /**
   * The parts of the chapter. A part with an `id` links to that anchor of
   * the page (a heading). A part with an `href` links to a page (an
   * episode); `current` marks the page of the visitor.
   */
  sections?: ({ text: string; current?: boolean } & ({ id: string } | { href: string }))[];
}

interface Props {
  /** For example "Course chapters". */
  title: string;
  /** The short text of the closed box. The default is the position of the open chapter, "2 of 5". */
  note?: string;
  chapters: Chapter[];
  class?: string;
}

const { title, note: noteProp, chapters, class: className } = Astro.props;
const position = chapters.findIndex((chapter) => chapter.active) + 1;
const note = noteProp ?? (position > 0 ? `${position} of ${chapters.length}` : undefined);
// When a part of the open chapter is the page, the part takes the mark, not the chapter.
const isPage = (chapter: Chapter) =>
  chapter.active && !chapter.sections?.some((section) => section.current);
---

{
  /*
  The chapters of a course, with the parts of the open chapter under it:
  the sections of the page, or the pages of the chapter.
  The slot takes the text under the list. TocShell gives the box, the
  float and the mark on the section that the visitor reads.
*/
}
<TocShell title={title} note={note} class={className}>
  <ol>
    {
      chapters.map((chapter) => (
        <li>
          <a
            href={chapter.href}
            title={chapter.title}
            aria-current={isPage(chapter) ? 'page' : undefined}
          >
            {chapter.title}
          </a>
          {chapter.active && chapter.sections && chapter.sections.length > 0 && (
            <ul class={styles.sections}>
              {chapter.sections.map((section) => (
                <li>
                  <a
                    class={styles.section}
                    href={'href' in section ? section.href : `#${section.id}`}
                    title={section.text}
                    aria-current={section.current ? 'page' : undefined}
                  >
                    {section.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
  {
    Astro.slots.has('default') && (
      <Fragment slot="footer">
        <slot />
      </Fragment>
    )
  }
</TocShell>
