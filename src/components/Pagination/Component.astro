---
import styles from './style.module.css';

interface Props {
  /** The number of the current page, from 1. */
  current: number;
  total: number;
  /** The address of page 1. Page n is at `${baseUrl}/p/${n}`. */
  baseUrl: string;
  window?: number;
  /** The query string of each link, with the `?` (for example `?s=cms`). */
  search?: string;
}

const { current, total, baseUrl, window = 7, search = '' } = Astro.props;

const href = (page: number) => (page === 1 ? baseUrl : `${baseUrl}/p/${page}`) + search;

// Show `window` pages around the current page, and keep them inside 1..total.
const first = Math.max(1, Math.min(current - Math.floor(window / 2), total - window + 1));
const pages = Array.from({ length: Math.min(window, total) }, (_, i) => first + i);
---

{
  total > 1 && (
    <nav class:list={[styles.root, 'bodyMedium']} aria-label="Pages">
      {current > 1 ? (
        <a class={styles.step} href={href(current - 1)} rel="prev">
          Previous
        </a>
      ) : (
        <span class:list={[styles.step, styles.disabled]}>Previous</span>
      )}
      <ul class={styles.pages}>
        {pages.map((page) => (
          <li>
            <a
              class={styles.page}
              href={href(page)}
              aria-current={page === current ? 'page' : undefined}
            >
              {page}
            </a>
          </li>
        ))}
      </ul>
      {current < total ? (
        <a class={styles.step} href={href(current + 1)} rel="next">
          Next
        </a>
      ) : (
        <span class:list={[styles.step, styles.disabled]}>Next</span>
      )}
    </nav>
  )
}
