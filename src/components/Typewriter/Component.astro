---
import type { HTMLTag } from 'astro/types';
import type { Step, TypewriterStart } from '~/lib/motion/typewriter';

interface Props {
  /** The tag of the content: `span` for inline content, else a block. */
  as?: HTMLTag;
  /** The steps. They must follow the order of the final text in the slot. */
  script: Step[];
  /** When the animation starts. `manual` waits for a `typewriter:start` event. */
  start?: TypewriterStart;
  /** Delay in ms after the start trigger. */
  delay?: number;
  /**
   * When the visitor scrolls, presses a key or taps before the end, the
   * rest of the animation ends in 500ms. For a hero: the visitor does not
   * wait for it.
   */
  hurryOnInteraction?: boolean;
  /** IntersectionObserver options for `start="view"`. */
  threshold?: number;
  rootMargin?: string;
  class?: string;
}

const {
  as = 'span',
  script,
  start = 'view',
  delay = 0,
  hurryOnInteraction = false,
  threshold = 0,
  rootMargin = '0px',
  class: className,
} = Astro.props;

// A block wrapper keeps block content valid.
const Inner = as === 'span' ? 'span' : 'div';
---

<type-writer
  class={className}
  data-typewriter={JSON.stringify(script)}
  data-tw-start={start}
  data-tw-delay={delay}
  data-tw-hurry={hurryOnInteraction ? '' : undefined}
  data-tw-threshold={threshold}
  data-tw-root-margin={rootMargin}
>
  <Inner data-tw-final><slot /></Inner>
</type-writer>

<script>
  import { onEnterViewport } from '~/lib/motion/inView';
  import { typewrite, type Step, type TypewriterStart } from '~/lib/motion/typewriter';
  import { WebComponent } from '~/lib/WebComponent';

  // The element types its text once: on load, in view, or on a
  // `typewriter:start` event. A `typewriter:replay` event types it again,
  // each time (for example, a form error that comes back). `data-tw-armed`
  // tells the CSS that the script runs. With `data-tw-hurry`, the first
  // scroll, key or tap of the visitor sends `typewriter:hurry`: the rest of
  // the animation then ends in 500ms.
  customElements.define(
    'type-writer',
    class extends WebComponent {
      parsedCallback() {
        this.dataset.twArmed = '';
        const steps = JSON.parse(this.dataset.typewriter || '[]') as Step[];
        const start = (this.dataset.twStart || 'view') as TypewriterStart;
        const delay = Number(this.dataset.twDelay || 0);
        let started = false;
        let running = false;
        const run = async () => {
          if (running) return;
          running = true;
          await typewrite(this, steps);
          running = false;
        };
        const play = () => {
          if (started) return;
          started = true;
          setTimeout(run, delay);
        };
        if (start === 'load') play();
        else if (start === 'view') {
          onEnterViewport(this, play, {
            threshold: Number(this.dataset.twThreshold || 0),
            rootMargin: this.dataset.twRootMargin || '0px',
          });
        }
        if ('twHurry' in this.dataset) this.hurryOnInteraction();
        this.on(this, 'typewriter:start', play);
        this.on(this, 'typewriter:replay', () => {
          started = true;
          run();
        });
      }

      hurryOnInteraction() {
        const events = ['scroll', 'keydown', 'pointerdown'] as const;
        const hurry = () => {
          stop();
          this.dispatchEvent(new CustomEvent('typewriter:hurry'));
        };
        const stop = () => {
          for (const event of events) window.removeEventListener(event, hurry);
        };
        for (const event of events) window.addEventListener(event, hurry, { passive: true });
        this.on(this, 'typewriter:done', stop);
      }
    },
  );
</script>
