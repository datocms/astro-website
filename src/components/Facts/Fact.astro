---
/*
 * One fact of a Facts list. It has two forms:
 *
 * - One value (the slot): the label and the value are on one row, the
 *   label on the left, the value on the right.
 * - A list (`values`): the label is above, and each value is on a line of
 *   its own. A list with one item also has this form, thus all the lists
 *   of a page look the same.
 *
 * A value of the list is a string, or a FactValue with a link.
 *
 * Without a value, the fact does not show.
 */
import styles from './style.module.css';

export type FactValue = {
  text: string;
  /** The value is a link to this URL. */
  href?: string;
  /** The link opens in a new tab. */
  external?: boolean;
};

interface Props {
  label: string;
  /** The values of a list. Without it, the slot is the value. */
  values?: Array<string | FactValue>;
  /** Tabular numbers, for a version, a count or a date. */
  tabular?: boolean;
}

const { label, values, tabular = false } = Astro.props;

const slotted = values ? undefined : await Astro.slots.render('default');
const listItems = values?.map((value) => (typeof value === 'string' ? { text: value } : value));
const isList = listItems !== undefined;
const count = listItems ? listItems.length : slotted?.trim() ? 1 : 0;
---

{
  count > 0 && (
    <div class:list={[styles.fact, isList && styles.list]}>
      <dt class:list={[styles.label, 'label']}>{label}</dt>
      {listItems ? (
        listItems.map((item) => (
          <dd class:list={[styles.value, 'body', tabular && 'tabular']}>
            {item.href ? (
              <a
                href={item.href}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.text}
              </a>
            ) : (
              item.text
            )}
          </dd>
        ))
      ) : (
        <dd class:list={[styles.value, 'body', tabular && 'tabular']}>
          <Fragment set:html={slotted} />
        </dd>
      )}
    </div>
  )
}
