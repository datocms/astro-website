---
/*
 * One fact of a Facts list. It has two forms:
 *
 * - One value (the slot, or `values` with one item): the label and the
 *   value are on one row, the label on the left, the value on the right.
 * - A list (`values` with two or more items): the label is above, and each
 *   value is on a line of its own.
 *
 * Without a value, the fact does not show.
 */
import styles from './style.module.css';

interface Props {
  label: string;
  /** The values of a list. Without it, the slot is the value. */
  values?: string[];
  /** Tabular numbers, for a version, a count or a date. */
  tabular?: boolean;
}

const { label, values, tabular = false } = Astro.props;

const slotted = values ? undefined : await Astro.slots.render('default');
const items = values ?? (slotted?.trim() ? [slotted] : []);
const isList = items.length > 1;
---

{
  items.length > 0 && (
    <div class:list={[styles.fact, isList && styles.list]}>
      <dt class:list={[styles.label, 'label']}>{label}</dt>
      {items.map((item) => (
        <dd class:list={[styles.value, 'body', tabular && 'tabular']}>
          {values ? item : <Fragment set:html={item} />}
        </dd>
      ))}
    </div>
  )
}
