---
/*
 * A list of facts about the subject of a page: a plugin, a starter, a
 * partner, a project. Put one Fact in the slot for each fact.
 *
 * The list uses the dense steps of the type ladder (the steps of the docs),
 * thus a value is body text that can wrap, at the size of a label.
 */
import styles from './style.module.css';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<dl class:list={[styles.facts, className]} data-density="dense">
  <slot />
</dl>
