{
  "name": "datocms-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  "cache": { "enabled": true },
  "observability": { "enabled": true },
}
