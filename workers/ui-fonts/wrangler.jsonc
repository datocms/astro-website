// Deploy with `npx wrangler deploy` from this folder.
// Upload a font with:
// npx wrangler r2 object put datocms-ui-fonts/<file> --file <path> --content-type font/woff2 --remote
{
  "name": "datocms-ui-fonts",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "UI_FONTS", "bucket_name": "datocms-ui-fonts" }],
}
